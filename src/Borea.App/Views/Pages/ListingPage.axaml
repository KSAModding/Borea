<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Borea.App.ViewModels"
             xmlns:views="using:Borea.App.Views"
             xmlns:listings="using:Borea.Core.Listings"
             x:Class="Borea.App.Views.Pages.ListingPage"
             x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <StyleInclude Source="avares://Borea.App/Views/PageBodyStyles.axaml" />
        <Style Selector="Button.step">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="-8,0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.step:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
        </Style>
        <Style Selector="Border.step-mark">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
        </Style>
        <Style Selector="Border.step-mark.done">
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Positive}" />
        </Style>
        <Style Selector="Border.step-mark.done Path">
            <Setter Property="Stroke" Value="{StaticResource Brush.Positive}" />
        </Style>
        <Style Selector="Border.step-mark.fix">
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
            <Setter Property="Background" Value="{StaticResource Brush.DangerSoft}" />
        </Style>
        <Style Selector="Border.step-mark.fix TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
        </Style>
    </UserControl.Styles>
    <UserControl.Resources>
        <!-- a stamped release in a list of releases, a release that is not stable with its status -->
        <DataTemplate x:Key="ReleaseChoiceTemplate" x:DataType="vm:ListingReleaseChoice">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Version}" VerticalAlignment="Center" />
                <Border Classes="chip" VerticalAlignment="Center" IsVisible="{Binding HasStatus}">
                    <TextBlock Text="{Binding Status}" />
                </Border>
            </StackPanel>
        </DataTemplate>
        <!-- the icon or one description image -->
        <DataTemplate x:Key="ListingImageTemplate" x:DataType="vm:ListingImageRow">
            <Border Background="{StaticResource Brush.Window}" CornerRadius="12" Padding="16">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,8,Auto">
                        <TextBlock Classes="label-md" Text="{Binding FactsText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="icon" Command="{Binding RemoveCommand}" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingRemove}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingRemove}">
                            <Path Classes="icon size-16" Data="{StaticResource Icon.Trash}" />
                        </Button>
                    </Grid>
                    <StackPanel Spacing="6" IsVisible="{Binding IsDescriptionImage}">
                        <TextBlock Classes="heading-sm" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingId}" />
                        <TextBox Classes="field" Text="{Binding Id}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingId}" />
                    </StackPanel>
                    <TextBlock Classes="heading-sm" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingImageUrl}" />
                    <TextBlock Classes="body-sm secondary" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingImageUrlHint}" TextWrapping="Wrap" />
                    <TextBox Classes="field" Text="{Binding Url}" PlaceholderText="https://" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingImageUrl}" />
                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                        <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingChooseFile}" Command="{Binding ChooseFileCommand}" />
                        <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingMeasure}" Command="{Binding MeasureCommand}" />
                    </WrapPanel>
                    <TextBlock Classes="body-sm danger" Text="{Binding Problem}" TextWrapping="Wrap" IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Classes="heading-sm" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingImageLicense}" Margin="0,6,0,0" />
                    <TextBox Classes="field" Text="{Binding License}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingImageLicense}" />
                    <TextBlock Classes="heading-sm" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingImageAttribution}" />
                    <TextBox Classes="field" Text="{Binding Attribution}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingImageAttribution}" />
                    <TextBlock Classes="heading-sm" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingImageSource}" />
                    <TextBox Classes="field" Text="{Binding Source}" PlaceholderText="https://" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingImageSource}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- List or change your mod: the form, with the checks along the right edge -->
    <Grid>
        <ScrollViewer>
            <views:PageBodyPanel HasSidePanel="True">
                <StackPanel Container.Name="page-body" Container.Sizing="Width">
                    <StackPanel Orientation="Horizontal" Spacing="4" Height="24">
                        <Button Classes="plain back" Command="{Binding GoBackCommand}" VerticalAlignment="Center" ToolTip.Tip="{Binding Localization.NavigationBack}" AutomationProperties.Name="{Binding Localization.NavigationBack}">
                            <Path Classes="icon" Data="{StaticResource Icon.ArrowLeft}" />
                        </Button>
                        <Path Classes="icon" Data="{StaticResource Icon.Compass}" />
                        <Button Classes="plain" Command="{Binding SetMainWindowDiscover}">
                            <TextBlock Classes="label-lg" Text="{Binding Localization.PageDiscoverHeading}" VerticalAlignment="Center" />
                        </Button>
                        <TextBlock Classes="label-lg" Text="/" VerticalAlignment="Center" />
                        <TextBlock Classes="label-lg" Text="{Binding Localization.DiscoverListYourMod}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="body-md secondary" Text="{Binding Localization.ListingIntro}" TextWrapping="Wrap" Margin="0,24,0,0" />

                    <!-- start: a new listing from its release host, or a listed one to change -->
                    <StackPanel Spacing="16" Margin="0,24,0,0" IsVisible="{Binding ListingEditor.IsStartStep}">
                        <Border Classes="card" Padding="24">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="heading-md" Text="{Binding Localization.ListingNewTitle}" />
                                <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ListingNewHint}" TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="*,8,Auto" Margin="0,4,0,0" IsEnabled="{Binding !ListingEditor.IsBusy}">
                                    <TextBox Classes="field" Text="{Binding ListingEditor.SourceText}" PlaceholderText="{Binding Localization.ListingSourcePlaceholder}" AutomationProperties.Name="{Binding Localization.ListingNewTitle}" />
                                    <Button Grid.Column="2" Classes="text primary" Content="{Binding Localization.ListingReadSource}" Command="{Binding ListingEditor.ReadSourceCommand}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,8,Auto" IsVisible="{Binding ListingEditor.IsReadingSource}">
                                    <TextBlock Classes="body-sm secondary" Text="{Binding ListingEditor.SourceProgress}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Classes="text" Content="{Binding Localization.LibraryCancel}" Command="{Binding ListingEditor.CancelCommand}" />
                                </Grid>
                                <TextBlock Classes="body-sm danger" Text="{Binding ListingEditor.SourceError}" TextWrapping="Wrap" IsVisible="{Binding ListingEditor.SourceError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <Button Classes="link" Command="{Binding ListingEditor.StartEmptyCommand}" HorizontalAlignment="Left" IsEnabled="{Binding !ListingEditor.IsBusy}">
                                    <TextBlock Classes="action-md" Text="{Binding Localization.ListingStartEmpty}" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Classes="card" Padding="24">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="heading-md" Text="{Binding Localization.ListingPackTitle}" />
                                <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ListingPackHint}" TextWrapping="Wrap" />
                                <Button Classes="link" Command="{Binding ListingEditor.StartPackCommand}" HorizontalAlignment="Left" IsEnabled="{Binding !ListingEditor.IsBusy}">
                                    <TextBlock Classes="action-md" Text="{Binding Localization.ListingStartPack}" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Classes="card" Padding="24">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="heading-md" Text="{Binding Localization.ListingChangeTitle}" />
                                <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ListingChangeHint}" TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="*,8,Auto" Margin="0,4,0,0" IsEnabled="{Binding !ListingEditor.IsBusy}">
                                    <TextBox x:Name="ListedSearch" Classes="field search" Text="{Binding ListingEditor.ListedQuery}" PlaceholderText="{Binding Localization.ListingSearchListed}" AutomationProperties.Name="{Binding Localization.ListingChangeTitle}">
                                        <TextBox.InnerLeftContent>
                                            <Path Classes="icon size-16" Data="{StaticResource Icon.Search}" Margin="10,0,0,0" />
                                        </TextBox.InnerLeftContent>
                                    </TextBox>
                                    <Button Grid.Column="2" Classes="text" Content="{Binding Localization.ListingLoad}" Command="{Binding ListingEditor.LoadListedCommand}" />
                                </Grid>
                                <ListBox x:Name="ListedResults" ItemsSource="{Binding ListingEditor.ListedMatches}" SelectedItem="{Binding ListingEditor.SelectedListed}" MaxHeight="240" IsEnabled="{Binding !ListingEditor.IsBusy}" AutomationProperties.Name="{Binding Localization.ListingChangeTitle}" IsVisible="{Binding !!ListingEditor.ListedMatches.Count}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ListedListing">
                                            <Grid ColumnDefinitions="*,16,Auto,8,Auto">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Classes="heading-sm" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Classes="label-md" Text="{Binding Id}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Classes="body-sm secondary" Text="{Binding AuthorsText}" MaxWidth="240" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <Border Grid.Column="4" Classes="chip positive" VerticalAlignment="Center" IsVisible="{Binding IsOwn}">
                                                    <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingYourMod}" />
                                                </Border>
                                                <Border Grid.Column="4" Classes="chip" VerticalAlignment="Center" IsVisible="{Binding IsPack}">
                                                    <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentTypeModPack}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ListingNoListedOrPackMatch}" IsVisible="{Binding ListingEditor.HasNoListedMatch}" />
                                <TextBlock Classes="body-sm danger" Text="{Binding ListingEditor.ListedError}" TextWrapping="Wrap" IsVisible="{Binding ListingEditor.ListedError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- form -->
                    <StackPanel Spacing="16" Margin="0,24,0,0" IsVisible="{Binding ListingEditor.IsFormStep}">
                        <Grid ColumnDefinitions="*,16,Auto">
                            <Panel VerticalAlignment="Center">
                                <TextBlock Classes="heading-lg" Text="{Binding ListingEditor.NewTitle}" IsVisible="{Binding ListingEditor.IsNew}" />
                                <TextBlock Classes="heading-lg" Text="{Binding ListingEditor.Id}" TextTrimming="CharacterEllipsis" IsVisible="{Binding ListingEditor.HasFixedId}" />
                            </Panel>
                            <Button Grid.Column="2" Classes="text" Content="{Binding Localization.ListingStartOver}" Command="{Binding ListingEditor.StartOverCommand}" />
                        </Grid>
                        <TextBlock Classes="body-sm secondary" Text="{Binding ListingEditor.NextVersionText}" TextWrapping="Wrap" IsVisible="{Binding ListingEditor.IsNextVersion}" />
                        <TextBlock Classes="body-sm secondary" Text="{Binding ListingEditor.ArchiveText}" TextWrapping="Wrap" IsVisible="{Binding ListingEditor.ArchiveText, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <Border Classes="card" Padding="24" Tag="about">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="heading-md" Text="{Binding Localization.ListingAbout}" Margin="0,0,0,6" />
                                <TextBlock Classes="heading-sm" Text="{Binding Localization.ListingId}" />
                                <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ListingIdHint}" TextWrapping="Wrap" IsVisible="{Binding !ListingEditor.IsPack}" />
                                <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ListingPackIdHint}" TextWrapping="Wrap" IsVisible="{Binding ListingEditor.IsPack}" />
                                <TextBox Classes="field" Text="{Binding ListingEditor.Id}" IsReadOnly="{Binding ListingEditor.HasFixedId}" AutomationProperties.Name="{Binding Localization.ListingId}" />
                                <TextBlock Classes="heading-sm" Text="{Binding Localization.ListingName}" Margin="0,10,0,0" />
                                <TextBox Classes="field" Text="{Binding ListingEditor.Name}" AutomationProperties.Name="{Binding Localization.ListingName}" />
                                <TextBlock Classes="heading-sm" Text="{Binding Localization.ListingAuthors}" Margin="0,10,0,0" />
                                <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ListingAuthorsHint}" TextWrapping="Wrap" />
                                <TextBox Classes="field" Text="{Binding ListingEditor.Authors}" AutomationProperties.Name="{Binding Localization.ListingAuthors}" />
                                <TextBlock Classes="heading-sm" Text="{Binding Localization.ListingAbstract}" Margin="0,10,0,0" />
                                <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ListingAbstractHint}" TextWrapping="Wrap" />
                                <TextBox Classes="field" Text="{Binding ListingEditor.Abstract}" TextWrapping="Wrap" AutomationProperties.Name="{Binding Localization.ListingAbstract}" />
                                <Grid ColumnDefinitions="*,16,Auto,8,Auto" Margin="0,10,0,0">
                                    <TextBlock Classes="heading-sm" Text="{Binding Localization.ListingDescription}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Classes="label-md" Text="{Binding Localization.ListingPreview}" VerticalAlignment="Center" />
                                    <ToggleSwitch Grid.Column="4" Classes="switch" IsChecked="{Binding ListingEditor.IsDescriptionPreviewOn}" AutomationProperties.Name="{Binding Localization.ListingDescriptionPreview}" />
                                </Grid>
                                <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ListingDescriptionHint}" TextWrapping="Wrap" />
                                <!-- the preview stands next to the field, so turning it on or off does not move the rest of the page -->
                                <Grid Classes="description-editor" Classes.preview="{Binding ListingEditor.IsDescriptionPreviewOn}" ColumnDefinitions="*,16,*">
                                    <Grid.Styles>
                                        <Style Selector="Grid.description-editor > TextBox">
                                            <Setter Property="Grid.ColumnSpan" Value="3" />
                                        </Style>
                                        <Style Selector="Grid.description-editor.preview > TextBox">
                                            <Setter Property="Grid.ColumnSpan" Value="1" />
                                        </Style>
                                    </Grid.Styles>
                                    <TextBox Classes="field" Text="{Binding ListingEditor.Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" MaxHeight="480" AutomationProperties.Name="{Binding Localization.ListingDescription}" />
                                    <!-- the description as the mod page draws it, with the same view -->
                                    <Border Grid.Column="2" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="12" MaxHeight="480" IsVisible="{Binding ListingEditor.IsDescriptionPreviewOn}">
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                            <Panel Margin="24">
                                                <views:MarkdownView Markdown="{Binding ListingEditor.DescriptionPreview}" Images="{Binding ListingEditor.DescriptionPreviewImages}" IsVisible="{Binding ListingEditor.DescriptionPreview, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                <TextBlock Classes="body-md muted" Text="{Binding Localization.ContentNoDescription}" IsVisible="{Binding ListingEditor.DescriptionPreview, Converter={x:Static ObjectConverters.IsNull}}" />
                                            </Panel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                                <TextBlock Classes="heading-sm" Text="{Binding Localization.ListingLicense}" Margin="0,10,0,0" />
                                <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ListingLicenseHint}" TextWrapping="Wrap" />
                                <TextBox Classes="field" Text="{Binding ListingEditor.License}" AutomationProperties.Name="{Binding Localization.ListingLicense}" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="24" Tag="links">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="heading-md" Text="{Binding Localization.ListingLinks}" Margin="0,0,0,6" />
                                <TextBlock Classes="heading-sm" Text="{Binding Localization.LinkForum}" />
                                <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ListingForumsHint}" TextWrapping="Wrap" />
                                <TextBox Classes="field" Text="{Binding ListingEditor.Forums}" PlaceholderText="https://forums.ahwoo.com/threads/" AutomationProperties.Name="{Binding Localization.LinkForum}" />
                                <TextBlock Classes="heading-sm" Text="{Binding Localization.LinkHomepage}" Margin="0,10,0,0" />
                                <TextBox Classes="field" Text="{Binding ListingEditor.Homepage}" AutomationProperties.Name="{Binding Localization.LinkHomepage}" />
                                <TextBlock Classes="heading-sm" Text="{Binding Localization.LinkRepository}" Margin="0,10,0,0" />
                                <TextBox Classes="field" Text="{Binding ListingEditor.Repository}" AutomationProperties.Name="{Binding Localization.LinkRepository}" />
                                <TextBlock Classes="heading-sm" Text="SpaceDock" Margin="0,10,0,0" />
                                <TextBox Classes="field" Text="{Binding ListingEditor.SpaceDockPage}" AutomationProperties.Name="SpaceDock" />
                                <TextBlock Classes="heading-sm" Text="{Binding Localization.LinkBugTracker}" Margin="0,10,0,0" />
                                <TextBox Classes="field" Text="{Binding ListingEditor.BugTracker}" AutomationProperties.Name="{Binding Localization.LinkBugTracker}" />
                                <TextBlock Classes="heading-sm" Text="{Binding Localization.LinkDiscussions}" Margin="0,10,0,0" />
                                <TextBox Classes="field" Text="{Binding ListingEditor.Discussions}" AutomationProperties.Name="{Binding Localization.LinkDiscussions}" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="24" Tag="releases" IsVisible="{Binding !ListingEditor.IsPack}">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="heading-md" Text="{Binding Localization.ListingReleases}" />
                                <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ListingReleasesHint}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <TextBlock Classes="heading-sm" Text="{Binding Localization.ListingReleasesGitHub}" />
                                <TextBox Classes="field" Text="{Binding ListingEditor.ReleasesGitHub}" PlaceholderText="owner/repository" AutomationProperties.Name="{Binding Localization.ListingReleasesGitHub}" />
                                <TextBlock Classes="heading-sm" Text="{Binding Localization.ListingReleasesSpaceDock}" Margin="0,10,0,0" />
                                <TextBox Classes="field" Text="{Binding ListingEditor.ReleasesSpaceDock}" AutomationProperties.Name="{Binding Localization.ListingReleasesSpaceDock}" />
                                <StackPanel Spacing="6" Margin="0,10,0,0" IsVisible="{Binding ListingEditor.NeedsAuthority}">
                                    <TextBlock Classes="heading-sm" Text="{Binding Localization.ListingReleasesAuthority}" />
                                    <ComboBox ItemsSource="{x:Static vm:ListingEditor.Authorities}" SelectedItem="{Binding ListingEditor.ReleasesAuthority}" AutomationProperties.Name="{Binding Localization.ListingReleasesAuthority}" MinWidth="200" />
                                </StackPanel>
                                <StackPanel Spacing="6" Margin="0,10,0,0" IsVisible="{Binding ListingEditor.HasReleasesHost}">
                                    <TextBlock Classes="heading-sm" Text="{Binding Localization.ListingReleasesSince}" />
                                    <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ListingReleasesSinceHint}" TextWrapping="Wrap" />
                                    <TextBox Classes="field" Text="{Binding ListingEditor.ReleasesSince}" PlaceholderText="1.0.0" AutomationProperties.Name="{Binding Localization.ListingReleasesSince}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="24" Tag="pack" IsVisible="{Binding ListingEditor.IsPack}">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="heading-md" Text="{Binding Localization.ListingPack}" Margin="0,0,0,6" />
                                <TextBlock Classes="heading-sm" Text="{Binding Localization.ListingPackVersion}" />
                                <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ListingPackVersionHint}" TextWrapping="Wrap" />
                                <TextBox Classes="field" Text="{Binding ListingEditor.PackVersion}" AutomationProperties.Name="{Binding Localization.ListingPackVersion}" />
                                <TextBlock Classes="heading-sm" Text="{Binding Localization.ListingReleasedAt}" Margin="0,10,0,0" />
                                <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ListingReleasedAtHint}" TextWrapping="Wrap" />
                                <TextBox Classes="field" Text="{Binding ListingEditor.ReleasedAt}" AutomationProperties.Name="{Binding Localization.ListingReleasedAt}" />
                                <TextBlock Classes="heading-sm" Text="{Binding Localization.ListingChangelog}" Margin="0,10,0,0" />
                                <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ListingChangelogHint}" TextWrapping="Wrap" />
                                <TextBox Classes="field" Text="{Binding ListingEditor.Changelog}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="240" AutomationProperties.Name="{Binding Localization.ListingChangelog}" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="24" Tag="members" IsVisible="{Binding ListingEditor.IsPack}">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="heading-md" Text="{Binding Localization.ListingMembers}" />
                                <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ListingMembersHint}" TextWrapping="Wrap" />
                                <StackPanel Spacing="4" IsVisible="{Binding ListingEditor.HasLeftOut}">
                                    <TextBlock Classes="body-sm" Text="{Binding ListingEditor.LeftOutTitle}" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding ListingEditor.LeftOut}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Classes="body-sm secondary" Text="{Binding}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding ListingEditor.Members}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ListingPackMemberRow">
                                            <Border Background="{StaticResource Brush.Window}" CornerRadius="12" Padding="12">
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnDefinitions="*,8,Auto,8,Auto">
                                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Classes="heading-sm" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Classes="label-md" Text="{Binding Id}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="2" MinWidth="180" VerticalAlignment="Center" ItemsSource="{Binding Releases}" SelectedItem="{Binding Selected}" ItemTemplate="{StaticResource ReleaseChoiceTemplate}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingMemberRelease}" />
                                                        <Button Grid.Column="4" Classes="icon" Command="{Binding RemoveCommand}" VerticalAlignment="Center" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingRemove}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingRemove}">
                                                            <Path Classes="icon size-16" Data="{StaticResource Icon.Trash}" />
                                                        </Button>
                                                    </Grid>
                                                    <TextBlock Classes="body-sm secondary" Text="{Binding Note}" TextWrapping="Wrap" IsVisible="{Binding HasNote}" />
                                                    <TextBlock Classes="body-sm danger" Text="{Binding RetractionNote}" TextWrapping="Wrap" IsVisible="{Binding IsNamedInRetraction}" />
                                                    <WrapPanel ItemSpacing="8" LineSpacing="4" IsVisible="{Binding HasNewer}">
                                                        <Border Classes="chip" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding NewerText}" />
                                                        </Border>
                                                        <Button Classes="link" Command="{Binding UseNewerCommand}" VerticalAlignment="Center">
                                                            <TextBlock Classes="action-md" Text="{Binding UseNewerText}" />
                                                        </Button>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid ColumnDefinitions="*,8,Auto" Margin="0,4,0,0">
                                    <TextBox Classes="field search" Text="{Binding ListingEditor.MemberQuery}" PlaceholderText="{Binding Localization.ListingSearchMembers}" AutomationProperties.Name="{Binding Localization.ListingSearchMembers}">
                                        <TextBox.InnerLeftContent>
                                            <Path Classes="icon size-16" Data="{StaticResource Icon.Search}" Margin="10,0,0,0" />
                                        </TextBox.InnerLeftContent>
                                    </TextBox>
                                    <Button Grid.Column="2" Classes="text" Content="{Binding Localization.ListingAddMember}" Command="{Binding ListingEditor.AddMemberCommand}" />
                                </Grid>
                                <ListBox ItemsSource="{Binding ListingEditor.MemberMatches}" SelectedItem="{Binding ListingEditor.SelectedMemberMatch}" MaxHeight="240" AutomationProperties.Name="{Binding Localization.ListingSearchMembers}" IsVisible="{Binding !!ListingEditor.MemberMatches.Count}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ListedListing">
                                            <Grid ColumnDefinitions="*,16,Auto">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Classes="heading-sm" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Classes="label-md" Text="{Binding Id}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Classes="body-sm secondary" Text="{Binding AuthorsText}" MaxWidth="240" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ListingNoListedMatch}" IsVisible="{Binding ListingEditor.HasNoMemberMatch}" />
                                <Button Classes="link" Command="{Binding ListingEditor.CopyForumListCommand}" HorizontalAlignment="Left" IsVisible="{Binding !!ListingEditor.Members.Count}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon size-16" Data="{StaticResource Icon.Copy}" />
                                        <TextBlock Classes="action-md" Text="{Binding Localization.ListingCopyForumList}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="24" Tag="compatibility">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="heading-md" Text="{Binding Localization.ListingCompatibility}" />
                                <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ListingGameHint}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <TextBlock Classes="heading-sm" Text="{Binding Localization.ListingGameMin}" />
                                <TextBox Classes="field" Text="{Binding ListingEditor.GameMin}" AutomationProperties.Name="{Binding Localization.ListingGameMin}" />
                                <StackPanel Spacing="4" IsVisible="{Binding ListingEditor.GameMinProposal, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <TextBlock Classes="body-sm" Text="{Binding ListingEditor.GameMinProposalText}" TextWrapping="Wrap" />
                                    <Button Classes="link" Command="{Binding ListingEditor.UseGameMinProposalCommand}" HorizontalAlignment="Left">
                                        <TextBlock Classes="action-md" Text="{Binding Localization.ListingUseGameMin}" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Classes="heading-sm" Text="{Binding Localization.ListingGameMax}" Margin="0,10,0,0" />
                                <TextBox Classes="field" Text="{Binding ListingEditor.GameMax}" AutomationProperties.Name="{Binding Localization.ListingGameMax}" />
                                <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ListingGameMaxHint}" TextWrapping="Wrap" />
                                <StackPanel Spacing="6" Margin="0,16,0,0" IsVisible="{Binding ListingEditor.CanUseLoader}">
                                    <Grid ColumnDefinitions="*,16,Auto">
                                        <TextBlock Classes="heading-sm" Text="{Binding Localization.ListingUsesLoader}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="2" Classes="switch" IsChecked="{Binding ListingEditor.UsesLoader}" AutomationProperties.Name="{Binding Localization.ListingUsesLoader}" />
                                    </Grid>
                                    <StackPanel Spacing="6" IsVisible="{Binding ListingEditor.UsesLoader}">
                                        <TextBlock Classes="heading-sm" Text="{Binding Localization.ListingLoaderId}" Margin="0,6,0,0" />
                                        <TextBox Classes="field" Text="{Binding ListingEditor.LoaderId}" AutomationProperties.Name="{Binding Localization.ListingLoaderId}" />
                                        <TextBlock Classes="heading-sm" Text="{Binding Localization.ListingLoaderMin}" Margin="0,10,0,0" />
                                        <TextBox Classes="field" Text="{Binding ListingEditor.LoaderMin}" AutomationProperties.Name="{Binding Localization.ListingLoaderMin}" />
                                        <TextBlock Classes="heading-sm" Text="{Binding Localization.ListingLoaderMax}" Margin="0,10,0,0" />
                                        <TextBox Classes="field" Text="{Binding ListingEditor.LoaderMax}" AutomationProperties.Name="{Binding Localization.ListingLoaderMax}" />
                                        <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ListingLoaderMaxHint}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="24" Tag="dependencies" IsVisible="{Binding !ListingEditor.IsPack}">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="heading-md" Text="{Binding Localization.ListingDependencies}" />
                                <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ListingDependenciesHint}" TextWrapping="Wrap" />
                                <Border Background="{StaticResource Brush.Window}" CornerRadius="12" Padding="12" IsVisible="{Binding ListingEditor.HasDeclaredHelp}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="body-sm secondary" Text="{Binding ListingEditor.DeclaredText}" TextWrapping="Wrap" IsVisible="{Binding ListingEditor.DeclaredText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        <ItemsControl ItemsSource="{Binding ListingEditor.DeclaredDependencies}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ListingDeclaredDependencyRow">
                                                    <Grid ColumnDefinitions="*,8,Auto,8,Auto">
                                                        <TextBlock Classes="body-md" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                        <Border Grid.Column="2" Classes="chip" VerticalAlignment="Center" IsVisible="{Binding IsLoader}">
                                                            <TextBlock Text="{Binding ModLoaderText}" />
                                                        </Border>
                                                        <Button Grid.Column="4" Classes="link" Command="{Binding AddBoundsCommand}" VerticalAlignment="Center" IsVisible="{Binding CanAddBounds}">
                                                            <TextBlock Classes="action-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingAddBounds}" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Spacing="4" IsVisible="{Binding ListingEditor.HasReleasesHost}">
                                            <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ListingReadArchiveHint}" TextWrapping="Wrap" />
                                            <Button Classes="link" Command="{Binding ListingEditor.ReadArchiveDependenciesCommand}" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Download}" />
                                                    <TextBlock Classes="action-md" Text="{Binding Localization.ListingReadArchive}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,8,Auto" IsVisible="{Binding ListingEditor.ArchiveReadText, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <TextBlock Classes="body-sm secondary" Text="{Binding ListingEditor.ArchiveReadText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Classes="text" Content="{Binding Localization.LibraryCancel}" Command="{Binding ListingEditor.CancelArchiveReadCommand}" IsVisible="{Binding ListingEditor.IsReadingArchive}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding ListingEditor.Dependencies}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ListingDependencyRow">
                                            <Border Background="{StaticResource Brush.Window}" CornerRadius="12" Padding="12">
                                                <Grid ColumnDefinitions="*,8,Auto">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="body-md secondary" Text="{Binding PreservedText}" TextWrapping="Wrap" Margin="0,6,0,0" IsVisible="{Binding IsPreserved}" />
                                                        <WrapPanel ItemSpacing="8" LineSpacing="8" IsVisible="{Binding IsEditable}">
                                                            <TextBox Classes="field" Width="180" Text="{Binding Id}" PlaceholderText="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingId}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingId}" />
                                                            <ComboBox Width="130" MinHeight="35" VerticalAlignment="Center" ItemsSource="{Binding KindChoices}" SelectedItem="{Binding Kind}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingDependencyKind}" />
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBox Classes="field" Width="150" Text="{Binding Min}" PlaceholderText="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingDependencyMin}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingDependencyMin}" IsVisible="{Binding HasNoVersions}" />
                                                                <ComboBox Width="150" MinHeight="35" VerticalAlignment="Center" IsEditable="True" ItemsSource="{Binding Versions}" Text="{Binding Min}" ItemTemplate="{StaticResource ReleaseChoiceTemplate}" PlaceholderText="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingDependencyMin}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingDependencyMin}" IsVisible="{Binding HasVersions}" />
                                                                <Button Classes="link" Command="{Binding NeedsNewestCommand}" VerticalAlignment="Center" ToolTip.Tip="{Binding NeedsNewestHint}" IsVisible="{Binding CanNeedNewest}">
                                                                    <TextBlock Classes="action-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingNeedsNewest}" />
                                                                </Button>
                                                            </StackPanel>
                                                            <Panel>
                                                                <TextBox Classes="field" Width="150" Text="{Binding Max}" PlaceholderText="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingDependencyMax}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingDependencyMax}" IsVisible="{Binding HasNoVersions}" />
                                                                <ComboBox Width="150" MinHeight="35" VerticalAlignment="Center" IsEditable="True" ItemsSource="{Binding Versions}" Text="{Binding Max}" ItemTemplate="{StaticResource ReleaseChoiceTemplate}" PlaceholderText="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingDependencyMax}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingDependencyMax}" IsVisible="{Binding HasVersions}" />
                                                            </Panel>
                                                        </WrapPanel>
                                                        <TextBlock Classes="body-sm secondary" Text="{Binding KindText}" TextWrapping="Wrap" IsVisible="{Binding HasKindText}" />
                                                        <TextBlock Classes="body-sm danger" Text="{Binding ErrorText}" TextWrapping="Wrap" IsVisible="{Binding HasErrors}" />
                                                        <TextBlock Classes="body-sm" Text="{Binding NoteText}" TextWrapping="Wrap" IsVisible="{Binding HasNotes}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Classes="icon" Command="{Binding RemoveCommand}" VerticalAlignment="Top" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingRemove}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingRemove}">
                                                        <Path Classes="icon size-16" Data="{StaticResource Icon.Trash}" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid ColumnDefinitions="*,8,Auto" Margin="0,4,0,0">
                                    <TextBox Classes="field search" Text="{Binding ListingEditor.DependencyQuery}" PlaceholderText="{Binding Localization.ListingSearchDependencies}" AutomationProperties.Name="{Binding Localization.ListingSearchDependencies}">
                                        <TextBox.InnerLeftContent>
                                            <Path Classes="icon size-16" Data="{StaticResource Icon.Search}" Margin="10,0,0,0" />
                                        </TextBox.InnerLeftContent>
                                    </TextBox>
                                    <Button Grid.Column="2" Classes="text" Content="{Binding Localization.ListingAddMember}" Command="{Binding ListingEditor.AddListedDependencyCommand}" />
                                </Grid>
                                <ListBox ItemsSource="{Binding ListingEditor.DependencyMatches}" SelectedItem="{Binding ListingEditor.SelectedDependencyMatch}" MaxHeight="240" AutomationProperties.Name="{Binding Localization.ListingSearchDependencies}" IsVisible="{Binding !!ListingEditor.DependencyMatches.Count}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ListedListing">
                                            <Grid ColumnDefinitions="*,16,Auto">
                                                <StackPanel Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Classes="heading-sm" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <Border Classes="chip" VerticalAlignment="Center" IsVisible="{Binding IsLoader}">
                                                            <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentTypeModLoader}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Classes="label-md" Text="{Binding Id}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Classes="body-sm secondary" Text="{Binding AuthorsText}" MaxWidth="240" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ListingNoListedMatch}" IsVisible="{Binding ListingEditor.HasNoDependencyMatch}" />
                                <TextBlock Classes="body-sm" Text="{Binding ListingEditor.LoaderSetText}" TextWrapping="Wrap" IsVisible="{Binding ListingEditor.LoaderSetText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <Button Classes="link" Command="{Binding ListingEditor.AddDependencyCommand}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon size-16" Data="{StaticResource Icon.Plus}" />
                                        <TextBlock Classes="action-md" Text="{Binding Localization.ListingAddDependency}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="24" Tag="tags">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="heading-md" Text="{Binding Localization.ListingTags}" />
                                <ItemsControl ItemsSource="{Binding ListingEditor.CuratedTags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemSpacing="6" LineSpacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ListingTagChip">
                                            <Button Classes="filter" Classes.active="{Binding IsSelected}" Command="{Binding ToggleCommand}" ToolTip.Tip="{Binding Meaning}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Path Classes="icon size-16" Data="{Binding Tag, Converter={x:Static views:CategoryIcon.FromTag}}" />
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Classes="heading-sm" Text="{Binding Localization.ListingMoreTags}" Margin="0,8,0,0" />
                                <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ListingMoreTagsHint}" TextWrapping="Wrap" />
                                <TextBox Classes="field" Text="{Binding ListingEditor.FreeTags}" AutomationProperties.Name="{Binding Localization.ListingMoreTags}" />
                                <TextBlock Classes="body-sm secondary" Text="{Binding ListingEditor.FreeTagsStoredText}" TextWrapping="Wrap" IsVisible="{Binding ListingEditor.FreeTagsStoredText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="24" Tag="images">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="heading-md" Text="{Binding Localization.ListingImages}" />
                                <TextBlock Classes="heading-sm" Text="{Binding Localization.ListingIcon}" Margin="0,6,0,0" />
                                <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ListingIconHint}" TextWrapping="Wrap" />
                                <ContentControl Content="{Binding ListingEditor.Icon}" ContentTemplate="{StaticResource ListingImageTemplate}" IsVisible="{Binding ListingEditor.HasIcon}" />
                                <Button Classes="link" Command="{Binding ListingEditor.AddIconCommand}" HorizontalAlignment="Left" IsVisible="{Binding ListingEditor.CanAddIcon}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon size-16" Data="{StaticResource Icon.Plus}" />
                                        <TextBlock Classes="action-md" Text="{Binding Localization.ListingAddIcon}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Classes="heading-sm" Text="{Binding Localization.ListingDescriptionImages}" Margin="0,10,0,0" />
                                <ItemsControl ItemsSource="{Binding ListingEditor.DescriptionImages}" ItemTemplate="{StaticResource ListingImageTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Button Classes="link" Command="{Binding ListingEditor.AddDescriptionImageCommand}" HorizontalAlignment="Left" IsEnabled="{Binding ListingEditor.CanAddDescriptionImage}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon size-16" Data="{StaticResource Icon.Plus}" />
                                        <TextBlock Classes="action-md" Text="{Binding Localization.ListingAddImage}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="24" Tag="status" IsVisible="{Binding ListingEditor.HasFixedId}">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="heading-md" Text="{Binding Localization.ListingStatus}" Margin="0,0,0,6" />
                                <Grid ColumnDefinitions="*,16,Auto">
                                    <TextBlock Classes="heading-sm" Text="{Binding Localization.ListingDeprecated}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <ToggleSwitch Grid.Column="2" Classes="switch" IsChecked="{Binding ListingEditor.IsDeprecated}" AutomationProperties.Name="{Binding Localization.ListingDeprecated}" />
                                </Grid>
                                <StackPanel Spacing="6" IsVisible="{Binding ListingEditor.IsDeprecated}">
                                    <TextBlock Classes="heading-sm" Text="{Binding Localization.ListingSupersededBy}" Margin="0,10,0,0" />
                                    <TextBox Classes="field" Text="{Binding ListingEditor.SupersededBy}" AutomationProperties.Name="{Binding Localization.ListingSupersededBy}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- the listing file, and what happens with it -->
                        <Border Classes="card" Padding="24">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="heading-md" Text="{Binding Localization.ListingFile}" />
                                <Border Background="{StaticResource Brush.Window}" CornerRadius="8" Padding="12">
                                    <SelectableTextBlock FontFamily="{StaticResource Font.Mono}" FontSize="12" Text="{Binding ListingEditor.DocumentText}" TextWrapping="Wrap" />
                                </Border>
                                <WrapPanel ItemSpacing="8" LineSpacing="8">
                                    <Button Classes="text" Content="{Binding Localization.ListingCopy}" Command="{Binding ListingEditor.CopyCommand}" />
                                    <Button Classes="text" Content="{Binding Localization.ListingSaveAs}" Command="{Binding ListingEditor.SaveCommand}" />
                                </WrapPanel>
                                <!-- the owner record that the first version of a new pack adds, for the browser path -->
                                <StackPanel Spacing="8" IsVisible="{Binding ListingEditor.IsNewPack}">
                                    <TextBlock Classes="body-sm secondary" Text="{Binding ListingEditor.OwnerFileText}" TextWrapping="Wrap" />
                                    <Border Background="{StaticResource Brush.Window}" CornerRadius="8" Padding="12">
                                        <SelectableTextBlock FontFamily="{StaticResource Font.Mono}" FontSize="12" Text="{Binding ListingEditor.OwnerFile}" TextWrapping="Wrap" />
                                    </Border>
                                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                                        <Button Classes="text" Content="{Binding Localization.ListingCopyOwnerFile}" Command="{Binding ListingEditor.CopyOwnerFileCommand}" />
                                        <Button Classes="text" Content="{Binding Localization.ListingSaveOwnerFile}" Command="{Binding ListingEditor.SaveOwnerFileCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                                <!-- no GitHub sign-in in this build, so the browser opens the pull request -->
                                <StackPanel Spacing="12" IsVisible="{Binding ListingEditor.UsesBrowserOnly}">
                                    <TextBlock Classes="body-sm secondary" Text="{Binding ListingEditor.PullRequestText}" TextWrapping="Wrap" />
                                    <Button Classes="cta with-icon" Command="{Binding ListingEditor.OpenPullRequestCommand}" IsEnabled="{Binding ListingEditor.CanOpenPullRequest}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Classes="icon size-16" Data="{StaticResource Icon.GithubLogo}" Stroke="{StaticResource Brush.SurfaceHeader}" VerticalAlignment="Center" />
                                            <TextBlock Classes="action-lg" Text="{Binding Localization.ListingOpenPullRequest}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <StackPanel Spacing="12" IsVisible="{Binding ListingEditor.OffersSignedInPublish}">
                                    <TextBlock Classes="body-sm secondary" Text="{Binding ListingEditor.PublishText}" TextWrapping="Wrap" />
                                    <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ListingOwnershipChecking}" TextWrapping="Wrap" IsVisible="{Binding ListingEditor.IsCheckingOwnership}" />
                                    <StackPanel Spacing="4" IsVisible="{Binding ListingEditor.HasOwnership}">
                                        <TextBlock Classes="body-md" Classes.positive="{Binding ListingEditor.IsOwnershipVerified}" Text="{Binding ListingEditor.OwnershipText}" TextWrapping="Wrap" />
                                        <TextBlock Classes="body-sm secondary" Text="{Binding ListingEditor.OwnershipDetail}" TextWrapping="Wrap" IsVisible="{Binding ListingEditor.OwnershipDetail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        <WrapPanel ItemSpacing="16" LineSpacing="4">
                                            <Button Classes="link" Command="{Binding ListingEditor.OpenOwnershipFixCommand}" IsVisible="{Binding ListingEditor.OwnershipFixUrl, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <TextBlock Classes="action-md" Text="{Binding ListingEditor.OwnershipFixLabel}" />
                                            </Button>
                                            <Button Classes="link" Command="{Binding ListingEditor.CheckOwnershipAgainCommand}" IsVisible="{Binding ListingEditor.CanCheckOwnershipAgain}">
                                                <TextBlock Classes="action-md" Text="{Binding Localization.ListingCheckAgain}" />
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                    <StackPanel Spacing="4" IsVisible="{Binding ListingEditor.HasForkStep}">
                                        <TextBlock Classes="body-md" Text="{Binding ListingEditor.ForkStepText}" TextWrapping="Wrap" />
                                        <WrapPanel ItemSpacing="16" LineSpacing="4">
                                            <Button Classes="link" Command="{Binding ListingEditor.OpenForkStepCommand}">
                                                <TextBlock Classes="action-md" Text="{Binding ListingEditor.ForkStepLabel}" />
                                            </Button>
                                            <Button Classes="link" Command="{Binding ListingEditor.PublishCommand}" IsEnabled="{Binding ListingEditor.CanPublish}">
                                                <TextBlock Classes="action-md" Text="{Binding Localization.ListingCheckAgain}" />
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                                        <Button Classes="cta with-icon" Command="{Binding ListingEditor.PublishCommand}" IsEnabled="{Binding ListingEditor.CanPublish}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Path Classes="icon size-16" Data="{StaticResource Icon.GithubLogo}" Stroke="{StaticResource Brush.SurfaceHeader}" VerticalAlignment="Center" />
                                                <TextBlock Classes="action-lg" Text="{Binding ListingEditor.PublishLabel}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="text" Content="{Binding Localization.LibraryCancel}" Command="{Binding ListingEditor.CancelPublishCommand}" IsVisible="{Binding ListingEditor.IsPublishing}" />
                                    </WrapPanel>
                                    <TextBlock Classes="body-sm secondary" Text="{Binding ListingEditor.PublishProgress}" TextWrapping="Wrap" IsVisible="{Binding ListingEditor.IsPublishing}" />
                                </StackPanel>

                                <Button Classes="link" Command="{Binding ListingEditor.OpenPullRequestCommand}" IsEnabled="{Binding ListingEditor.CanOpenPullRequest}" HorizontalAlignment="Left" IsVisible="{Binding ListingEditor.OffersSignedInPublish}">
                                    <TextBlock Classes="action-md" Text="{Binding Localization.ListingOpenInBrowser}" />
                                </Button>
                                <TextBlock Classes="body-sm danger" Text="{Binding Localization.ListingFixErrors}" TextWrapping="Wrap" IsVisible="{Binding ListingEditor.HasErrors}" />
                                <TextBlock Classes="body-sm danger" Text="{Binding ListingEditor.PublishError}" TextWrapping="Wrap" IsVisible="{Binding ListingEditor.PublishError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock Classes="body-sm" Text="{Binding ListingEditor.OutputMessage}" TextWrapping="Wrap" IsVisible="{Binding ListingEditor.OutputMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                <!-- the opened pull request, followed while the page is open -->
                                <Border Background="{StaticResource Brush.Window}" CornerRadius="8" Padding="16" IsVisible="{Binding ListingEditor.HasPullRequest}">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,8,Auto">
                                            <Button Classes="link" Command="{Binding ListingEditor.OpenFollowedPullRequestCommand}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Classes="action-md" Text="{Binding ListingEditor.PullRequestTitle}" />
                                            </Button>
                                            <Button Grid.Column="2" Classes="text" Content="{Binding Localization.ListingRefresh}" Command="{Binding ListingEditor.RefreshStatusCommand}" IsEnabled="{Binding !ListingEditor.IsRefreshingStatus}" IsVisible="{Binding ListingEditor.HasOpenPullRequest}" />
                                        </Grid>
                                        <TextBlock Classes="body-md" Classes.positive="{Binding ListingEditor.IsPullRequestGood}" Classes.danger="{Binding ListingEditor.IsPullRequestBad}" Text="{Binding ListingEditor.PullRequestStateText}" TextWrapping="Wrap" IsVisible="{Binding ListingEditor.PullRequestStateText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        <views:MarkdownView Markdown="{Binding ListingEditor.PullRequestVerdict}" IsVisible="{Binding ListingEditor.PullRequestVerdict, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        <TextBlock Classes="body-sm danger" Text="{Binding ListingEditor.StatusError}" TextWrapping="Wrap" IsVisible="{Binding ListingEditor.StatusError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        <Button Classes="link" Command="{Binding ListingEditor.SignInCommand}" HorizontalAlignment="Left" IsVisible="{Binding ListingEditor.NeedsSignInToFollow}">
                                            <TextBlock Classes="action-md" Text="{Binding Localization.ListingSignIn}" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </views:PageBodyPanel>
        </ScrollViewer>

        <!-- the preview, the steps and the problems, while the author types -->
        <Border Classes="side-panel" IsVisible="{Binding ListingEditor.IsFormStep}">
            <ScrollViewer>
                <StackPanel Spacing="16" Margin="24">
                    <TextBlock Classes="heading-md" Text="{Binding Localization.ListingPreview}" />
                    <Border Background="{StaticResource Brush.Window}" CornerRadius="12" Padding="12">
                        <Grid ColumnDefinitions="56,12,*">
                            <Border Classes="thumbnail" Width="56" Height="56" VerticalAlignment="Top">
                                <Path Classes="icon" Data="{StaticResource Icon.PuzzlePiece}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Classes="heading-sm" Text="{Binding ListingEditor.PreviewName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="body-sm secondary" Text="{Binding ListingEditor.PreviewAuthors}" TextTrimming="CharacterEllipsis" IsVisible="{Binding ListingEditor.PreviewAuthors, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock Classes="body-sm secondary" Text="{Binding ListingEditor.PreviewAbstract}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="3" />
                                <ItemsControl ItemsSource="{Binding ListingEditor.PreviewTags}" Margin="0,4,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border Classes="chip">
                                                <TextBlock Text="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Height="1" Background="{StaticResource Brush.BorderStrong}" />
                    <StackPanel Spacing="6">
                        <TextBlock Classes="heading-md" Text="{Binding Localization.ListingSteps}" />
                        <TextBlock Classes="body-sm secondary" Text="{Binding ListingEditor.SchemaText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding ListingEditor.Steps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ListingStepItem">
                                <Button Classes="plain step" Tag="{Binding Key}" Click="OnStepClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Name}">
                                    <Grid ColumnDefinitions="20,10,*,8,Auto">
                                        <Border Classes="step-mark" Classes.done="{Binding IsDone}" Classes.fix="{Binding IsFix}">
                                            <Panel>
                                                <Path Classes="icon" Data="{StaticResource Icon.Check}" Width="12" Height="12" Stretch="Uniform" IsVisible="{Binding IsDone}" />
                                                <TextBlock Classes="label-sm" Text="!" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsFix}" />
                                            </Panel>
                                        </Border>
                                        <TextBlock Grid.Column="2" Classes="body-md" Classes.secondary="{Binding IsOpen}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Classes="label-sm secondary" Classes.danger="{Binding IsFix}" Text="{Binding Detail}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="body-sm" Text="{Binding ListingEditor.MissingText}" TextWrapping="Wrap" IsVisible="{Binding ListingEditor.MissingText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Classes="body-md positive" Text="{Binding Localization.ListingNoIssues}" TextWrapping="Wrap" IsVisible="{Binding ListingEditor.IsComplete}" />
                    <StackPanel Spacing="8" IsVisible="{Binding ListingEditor.HasVisibleErrors}">
                        <TextBlock Classes="heading-sm" Text="{Binding Localization.ListingErrorsHeading}" />
                        <ItemsControl ItemsSource="{Binding ListingEditor.VisibleErrors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Classes="body-sm danger" Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Spacing="8" IsVisible="{Binding ListingEditor.HasVisibleNotes}">
                        <TextBlock Classes="heading-sm" Text="{Binding Localization.ListingNotesHeading}" />
                        <ItemsControl ItemsSource="{Binding ListingEditor.VisibleNotes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Classes="body-sm secondary" Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
