<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Borea.App.ViewModels"
             xmlns:views="using:Borea.App.Views"
             x:Class="Borea.App.Views.Pages.LibraryPage"
             x:DataType="vm:MainViewModel">
    <!-- Library -->
    <Grid RowDefinitions="Auto,*">
        <views:PageBodyPanel HasBottomMargin="False">
            <!-- header: breadcrumb, c/link-cta, the menu, bottom border -->
            <Border BorderBrush="{StaticResource Brush.Surface}" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="24">
                    <StackPanel Orientation="Horizontal" Spacing="4" Height="24">
                        <Path Classes="icon" Data="{StaticResource Icon.Library}" />
                        <TextBlock Classes="label-lg" Text="{Binding Localization.PageLibraryHeading}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="link" Command="{Binding BeginCreateInstanceCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="icon size-16" Data="{StaticResource Icon.Plus}" Stroke="{StaticResource Brush.Accent}" VerticalAlignment="Center" />
                            <TextBlock Classes="action-md" Text="{Binding Localization.LibraryNewInstance}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Classes="icon" AutomationProperties.Name="{Binding Localization.LibraryMoreActions}">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Command="{Binding BeginImportSharedProfileCommand}" IsVisible="{Binding HasSharedProfileMods}" ToolTip.Tip="{Binding Localization.LibraryImportFromProfileToolTip}" AutomationProperties.Name="{Binding Localization.LibraryImportFromProfile}" AutomationProperties.HelpText="{Binding Localization.LibraryImportFromProfileToolTip}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Localization.LibraryImportFromProfile}" VerticalAlignment="Center" />
                                            <views:InfoButton Text="{Binding Localization.LibraryImportFromProfileToolTip}" AutomationProperties.Name="{Binding Localization.MoreInformation}" />
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Header="{Binding Localization.LibraryImportModList}" Command="{Binding ImportModListCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <Path Classes="icon-filled" Data="{StaticResource Icon.More}" />
                    </Button>
                </Grid>
            </Border>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GameSetupBanner}" IsVisible="{Binding NeedsGameSetup}" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SharedProfileBanner}" IsVisible="{Binding ShowSharedProfileBanner}" />

            <ScrollViewer MaxHeight="{Binding $parent[UserControl].Bounds.Height, Converter={x:Static views:PageBodyPanel.HeaderMessagesMaxHeight}}">
                <StackPanel>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource LaunchStatus}" />
                </StackPanel>
            </ScrollViewer>

            <!-- c/inner-nav-bar, as on the instance page -->
            <Border Background="{StaticResource Brush.SurfaceHeader}" CornerRadius="100" Padding="6" Margin="0,24,0,0">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Button Classes="tab quiet" Classes.active="{Binding IsLibraryInstancesTab}" Content="{Binding Localization.LibraryTabInstances}" Command="{Binding ShowLibraryInstancesCommand}" />
                    <Button Classes="tab quiet" Classes.active="{Binding IsLibraryScreenshotsTab}" Content="{Binding Localization.LibraryTabScreenshots}" Command="{Binding ShowLibraryScreenshotsCommand}" />
                </StackPanel>
            </Border>

            <Button Classes="dropdown" HorizontalAlignment="Left" Margin="0,16,0,0" AutomationProperties.Name="{Binding Localization.DiscoverSortBy}">
                <Button.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsLibraryInstancesTab" />
                        <Binding Path="!!Instances.Count" />
                    </MultiBinding>
                </Button.IsVisible>
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <MenuItem Header="{Binding Localization.LibrarySortName}" Command="{Binding SelectLibrarySortCommand}" CommandParameter="{x:Static vm:LibrarySort.Name}" />
                        <MenuItem Header="{Binding Localization.LibrarySortLastPlayed}" Command="{Binding SelectLibrarySortCommand}" CommandParameter="{x:Static vm:LibrarySort.LastPlayed}" />
                    </MenuFlyout>
                </Button.Flyout>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Classes="body-md secondary" Text="{Binding Localization.DiscoverSortBy, StringFormat='{}{0}:'}" VerticalAlignment="Center" />
                    <TextBlock Classes="body-md" Text="{Binding LibrarySortText}" VerticalAlignment="Center" />
                    <Path Classes="icon size-16" Data="{StaticResource Icon.CaretDown}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0" IsVisible="{Binding IsLibraryScreenshotsTab}">
                <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding HasScreenshots}">
                    <ComboBox ItemsSource="{Binding ScreenshotFilters}" SelectedItem="{Binding SelectedScreenshotFilter}" MinWidth="200" MaxDropDownHeight="300" AutomationProperties.Name="{Binding Localization.ScreenshotsFilterName}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScreenshotFilter">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Classes="body-md secondary" Text="{Binding ScreenshotCountText}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="2" Classes="link" VerticalAlignment="Center" Command="{Binding ReloadScreenshotsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Classes="icon size-16" Data="{StaticResource Icon.ArrowClockwise}" Stroke="{StaticResource Brush.Accent}" VerticalAlignment="Center" />
                        <TextBlock Classes="action-md" Text="{Binding Localization.ScreenshotsRefresh}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </views:PageBodyPanel>

        <ScrollViewer x:Name="PageScroller" Grid.Row="1">
            <views:PageBodyPanel HasTopMargin="False">
                <StackPanel IsVisible="{Binding IsLibraryInstancesTab}">
                    <TextBlock Classes="body-md muted" Text="{Binding Localization.LibraryEmpty}" Margin="8,24,0,0" IsVisible="{Binding !Instances.Count}" />

                    <TextBlock Classes="heading-sm heading" Text="{Binding Localization.LibraryActiveHeading}" Margin="8,16,0,0" IsVisible="{Binding HasActiveInstance}" />
                    <ContentControl Content="{Binding ActiveInstance}" ContentTemplate="{StaticResource InstanceRow}" Margin="0,8,0,0" IsVisible="{Binding HasActiveInstance}" />
                    <TextBlock Classes="heading-sm heading" Text="{Binding Localization.LibraryOtherInstancesHeading}" Margin="8,24,0,0">
                        <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="HasActiveInstance" />
                                <Binding Path="!!OtherInstances.Count" />
                            </MultiBinding>
                        </TextBlock.IsVisible>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding OtherInstances}" ItemTemplate="{StaticResource InstanceRow}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- the rows of tiles virtualize, because a library can hold thousands of screenshots -->
                <StackPanel IsVisible="{Binding IsLibraryScreenshotsTab}" Margin="0,16,0,0">
                    <TextBlock Classes="body-md muted" Text="{Binding Localization.ScreenshotsEmpty}" TextWrapping="Wrap" Margin="8,8,0,0" IsVisible="{Binding ShowsScreenshotsEmpty}" />
                    <views:TileGrid Items="{Binding ShownScreenshots}" ItemTemplate="{StaticResource ScreenshotTile}" MinTileWidth="200" Spacing="16" />
                </StackPanel>
            </views:PageBodyPanel>
        </ScrollViewer>

        <views:ScrollToTopButton Grid.Row="1" Target="{Binding #PageScroller}" Margin="{x:Static views:PageBodyPanel.FloatingBottomMargin}" HorizontalAlignment="Center" VerticalAlignment="Bottom" AutomationProperties.Name="{Binding Localization.DiscoverBackToTop}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Classes="icon size-16" Data="{StaticResource Icon.ArrowUp}" />
                <TextBlock Classes="action-md" Text="{Binding Localization.DiscoverBackToTop}" VerticalAlignment="Center" />
            </StackPanel>
        </views:ScrollToTopButton>
    </Grid>
</UserControl>
