<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Borea.App.ViewModels"
             xmlns:views="using:Borea.App.Views"
             xmlns:prefs="using:Borea.Core.Preferences"
             x:Class="Borea.App.Views.Pages.DiscoverPage"
             x:DataType="vm:MainViewModel">
    <!-- Discover: the list, with the filter panel along the right edge -->
    <Grid>
        <ScrollViewer>
            <!-- the list keeps the center line of Home and Library, and moves left only when the panel needs the room -->
            <views:PageBodyPanel>
                <StackPanel Margin="32,42,32,32">
                    <StackPanel Orientation="Horizontal" Spacing="4" Height="24">
                        <Path Classes="icon" Data="{StaticResource Icon.Compass}" />
                        <TextBlock Classes="label-lg" Text="{Binding Localization.PageDiscoverHeading}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GameSetupBanner}" IsVisible="{Binding NeedsGameSetup}" />

                    <!-- c/inner-nav-bar -->
                    <Border Background="{StaticResource Brush.SurfaceHeader}" CornerRadius="100" Padding="6" Margin="0,16,0,0" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Button Classes="tab" Classes.active="{Binding IsModsTab}" Content="{Binding Localization.DiscoverTabMods}" Command="{Binding ShowDiscoverModsCommand}" />
                            <Button Classes="tab" Classes.active="{Binding IsLoadersTab}" Content="{Binding Localization.DiscoverTabLoaders}" Command="{Binding ShowDiscoverLoadersCommand}" />
                            <Button Classes="tab" Classes.active="{Binding IsModpacksTab}" Content="{Binding Localization.DiscoverTabModpacks}" Command="{Binding ShowDiscoverModpacksCommand}" />
                            <Button Classes="tab" Content="{Binding Localization.DiscoverTabVehicles}" IsEnabled="False" />
                            <Button Classes="tab" Content="{Binding Localization.DiscoverTabSaves}" IsEnabled="False" />
                        </StackPanel>
                    </Border>

                    <!-- stale index -->
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="8,16,8,0" IsVisible="{Binding IsIndexStale}">
                        <TextBlock Classes="body-md secondary" Text="{Binding IndexStaleText}" VerticalAlignment="Center" />
                        <Button Classes="link" Command="{Binding RetryContentIndexCommand}">
                            <TextBlock Classes="action-md" Text="{Binding Localization.DiscoverIndexRetry}" />
                        </Button>
                    </StackPanel>

                    <!-- active filters, and the sort order of the Mods and Modpacks tabs -->
                    <DockPanel Margin="8,24,0,0">
                        <DockPanel.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                <Binding Path="HasDiscoverFilters" />
                                <Binding Path="!IsLoadersTab" />
                            </MultiBinding>
                        </DockPanel.IsVisible>
                        <Button DockPanel.Dock="Right" Classes="dropdown" Margin="16,0,0,0" IsVisible="{Binding !IsLoadersTab}" AutomationProperties.Name="{Binding Localization.DiscoverSortBy}">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="{Binding Localization.DiscoverSortPopularity}" Command="{Binding SelectDiscoverSortCommand}" CommandParameter="{x:Static prefs:DiscoverSortOrder.Popularity}" />
                                    <MenuItem Header="{Binding Localization.DiscoverSortRecentlyUpdated}" Command="{Binding SelectDiscoverSortCommand}" CommandParameter="{x:Static prefs:DiscoverSortOrder.RecentlyUpdated}" />
                                    <MenuItem Header="{Binding Localization.DiscoverSortName}" Command="{Binding SelectDiscoverSortCommand}" CommandParameter="{x:Static prefs:DiscoverSortOrder.Name}" />
                                </MenuFlyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="body-md secondary" Text="{Binding Localization.DiscoverSortBy, StringFormat='{}{0}:'}" VerticalAlignment="Center" />
                                <TextBlock Classes="body-md" Text="{Binding DiscoverSortText}" VerticalAlignment="Center" />
                                <Path Classes="icon size-16" Data="{StaticResource Icon.CaretDown}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" ClipToBounds="True" IsVisible="{Binding HasDiscoverFilters}">
                            <Button Classes="chip-button" Command="{Binding ClearDiscoverFiltersCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Close}" />
                                    <TextBlock Classes="label-sm" Text="{Binding Localization.DiscoverClearAll}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <ItemsControl ItemsSource="{Binding SelectedCategories}" IsVisible="{Binding !!SelectedCategories.Count}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DiscoverCategory">
                                        <Button Classes="chip-button" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleCategoryCommand}" CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Path Classes="icon size-16" Data="{StaticResource Icon.Close}" />
                                                <TextBlock Classes="label-sm" Text="{Binding Name}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Classes="chip-button" Command="{Binding ClearDiscoverGameVersionRangeCommand}" IsVisible="{Binding DiscoverGameVersionRangeText, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Close}" />
                                    <TextBlock Classes="label-sm" Text="{Binding DiscoverGameVersionRangeText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="chip-button" Command="{Binding SelectOsCommand}" IsVisible="{Binding SelectedOs, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Close}" />
                                    <TextBlock Classes="label-sm" Text="{Binding SelectedOs}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="chip-button" Command="{Binding SelectLicenseCommand}" IsVisible="{Binding SelectedLicense, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Close}" />
                                    <TextBlock Classes="label-sm" Text="{Binding SelectedLicense}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Classes="body-md muted" Text="{Binding Localization.DiscoverLoading}" Margin="8,24,0,0" IsVisible="{Binding IsDiscoverLoading}" />
                    <TextBlock Classes="body-md danger" Text="{Binding DiscoverError}" TextWrapping="Wrap" Margin="8,24,0,0">
                        <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="DiscoverError" Converter="{x:Static ObjectConverters.IsNotNull}" />
                                <Binding Path="!IsIndexUnreachable" />
                            </MultiBinding>
                        </TextBlock.IsVisible>
                    </TextBlock>
                    <StackPanel Spacing="8" Margin="8,24,0,0" IsVisible="{Binding IsIndexUnreachable}">
                        <TextBlock Classes="body-md danger" Text="{Binding IndexFailureText}" TextWrapping="Wrap" />
                        <Button Classes="link" Command="{Binding RetryContentIndexCommand}" HorizontalAlignment="Left">
                            <TextBlock Classes="action-md" Text="{Binding Localization.DiscoverIndexRetry}" />
                        </Button>
                    </StackPanel>
                    <TextBlock Classes="body-md muted" Text="{Binding Localization.DiscoverNoInstance}" Margin="8,24,0,0" IsVisible="{Binding !HasActiveInstance}" />
                    <TextBlock Classes="body-md muted" Text="{Binding Localization.DiscoverEmpty}" Margin="8,24,0,0">
                        <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!HasDiscoverItems" />
                                <Binding Path="!IsDiscoverLoading" />
                                <Binding Path="DiscoverError" Converter="{x:Static ObjectConverters.IsNull}" />
                                <Binding Path="!IsIndexUnreachable" />
                            </MultiBinding>
                        </TextBlock.IsVisible>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding DiscoverItems}" ItemTemplate="{StaticResource DiscoverRow}" Margin="0,24,0,0" IsVisible="{Binding !IsModpacksTab}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding DiscoverPacks}" ItemTemplate="{StaticResource PackRow}" Margin="0,24,0,0" IsVisible="{Binding IsModpacksTab}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </views:PageBodyPanel>
        </ScrollViewer>

        <!-- filter-panel -->
        <Border Classes="side-panel">
            <ScrollViewer>
                <StackPanel Spacing="16" Margin="24">
                    <TextBox Classes="field search" Text="{Binding SearchText}" PlaceholderText="{Binding Localization.DiscoverSearchPlaceholder}" AutomationProperties.Name="{Binding Localization.DiscoverSearchPlaceholder}">
                        <TextBox.InnerLeftContent>
                            <Path Classes="icon size-16" Data="{StaticResource Icon.Search}" Margin="10,0,0,0" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,16,Auto">
                            <TextBlock Classes="heading-sm" Text="{Binding Localization.DiscoverHideInstalled}" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="2" Classes="switch" IsChecked="{Binding HideInstalled}" AutomationProperties.Name="{Binding Localization.DiscoverHideInstalled}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,16,Auto">
                            <TextBlock Classes="heading-sm" Text="{Binding Localization.DiscoverHideIncompatible}" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="2" Classes="switch" IsChecked="{Binding HideIncompatible}" AutomationProperties.Name="{Binding Localization.DiscoverHideIncompatible}" />
                        </Grid>
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource Brush.BorderStrong}" IsVisible="{Binding !!CategoryOptions.Count}" />
                    <StackPanel Spacing="10" IsVisible="{Binding !!CategoryOptions.Count}">
                        <TextBlock Classes="heading-md" Text="{Binding Localization.DiscoverCategory}" />
                        <ItemsControl ItemsSource="{Binding CategoryOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DiscoverCategory">
                                    <Button Classes="filter" Classes.active="{Binding IsSelected}" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleCategoryCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding Meaning}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Path Classes="icon size-16" Data="{Binding Tag, Converter={x:Static views:CategoryIcon.FromTag}}" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource Brush.BorderStrong}" IsVisible="{Binding !!GameVersionOptions.Count}" />
                    <StackPanel Spacing="10" IsVisible="{Binding !!GameVersionOptions.Count}">
                        <TextBlock Classes="heading-md" Text="{Binding Localization.ContentGameVersionHeader}" />
                        <StackPanel Spacing="8">
                            <!-- a chosen build keeps its "Min:" or "Max:" label, like the inline dropdowns -->
                            <ComboBox ItemsSource="{Binding GameVersionOptions}" SelectedItem="{Binding DiscoverGameMax}" PlaceholderText="{Binding Localization.DiscoverGameVersionMax}" AutomationProperties.Name="{Binding Localization.DiscoverGameVersionMax}" HorizontalAlignment="Stretch" MaxDropDownHeight="300">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GameVersionOption">
                                        <TextBlock Text="{Binding Text}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                <ComboBox.SelectionBoxItemTemplate>
                                    <DataTemplate x:DataType="vm:GameVersionOption">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Classes="secondary" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.DiscoverGameVersionMax, StringFormat='{}{0}:'}" />
                                            <TextBlock Text="{Binding Text}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.SelectionBoxItemTemplate>
                            </ComboBox>
                            <ComboBox ItemsSource="{Binding GameVersionOptions}" SelectedItem="{Binding DiscoverGameMin}" PlaceholderText="{Binding Localization.DiscoverGameVersionMin}" AutomationProperties.Name="{Binding Localization.DiscoverGameVersionMin}" HorizontalAlignment="Stretch" MaxDropDownHeight="300">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GameVersionOption">
                                        <TextBlock Text="{Binding Text}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                <ComboBox.SelectionBoxItemTemplate>
                                    <DataTemplate x:DataType="vm:GameVersionOption">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Classes="secondary" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.DiscoverGameVersionMin, StringFormat='{}{0}:'}" />
                                            <TextBlock Text="{Binding Text}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.SelectionBoxItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource Brush.BorderStrong}" IsVisible="{Binding !!OsOptions.Count}" />
                    <StackPanel Spacing="10" IsVisible="{Binding !!OsOptions.Count}">
                        <TextBlock Classes="heading-md" Text="{Binding Localization.DiscoverOperatingSystem}" />
                        <ItemsControl ItemsSource="{Binding OsOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Classes="filter" Content="{Binding}" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectOsCommand}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource Brush.BorderStrong}" IsVisible="{Binding !!LicenseOptions.Count}" />
                    <StackPanel Spacing="10" IsVisible="{Binding !!LicenseOptions.Count}">
                        <TextBlock Classes="heading-md" Text="{Binding Localization.DiscoverLicense}" />
                        <ItemsControl ItemsSource="{Binding LicenseOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Classes="filter" Content="{Binding}" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectLicenseCommand}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
