<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Borea.App.ViewModels"
             xmlns:views="using:Borea.App.Views"
             xmlns:prefs="using:Borea.Core.Preferences"
             x:Class="Borea.App.Views.Pages.DiscoverPage"
             x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <!-- a virtualizing panel has no Spacing, so each row keeps the gap below itself; a row's logical parent is the list, not the panel -->
        <Style Selector="ItemsControl.rows > views|RowListItem">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Styles>
    <!-- Discover: the list, with the filter panel along the right edge -->
    <Grid>
        <ScrollViewer x:Name="ListScroller">
            <views:PageBodyPanel HasSidePanel="True">
                <StackPanel>
                    <DockPanel Height="24">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4">
                            <Path Classes="icon" Data="{StaticResource Icon.Compass}" />
                            <TextBlock Classes="label-lg" Text="{Binding Localization.PageDiscoverHeading}" VerticalAlignment="Center" />
                            <Button Classes="plain" Margin="8,0,0,0" VerticalAlignment="Center" Command="{Binding RefreshContentIndexCommand}" ToolTip.Tip="{Binding Localization.DiscoverRefresh}" AutomationProperties.Name="{Binding Localization.DiscoverRefresh}">
                                <Path Classes="icon size-16" Data="{StaticResource Icon.ArrowClockwise}" />
                            </Button>
                        </StackPanel>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AddingTo}" />
                    </DockPanel>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GameSetupBanner}" IsVisible="{Binding NeedsGameSetup}" />

                    <!-- c/inner-nav-bar -->
                    <Border Background="{StaticResource Brush.SurfaceHeader}" CornerRadius="24" Padding="6" Margin="0,16,0,0" HorizontalAlignment="Stretch">
                        <WrapPanel ItemSpacing="4" LineSpacing="6">
                            <Button Classes="tab" Classes.active="{Binding IsModsTab}" Content="{Binding Localization.DiscoverTabMods}" Command="{Binding ShowDiscoverModsCommand}" />
                            <Button Classes="tab" Classes.active="{Binding IsLoadersTab}" Content="{Binding Localization.DiscoverTabLoaders}" Command="{Binding ShowDiscoverLoadersCommand}" />
                            <Button Classes="tab" Classes.active="{Binding IsModpacksTab}" Content="{Binding Localization.DiscoverTabModpacks}" Command="{Binding ShowDiscoverModpacksCommand}" />
                            <Button Classes="tab" Classes.active="{Binding IsVehiclesTab}" Content="{Binding Localization.DiscoverTabVehicles}" Command="{Binding ShowDiscoverVehiclesCommand}" />
                            <Button Classes="tab" Classes.active="{Binding IsSavesTab}" Content="{Binding Localization.DiscoverTabSaves}" Command="{Binding ShowDiscoverSavesCommand}" />
                        </WrapPanel>
                    </Border>

                    <!-- stale index -->
                    <WrapPanel ItemSpacing="12" LineSpacing="4" Margin="8,16,8,0" IsVisible="{Binding IsIndexStale}">
                        <TextBlock Classes="body-md secondary" Text="{Binding IndexStaleText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Classes="link" Command="{Binding RetryContentIndexCommand}" VerticalAlignment="Center">
                            <TextBlock Classes="action-md" Text="{Binding Localization.DiscoverIndexRetry}" />
                        </Button>
                    </WrapPanel>

                    <!-- active filters, and the sort order of the Mods and Modpacks tabs -->
                    <DockPanel MinHeight="32" Margin="8,24,0,0">
                        <Button DockPanel.Dock="Right" Classes="dropdown" Margin="16,0,0,0" VerticalAlignment="Top" IsVisible="{Binding !IsLoadersTab}" AutomationProperties.Name="{Binding Localization.DiscoverSortBy}">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="{Binding Localization.DiscoverSortPopularity}" Command="{Binding SelectDiscoverSortCommand}" CommandParameter="{x:Static prefs:DiscoverSortOrder.Popularity}" />
                                    <MenuItem Header="{Binding Localization.DiscoverSortRecentlyUpdated}" Command="{Binding SelectDiscoverSortCommand}" CommandParameter="{x:Static prefs:DiscoverSortOrder.RecentlyUpdated}" />
                                    <MenuItem Header="{Binding Localization.DiscoverSortRecentlyListed}" Command="{Binding SelectDiscoverSortCommand}" CommandParameter="{x:Static prefs:DiscoverSortOrder.RecentlyListed}" />
                                    <MenuItem Header="{Binding Localization.DiscoverSortName}" Command="{Binding SelectDiscoverSortCommand}" CommandParameter="{x:Static prefs:DiscoverSortOrder.Name}" />
                                </MenuFlyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="body-md secondary" Text="{Binding Localization.DiscoverSortBy, StringFormat='{}{0}:'}" VerticalAlignment="Center" />
                                <TextBlock Classes="body-md" Text="{Binding DiscoverSortText}" VerticalAlignment="Center" />
                                <Path Classes="icon size-16" Data="{StaticResource Icon.CaretDown}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <!-- the chips wrap onto more lines, and the first line stays level with Sort by -->
                        <WrapPanel ItemSpacing="8" LineSpacing="8" Margin="0,4" IsVisible="{Binding HasDiscoverFilters}">
                            <Button Classes="chip-button" Command="{Binding ClearDiscoverFiltersCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Close}" />
                                    <TextBlock Classes="label-sm" Text="{Binding Localization.DiscoverClearAll}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="chip-button" Command="{Binding ClearSelectedAuthorCommand}" IsVisible="{Binding SelectedAuthor, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="{Binding SelectedAuthorText}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Close}" />
                                    <TextBlock Classes="label-sm" Text="{Binding SelectedAuthorText}" MaxWidth="140" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="chip-button" Command="{Binding ClearHideInstalledCommand}" IsVisible="{Binding HideInstalled}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Close}" />
                                    <TextBlock Classes="label-sm" Text="{Binding Localization.DiscoverHideInstalled}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="chip-button" Command="{Binding ClearHideIncompatibleCommand}" IsVisible="{Binding HideIncompatible}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Close}" />
                                    <TextBlock Classes="label-sm" Text="{Binding Localization.DiscoverHideIncompatible}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="chip-button" Command="{Binding ClearFavoritesOnlyCommand}" IsVisible="{Binding FavoritesOnly}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Close}" />
                                    <TextBlock Classes="label-sm" Text="{Binding Localization.DiscoverFavoritesOnly}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="chip-button" Command="{Binding ClearInstalledInOtherInstancesCommand}" IsVisible="{Binding InstalledInOtherInstances}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Close}" />
                                    <TextBlock Classes="label-sm" Text="{Binding Localization.DiscoverInstalledInOtherInstances}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <ItemsControl ItemsSource="{Binding SelectedCategories}">
                                <ItemsControl.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="ShowsCategories" />
                                        <Binding Path="!!SelectedCategories.Count" />
                                    </MultiBinding>
                                </ItemsControl.IsVisible>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemSpacing="8" LineSpacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DiscoverCategory">
                                        <Button Classes="chip-button" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleCategoryCommand}" CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Path Classes="icon size-16" Data="{StaticResource Icon.Close}" />
                                                <TextBlock Classes="label-sm" Text="{Binding Name}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Classes="chip-button" Command="{Binding ClearDiscoverGameVersionRangeCommand}" IsVisible="{Binding DiscoverGameVersionRangeText, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Close}" />
                                    <TextBlock Classes="label-sm" Text="{Binding DiscoverGameVersionRangeText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="chip-button" Command="{Binding SelectOsCommand}" IsVisible="{Binding SelectedOs, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Close}" />
                                    <TextBlock Classes="label-sm" Text="{Binding SelectedOs}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <ItemsControl ItemsSource="{Binding SelectedLicenses}" IsVisible="{Binding !!SelectedLicenses.Count}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemSpacing="8" LineSpacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Button Classes="chip-button" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleLicenseCommand}" CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Path Classes="icon size-16" Data="{StaticResource Icon.Close}" />
                                                <TextBlock Classes="label-sm" Text="{Binding}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>
                    </DockPanel>

                    <TextBlock Classes="body-md muted" Text="{Binding Localization.DiscoverLoading}" Margin="8,24,0,0" IsVisible="{Binding IsDiscoverLoading}" />
                    <TextBlock Classes="body-md danger" Text="{Binding DiscoverError}" TextWrapping="Wrap" Margin="8,24,0,0">
                        <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="DiscoverError" Converter="{x:Static ObjectConverters.IsNotNull}" />
                                <Binding Path="!IsIndexUnreachable" />
                            </MultiBinding>
                        </TextBlock.IsVisible>
                    </TextBlock>
                    <StackPanel Spacing="8" Margin="8,24,0,0" IsVisible="{Binding IsIndexUnreachable}">
                        <TextBlock Classes="body-md danger" Text="{Binding IndexFailureText}" TextWrapping="Wrap" />
                        <Button Classes="link" Command="{Binding RetryContentIndexCommand}" HorizontalAlignment="Left">
                            <TextBlock Classes="action-md" Text="{Binding Localization.DiscoverIndexRetry}" />
                        </Button>
                    </StackPanel>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource InstanceHint}" Margin="8,24,0,0" IsVisible="{Binding !HasActiveInstance}" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ActiveKeptBuildUnavailable}" Margin="8,24,0,0" IsVisible="{Binding !CanAddToActiveInstance}" />
                    <StackPanel Spacing="4" Margin="8,24,0,0" IsVisible="{Binding ShowsNothingSharedYet}">
                        <TextBlock Classes="heading-md" Text="{Binding DiscoverNothingSharedText}" TextWrapping="Wrap" />
                        <!-- the hint names the action of the button, so a type that the index refuses keeps only the heading -->
                        <TextBlock Classes="body-md secondary" Text="{Binding DiscoverNothingSharedHint}" TextWrapping="Wrap" IsVisible="{Binding ShowsDiscoverShare}" />
                        <Button Classes="text primary" HorizontalAlignment="Left" Margin="0,8,0,0" Content="{Binding DiscoverShareAction}" Command="{Binding ShareFromDiscoverCommand}" IsVisible="{Binding ShowsDiscoverShare}" />
                    </StackPanel>
                    <StackPanel Spacing="4" Margin="8,24,0,0">
                        <StackPanel.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!HasDiscoverItems" />
                                <Binding Path="!IsDiscoverLoading" />
                                <Binding Path="DiscoverError" Converter="{x:Static ObjectConverters.IsNull}" />
                                <Binding Path="!IsIndexUnreachable" />
                                <Binding Path="!ShowsNothingSharedYet" />
                            </MultiBinding>
                        </StackPanel.IsVisible>
                        <TextBlock Classes="body-md secondary" Text="{Binding Localization.DiscoverEmpty}" />
                        <Button Classes="link" HorizontalAlignment="Left" Margin="-8,0,0,0" Command="{Binding ClearDiscoverSearchAndFiltersCommand}" IsVisible="{Binding ShowsClearSearchAndFilters}">
                            <TextBlock Classes="action-md" Text="{Binding Localization.DiscoverClearSearchAndFilters}" />
                        </Button>
                    </StackPanel>

                    <!-- a message above the list stays 24 above it, while the list starts 4 below the filter row -->
                    <Border Height="20">
                        <Border.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                <Binding Path="IsDiscoverLoading" />
                                <Binding Path="DiscoverError" Converter="{x:Static ObjectConverters.IsNotNull}" />
                                <Binding Path="IsIndexUnreachable" />
                                <Binding Path="!HasActiveInstance" />
                            </MultiBinding>
                        </Border.IsVisible>
                    </Border>
                    <views:RowList Classes="rows" ItemsSource="{Binding DiscoverItems}" ItemTemplate="{StaticResource DiscoverRow}" Margin="0,4,0,0" IsVisible="{Binding !IsModpacksTab}">
                        <views:RowList.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel CacheLength="2" />
                            </ItemsPanelTemplate>
                        </views:RowList.ItemsPanel>
                    </views:RowList>
                    <views:RowList Classes="rows" ItemsSource="{Binding DiscoverPacks}" ItemTemplate="{StaticResource PackRow}" Margin="0,4,0,0" IsVisible="{Binding IsModpacksTab}">
                        <views:RowList.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel CacheLength="2" />
                            </ItemsPanelTemplate>
                        </views:RowList.ItemsPanel>
                    </views:RowList>
                </StackPanel>
            </views:PageBodyPanel>
        </ScrollViewer>

        <views:ScrollToTopButton Target="{Binding #ListScroller}" Margin="{x:Static views:PageBodyPanel.BesideSidePanelBottomMargin}" HorizontalAlignment="Center" VerticalAlignment="Bottom" AutomationProperties.Name="{Binding Localization.DiscoverBackToTop}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Classes="icon size-16" Data="{StaticResource Icon.ArrowUp}" />
                <TextBlock Classes="action-md" Text="{Binding Localization.DiscoverBackToTop}" VerticalAlignment="Center" />
            </StackPanel>
        </views:ScrollToTopButton>

        <!-- filter-panel -->
        <Border Classes="side-panel">
            <!-- the count stays at the foot of the panel while the filters above it scroll -->
            <DockPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="0,1,0,0" Padding="24,12" IsVisible="{Binding DiscoverCountText, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Classes="body-sm secondary" Text="{Binding DiscoverCountText}" TextTrimming="CharacterEllipsis" />
                </Border>
                <ScrollViewer>
                    <StackPanel Spacing="16" Margin="24">
                        <TextBox Classes="field search" Text="{Binding SearchText}" PlaceholderText="{Binding DiscoverSearchPlaceholderText}" AutomationProperties.Name="{Binding DiscoverSearchPlaceholderText}">
                            <TextBox.InnerLeftContent>
                                <Path Classes="icon size-16" Data="{StaticResource Icon.Search}" Margin="10,0,0,0" />
                            </TextBox.InnerLeftContent>
                        </TextBox>
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,16,Auto">
                                <TextBlock Classes="heading-sm" Text="{Binding Localization.DiscoverHideInstalled}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="2" Classes="switch" IsChecked="{Binding HideInstalled}" AutomationProperties.Name="{Binding Localization.DiscoverHideInstalled}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,16,Auto">
                                <TextBlock Classes="heading-sm" Text="{Binding Localization.DiscoverHideIncompatible}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="2" Classes="switch" IsChecked="{Binding HideIncompatible}" AutomationProperties.Name="{Binding Localization.DiscoverHideIncompatible}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,16,Auto" IsVisible="{Binding HasFavorites}">
                                <TextBlock Classes="heading-sm" Text="{Binding Localization.DiscoverFavoritesOnly}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="2" Classes="switch" IsChecked="{Binding FavoritesOnly}" AutomationProperties.Name="{Binding Localization.DiscoverFavoritesOnly}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,16,Auto" IsVisible="{Binding !!OtherInstances.Count}">
                                <TextBlock Classes="heading-sm" Text="{Binding Localization.DiscoverInstalledInOtherInstances}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="2" Classes="switch" IsChecked="{Binding InstalledInOtherInstances}" AutomationProperties.Name="{Binding Localization.DiscoverInstalledInOtherInstances}" />
                            </Grid>
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource Brush.BorderStrong}">
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="ShowsCategories" />
                                    <Binding Path="!!CategoryOptions.Count" />
                                </MultiBinding>
                            </Border.IsVisible>
                        </Border>
                        <StackPanel Spacing="10">
                            <StackPanel.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="ShowsCategories" />
                                    <Binding Path="!!CategoryOptions.Count" />
                                </MultiBinding>
                            </StackPanel.IsVisible>
                            <TextBlock Classes="heading-md" Text="{Binding Localization.DiscoverCategory}" />
                            <ItemsControl ItemsSource="{Binding CategoryOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DiscoverCategory">
                                        <Button Classes="filter" Classes.active="{Binding IsSelected}" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleCategoryCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding Meaning}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Path Classes="icon size-16" Data="{Binding Tag, Converter={x:Static views:CategoryIcon.FromTag}}" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource Brush.BorderStrong}" IsVisible="{Binding !!GameVersionOptions.Count}" />
                        <StackPanel Spacing="10" IsVisible="{Binding !!GameVersionOptions.Count}">
                            <TextBlock Classes="heading-md" Text="{Binding Localization.ContentGameVersionHeader}" />
                            <!-- the X of an empty box stays in place and only turns inactive, so the box keeps its width -->
                            <Grid ColumnDefinitions="*,8,Auto" RowDefinitions="Auto,8,Auto">
                                <!-- a chosen build keeps its "Min:" or "Max:" label, like the inline dropdowns -->
                                <ComboBox ItemsSource="{Binding GameVersionOptions}" SelectedItem="{Binding DiscoverGameMax}" PlaceholderText="{Binding Localization.DiscoverGameVersionMax}" AutomationProperties.Name="{Binding Localization.DiscoverGameVersionMax}" HorizontalAlignment="Stretch" MaxDropDownHeight="300">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GameVersionOption">
                                            <TextBlock Text="{Binding Text}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                    <ComboBox.SelectionBoxItemTemplate>
                                        <DataTemplate x:DataType="vm:GameVersionOption">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Classes="secondary" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.DiscoverGameVersionMax, StringFormat='{}{0}:'}" />
                                                <TextBlock Text="{Binding Text}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.SelectionBoxItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2" Classes="icon" Command="{Binding ClearDiscoverGameMaxCommand}" IsEnabled="{Binding DiscoverGameMax, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="{Binding Localization.DiscoverGameVersionClearMax}" AutomationProperties.Name="{Binding Localization.DiscoverGameVersionClearMax}">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Close}" />
                                </Button>
                                <ComboBox Grid.Row="2" ItemsSource="{Binding GameVersionOptions}" SelectedItem="{Binding DiscoverGameMin}" PlaceholderText="{Binding Localization.DiscoverGameVersionMin}" AutomationProperties.Name="{Binding Localization.DiscoverGameVersionMin}" HorizontalAlignment="Stretch" MaxDropDownHeight="300">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GameVersionOption">
                                            <TextBlock Text="{Binding Text}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                    <ComboBox.SelectionBoxItemTemplate>
                                        <DataTemplate x:DataType="vm:GameVersionOption">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Classes="secondary" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.DiscoverGameVersionMin, StringFormat='{}{0}:'}" />
                                                <TextBlock Text="{Binding Text}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.SelectionBoxItemTemplate>
                                </ComboBox>
                                <Button Grid.Row="2" Grid.Column="2" Classes="icon" Command="{Binding ClearDiscoverGameMinCommand}" IsEnabled="{Binding DiscoverGameMin, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="{Binding Localization.DiscoverGameVersionClearMin}" AutomationProperties.Name="{Binding Localization.DiscoverGameVersionClearMin}">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Close}" />
                                </Button>
                            </Grid>
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource Brush.BorderStrong}" IsVisible="{Binding !!OsOptions.Count}" />
                        <StackPanel Spacing="10" IsVisible="{Binding !!OsOptions.Count}">
                            <TextBlock Classes="heading-md" Text="{Binding Localization.DiscoverOperatingSystem}" />
                            <ItemsControl ItemsSource="{Binding OsOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DiscoverChoice">
                                        <Button Classes="filter" Classes.active="{Binding IsSelected}" Content="{Binding Value}" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectOsCommand}" CommandParameter="{Binding Value}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource Brush.BorderStrong}" IsVisible="{Binding !!LicenseOptions.Count}" />
                        <StackPanel Spacing="10" IsVisible="{Binding !!LicenseOptions.Count}">
                            <TextBlock Classes="heading-md" Text="{Binding Localization.DiscoverLicense}" />
                            <ItemsControl ItemsSource="{Binding LicenseOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DiscoverChoice">
                                        <Button Classes="filter" Classes.active="{Binding IsSelected}" Content="{Binding Value}" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleLicenseCommand}" CommandParameter="{Binding Value}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource Brush.BorderStrong}" IsVisible="{Binding ShowsModAuthors}" />
                        <StackPanel Spacing="10" IsVisible="{Binding ShowsModAuthors}">
                            <TextBlock Classes="heading-md" Text="{Binding Localization.DiscoverForModAuthors}" />
                            <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding Localization.DiscoverForModAuthorsText}" />
                            <!-- the padding keeps the text inside the hover background, and the margin lines the text up with the one above -->
                            <Button Classes="link" HorizontalAlignment="Left" Margin="-8,0,0,0" Command="{Binding ListYourModCommand}">
                                <TextBlock Classes="action-md" Text="{Binding Localization.DiscoverListYourMod}" />
                            </Button>
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource Brush.BorderStrong}" IsVisible="{Binding ShowsDiscoverShare}" />
                        <StackPanel Spacing="10" IsVisible="{Binding ShowsDiscoverShare}">
                            <TextBlock Classes="heading-md" Text="{Binding DiscoverShareHeading}" />
                            <TextBlock Classes="body-sm secondary" TextWrapping="Wrap" Text="{Binding DiscoverShareText}" />
                            <Button Classes="link" HorizontalAlignment="Left" Margin="-8,0,0,0" Command="{Binding ShareFromDiscoverCommand}">
                                <TextBlock Classes="action-md" Text="{Binding DiscoverShareAction}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
