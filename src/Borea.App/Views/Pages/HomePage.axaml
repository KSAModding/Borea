<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Borea.App.ViewModels"
             xmlns:views="using:Borea.App.Views"
             x:Class="Borea.App.Views.Pages.HomePage"
             x:DataType="vm:MainViewModel">
    <!-- Home -->
    <ScrollViewer>
        <views:PageBodyPanel>
            <!-- c/breadcrumb, and the launch split button on the right -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="4" Height="24" VerticalAlignment="Center">
                    <Path Classes="icon" Data="{StaticResource Icon.Home}" />
                    <TextBlock Classes="label-lg" Text="{Binding Localization.PageHomeHeading}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- the left half starts the option last chosen in the menu of the right half -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Classes="splitButton primary" Command="{Binding PlayHomeCommand}" IsEnabled="{Binding EnableHomeLaunch}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="icon-filled size-16" Fill="{StaticResource Brush.SurfaceHeader}" Data="{StaticResource Icon.Play}" VerticalAlignment="Center" />
                            <TextBlock Classes="action-md" Foreground="{StaticResource Brush.SurfaceHeader}" Text="{Binding HomeLaunchText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="splitButton flyout">
                        <Path Classes="icon size-16" Stroke="{StaticResource Brush.SurfaceHeader}" StrokeThickness="2.5" Data="{StaticResource Icon.CaretDown}" VerticalAlignment="Center" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="{Binding Localization.LaunchActiveInstance}" Command="{Binding PlayActiveInstanceCommand}" IsEnabled="{Binding EnableActiveInstance}" ToggleType="Radio" GroupName="HomeLaunch" IsChecked="{Binding IsHomeLaunchActiveInstance, Mode=OneWay}" />
                                <MenuItem Header="{Binding Localization.LaunchWithoutModLoader}" Command="{Binding PlayWithoutModLoaderCommand}" ToolTip.Tip="{Binding Localization.LaunchWithoutModLoaderToolTip}" ToggleType="Radio" GroupName="HomeLaunch" IsChecked="{Binding !IsHomeLaunchActiveInstance, Mode=OneWay}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource LaunchStatus}" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GameSetupBanner}" IsVisible="{Binding NeedsGameSetup}" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SharedProfileBanner}" IsVisible="{Binding ShowSharedProfileBanner}" />
            <views:UpdateNotice Margin="0,16,0,0" IsVisible="{Binding HasAvailableUpdate}" />

            <!-- Current install: black container with the header strip, holding the active instance row -->
            <Border Background="{StaticResource Brush.SurfaceHeader}" CornerRadius="16" Margin="0,16,0,0">
                <StackPanel>
                    <Grid ColumnDefinitions="Auto,8,*,Auto" Height="44" Margin="12,0">
                        <Path Grid.Column="0" Classes="icon-filled size-16" Fill="{StaticResource Brush.Positive}" Data="{StaticResource Icon.Paw}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="label-md positive" Text="{Binding Localization.HomeCurrentInstall}" VerticalAlignment="Center" />
                        <Border Grid.Column="3" Classes="chip" VerticalAlignment="Center">
                            <Panel>
                                <TextBlock IsVisible="{Binding InstalledVersionText, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Run Text="KSA" /><Run Text=" " /><Run Text="{Binding InstalledVersionText}" />
                                </TextBlock>
                                <TextBlock IsVisible="{Binding InstalledVersionText, Converter={x:Static ObjectConverters.IsNull}}" Text="{Binding Localization.HomeNoGameVersion}" />
                            </Panel>
                        </Border>
                    </Grid>
                    <ContentControl Content="{Binding ActiveInstance}" ContentTemplate="{StaticResource InstanceRow}" IsVisible="{Binding HasActiveInstance}" />
                    <Button Classes="plain card-button" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding FollowInstanceHintCommand}" IsVisible="{Binding !HasActiveInstance}" AutomationProperties.Name="{Binding HomeInstanceHintText}" AutomationProperties.HelpText="{Binding InstanceHintActionText}">
                        <Border Classes="card" Padding="12">
                            <Grid ColumnDefinitions="70,16,*" Height="70">
                                <Border Classes="thumbnail">
                                    <Path Classes="icon size-32" Data="{StaticResource Icon.Box}" />
                                </Border>
                                <TextBlock Grid.Column="2" Classes="heading-md muted" Text="{Binding HomeInstanceHintText}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Recently updated: the index has no trend over time, so Home shows the newest releases instead of the trending ones of the design -->
            <Grid ColumnDefinitions="*,Auto" Margin="3,44,3,0" IsVisible="{Binding HasRecentItems}">
                <TextBlock Classes="heading-sm heading" Text="{Binding Localization.HomeRecentlyUpdated}" />
                <Button Grid.Column="1" Classes="link" Padding="0" Height="18" Command="{Binding SetMainWindowDiscover}">
                    <TextBlock Classes="action-md" Text="{Binding Localization.HomeDiscoverMods}" />
                </Button>
            </Grid>

            <ItemsControl ItemsSource="{Binding RecentItems}" Margin="0,16,0,0" IsVisible="{Binding HasRecentItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <views:TileRowPanel MinTileSize="171" Spacing="5" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RecentItem">
                        <!-- the tile shows the icon with the text over its bottom, and the gradient when no icon shows; the panel sizes it -->
                        <Button Classes="plain" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}">
                            <Border Classes="card" Background="{StaticResource Brush.Thumbnail}">
                                <Panel>
                                    <views:ListingImageView Image="{Binding Icon}" Background="{StaticResource Brush.Surface}" />
                                    <Border Background="{StaticResource Brush.Scrim}" IsVisible="{Binding Icon.IsLoaded, FallbackValue=False}" />
                                    <StackPanel VerticalAlignment="Bottom" Spacing="10" Margin="16">
                                        <TextBlock Classes="heading-md" Text="{Binding Name}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="label-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentTypeMod}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" ToolTip.Tip="{Binding UpdatedDateText}">
                                                <Path Classes="icon size-16" Data="{StaticResource Icon.Clock}" />
                                                <TextBlock Classes="label-md" Text="{Binding UpdatedText}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Panel>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </views:PageBodyPanel>
    </ScrollViewer>
</UserControl>
