<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Borea.App.ViewModels"
             xmlns:views="using:Borea.App.Views"
             xmlns:steward="using:Borea.Core.Stewardship"
             x:Class="Borea.App.Views.Pages.StewardPage"
             x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <!-- the marks of the Statistics tab are thin and take one hue from the accent, and their values stay in the text colors.
             The second part of a two-part mark is a paler step of that hue, which each theme sets for its own surface. -->
        <Style Selector="TextBlock.stat-value">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.stat-bar">
            <Setter Property="Height" Value="6" />
            <Setter Property="CornerRadius" Value="0,3,3,0" />
            <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
        </Style>
        <Style Selector="Border.stat-segment">
            <Setter Property="Height" Value="8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
        </Style>
        <Style Selector="Border.stat-swatch">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
        </Style>
        <Style Selector="Border.stat-second">
            <Setter Property="Background" Value="{StaticResource Brush.AccentMuted}" />
        </Style>
        <!-- a problem in a cell of the upkeep table -->
        <Style Selector="Border.stat-mark">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{StaticResource Brush.DangerSoft}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.stat-mark Path.icon">
            <Setter Property="Stroke" Value="{StaticResource Brush.Danger}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- styles set the place of a table or a list, so that a narrower tab can move it -->
        <Style Selector=":is(Control).stat-right">
            <Setter Property="Grid.Column" Value="2" />
        </Style>
        <Style Selector=":is(Control).stat-types">
            <Setter Property="Grid.Column" Value="0" />
        </Style>
        <Style Selector=":is(Control).stat-hosts">
            <Setter Property="Grid.Column" Value="2" />
        </Style>
        <Style Selector=":is(Control).stat-tags">
            <Setter Property="Grid.Column" Value="4" />
        </Style>
        <Style Selector=":is(Control).stat-licenses">
            <Setter Property="Grid.Column" Value="6" />
        </Style>
        <!-- two tables need more room than a small window gives, so they stack -->
        <ContainerQuery Name="statistics" Query="max-width:800">
            <Style Selector=":is(Control).stat-left">
                <Setter Property="Grid.ColumnSpan" Value="3" />
            </Style>
            <Style Selector=":is(Control).stat-right">
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.ColumnSpan" Value="3" />
                <Setter Property="Grid.Row" Value="1" />
                <Setter Property="Margin" Value="0,24,0,0" />
            </Style>
        </ContainerQuery>
        <!-- four small lists fit in one row only on a wide window, and otherwise form two rows of two, the shorter lists in the first row so that no long list faces an empty space -->
        <ContainerQuery Name="statistics" Query="max-width:1100">
            <Style Selector=":is(Control).stat-types">
                <Setter Property="Grid.ColumnSpan" Value="3" />
            </Style>
            <Style Selector=":is(Control).stat-hosts">
                <Setter Property="Grid.Column" Value="4" />
                <Setter Property="Grid.ColumnSpan" Value="3" />
            </Style>
            <Style Selector=":is(Control).stat-tags">
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.ColumnSpan" Value="3" />
                <Setter Property="Grid.Row" Value="1" />
                <Setter Property="Margin" Value="0,24,0,0" />
            </Style>
            <Style Selector=":is(Control).stat-licenses">
                <Setter Property="Grid.Column" Value="4" />
                <Setter Property="Grid.ColumnSpan" Value="3" />
                <Setter Property="Grid.Row" Value="1" />
                <Setter Property="Margin" Value="0,24,0,0" />
            </Style>
        </ContainerQuery>
    </UserControl.Styles>
    <UserControl.Resources>
        <!-- the name of a row of the Statistics tab, which opens its content page when it has one.
             A long name trims and shows whole in the tooltip. -->
        <DataTemplate x:Key="StatisticsRowName" x:DataType="vm:StewardStatisticsRow">
            <Panel>
                <Button Classes="plain" Command="{Binding OpenCommand}" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip.Tip="{Binding Name}" IsVisible="{Binding CanOpen}">
                    <TextBlock Classes="body-md" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock Classes="body-md secondary" Text="{Binding Name}" ToolTip.Tip="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsVisible="{Binding !CanOpen}" />
            </Panel>
        </DataTemplate>
        <!-- the end of a long list, where the margin keeps the text on the left edge of the list and the hover pill goes past that edge -->
        <DataTemplate x:Key="StatisticsShowAll" x:DataType="vm:StewardStatisticsList">
            <Button Classes="link" Margin="-8,0,0,0" HorizontalAlignment="Left" Command="{Binding ToggleShowAllCommand}" IsVisible="{Binding CanShowAll}">
                <TextBlock Classes="action-md" Text="{Binding ShowAllText}" />
            </Button>
        </DataTemplate>
        <!-- a small ranked list: the title, then per row the name and the number, with the bar below them -->
        <DataTemplate x:Key="StatisticsBarList" x:DataType="vm:StewardStatisticsList">
            <StackPanel Spacing="8">
                <TextBlock Classes="label-md" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="body-md muted" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardStatisticsNothing}" TextWrapping="Wrap" IsVisible="{Binding IsEmpty}" />
                <ItemsControl ItemsSource="{Binding ShownRows}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StewardStatisticsBarRow">
                            <Grid ColumnDefinitions="*,12,Auto" RowDefinitions="Auto,Auto">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatisticsRowName}" />
                                <TextBlock Grid.Column="2" Classes="label-md" Text="{Binding Value}" VerticalAlignment="Center" />
                                <views:ShareBarPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,4,0,0">
                                    <Border Classes="stat-bar" views:ShareBarPanel.Share="{Binding Share}" />
                                </views:ShareBarPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatisticsShowAll}" />
            </StackPanel>
        </DataTemplate>
        <!-- one of the two dependency tables, with the name above a bar of the required and the optional part and a right-aligned column for each.
             The swatch in a column heading is the legend of the bar. -->
        <DataTemplate x:Key="StatisticsDependencyTable" x:DataType="vm:StewardStatisticsList">
            <StackPanel Spacing="8" Grid.IsSharedSizeScope="True">
                <Border BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="StatisticsRequired" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="StatisticsOptional" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Classes="label-md" Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsEmpty}">
                            <Border Classes="stat-swatch" />
                            <TextBlock Classes="label-sm" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardStatisticsRequired}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsEmpty}">
                            <Border Classes="stat-swatch stat-second" />
                            <TextBlock Classes="label-sm" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardStatisticsOptional}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Classes="body-md muted" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardStatisticsNothing}" TextWrapping="Wrap" IsVisible="{Binding IsEmpty}" />
                <ItemsControl ItemsSource="{Binding ShownRows}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StewardStatisticsDependencyRow">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="StatisticsRequired" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="StatisticsOptional" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatisticsRowName}" />
                                    <views:ShareBarPanel>
                                        <Border Classes="stat-bar" views:ShareBarPanel.Share="{Binding RequiredShare}" />
                                        <Border Classes="stat-bar stat-second" views:ShareBarPanel.Share="{Binding OptionalShare}" />
                                    </views:ShareBarPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Classes="label-md" Classes.muted="{Binding Required.IsZero}" Text="{Binding Required.Text}" TextAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Classes="label-md" Classes.muted="{Binding Optional.IsZero}" Text="{Binding Optional.Text}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatisticsShowAll}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <!-- Steward tools: the tabs of the steward work in content-index and content-index-releases -->
    <ScrollViewer>
        <views:PageBodyPanel>
            <StackPanel DataContext="{Binding StewardPage}" x:DataType="vm:StewardPage">
                <!-- header: the page name, the way back from a review, and Refresh of the review or the tab that shows, bottom border -->
                <Border BorderBrush="{StaticResource Brush.Surface}" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="24">
                        <StackPanel Orientation="Horizontal" Spacing="4" Height="24">
                            <Button Classes="plain back" Command="{Binding CloseReviewCommand}" VerticalAlignment="Center" IsVisible="{Binding IsReviewOpen}" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.NavigationBack}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.NavigationBack}">
                                <Path Classes="icon" Data="{StaticResource Icon.ArrowLeft}" />
                            </Button>
                            <Path Classes="icon" Data="{StaticResource Icon.Settings}" />
                            <TextBlock Classes="label-lg" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardHeading}" VerticalAlignment="Center" />
                            <TextBlock Classes="label-lg" Text="/" VerticalAlignment="Center" IsVisible="{Binding IsReviewOpen}" />
                            <TextBlock Classes="label-lg" Text="{Binding Review.NumberText}" VerticalAlignment="Center" IsVisible="{Binding IsReviewOpen}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="link" Command="{Binding RefreshTabCommand}">
                            <TextBlock Classes="action-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingRefresh}" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <!-- the tabs, which a review replaces -->
                <StackPanel IsVisible="{Binding !IsReviewOpen}">
                    <!-- c/inner-nav-bar -->
                    <Border Background="{StaticResource Brush.SurfaceHeader}" CornerRadius="100" Padding="6" Margin="0,24,0,0" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Button Classes="tab quiet" Classes.active="{Binding IsQueueTab}" Content="{Binding QueueTabText}" Command="{Binding ShowQueueCommand}" />
                            <Button Classes="tab quiet" Classes.active="{Binding IsReportsTab}" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardTabReports}" Command="{Binding ShowReportsCommand}" />
                            <Button Classes="tab quiet" Classes.active="{Binding IsStatusTab}" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardTabStatus}" Command="{Binding ShowStatusCommand}" />
                            <Button Classes="tab quiet" Classes.active="{Binding IsWatcherTab}" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardTabWatcher}" Command="{Binding ShowWatcherCommand}" />
                            <Button Classes="tab quiet" Classes.active="{Binding IsStatisticsTab}" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardTabStatistics}" Command="{Binding ShowStatisticsCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- Queue: the open pull requests of both index repositories, oldest first -->
                    <Panel IsVisible="{Binding IsQueueTab}">
                        <StackPanel DataContext="{Binding Queue}" x:DataType="vm:StewardQueueTab">
                            <TextBlock Classes="body-md secondary" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardQueueHint}" TextWrapping="Wrap" Margin="0,16,0,0" />
                            <!-- what the queue shows: the scope by what a pull request changes, and whether all open ones show -->
                            <WrapPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Classes="dropdown" Margin="0,0,32,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardQueueScope}">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                            <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardQueueScopeContent}" Command="{Binding SelectScopeCommand}" CommandParameter="{x:Static steward:StewardQueueScope.Content}" />
                                            <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardQueueScopeOther}" Command="{Binding SelectScopeCommand}" CommandParameter="{x:Static steward:StewardQueueScope.Other}" />
                                            <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardQueueScopeAll}" Command="{Binding SelectScopeCommand}" CommandParameter="{x:Static steward:StewardQueueScope.All}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Classes="body-md secondary" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardQueueScope, StringFormat='{}{0}:'}" VerticalAlignment="Center" />
                                        <TextBlock Classes="body-md" Text="{Binding ScopeText}" VerticalAlignment="Center" />
                                        <Path Classes="icon size-16" Data="{StaticResource Icon.CaretDown}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <TextBlock Classes="body-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardQueueAllOpen}" VerticalAlignment="Center" />
                                    <ToggleSwitch Classes="switch" IsChecked="{Binding ShowAllOpen}" VerticalAlignment="Center" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardQueueAllOpen}" />
                                </StackPanel>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0" IsVisible="{Binding IsLoading}">
                                <ProgressBar Width="38" Height="6" VerticalAlignment="Center" IsIndeterminate="True" Foreground="{StaticResource Brush.Accent}" />
                                <TextBlock Classes="body-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardQueueLoading}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Classes="body-md danger" Text="{Binding Error}" TextWrapping="Wrap" Margin="0,16,0,0" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <ItemsControl ItemsSource="{Binding Failures}" Margin="0,16,0,0" IsVisible="{Binding !!Failures.Count}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Classes="body-md danger" Text="{Binding}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="body-md muted" Text="{Binding EmptyText}" Margin="0,16,0,0" IsVisible="{Binding IsEmpty}" />

                            <ItemsControl ItemsSource="{Binding Items}" Margin="0,16,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StewardQueueEntry">
                                        <Border Classes="card" Padding="24,16">
                                            <StackPanel Spacing="6">
                                                <WrapPanel ItemSpacing="12" LineSpacing="4">
                                                    <TextBlock Classes="body-sm secondary" Text="{Binding NumberText}" VerticalAlignment="Center" />
                                                    <Button Classes="link" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding Item.Url}">
                                                        <TextBlock Classes="action-md" Text="{Binding Title}" TextWrapping="Wrap" />
                                                    </Button>
                                                </WrapPanel>
                                                <TextBlock Classes="body-sm secondary" Text="{Binding ByText}" TextWrapping="Wrap" />
                                                <WrapPanel ItemSpacing="4" LineSpacing="4">
                                                    <Border Classes="chip positive" IsVisible="{Binding ShowsWaiting}">
                                                        <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardQueueWaiting}" />
                                                    </Border>
                                                    <Border Classes="chip untested" IsVisible="{Binding Item.IsDraft}">
                                                        <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardQueueDraft}" />
                                                    </Border>
                                                    <ItemsControl ItemsSource="{Binding KindTexts}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <Border Classes="chip">
                                                                    <TextBlock Text="{Binding}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Border Classes="chip untested" IsVisible="{Binding Item.HasOtherFiles}">
                                                        <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardQueueOtherFiles}" />
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Classes="body-md secondary" Classes.muted="{Binding !HasVerdict}" Text="{Binding VerdictText}" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Panel>

                    <!-- Reports: the open takedown and id dispute reports of content-index, oldest first, or the reports closed lately, with the sections of their forms -->
                    <Panel IsVisible="{Binding IsReportsTab}">
                        <StackPanel DataContext="{Binding Reports}" x:DataType="vm:StewardReportsTab">
                            <TextBlock Classes="body-md secondary" Text="{Binding HintText}" TextWrapping="Wrap" Margin="0,16,0,0" />
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
                                <TextBlock Classes="body-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardReportsShowClosed}" VerticalAlignment="Center" />
                                <ToggleSwitch Classes="switch" IsChecked="{Binding ShowClosed}" VerticalAlignment="Center" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardReportsShowClosed}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0" IsVisible="{Binding IsLoading}">
                                <ProgressBar Width="38" Height="6" VerticalAlignment="Center" IsIndeterminate="True" Foreground="{StaticResource Brush.Accent}" />
                                <TextBlock Classes="body-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardReportsLoading}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Classes="body-md danger" Text="{Binding Error}" TextWrapping="Wrap" Margin="0,16,0,0" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <TextBlock Classes="body-md muted" Text="{Binding EmptyText}" Margin="0,16,0,0" IsVisible="{Binding IsEmpty}" />

                            <ItemsControl ItemsSource="{Binding Reports}" Margin="0,16,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StewardReport">
                                        <Border Classes="card" Padding="24,16">
                                            <StackPanel Spacing="6">
                                                <!-- the id that the report names, which opens its content page when the index has it -->
                                                <WrapPanel ItemSpacing="12" LineSpacing="4">
                                                    <Border Classes="chip" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding KindText}" />
                                                    </Border>
                                                    <Button Classes="link" Command="{Binding OpenContentCommand}" IsVisible="{Binding CanOpenContent}">
                                                        <TextBlock Classes="heading-md" Text="{Binding ContentName}" />
                                                    </Button>
                                                    <TextBlock Classes="heading-md" Text="{Binding Report.Id}" VerticalAlignment="Center" IsVisible="{Binding IsIdUnknown}" />
                                                    <TextBlock Classes="body-sm secondary" Text="{Binding VersionText}" VerticalAlignment="Center" IsVisible="{Binding HasVersion}" />
                                                    <TextBlock Classes="body-sm muted" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardWatcherUnknownListing}" VerticalAlignment="Center" IsVisible="{Binding IsIdUnknown}" />
                                                </WrapPanel>
                                                <TextBlock Classes="body-md danger" Text="{Binding UnreadableIdText}" TextWrapping="Wrap" IsVisible="{Binding UnreadableIdText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                <WrapPanel ItemSpacing="12" LineSpacing="4">
                                                    <TextBlock Classes="body-sm secondary" Text="{Binding NumberText}" VerticalAlignment="Center" />
                                                    <Button Classes="link" Command="{Binding AnswerCommand}" ToolTip.Tip="{Binding Report.Url}">
                                                        <TextBlock Classes="action-md" Text="{Binding Report.Title}" TextWrapping="Wrap" />
                                                    </Button>
                                                </WrapPanel>
                                                <TextBlock Classes="body-sm secondary" Text="{Binding ByText}" TextWrapping="Wrap" />
                                                <TextBlock Classes="body-sm secondary" Text="{Binding ClosedText}" TextWrapping="Wrap" IsVisible="{Binding !IsOpen}" />
                                                <TextBlock Classes="body-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardReporterWarning}" TextWrapping="Wrap" IsVisible="{Binding IsReporter}" />
                                                <TextBlock Classes="body-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardOwnerWarning}" TextWrapping="Wrap" IsVisible="{Binding IsOwner}" />

                                                <!-- the sections of the form, as the reporter wrote them -->
                                                <ItemsControl ItemsSource="{Binding Sections}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Spacing="8" Margin="0,6,0,0" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:StewardReportSection">
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Classes="label-md secondary" Text="{Binding Label}" />
                                                                <SelectableTextBlock Classes="body-md" Text="{Binding Text}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding MissingTexts}" IsVisible="{Binding !!MissingTexts.Count}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Classes="body-sm muted" Text="{Binding}" TextWrapping="Wrap" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- the report actions for a steward of content-index while GitHub lets Borea write to issues, else Answer on GitHub, and the status actions on an open report -->
                                                <WrapPanel ItemSpacing="8" LineSpacing="4" Margin="0,6,0,0">
                                                    <WrapPanel ItemSpacing="8" LineSpacing="4" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).StewardPage.Reports.CanWriteIssues}">
                                                        <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardActionComment}" Command="{Binding CommentCommand}" />
                                                        <WrapPanel ItemSpacing="8" LineSpacing="4" IsVisible="{Binding IsOpen}">
                                                            <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardReportCloseCompleted}" Command="{Binding CloseCompletedCommand}" />
                                                            <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardReportCloseNotPlanned}" Command="{Binding CloseNotPlannedCommand}" />
                                                        </WrapPanel>
                                                        <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardReportReopen}" Command="{Binding ReopenCommand}" IsVisible="{Binding !IsOpen}" />
                                                    </WrapPanel>
                                                    <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardReportAnswer}" Command="{Binding AnswerCommand}" IsVisible="{Binding !$parent[Window].((vm:MainViewModel)DataContext).StewardPage.Reports.CanWriteIssues}" />
                                                    <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardReportOpenForums}" Command="{Binding OpenForumsCommand}" IsVisible="{Binding CanOpenForums}" />
                                                    <WrapPanel ItemSpacing="8" LineSpacing="4" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).CanEditIndexStatus}">
                                                        <WrapPanel ItemSpacing="8" LineSpacing="4" IsVisible="{Binding CanChangeStatus}">
                                                            <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardDispute}" Command="{Binding DisputeCommand}" />
                                                            <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardDelist}" Command="{Binding DelistCommand}" />
                                                            <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardRetract}" Command="{Binding RetractCommand}" IsVisible="{Binding HasVersion}" />
                                                            <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardReportLeavePack}" Command="{Binding LeavePackCommand}" IsVisible="{Binding IsLeavePack}" />
                                                        </WrapPanel>
                                                    </WrapPanel>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Panel>

                    <!-- Status: the states of index-status.toml on the base branch, with Lift on each -->
                    <StackPanel IsVisible="{Binding IsStatusTab}">
                        <TextBlock Classes="body-md secondary" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardStatusHint}" TextWrapping="Wrap" Margin="0,16,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0" IsVisible="{Binding IsLoading}">
                            <ProgressBar Width="38" Height="6" VerticalAlignment="Center" IsIndeterminate="True" Foreground="{StaticResource Brush.Accent}" />
                            <TextBlock Classes="body-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardStatusLoading}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="body-md danger" Text="{Binding Error}" TextWrapping="Wrap" Margin="0,16,0,0" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Classes="body-md muted" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardStatusEmpty}" Margin="0,16,0,0" IsVisible="{Binding IsStatusEmpty}" />

                        <ItemsControl ItemsSource="{Binding StatusEntries}" Margin="0,16,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StewardStatusEntry">
                                    <Border Classes="card" Padding="24,16">
                                        <Grid ColumnDefinitions="*,16,Auto">
                                            <StackPanel Spacing="4">
                                                <WrapPanel ItemSpacing="12" LineSpacing="4">
                                                    <TextBlock Classes="heading-md" Text="{Binding Id}" VerticalAlignment="Center" />
                                                    <Border Classes="chip" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StateText}" />
                                                    </Border>
                                                    <TextBlock Classes="body-sm secondary" Text="{Binding VersionText}" VerticalAlignment="Center" IsVisible="{Binding VersionText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    <TextBlock Classes="body-sm secondary" Text="{Binding SinceText}" VerticalAlignment="Center" IsVisible="{Binding SinceText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                </WrapPanel>
                                                <TextBlock Classes="body-md secondary" Text="{Binding Reason}" TextWrapping="Wrap" IsVisible="{Binding Reason, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardLift}" Command="{Binding LiftCommand}" VerticalAlignment="Center" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).CanEditIndexStatus}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Spacing="8" Margin="0,32,0,0" IsVisible="{Binding HasStatusPullRequests}">
                            <TextBlock Classes="heading-sm heading" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardStatusPullRequests}" />
                            <ItemsControl ItemsSource="{Binding StatusPullRequests}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StewardPullRequest">
                                        <WrapPanel ItemSpacing="12" LineSpacing="4">
                                            <Button Classes="link" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding PullRequest.Url}">
                                                <TextBlock Classes="action-md" Text="{Binding Text}" TextWrapping="Wrap" />
                                            </Button>
                                            <TextBlock Classes="body-sm danger" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardStatusConflict}" VerticalAlignment="Center" IsVisible="{Binding Conflicts}" />
                                        </WrapPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- Watcher: the listing issues of the watcher in content-index, the watchdog issue in content-index-releases, and the releases gone from their host -->
                    <Panel IsVisible="{Binding IsWatcherTab}">
                        <StackPanel DataContext="{Binding Watcher}" x:DataType="vm:StewardWatcherTab">
                            <TextBlock Classes="body-md secondary" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardWatcherHint}" TextWrapping="Wrap" Margin="0,16,0,0" />
                            <WrapPanel ItemSpacing="12" LineSpacing="4" Margin="0,8,0,0">
                                <TextBlock Classes="body-md secondary" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardWatcherBackfill}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Classes="link" Command="{Binding OpenWorkflowCommand}" ToolTip.Tip="{Binding WorkflowUrl}">
                                    <TextBlock Classes="action-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardWatcherWorkflow}" />
                                </Button>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0" IsVisible="{Binding IsLoading}">
                                <ProgressBar Width="38" Height="6" VerticalAlignment="Center" IsIndeterminate="True" Foreground="{StaticResource Brush.Accent}" />
                                <TextBlock Classes="body-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardWatcherLoading}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Classes="body-md danger" Text="{Binding Error}" TextWrapping="Wrap" Margin="0,16,0,0" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <ItemsControl ItemsSource="{Binding Failures}" Margin="0,16,0,0" IsVisible="{Binding !!Failures.Count}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Classes="body-md danger" Text="{Binding}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- the watchdog issue, or that the watcher ticks -->
                            <TextBlock Classes="body-md secondary" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardWatcherTicking}" TextWrapping="Wrap" Margin="0,16,0,0" IsVisible="{Binding IsTicking}" />
                            <ItemsControl ItemsSource="{Binding Watchdog}" Margin="0,16,0,0" IsVisible="{Binding !!Watchdog.Count}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StewardWatcherIssue">
                                        <Border Classes="card" Padding="24,16">
                                            <StackPanel Spacing="6">
                                                <TextBlock Classes="body-md danger" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardWatcherNotTicking}" TextWrapping="Wrap" />
                                                <WrapPanel ItemSpacing="12" LineSpacing="4">
                                                    <TextBlock Classes="body-sm secondary" Text="{Binding NumberText}" VerticalAlignment="Center" />
                                                    <Button Classes="link" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding Issue.Url}">
                                                        <TextBlock Classes="action-md" Text="{Binding Title}" TextWrapping="Wrap" />
                                                    </Button>
                                                </WrapPanel>
                                                <TextBlock Classes="body-sm secondary" Text="{Binding UpdatedText}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- the listing issues, each with the content page of its listing -->
                            <TextBlock Classes="heading-sm heading" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardWatcherListings}" Margin="0,32,0,0" />
                            <TextBlock Classes="body-md muted" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardWatcherListingsEmpty}" Margin="0,16,0,0" IsVisible="{Binding IsListingsEmpty}" />
                            <ItemsControl ItemsSource="{Binding Listings}" Margin="0,16,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StewardWatcherIssue">
                                        <Border Classes="card" Padding="24,16">
                                            <StackPanel Spacing="6">
                                                <WrapPanel ItemSpacing="12" LineSpacing="4">
                                                    <Button Classes="link" Command="{Binding OpenListingCommand}" IsVisible="{Binding CanOpenListing}">
                                                        <TextBlock Classes="heading-md" Text="{Binding ListingName}" />
                                                    </Button>
                                                    <TextBlock Classes="heading-md" Text="{Binding Issue.ListingId}" VerticalAlignment="Center" IsVisible="{Binding IsListingUnknown}" />
                                                    <TextBlock Classes="body-sm muted" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardWatcherUnknownListing}" VerticalAlignment="Center" IsVisible="{Binding IsListingUnknown}" />
                                                    <TextBlock Classes="body-md muted" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardWatcherNoListing}" VerticalAlignment="Center" IsVisible="{Binding HasNoListing}" />
                                                </WrapPanel>
                                                <WrapPanel ItemSpacing="12" LineSpacing="4">
                                                    <TextBlock Classes="body-sm secondary" Text="{Binding NumberText}" VerticalAlignment="Center" />
                                                    <Button Classes="link" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding Issue.Url}">
                                                        <TextBlock Classes="action-md" Text="{Binding Title}" TextWrapping="Wrap" />
                                                    </Button>
                                                </WrapPanel>
                                                <TextBlock Classes="body-sm secondary" Text="{Binding UpdatedText}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- the releases that carry download.unavailable_since, by listing and date -->
                            <TextBlock Classes="heading-sm heading" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardWatcherGone}" Margin="0,32,0,0" />
                            <TextBlock Classes="body-md secondary" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardWatcherGoneHint}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Classes="body-md muted" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardWatcherGoneEmpty}" Margin="0,16,0,0" IsVisible="{Binding IsGoneEmpty}" />
                            <ItemsControl ItemsSource="{Binding Gone}" Margin="0,16,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StewardGoneListing">
                                        <Border Classes="card" Padding="24,16">
                                            <StackPanel Spacing="6">
                                                <Button Classes="link" Command="{Binding OpenListingCommand}" IsVisible="{Binding CanOpenListing}">
                                                    <TextBlock Classes="heading-md" Text="{Binding Name}" />
                                                </Button>
                                                <TextBlock Classes="heading-md" Text="{Binding Name}" IsVisible="{Binding IsListingUnknown}" />
                                                <ItemsControl ItemsSource="{Binding Releases}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Spacing="4" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:StewardGoneRelease">
                                                            <WrapPanel ItemSpacing="12" LineSpacing="4">
                                                                <TextBlock Classes="body-md" Text="{Binding Version}" VerticalAlignment="Center" />
                                                                <TextBlock Classes="body-sm secondary" Text="{Binding SinceText}" VerticalAlignment="Center" />
                                                            </WrapPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Panel>

                    <!-- Statistics: what the index holds, counted from the snapshot that Borea read, with the headline numbers first and then a card per subject, the most useful first -->
                    <Panel IsVisible="{Binding IsStatisticsTab}">
                        <StackPanel DataContext="{Binding Statistics}" x:DataType="vm:StewardStatisticsTab" Container.Name="statistics" Container.Sizing="Width">
                            <TextBlock Classes="body-md secondary" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardStatisticsHint}" TextWrapping="Wrap" Margin="0,16,0,0" />
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0" IsVisible="{Binding IsLoading}">
                                <ProgressBar Width="38" Height="6" VerticalAlignment="Center" IsIndeterminate="True" Foreground="{StaticResource Brush.Accent}" />
                                <TextBlock Classes="body-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardStatisticsLoading}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Classes="body-md danger" Text="{Binding Error}" TextWrapping="Wrap" Margin="0,16,0,0" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <Panel Margin="0,16,0,0" IsVisible="{Binding Report, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <StackPanel DataContext="{Binding Report}" x:DataType="vm:StewardStatisticsReport" Spacing="8">
                                    <!-- the headline numbers -->
                                    <ItemsControl ItemsSource="{Binding Tiles}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" ColumnSpacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:StewardStatisticsTile">
                                                <Border Classes="card" Padding="16,12" ToolTip.Tip="{Binding Detail}">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Classes="stat-value" Classes.muted="{Binding !IsKnown}" Text="{Binding Value}" />
                                                        <TextBlock Classes="body-sm secondary" Text="{Binding Label}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- the current build: the part of the mods that a release lets a player install on it, and the others -->
                                    <Border Classes="card" Padding="24,16">
                                        <StackPanel DataContext="{Binding BuildFit}" x:DataType="vm:StewardStatisticsBuildFit" Spacing="12">
                                            <WrapPanel ItemSpacing="12" LineSpacing="4">
                                                <TextBlock Classes="heading-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardStatisticsCurrentBuild}" VerticalAlignment="Center" />
                                                <Border Classes="chip" VerticalAlignment="Center" IsVisible="{Binding HasBuild}">
                                                    <TextBlock Text="{Binding Build}" />
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Classes="body-md muted" Text="{Binding Summary}" TextWrapping="Wrap" />
                                            <StackPanel Spacing="8" IsVisible="{Binding IsRated}">
                                                <views:ShareBarPanel AutomationProperties.Name="{Binding Summary}">
                                                    <Border Classes="stat-segment" views:ShareBarPanel.Share="{Binding NotBlocked.Share}" />
                                                    <Border Classes="stat-segment stat-second" views:ShareBarPanel.Share="{Binding Blocked.Share}" />
                                                </views:ShareBarPanel>
                                                <WrapPanel ItemSpacing="24" LineSpacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Border Classes="stat-swatch" />
                                                        <TextBlock Classes="heading-sm" Classes.muted="{Binding NotBlocked.Count.IsZero}" Text="{Binding NotBlocked.Count.Text}" VerticalAlignment="Center" />
                                                        <TextBlock Classes="body-md secondary" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardStatisticsNotBlocked}" VerticalAlignment="Center" />
                                                        <TextBlock Classes="label-md" Text="{Binding NotBlocked.Percent}" VerticalAlignment="Center" IsVisible="{Binding !NotBlocked.Count.IsZero}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Border Classes="stat-swatch stat-second" />
                                                        <TextBlock Classes="heading-sm" Classes.muted="{Binding Blocked.Count.IsZero}" Text="{Binding Blocked.Count.Text}" VerticalAlignment="Center" />
                                                        <TextBlock Classes="body-md secondary" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardStatisticsBlocked}" VerticalAlignment="Center" />
                                                        <TextBlock Classes="label-md" Text="{Binding Blocked.Percent}" VerticalAlignment="Center" IsVisible="{Binding !Blocked.Count.IsZero}" />
                                                    </StackPanel>
                                                </WrapPanel>
                                            </StackPanel>
                                            <StackPanel DataContext="{Binding BlockedMods}" x:DataType="vm:StewardStatisticsList" Spacing="8" IsVisible="{Binding !IsEmpty}">
                                                <TextBlock Classes="label-md" Text="{Binding Title}" TextWrapping="Wrap" />
                                                <ItemsControl ItemsSource="{Binding ShownRows}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:StewardStatisticsRow">
                                                            <Button Classes="chip-button chip-action" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding Name}">
                                                                <TextBlock MaxWidth="240" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatisticsShowAll}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- dependencies: side by side where they fit -->
                                    <Border Classes="card" Padding="24,16">
                                        <StackPanel Spacing="12">
                                            <TextBlock Classes="heading-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardStatisticsDependencies}" />
                                            <Grid ColumnDefinitions="*,32,*" RowDefinitions="Auto,Auto">
                                                <ContentControl Classes="stat-left" Content="{Binding MostDependencies}" ContentTemplate="{StaticResource StatisticsDependencyTable}" />
                                                <ContentControl Classes="stat-right" Content="{Binding MostDependedOn}" ContentTemplate="{StaticResource StatisticsDependencyTable}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- upkeep: a row per listing and a column per problem, with the count of each problem in its heading -->
                                    <Border Classes="card" Padding="24,16">
                                        <StackPanel DataContext="{Binding Upkeep}" x:DataType="vm:StewardStatisticsUpkeep" Spacing="12">
                                            <TextBlock Classes="heading-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardStatisticsUpkeep}" />
                                            <TextBlock Classes="body-md muted" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardStatisticsUpkeepEmpty}" IsVisible="{Binding Rows.IsEmpty}" />
                                            <StackPanel IsVisible="{Binding !Rows.IsEmpty}">
                                                <Border BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                                                    <Grid ColumnDefinitions="*,2*">
                                                        <TextBlock Classes="label-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardStatisticsListing}" VerticalAlignment="Bottom" />
                                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Columns}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <UniformGrid Rows="1" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:StewardStatisticsUpkeepColumn">
                                                                    <Grid RowDefinitions="*,Auto" Margin="4,0">
                                                                        <TextBlock Classes="label-sm" Text="{Binding Title}" TextWrapping="Wrap" TextAlignment="Center" />
                                                                        <TextBlock Grid.Row="1" Classes="heading-sm" Classes.muted="{Binding Count.IsZero}" Text="{Binding Count.Text}" TextAlignment="Center" Margin="0,4,0,0" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding Rows.ShownRows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:StewardStatisticsUpkeepRow">
                                                            <Border BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="0,0,0,1" MinHeight="32">
                                                                <Grid ColumnDefinitions="*,2*">
                                                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatisticsRowName}" VerticalAlignment="Center" />
                                                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}" VerticalAlignment="Center">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <UniformGrid Rows="1" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="vm:StewardStatisticsUpkeepCell">
                                                                                <Panel>
                                                                                    <Border Classes="stat-mark" ToolTip.Tip="{Binding Problem}" AutomationProperties.Name="{Binding Problem}" IsVisible="{Binding HasProblem}">
                                                                                        <Path Classes="icon size-16" Data="{StaticResource Icon.Close}" />
                                                                                    </Border>
                                                                                </Panel>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ContentControl Content="{Binding Rows}" ContentTemplate="{StaticResource StatisticsShowAll}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- overview: small ranked lists, and the most downloaded listings across the width -->
                                    <Border Classes="card" Padding="24,16">
                                        <StackPanel Spacing="24">
                                            <StackPanel Spacing="12">
                                                <TextBlock Classes="heading-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardStatisticsOverview}" />
                                                <Grid ColumnDefinitions="*,24,*,24,*,24,*" RowDefinitions="Auto,Auto">
                                                    <ContentControl Classes="stat-types" Content="{Binding Types}" ContentTemplate="{StaticResource StatisticsBarList}" />
                                                    <ContentControl Classes="stat-hosts" Content="{Binding ReleaseHosts}" ContentTemplate="{StaticResource StatisticsBarList}" />
                                                    <ContentControl Classes="stat-tags" Content="{Binding Tags}" ContentTemplate="{StaticResource StatisticsBarList}" />
                                                    <ContentControl Classes="stat-licenses" Content="{Binding Licenses}" ContentTemplate="{StaticResource StatisticsBarList}" />
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel DataContext="{Binding MostDownloaded}" x:DataType="vm:StewardStatisticsList" Spacing="8">
                                                <TextBlock Classes="label-md" Text="{Binding Title}" />
                                                <TextBlock Classes="body-md muted" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardStatisticsNothing}" TextWrapping="Wrap" IsVisible="{Binding IsEmpty}" />
                                                <ItemsControl ItemsSource="{Binding ShownRows}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Spacing="4" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:StewardStatisticsBarRow">
                                                            <Grid ColumnDefinitions="240,12,*,12,72" MinHeight="24">
                                                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatisticsRowName}" VerticalAlignment="Center" />
                                                                <views:ShareBarPanel Grid.Column="2" VerticalAlignment="Center">
                                                                    <Border Classes="stat-bar" views:ShareBarPanel.Share="{Binding Share}" />
                                                                </views:ShareBarPanel>
                                                                <TextBlock Grid.Column="4" Classes="label-md" Text="{Binding Value}" TextAlignment="Right" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Panel>
                        </StackPanel>
                    </Panel>
                </StackPanel>

                <!-- Review: one pull request in place of the tabs, with the steward actions on it -->
                <Panel IsVisible="{Binding IsReviewOpen}">
                    <StackPanel DataContext="{Binding Review}" x:DataType="vm:StewardReview" Margin="0,24,0,0">
                        <WrapPanel ItemSpacing="8" LineSpacing="4">
                            <TextBlock Classes="body-sm secondary" Text="{Binding NumberText}" VerticalAlignment="Center" />
                            <Border Classes="chip untested" IsVisible="{Binding IsDraft}">
                                <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardQueueDraft}" />
                            </Border>
                            <Border Classes="chip" IsVisible="{Binding StateText, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Text="{Binding StateText}" />
                            </Border>
                        </WrapPanel>
                        <TextBlock Classes="heading-lg" Text="{Binding Title}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <WrapPanel ItemSpacing="12" LineSpacing="4" Margin="0,8,0,0">
                            <TextBlock Classes="body-md secondary" Text="{Binding ByText}" VerticalAlignment="Center" IsVisible="{Binding ByText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <TextBlock Classes="body-md secondary" Text="{Binding FromText}" VerticalAlignment="Center" IsVisible="{Binding FromText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <Button Classes="link" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding Url}">
                                <TextBlock Classes="action-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardReviewOpenOnGitHub}" />
                            </Button>
                        </WrapPanel>
                        <ItemsControl ItemsSource="{Binding Labels}" Margin="0,12,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Classes="chip">
                                        <TextBlock Text="{Binding}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0" IsVisible="{Binding IsLoading}">
                            <ProgressBar Width="38" Height="6" VerticalAlignment="Center" IsIndeterminate="True" Foreground="{StaticResource Brush.Accent}" />
                            <TextBlock Classes="body-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardReviewLoading}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="body-md danger" Text="{Binding Error}" TextWrapping="Wrap" Margin="0,16,0,0" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <!-- the head commit, validate on it, and the checks to run again -->
                        <Border Classes="card" Padding="24,16" Margin="0,16,0,0" IsVisible="{Binding CommitText, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Spacing="8">
                                <WrapPanel ItemSpacing="12" LineSpacing="4">
                                    <TextBlock Classes="label-md" Text="{Binding CommitText}" VerticalAlignment="Center" />
                                    <Border Classes="chip" Classes.positive="{Binding IsValidateSuccess}" Classes.incompatible="{Binding IsValidateBad}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ValidateText}" TextWrapping="Wrap" />
                                    </Border>
                                    <Button Classes="link" Command="{Binding OpenValidateDetailsCommand}" ToolTip.Tip="{Binding ValidateDetails}" VerticalAlignment="Center" IsVisible="{Binding ValidateDetails, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <TextBlock Classes="action-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardReviewValidateDetails}" />
                                    </Button>
                                </WrapPanel>
                                <TextBlock Classes="body-sm secondary" Text="{Binding ValidateDescription}" TextWrapping="Wrap" IsVisible="{Binding ValidateDescription, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <WrapPanel ItemSpacing="12" LineSpacing="4" IsVisible="{Binding CanRunChecks}">
                                    <Button Classes="link" Command="{Binding RunChecksCommand}" ToolTip.Tip="{Binding ChecksWorkflowUrl}" VerticalAlignment="Center">
                                        <TextBlock Classes="action-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardReviewRunChecks}" />
                                    </Button>
                                    <TextBlock Classes="body-sm secondary" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardReviewRunChecksHint}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- the steward actions, each with a confirmation, and why Merge is off -->
                        <StackPanel Spacing="8" Margin="0,16,0,0" IsVisible="{Binding CanAct}">
                            <WrapPanel ItemSpacing="8" LineSpacing="8">
                                <Button Classes="cta" Command="{Binding MergeCommand}" IsEnabled="{Binding CanMerge}">
                                    <TextBlock Classes="action-lg" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardActionMerge}" VerticalAlignment="Center" />
                                </Button>
                                <Button Classes="text tall" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardActionApprove}" Command="{Binding ApproveCommand}" VerticalAlignment="Center" />
                                <Button Classes="text tall" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardActionRequestChanges}" Command="{Binding RequestChangesCommand}" VerticalAlignment="Center" />
                                <Button Classes="text tall" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardActionComment}" Command="{Binding CommentCommand}" VerticalAlignment="Center" />
                                <Button Classes="text tall" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardActionClose}" Command="{Binding ClosePullRequestCommand}" VerticalAlignment="Center" />
                            </WrapPanel>
                            <TextBlock Classes="body-sm secondary" Text="{Binding MergeBlockedText}" TextWrapping="Wrap" IsVisible="{Binding MergeBlockedText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <TextBlock Classes="body-sm" Text="{Binding OwnWarning}" TextWrapping="Wrap" IsVisible="{Binding OwnWarning, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>

                        <!-- the verdict of the checks, as Markdown -->
                        <StackPanel Spacing="12" Margin="0,32,0,0" IsVisible="{Binding CommitText, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Classes="heading-sm heading" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardReviewVerdict}" />
                            <Border Classes="card" Padding="24,16" IsVisible="{Binding HasVerdict}">
                                <views:MarkdownView Markdown="{Binding Verdict}" />
                            </Border>
                            <TextBlock Classes="body-md muted" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardQueueNoVerdict}" IsVisible="{Binding !HasVerdict}" />
                        </StackPanel>

                        <!-- each listing or pack document at the head commit, laid out like the header and description of its content page -->
                        <StackPanel Spacing="12" Margin="0,32,0,0" IsVisible="{Binding HasDocuments}">
                            <TextBlock Classes="heading-sm heading" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardReviewDocuments}" />
                            <ItemsControl ItemsSource="{Binding Documents}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StewardReviewDocument">
                                        <Border Classes="card" Padding="24">
                                            <StackPanel Spacing="16">
                                                <WrapPanel ItemSpacing="8" LineSpacing="4">
                                                    <TextBlock Classes="label-md" Text="{Binding Path}" VerticalAlignment="Center" />
                                                    <Border Classes="chip" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding KindText}" />
                                                    </Border>
                                                </WrapPanel>

                                                <!-- a document that does not parse: why, and its text -->
                                                <TextBlock Classes="body-md danger" Text="{Binding Problem}" TextWrapping="Wrap" IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                <Border Background="{StaticResource Brush.Window}" CornerRadius="8" Padding="12" IsVisible="{Binding RawText, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                    <SelectableTextBlock FontFamily="{StaticResource Font.Mono}" FontSize="12" Text="{Binding RawText}" TextWrapping="Wrap" />
                                                </Border>

                                                <StackPanel Spacing="16" IsVisible="{Binding IsPreview}">
                                                    <!-- c/content-header -->
                                                    <Grid ColumnDefinitions="96,24,*">
                                                        <Border Classes="thumbnail" Width="96" Height="96" Background="{StaticResource Brush.Surface}" VerticalAlignment="Top">
                                                            <Path Classes="icon" Data="{StaticResource Icon.PuzzlePiece}" RenderTransform="scale(1.5)" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="2" Spacing="4">
                                                            <TextBlock Classes="heading-lg" Text="{Binding Name}" TextWrapping="Wrap" />
                                                            <TextBlock Classes="body-sm secondary" Text="{Binding AuthorsText}" TextWrapping="Wrap" IsVisible="{Binding AuthorsText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                            <TextBlock Classes="body-md secondary" Text="{Binding Abstract}" TextWrapping="Wrap" LineHeight="18" IsVisible="{Binding Abstract, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                            <WrapPanel ItemSpacing="8" LineSpacing="4" Margin="0,8,0,0">
                                                                <Border Classes="chip" IsVisible="{Binding VersionText, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                                    <TextBlock Text="{Binding VersionText}" />
                                                                </Border>
                                                                <Border Classes="chip" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentCompatibility}" IsVisible="{Binding GameVersionText, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                                    <TextBlock Text="{Binding GameVersionText}" />
                                                                </Border>
                                                                <StackPanel Orientation="Horizontal" Spacing="8" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.DiscoverLicense}" IsVisible="{Binding License, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Scales}" />
                                                                    <TextBlock Classes="body-sm secondary" FontWeight="SemiBold" Text="{Binding License}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </WrapPanel>
                                                            <ItemsControl ItemsSource="{Binding Tags}" Margin="0,8,0,0">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="x:String">
                                                                        <Border Classes="chip">
                                                                            <TextBlock Text="{Binding}" />
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- c/block-text: the CommonMark description -->
                                                    <Border BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="16" Padding="24,20">
                                                        <Panel>
                                                            <views:MarkdownView Markdown="{Binding Description}" IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                            <TextBlock Classes="body-md muted" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentNoDescription}" IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNull}}" />
                                                        </Panel>
                                                    </Border>

                                                    <StackPanel Spacing="10" IsVisible="{Binding !!Links.Count}">
                                                        <TextBlock Classes="heading-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentLinks}" />
                                                        <ItemsControl ItemsSource="{Binding Links}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel ItemSpacing="6" LineSpacing="6" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:ContentLink">
                                                                    <Button Classes="filter" Command="{Binding $parent[ItemsControl].((vm:StewardReviewDocument)DataContext).OpenLinkCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding Url}" AutomationProperties.ControlTypeOverride="Hyperlink">
                                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                                            <Path Classes="icon size-16" Data="{Binding Key, Converter={x:Static views:LinkIcon.FromKey}}" />
                                                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <StackPanel Spacing="10" IsVisible="{Binding !!Members.Count}">
                                                        <TextBlock Classes="heading-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.PackMods}" />
                                                        <ItemsControl ItemsSource="{Binding Members}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="x:String">
                                                                    <TextBlock Classes="label-md" Text="{Binding}" Margin="0,2" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <!-- a vehicle or save: what it depends on, and the folder that its newest release already installs as -->
                                                    <StackPanel Spacing="16" IsVisible="{Binding IsVehicleOrSave}">
                                                        <StackPanel Spacing="10" IsVisible="{Binding !!Dependencies.Count}">
                                                            <TextBlock Classes="heading-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingDependencies}" />
                                                            <ItemsControl ItemsSource="{Binding Dependencies}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="x:String">
                                                                        <TextBlock Classes="label-md" Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                        <StackPanel Spacing="10">
                                                            <TextBlock Classes="heading-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardReviewNewestRelease}" />
                                                            <TextBlock Classes="body-sm" Classes.secondary="{Binding !IsReleaseUnreadable}" Classes.danger="{Binding IsReleaseUnreadable}" Text="{Binding ReleaseText}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- the ownership proof of the pull request author against the listing on the base branch -->
                                                <StackPanel Spacing="6" IsVisible="{Binding HasOwnership}">
                                                    <TextBlock Classes="heading-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardReviewOwnership}" />
                                                    <TextBlock Classes="body-md" Classes.positive="{Binding IsOwnershipVerified}" Text="{Binding OwnershipText}" TextWrapping="Wrap" />
                                                    <TextBlock Classes="body-sm secondary" Text="{Binding OwnershipDetail}" TextWrapping="Wrap" IsVisible="{Binding OwnershipDetail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    <ItemsControl ItemsSource="{Binding OwnershipLinks}" Margin="0,4,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel ItemSpacing="6" LineSpacing="6" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:ContentLink">
                                                                <Button Classes="filter" Command="{Binding $parent[ItemsControl].((vm:StewardReviewDocument)DataContext).OpenLinkCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding Url}" AutomationProperties.ControlTypeOverride="Hyperlink">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <Path Classes="icon size-16" Data="{Binding Key, Converter={x:Static views:LinkIcon.FromKey}}" />
                                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- each pack owner record that the pull request changes: the owner before and after it, and the login of the new account id now -->
                        <StackPanel Spacing="12" Margin="0,32,0,0" IsVisible="{Binding HasOwnerRecords}">
                            <TextBlock Classes="heading-sm heading" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardReviewOwnerRecords}" />
                            <ItemsControl ItemsSource="{Binding OwnerRecords}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StewardReviewOwnerRecord">
                                        <Border Classes="card" Padding="24">
                                            <StackPanel Spacing="8">
                                                <WrapPanel ItemSpacing="8" LineSpacing="4">
                                                    <TextBlock Classes="label-md" Text="{Binding Path}" VerticalAlignment="Center" />
                                                    <Border Classes="chip" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding KindText}" />
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Classes="body-sm secondary" Text="{Binding FirstClaimText}" TextWrapping="Wrap" IsVisible="{Binding FirstClaimText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                <TextBlock Classes="body-md" Text="{Binding BeforeText}" TextWrapping="Wrap" />
                                                <Border Background="{StaticResource Brush.Window}" CornerRadius="8" Padding="12" IsVisible="{Binding RawBefore, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                    <SelectableTextBlock FontFamily="{StaticResource Font.Mono}" FontSize="12" Text="{Binding RawBefore}" TextWrapping="Wrap" />
                                                </Border>
                                                <TextBlock Classes="body-md" Text="{Binding AfterText}" TextWrapping="Wrap" />
                                                <Border Background="{StaticResource Brush.Window}" CornerRadius="8" Padding="12" IsVisible="{Binding RawAfter, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                    <SelectableTextBlock FontFamily="{StaticResource Font.Mono}" FontSize="12" Text="{Binding RawAfter}" TextWrapping="Wrap" />
                                                </Border>
                                                <TextBlock Classes="body-md" Classes.positive="{Binding IsAccountSame}" Classes.danger="{Binding IsAccountWrong}" Text="{Binding AccountText}" TextWrapping="Wrap" IsVisible="{Binding AccountText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- the changed files with their diff, or the way to GitHub where it sends none -->
                        <StackPanel Spacing="12" Margin="0,32,0,0" IsVisible="{Binding CommitText, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Classes="heading-sm heading" Text="{Binding FilesHeading}" />
                            <ItemsControl ItemsSource="{Binding Files}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StewardReviewFile">
                                        <Border Classes="card" Padding="24,16">
                                            <StackPanel Spacing="8">
                                                <Grid ColumnDefinitions="*,16,Auto">
                                                    <WrapPanel ItemSpacing="12" LineSpacing="4">
                                                        <TextBlock Classes="label-md" Text="{Binding File.Path}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                        <TextBlock Classes="body-sm secondary" Text="{Binding StatusText}" VerticalAlignment="Center" />
                                                        <TextBlock Classes="body-sm secondary" Text="{Binding ChangesText}" VerticalAlignment="Center" />
                                                    </WrapPanel>
                                                    <Button Grid.Column="2" Classes="link" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding File.DiffUrl}" VerticalAlignment="Top">
                                                        <TextBlock Classes="action-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardReviewOpenOnGitHub}" />
                                                    </Button>
                                                </Grid>
                                                <Border Background="{StaticResource Brush.Window}" CornerRadius="8" Padding="12" IsVisible="{Binding HasPatch}">
                                                    <ItemsControl ItemsSource="{Binding Lines}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:StewardPatchLine">
                                                                <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="12" Text="{Binding Text}" TextWrapping="Wrap" Classes.positive="{Binding IsAdded}" Classes.danger="{Binding IsRemoved}" Classes.secondary="{Binding IsHunk}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                                <TextBlock Classes="body-sm muted" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardReviewNoPatch}" TextWrapping="Wrap" IsVisible="{Binding !HasPatch}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Panel>
            </StackPanel>
        </views:PageBodyPanel>
    </ScrollViewer>
</UserControl>
