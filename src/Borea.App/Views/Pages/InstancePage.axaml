<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Borea.App.ViewModels"
             xmlns:views="using:Borea.App.Views"
             x:Class="Borea.App.Views.Pages.InstancePage"
             x:DataType="vm:MainViewModel">
    <UserControl.Resources>
        <!-- c/table-versions of one content group -->
        <DataTemplate x:Key="ContentGroupTable" x:DataType="vm:ContentGroup">
            <Border BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="16" views:RoundedClip.IsEnabled="True" Padding="0,0,0,4" Margin="0,0,0,16">
                <StackPanel>
                    <Border Background="{StaticResource Brush.Surface}" Padding="16,11">
                        <TextBlock Classes="body-md secondary" Text="{Binding Title}" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ContentRow}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="GameSaveRow" x:DataType="vm:GameSaveItem">
            <Border BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="0,1,0,0" Padding="16,8">
                <Grid ColumnDefinitions="48,16,*,24,Auto">
                    <Border Classes="thumbnail" Width="48" Height="48">
                        <Panel>
                            <Path Classes="icon" Data="{StaticResource Icon.Cylinder}" IsVisible="{Binding IsVehicle}" />
                            <Path Classes="icon" Data="{StaticResource Icon.Planet}" IsVisible="{Binding !IsVehicle}" />
                        </Panel>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Classes="heading-sm" Text="{Binding Name}" ToolTip.Tip="{Binding FolderName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="body-sm secondary" Text="{Binding UpdatedText}" />
                        <TextBlock Classes="body-sm danger" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.GameSaveDeleteConfirm}" TextWrapping="Wrap" IsVisible="{Binding IsConfirmingDelete}" />
                        <StackPanel Spacing="4" Margin="0,4,0,0" IsVisible="{Binding IsChoosingTarget}">
                            <TextBlock Classes="body-sm secondary" Text="{Binding CopyNoteText}" TextWrapping="Wrap" IsVisible="{Binding CopyNoteText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <ComboBox ItemsSource="{Binding CopyTargets}" SelectedItem="{Binding CopyTarget}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.GameSaveCopyToInstance}" Width="240">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:InstanceItem">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Classes="body-sm danger" Text="{Binding ReplaceText}" TextWrapping="Wrap" IsVisible="{Binding IsConfirmingReplace}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                        <Border Classes="chip untested" VerticalAlignment="Center" IsVisible="{Binding IsOlderBuild}" ToolTip.Tip="{Binding OlderBuildText}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse />
                                <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.GameSaveOlderBuild}" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding BuildText, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="{Binding BuildToolTip}">
                            <Path Classes="icon size-16" Data="{StaticResource Icon.GitCommit}" />
                            <TextBlock Classes="label-md" Text="{Binding BuildText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="label-md" Text="{Binding SizeText}" VerticalAlignment="Center" />
                        <Panel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsConfirmingDelete}">
                                <Button Classes="text danger" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryDelete}" Command="{Binding ConfirmDeleteCommand}" />
                                <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsChoosingTarget}">
                                <Button Classes="text primary" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.GameSaveCopy}" Command="{Binding CopyCommand}" />
                                <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsConfirmingReplace}">
                                <Button Classes="text danger" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.GameSaveReplace}" Command="{Binding ConfirmReplaceCommand}" />
                                <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelCommand}" />
                            </StackPanel>
                            <Button Classes="icon" IsVisible="{Binding IsIdle}" AutomationProperties.Name="{Binding Name}">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.GameDataOpenFolder}" Command="{Binding OpenFolderCommand}" />
                                        <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.GameSaveBackUp}" Command="{Binding BackUpCommand}" />
                                        <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.GameSaveCopyToInstance}" Command="{Binding BeginCopyCommand}" />
                                        <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryDelete}" Command="{Binding BeginDeleteCommand}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                                <Path Classes="icon-filled" Data="{StaticResource Icon.More}" />
                            </Button>
                        </Panel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- the mod loader the mods need, above the mods, in the shape of the other tables -->
        <DataTemplate x:Key="InstanceLoaderTable" x:DataType="vm:InstanceLoaderSection">
            <Border BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="16" views:RoundedClip.IsEnabled="True" Padding="0,0,0,4" Margin="0,0,0,16">
                <StackPanel>
                    <Border Background="{StaticResource Brush.Surface}" Padding="16,11">
                        <TextBlock Classes="body-md secondary" Text="{Binding Title}" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Classes="body-md secondary" Text="{Binding NoneText}" TextWrapping="Wrap" Margin="16,12" IsVisible="{Binding NoneText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Classes="body-sm danger" Text="{Binding DifferentText}" TextWrapping="Wrap" Margin="16,8" IsVisible="{Binding DifferentText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:InstanceLoaderRow">
                                <Border BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="0,1,0,0" Padding="16,8">
                                    <Grid ColumnDefinitions="48,16,*,16,Auto">
                                        <!-- like a mod row: the icon and the name open the loader's page -->
                                        <Button Classes="plain" Command="{Binding OpenCommand}" IsVisible="{Binding CanOpen}" AutomationProperties.Name="{Binding Name}">
                                            <Border Classes="thumbnail" Width="48" Height="48">
                                                <views:ListingImageView Image="{Binding Icon}" Background="{StaticResource Brush.Surface}">
                                                    <Path Classes="icon" Data="{StaticResource Icon.PuzzlePiece}" />
                                                </views:ListingImageView>
                                            </Border>
                                        </Button>
                                        <Border Classes="thumbnail" Width="48" Height="48" IsVisible="{Binding !CanOpen}" ToolTip.Tip="{Binding NoPageText}">
                                            <views:ListingImageView Image="{Binding Icon}" Background="{StaticResource Brush.Surface}">
                                                <Path Classes="icon" Data="{StaticResource Icon.PuzzlePiece}" />
                                            </views:ListingImageView>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Button Classes="plain" Command="{Binding OpenCommand}" IsVisible="{Binding CanOpen}" HorizontalAlignment="Left">
                                                <TextBlock Classes="heading-sm" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </Button>
                                            <TextBlock Classes="heading-sm" Text="{Binding Name}" TextTrimming="CharacterEllipsis" IsVisible="{Binding !CanOpen}" ToolTip.Tip="{Binding NoPageText}" />
                                            <TextBlock Classes="body-sm secondary" Text="{Binding RangeText}" TextWrapping="Wrap" />
                                            <TextBlock Classes="body-sm secondary" Text="{Binding NeededByText}" TextWrapping="Wrap" IsVisible="{Binding NeededByText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <Border Classes="chip" Classes.compatible="{Binding IsInstalled}" Classes.untested="{Binding IsWarning}" Classes.incompatible="{Binding IsConflict}" VerticalAlignment="Center" ToolTip.Tip="{Binding StatusToolTip}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Ellipse />
                                                    <TextBlock Text="{Binding StatusText}" />
                                                </StackPanel>
                                            </Border>
                                            <Button Classes="link" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenLoaderSettingsCommand}" IsVisible="{Binding CanFix}" VerticalAlignment="Center">
                                                <TextBlock Classes="action-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.InstanceLoaderOpenSettings}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="GameSaveTable" x:DataType="vm:GameSaveSection">
            <Border BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="16" views:RoundedClip.IsEnabled="True" Padding="0,0,0,4" Margin="0,0,0,16">
                <StackPanel>
                    <Border Background="{StaticResource Brush.Surface}" Padding="16,11">
                        <Grid ColumnDefinitions="*,16,Auto,4,Auto">
                            <TextBlock Classes="body-md secondary" Text="{Binding Title}" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="link" Command="{Binding BeginCopyFromProfileCommand}" IsVisible="{Binding !IsChoosingFromProfile}" VerticalAlignment="Center">
                                <TextBlock Classes="action-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.GameSaveCopyFromProfile}" />
                            </Button>
                            <views:InfoButton Grid.Column="4" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).GameProfileInfoText}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.MoreInformation}" IsVisible="{Binding !IsChoosingFromProfile}" />
                        </Grid>
                    </Border>
                    <TextBlock Classes="body-sm danger" Text="{Binding Error}" TextWrapping="Wrap" Margin="16,8" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <StackPanel Spacing="8" Margin="16,8" IsVisible="{Binding IsChoosingFromProfile}">
                        <TextBlock Classes="body-sm secondary" Text="{Binding CopyNoteText}" TextWrapping="Wrap" IsVisible="{Binding CopyNoteText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Classes="body-md muted" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.GameSaveProfileEmpty}" IsVisible="{Binding !HasProfileItems}" />
                        <!-- the command decides between select all and clear all, because a check box in the mixed state clears on its own -->
                        <CheckBox IsChecked="{Binding AreAllProfileItemsSelected, Mode=OneWay}" Command="{Binding ToggleAllProfileItemsCommand}" IsVisible="{Binding HasProfileItems}">
                            <TextBlock Classes="body-sm secondary" Text="{Binding ProfileSelectionText}" />
                        </CheckBox>
                        <ItemsControl ItemsSource="{Binding ProfileItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GameSaveItem">
                                    <Grid ColumnDefinitions="Auto,8,*,16,Auto,16,Auto" Margin="0,4">
                                        <CheckBox IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Name}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Classes="heading-sm" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="body-sm secondary" Text="{Binding UpdatedText}" />
                                            <TextBlock Classes="body-sm secondary" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.GameSaveExistsInInstance}" IsVisible="{Binding ExistsInInstance}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="4" Classes="label-md" Text="{Binding BuildText}" VerticalAlignment="Center" ToolTip.Tip="{Binding BuildToolTip}" />
                                        <TextBlock Grid.Column="6" Classes="label-md" Text="{Binding SizeText}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="body-sm danger" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.GameSaveProfileReplace}" TextWrapping="Wrap" IsVisible="{Binding IsConfirmingProfileReplace}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Classes="text primary" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.GameSaveCopy}" Command="{Binding CopyFromProfileCommand}" IsVisible="{Binding !IsConfirmingProfileReplace}" IsEnabled="{Binding HasProfileItems}" />
                            <Button Classes="text danger" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.GameSaveReplace}" Command="{Binding ReplaceFromProfileCommand}" IsVisible="{Binding IsConfirmingProfileReplace}" />
                            <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelCopyFromProfileCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,16,Auto" Margin="16,12" IsVisible="{Binding !HasItems}">
                        <TextBlock Classes="body-md muted" Text="{Binding EmptyText}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.GameDataOpenFolder}" Command="{Binding OpenFolderCommand}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource GameSaveRow}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="BackupRow" x:DataType="vm:GameSaveBackupItem">
            <Border BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="0,1,0,0" Padding="16,8">
                <Grid ColumnDefinitions="48,16,*,24,Auto">
                    <Border Classes="thumbnail" Width="48" Height="48">
                        <Panel>
                            <Path Classes="icon" Data="{StaticResource Icon.Cylinder}" IsVisible="{Binding IsVehicle}" />
                            <Path Classes="icon" Data="{StaticResource Icon.Planet}" IsVisible="{Binding IsSave}" />
                            <Path Classes="icon" Data="{StaticResource Icon.FolderOpen}" IsVisible="{Binding !CanRestore}" />
                        </Panel>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Classes="heading-sm" Text="{Binding Name}" ToolTip.Tip="{Binding Id}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="body-sm secondary" Text="{Binding TimeText}" />
                        <TextBlock Classes="body-sm secondary" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.BackupUnknownOrigin}" TextWrapping="Wrap" IsVisible="{Binding !CanRestore}" />
                        <TextBlock Classes="body-sm danger" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.BackupDeleteConfirm}" TextWrapping="Wrap" IsVisible="{Binding IsConfirmingDelete}" />
                        <TextBlock Classes="body-sm danger" Text="{Binding ReplaceText}" TextWrapping="Wrap" IsVisible="{Binding IsConfirmingReplace}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                        <TextBlock Classes="label-md" Text="{Binding SizeText}" VerticalAlignment="Center" />
                        <Panel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsConfirmingDelete}">
                                <Button Classes="text danger" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryDelete}" Command="{Binding ConfirmDeleteCommand}" />
                                <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsConfirmingReplace}">
                                <Button Classes="text danger" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.GameSaveReplace}" Command="{Binding ConfirmReplaceCommand}" />
                                <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsIdle}">
                                <Button Classes="text primary" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.BackupRestore}" Command="{Binding RestoreCommand}" IsVisible="{Binding CanRestore}" />
                                <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryDelete}" Command="{Binding BeginDeleteCommand}" />
                            </StackPanel>
                        </Panel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Instance (library-instance) -->
    <Grid RowDefinitions="Auto,*">
        <views:PageBodyPanel HasBottomMargin="False">
            <!-- breadcrumb: Library / name -->
            <StackPanel Orientation="Horizontal" Spacing="4" Height="24">
                <Button Classes="plain back" Command="{Binding GoBackCommand}" VerticalAlignment="Center" ToolTip.Tip="{Binding Localization.NavigationBack}" AutomationProperties.Name="{Binding Localization.NavigationBack}">
                    <Path Classes="icon" Data="{StaticResource Icon.ArrowLeft}" />
                </Button>
                <Path Classes="icon" Data="{StaticResource Icon.Library}" />
                <Button Classes="plain" Command="{Binding SetMainWindowLibrary}">
                    <TextBlock Classes="label-lg" Text="{Binding Localization.PageLibraryHeading}" VerticalAlignment="Center" />
                </Button>
                <TextBlock Classes="label-lg" Text="/" VerticalAlignment="Center" />
                <TextBlock Classes="label-lg" Text="{Binding SelectedInstance.Name}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- c/content-header -->
            <Grid ColumnDefinitions="70,24,*" Margin="0,42,0,0">
                <Border Classes="thumbnail" Width="70" Height="70">
                    <Path Classes="icon size-32" Data="{StaticResource Icon.Box}" />
                </Border>
                <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto" Height="70">
                    <Grid ColumnDefinitions="*,24,Auto">
                        <TextBlock Classes="heading-lg" Text="{Binding SelectedInstance.Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <!-- c/link-cta, so Play stays the one filled button of the header -->
                            <Button Classes="link" Command="{Binding UpdateAll.UpdateCommand}" IsEnabled="{Binding CanChangeContent}" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Button.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="HasUpdates" />
                                        <Binding Path="!UpdateAll.IsInstalling" />
                                    </MultiBinding>
                                </Button.IsVisible>
                                <TextBlock Classes="action-md" Text="{Binding Localization.InstanceUpdateAll}" />
                            </Button>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0" IsVisible="{Binding UpdateAll.IsInstalling}">
                                <ProgressBar Width="96" Height="6" VerticalAlignment="Center" Value="{Binding UpdateAll.Progress}" Maximum="100" Foreground="{StaticResource Brush.Accent}" />
                                <Button Classes="text" Content="{Binding UpdateAll.Run.PauseText}" Command="{Binding UpdateAll.Run.TogglePauseCommand}" />
                                <Button Classes="text" Content="{Binding UpdateAll.Run.StopText}" Command="{Binding UpdateAll.Run.StopCommand}" />
                            </StackPanel>
                            <!-- c/button-cta -->
                            <Button Classes="cta" Command="{Binding PlayCommand}" IsEnabled="{Binding !IsLaunching}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="icon-filled size-16" Fill="{StaticResource Brush.SurfaceHeader}" Data="{StaticResource Icon.Play}" VerticalAlignment="Center" />
                                    <TextBlock Classes="action-lg" Text="{Binding Localization.InstancePlay}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <views:InstanceMenu DataContext="{Binding SelectedInstance}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="24">
                        <Border Classes="chip positive" IsVisible="{Binding SelectedInstance.SourceText, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Text="{Binding SelectedInstance.SourceText}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" ToolTip.Tip="{Binding SelectedInstance.ModCountToolTip}">
                            <Path Classes="icon size-16" Data="{StaticResource Icon.CirclesThree}" />
                            <TextBlock Classes="label-md" Text="{Binding SelectedInstance.ModCount}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" ToolTip.Tip="{Binding Localization.InstanceSizeToolTip}" IsVisible="{Binding InstanceSizeText, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Path Classes="icon size-16" Data="{StaticResource Icon.HardDrive}" />
                            <TextBlock Classes="label-md" Text="{Binding InstanceSizeText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" ToolTip.Tip="{Binding InstancePlaytimeToolTip}" IsVisible="{Binding InstancePlaytimeText, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Path Classes="icon size-16" Data="{StaticResource Icon.Clock}" />
                            <TextBlock Classes="label-md" Text="{Binding InstancePlaytimeText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="label-md" Text="{Binding InstanceSessionsText}" VerticalAlignment="Center" IsVisible="{Binding InstanceSessionsText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <ScrollViewer MaxHeight="{Binding $parent[UserControl].Bounds.Height, Converter={x:Static views:PageBodyPanel.HeaderMessagesMaxHeight}}">
                <StackPanel>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource LaunchStatus}" />
                    <TextBlock Classes="body-md secondary" Text="{Binding SharedProfileImportNotice}" TextWrapping="Wrap" Margin="0,16,0,0" IsVisible="{Binding SharedProfileImportNotice, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Classes="body-md secondary" Text="{Binding UpdateAll.ProgressStatus}" TextWrapping="Wrap" Margin="0,16,0,0" IsVisible="{Binding UpdateAll.ProgressStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,0" IsVisible="{Binding UpdateAll.IsConfirmingUpdate}">
                        <TextBlock Classes="body-md secondary" Text="{Binding UpdateAll.InstallWarning}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Panel IsEnabled="{Binding CanChangeContent}">
                                <Button Classes="text primary" Content="{Binding UpdateAll.ConfirmUpdateText}" Command="{Binding UpdateAll.ConfirmUpdateCommand}" IsEnabled="{Binding UpdateAll.Choices.IsComplete, FallbackValue={x:True}}" />
                            </Panel>
                            <Button Classes="text" Content="{Binding Localization.LibraryCancel}" Command="{Binding UpdateAll.CancelUpdateCommand}" />
                        </StackPanel>
                    </Grid>
                    <ContentControl Margin="0,12,0,0" Content="{Binding UpdateAll.Choices}" IsVisible="{Binding UpdateAll.Choices, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding UpdateAll.Changelogs}" ItemTemplate="{StaticResource ChangelogEntry}" IsVisible="{Binding UpdateAll.HasChangelogs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Classes="body-md danger" Text="{Binding UpdateAll.InstallError}" TextWrapping="Wrap" Margin="0,16,0,0" IsVisible="{Binding UpdateAll.InstallError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <!-- a newer version of the pack the instance was created from -->
                    <StackPanel Margin="0,16,0,0" IsVisible="{Binding PackUpdate, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="body-md secondary" Text="{Binding PackUpdate.NoticeText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                                <Button Classes="link" Command="{Binding PackUpdate.UpdateCommand}" IsEnabled="{Binding CanChangeContent}">
                                    <Button.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="!PackUpdate.IsInstalling" FallbackValue="{x:False}" />
                                            <Binding Path="!PackUpdate.IsConfirming" FallbackValue="{x:False}" />
                                        </MultiBinding>
                                    </Button.IsVisible>
                                    <TextBlock Classes="action-md" Text="{Binding Localization.PackUpdate}" />
                                </Button>
                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding PackUpdate.IsInstalling, FallbackValue={x:False}}">
                                    <ProgressBar Width="96" Height="6" VerticalAlignment="Center" Value="{Binding PackUpdate.Progress}" Maximum="100" Foreground="{StaticResource Brush.Accent}" />
                                    <Button Classes="text" Content="{Binding PackUpdate.Run.PauseText}" Command="{Binding PackUpdate.Run.TogglePauseCommand}" />
                                    <Button Classes="text" Content="{Binding PackUpdate.Run.StopText}" Command="{Binding PackUpdate.Run.StopCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <TextBlock Classes="body-md secondary" Text="{Binding PackUpdate.ProgressStatus}" TextWrapping="Wrap" Margin="0,8,0,0" IsVisible="{Binding PackUpdate.ProgressStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <StackPanel Margin="0,12,0,0" Spacing="4" IsVisible="{Binding PackUpdate.IsConfirming, FallbackValue={x:False}}">
                            <ItemsControl ItemsSource="{Binding PackUpdate.ChangeTexts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Classes="body-md" Text="{Binding}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                <TextBlock Classes="body-md secondary" Text="{Binding PackUpdate.InstallWarning}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <Panel IsEnabled="{Binding CanChangeContent}">
                                        <Button Classes="text primary" Content="{Binding PackUpdate.ConfirmText}" Command="{Binding PackUpdate.ConfirmUpdateCommand}" IsEnabled="{Binding PackUpdate.Choices.IsComplete, FallbackValue={x:True}}" />
                                    </Panel>
                                    <Button Classes="text" Content="{Binding Localization.LibraryCancel}" Command="{Binding PackUpdate.CancelUpdateCommand}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <ContentControl Margin="0,12,0,0" Content="{Binding PackUpdate.Choices}" IsVisible="{Binding PackUpdate.Choices, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Classes="body-md danger" Text="{Binding PackUpdate.InstallError}" TextWrapping="Wrap" Margin="0,8,0,0" IsVisible="{Binding PackUpdate.InstallError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                    <!-- mods the instance records whose folder is gone -->
                    <StackPanel Margin="0,16,0,0" IsVisible="{Binding MissingContent, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="body-md danger" Text="{Binding MissingContent.NoticeText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding CanChangeContent}">
                                    <StackPanel.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="!MissingContent.IsInstalling" FallbackValue="{x:False}" />
                                            <Binding Path="!MissingContent.IsConfirmingInstall" FallbackValue="{x:False}" />
                                            <Binding Path="!MissingContent.IsConfirmingDrop" FallbackValue="{x:False}" />
                                        </MultiBinding>
                                    </StackPanel.IsVisible>
                                    <Button Classes="text primary" Content="{Binding Localization.ContentInstallAgain}" Command="{Binding MissingContent.InstallAgainCommand}" />
                                    <Button Classes="text" Content="{Binding Localization.ContentRemoveFromList}" Command="{Binding MissingContent.BeginDropCommand}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding MissingContent.IsInstalling, FallbackValue={x:False}}">
                                    <ProgressBar Width="96" Height="6" VerticalAlignment="Center" Value="{Binding MissingContent.Progress}" Maximum="100" Foreground="{StaticResource Brush.Accent}" />
                                    <Button Classes="text" Content="{Binding MissingContent.Run.PauseText}" Command="{Binding MissingContent.Run.TogglePauseCommand}" />
                                    <Button Classes="text" Content="{Binding MissingContent.Run.StopText}" Command="{Binding MissingContent.Run.StopCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <TextBlock Classes="body-md secondary" Text="{Binding MissingContent.ProgressStatus}" TextWrapping="Wrap" Margin="0,8,0,0" IsVisible="{Binding MissingContent.ProgressStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0" IsVisible="{Binding MissingContent.IsConfirmingDrop, FallbackValue={x:False}}">
                            <TextBlock Classes="body-md danger" Text="{Binding MissingContent.ConfirmDropText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                                <Button Classes="text danger" Content="{Binding Localization.ContentRemoveFromList}" Command="{Binding MissingContent.ConfirmDropCommand}" />
                                <Button Classes="text" Content="{Binding Localization.LibraryCancel}" Command="{Binding MissingContent.CancelDropCommand}" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0" IsVisible="{Binding MissingContent.IsConfirmingInstall, FallbackValue={x:False}}">
                            <TextBlock Classes="body-md secondary" Text="{Binding MissingContent.InstallWarning}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                                <Button Classes="text primary" Content="{Binding Localization.InstallAnyway}" Command="{Binding MissingContent.ConfirmInstallCommand}" IsEnabled="{Binding CanChangeContent}" />
                                <Button Classes="text" Content="{Binding Localization.LibraryCancel}" Command="{Binding MissingContent.CancelInstallCommand}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Classes="body-md danger" Text="{Binding MissingContent.InstallError}" TextWrapping="Wrap" Margin="0,8,0,0" IsVisible="{Binding MissingContent.InstallError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- c/inner-nav-bar -->
            <Border Background="{StaticResource Brush.SurfaceHeader}" CornerRadius="100" Padding="6" Margin="0,32,0,0">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Button Classes="tab quiet" Classes.active="{Binding IsContentTab}" Content="{Binding Localization.InstanceTabContent}" Command="{Binding ShowInstanceContentCommand}" />
                    <Button Classes="tab quiet" Classes.active="{Binding IsManualInstallsTab}" Content="{Binding Localization.InstanceTabManualInstalls}" Command="{Binding ShowInstanceManualInstallsCommand}" />
                    <Button Classes="tab quiet" Classes.active="{Binding IsGameDataTab}" Content="{Binding Localization.InstanceTabGameData}" Command="{Binding ShowInstanceGameDataCommand}" />
                    <Button Classes="tab quiet" Classes.active="{Binding IsLogTab}" Content="{Binding Localization.InstanceTabLog}" Command="{Binding ShowInstanceLogCommand}" />
                </StackPanel>
            </Border>
        </views:PageBodyPanel>

        <ScrollViewer Grid.Row="1">
            <views:PageBodyPanel HasTopMargin="False">
                <Border IsVisible="{Binding IsManualInstallsTab}" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="16" views:RoundedClip.IsEnabled="True" Padding="0,0,0,4" Margin="0,32,0,0">
                    <StackPanel>
                        <Border Background="{StaticResource Brush.Surface}" Padding="16,11">
                            <TextBlock Classes="body-md secondary" Text="{Binding Localization.InstanceTabManualInstalls}" />
                        </Border>
                        <TextBlock Classes="body-sm danger" Text="{Binding ManualInstallsError}" TextWrapping="Wrap" Margin="16,8" IsVisible="{Binding ManualInstallsError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <Grid ColumnDefinitions="*,16,Auto" Margin="16,12" IsVisible="{Binding !HasManualInstalls}">
                            <TextBlock Classes="body-md muted" Text="{Binding Localization.ManualInstallsEmpty}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="text" Content="{Binding Localization.GameDataOpenFolder}" Command="{Binding OpenInstanceModsFolderCommand}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ManualInstallItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ManualInstallItem">
                                    <Border BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="0,1,0,0" Padding="16,8">
                                        <Grid ColumnDefinitions="48,16,*,24,Auto">
                                            <Border Classes="thumbnail" Width="48" Height="48">
                                                <Path Classes="icon" Data="{StaticResource Icon.PuzzlePiece}" />
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Classes="heading-sm" Text="{Binding FolderName}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Classes="body-sm secondary" Text="{Binding StatusText}" IsVisible="{Binding StatusText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                <TextBlock Classes="body-sm secondary" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ManualInstallsChecking}" IsVisible="{Binding IsChecking}" />
                                                <TextBlock Classes="body-sm secondary" Text="{Binding ProgressStatus}" TextTrimming="CharacterEllipsis" IsVisible="{Binding ProgressStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                <TextBlock Classes="body-sm danger" Text="{Binding ReplaceWarningText}" TextWrapping="Wrap" IsVisible="{Binding IsConfirmingReplace}" />
                                                <TextBlock Classes="body-sm secondary" Text="{Binding InstallWarning}" TextWrapping="Wrap" IsVisible="{Binding InstallWarning, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                <TextBlock Classes="body-sm danger" Text="{Binding InstallError}" TextWrapping="Wrap" IsVisible="{Binding InstallError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            </StackPanel>
                                            <Panel Grid.Column="4" VerticalAlignment="Center">
                                                <ProgressBar Width="38" Height="6" VerticalAlignment="Center" IsVisible="{Binding IsChecking}" IsIndeterminate="True" Foreground="{StaticResource Brush.Accent}" />
                                                <ProgressBar Width="38" Height="6" VerticalAlignment="Center" IsVisible="{Binding IsInstalling}" Value="{Binding Progress}" Maximum="100" Foreground="{StaticResource Brush.Accent}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsConfirmingReplace}">
                                                    <Button Classes="text danger" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ManualInstallsDeleteAndReplace}" Command="{Binding ConfirmReplaceCommand}" />
                                                    <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelReplaceCommand}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding InstallWarning, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                    <Button Classes="text primary" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.InstallAnyway}" Command="{Binding ConfirmInstallCommand}" />
                                                    <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelInstallCommand}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanAct}">
                                                    <Button Classes="text primary" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ManualInstallsManage}" Command="{Binding ManageCommand}" IsVisible="{Binding CanManage}" />
                                                    <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ManualInstallsReplace}" Command="{Binding BeginReplaceCommand}" />
                                                </StackPanel>
                                            </Panel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel IsVisible="{Binding IsGameDataTab}" Margin="0,32,0,0">
                    <Border BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="16" views:RoundedClip.IsEnabled="True" Padding="0,0,0,4" Margin="0,0,0,16">
                        <StackPanel>
                            <Border Background="{StaticResource Brush.Surface}" Padding="16,11">
                                <TextBlock Classes="body-md secondary" Text="{Binding Localization.InstanceTabGameData}" />
                            </Border>
                            <TextBlock Classes="body-sm danger" Text="{Binding GameDataError}" TextWrapping="Wrap" Margin="16,8" IsVisible="{Binding GameDataError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <ItemsControl ItemsSource="{Binding GameDataItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GameDataItem">
                                        <Border BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="0,1,0,0" Padding="16,8">
                                            <Grid ColumnDefinitions="48,16,*,24,Auto">
                                                <Border Classes="thumbnail" Width="48" Height="48">
                                                    <Path Classes="icon" Data="{StaticResource Icon.FolderOpen}" />
                                                </Border>
                                                <TextBlock Grid.Column="2" Classes="heading-sm" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                                                    <TextBlock Classes="label-md" Text="{Binding SizeText}" VerticalAlignment="Center" />
                                                    <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.GameDataCreatePreset}" Command="{Binding CreatePresetCommand}" IsVisible="{Binding IsSettingsFile}" />
                                                    <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.GameDataOpenFolder}" Command="{Binding OpenFolderCommand}" IsEnabled="{Binding Exists}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="16" views:RoundedClip.IsEnabled="True" Padding="0,0,0,4">
                        <StackPanel>
                            <Border Background="{StaticResource Brush.Surface}" Padding="16,11">
                                <TextBlock Classes="body-md secondary" Text="{Binding Localization.BackupsTitle}" />
                            </Border>
                            <TextBlock Classes="body-sm danger" Text="{Binding BackupsError}" TextWrapping="Wrap" Margin="16,8" IsVisible="{Binding BackupsError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <TextBlock Classes="body-md muted" Text="{Binding Localization.BackupsEmpty}" Margin="16,12" IsVisible="{Binding ShowNoBackups}" />
                            <ItemsControl ItemsSource="{Binding BackupItems}" ItemTemplate="{StaticResource BackupRow}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border IsVisible="{Binding IsLogTab}" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="16" views:RoundedClip.IsEnabled="True" Padding="0,0,0,4" Margin="0,32,0,0">
                    <StackPanel>
                        <Border Background="{StaticResource Brush.Surface}" Padding="16,11">
                            <Grid ColumnDefinitions="*,16,Auto">
                                <TextBlock Classes="body-md secondary" Text="{Binding GameLogPathText}" ToolTip.Tip="{Binding GameLogPathText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                    <Button Classes="link" Command="{Binding ReloadGameLogCommand}">
                                        <TextBlock Classes="action-md" Text="{Binding Localization.GameLogReload}" />
                                    </Button>
                                    <Button Classes="link" Click="CopyGameLog" IsEnabled="{Binding HasGameLog}">
                                        <TextBlock Classes="action-md" Text="{Binding Localization.GameLogCopy}" />
                                    </Button>
                                    <Button Classes="link" Command="{Binding OpenGameLogCommand}" IsEnabled="{Binding CanOpenGameLog}">
                                        <TextBlock Classes="action-md" Text="{Binding Localization.GameLogOpen}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Classes="body-sm danger" Text="{Binding GameLogError}" TextWrapping="Wrap" Margin="16,8" IsVisible="{Binding GameLogError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Classes="body-md muted" Text="{Binding Localization.GameLogMissing}" TextWrapping="Wrap" Margin="16,12" IsVisible="{Binding IsGameLogMissing}" />
                        <!-- one text for every line, so a selection can span lines -->
                        <views:GameLogView Classes="log-line" TextWrapping="Wrap" Margin="16,12" Lines="{Binding GameLogLines}" IsVisible="{Binding HasGameLog}" />
                    </StackPanel>
                </Border>

                <!-- the design order: the mod loader, the groups, vehicles, saves, then the dependencies; a hidden group takes no space, margin included -->
                <StackPanel Margin="0,32,0,0" IsVisible="{Binding IsContentTab}">
                    <ContentControl Content="{Binding InstanceLoader}" ContentTemplate="{StaticResource InstanceLoaderTable}" IsVisible="{Binding InstanceLoader, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <ItemsControl ItemsSource="{Binding ContentGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ContentGroup">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ContentGroupTable}" IsVisible="{Binding !IsDependencies}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="16" views:RoundedClip.IsEnabled="True" Padding="0,0,0,4" Margin="0,0,0,16" IsVisible="{Binding !HasContent}">
                        <StackPanel>
                            <Border Background="{StaticResource Brush.Surface}" Padding="16,11">
                                <TextBlock Classes="body-md secondary" Text="{Binding Localization.InstanceGroupMods}" />
                            </Border>
                            <Grid ColumnDefinitions="*,16,Auto" Margin="16,12">
                                <TextBlock Classes="body-md muted" Text="{Binding Localization.InstanceEmptyContent}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Classes="text" Content="{Binding Localization.HomeDiscoverMods}" Command="{Binding SetMainWindowDiscoverCommand}" IsVisible="{Binding SelectedInstance.IsActive, FallbackValue={x:False}}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <WrapPanel ItemSpacing="12" LineSpacing="4" Margin="8,0,0,12" IsVisible="{Binding ShowInstanceStartsEmpty}">
                        <TextBlock Classes="body-md secondary" Text="{Binding Localization.GameSaveInstanceStartsEmpty}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Classes="link" Command="{Binding CopyAllFromProfileCommand}" VerticalAlignment="Center">
                                <TextBlock Classes="action-md" Text="{Binding Localization.GameSaveCopyFromProfile}" />
                            </Button>
                            <views:InfoButton Text="{Binding GameProfileInfoText}" AutomationProperties.Name="{Binding Localization.MoreInformation}" />
                        </StackPanel>
                    </WrapPanel>
                    <ContentControl Content="{Binding VehiclesSection}" ContentTemplate="{StaticResource GameSaveTable}" />
                    <ContentControl Content="{Binding SavesSection}" ContentTemplate="{StaticResource GameSaveTable}" />
                    <ItemsControl ItemsSource="{Binding ContentGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ContentGroup">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ContentGroupTable}" IsVisible="{Binding IsDependencies}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </views:PageBodyPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
