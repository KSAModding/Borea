<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Borea.App.ViewModels"
             x:Class="Borea.App.Views.UnexpectedErrorBar"
             x:DataType="vm:MainViewModel">
    <!-- the danger tint is made for a solid surface, so the bar brings its own and the page below does not show through -->
    <Border Background="{StaticResource Brush.Window}" CornerRadius="12">
        <Border Background="{StaticResource Brush.DangerSoft}" BorderBrush="{StaticResource Brush.Danger}" BorderThickness="1" CornerRadius="12" Padding="16,10">
            <Grid ColumnDefinitions="*,12,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Classes="body-md danger" Text="{Binding Localization.UnexpectedErrorHint}" TextWrapping="Wrap" />
                    <SelectableTextBlock Classes="body-sm danger" Text="{Binding UnexpectedError}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                        <Button Classes="text" Content="{Binding Localization.UnexpectedErrorCopyDetails}" Command="{Binding CopyUnexpectedErrorCommand}" />
                        <Button Classes="text" Content="{Binding Localization.UnexpectedErrorReport}" Command="{Binding ReportUnexpectedErrorCommand}" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Classes="icon" VerticalAlignment="Top" Command="{Binding DismissUnexpectedErrorCommand}" AutomationProperties.Name="{Binding Localization.ModalClose}">
                    <Path Classes="icon size-16" Data="{StaticResource Icon.Close}" Stroke="{StaticResource Brush.Danger}" />
                </Button>
            </Grid>
        </Border>
    </Border>
</UserControl>
