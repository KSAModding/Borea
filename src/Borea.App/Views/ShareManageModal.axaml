<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Borea.App.ViewModels"
             xmlns:views="using:Borea.App.Views"
             x:Class="Borea.App.Views.ShareManageModal"
             x:DataType="vm:MainViewModel">
    <!-- modal: the owner of a listing on a share host changes its text or takes a version down. It scrolls, because a window can be 480 px high -->
    <Panel Background="#99000000" views:ModalBackdrop.CloseButton="{Binding #CloseButton}">
        <Border Classes="modal" MaxWidth="640" HorizontalAlignment="Stretch" Margin="104,32,24,32" DataContext="{Binding ShareManage}" x:DataType="vm:ShareManageDialog">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="24,24,24,0">
                    <TextBlock Classes="heading-lg" Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button x:Name="CloseButton" Grid.Column="1" Classes="icon" Command="{Binding CloseCommand}" AutomationProperties.Name="{Binding Localization.ModalClose}">
                        <Path Classes="icon" Data="{StaticResource Icon.Close}" />
                    </Button>
                </Grid>
                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Brush.Window}" Margin="0,24,0,0" />
                <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="36,16,24,24">
                    <TextBlock Classes="body-sm secondary" Text="{Binding SendReason}" TextWrapping="Wrap">
                        <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="ShowsChangeFields" />
                                <Binding Path="SendReason" Converter="{x:Static ObjectConverters.IsNotNull}" />
                            </MultiBinding>
                        </TextBlock.IsVisible>
                    </TextBlock>
                    <WrapPanel ItemSpacing="8" LineSpacing="8" HorizontalAlignment="Right">
                        <Button Classes="text tall" Content="{Binding Localization.LibraryCancel}" Command="{Binding CloseCommand}" VerticalAlignment="Center" IsVisible="{Binding DoneText, Converter={x:Static ObjectConverters.IsNull}}" />
                        <Button Classes="cta" Command="{Binding SendChangeCommand}" IsVisible="{Binding ShowsChangeFields}">
                            <TextBlock Classes="action-lg" Text="{Binding Localization.ShareManageSend}" VerticalAlignment="Center" />
                        </Button>
                        <!-- the only control that sends a take-down, so it needs a click on the button that names the version. It stands disabled before a choice, so the next step is visible -->
                        <Button Classes="text tall danger" Content="{Binding TakeDownText}" Command="{Binding TakeDownCommand}" VerticalAlignment="Center" IsVisible="{Binding ShowsTakeDownButton}" />
                        <Button Classes="text tall" Content="{Binding Localization.ModalClose}" Command="{Binding CloseCommand}" VerticalAlignment="Center" IsVisible="{Binding DoneText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </WrapPanel>
                </StackPanel>
                <ScrollViewer>
                    <StackPanel Margin="36,32,24,16" Spacing="6">
                        <StackPanel Spacing="6" IsVisible="{Binding ShowsChangeFields}" IsEnabled="{Binding !IsRunning}">
                            <TextBlock Classes="body-md secondary" Text="{Binding Localization.ShareManageChangeHint}" TextWrapping="Wrap" />

                            <TextBlock Classes="heading-sm" Text="{Binding Localization.ListingName}" Margin="0,10,0,0" />
                            <TextBox Classes="field" Text="{Binding Name}" AutomationProperties.Name="{Binding Localization.ListingName}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>

                            <TextBlock Classes="heading-sm" Text="{Binding Localization.ShareOneSentence}" Margin="0,10,0,0" />
                            <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ShareOneSentenceHint}" TextWrapping="Wrap" />
                            <TextBox Classes="field" Text="{Binding Abstract}" TextWrapping="Wrap" AutomationProperties.Name="{Binding Localization.ShareOneSentence}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <Grid ColumnDefinitions="*,8,Auto">
                                <TextBlock Classes="body-sm danger" Text="{Binding SentenceError}" TextWrapping="Wrap" IsVisible="{Binding SentenceError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock Grid.Column="2" Classes="body-sm secondary" Text="{Binding SentenceCount}" />
                            </Grid>

                            <TextBlock Classes="heading-sm" Text="{Binding Localization.ListingLicense}" Margin="0,10,0,0" />
                            <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ShareLicenseHint}" TextWrapping="Wrap" />
                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding LicenseChoices}" SelectedItem="{Binding SelectedLicense}" PlaceholderText="{Binding Localization.ShareLicensePlaceholder}" AutomationProperties.Name="{Binding Localization.ListingLicense}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ShareLicenseChoice">
                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <StackPanel Spacing="6" IsVisible="{Binding IsOtherLicense}">
                                <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ListingLicenseHint}" TextWrapping="Wrap" />
                                <TextBox Classes="field" Text="{Binding License}" AutomationProperties.Name="{Binding Localization.ListingLicense}">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <TextBlock Classes="body-sm danger" Text="{Binding LicenseError}" TextWrapping="Wrap" IsVisible="{Binding LicenseError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>

                            <TextBlock Classes="heading-sm" Text="{Binding Localization.ListingDescription}" Margin="0,10,0,0" />
                            <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ShareDescriptionHint}" TextWrapping="Wrap" />
                            <TextBox Classes="field" Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxHeight="320" AutomationProperties.Name="{Binding Localization.ListingDescription}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>

                            <TextBlock Classes="heading-sm" Text="{Binding Localization.ListingTags}" Margin="0,10,0,0" />
                            <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ListingMoreTagsHint}" TextWrapping="Wrap" />
                            <TextBox Classes="field" Text="{Binding FreeTags}" AutomationProperties.Name="{Binding Localization.ListingTags}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <TextBlock Classes="body-sm danger" Text="{Binding TagsError}" TextWrapping="Wrap" IsVisible="{Binding TagsError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>

                        <StackPanel Spacing="8" IsVisible="{Binding ShowsTakeDown}">
                            <TextBlock Classes="body-md" Text="{Binding Localization.ShareTakeDownNoVersion}" TextWrapping="Wrap" IsVisible="{Binding HasNoVersion}" />
                            <StackPanel Spacing="6" IsVisible="{Binding ShowsVersionChoice}">
                                <TextBlock Classes="body-md" Text="{Binding Localization.ShareTakeDownChoose}" TextWrapping="Wrap" />
                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" PlaceholderText="{Binding Localization.ShareTakeDownPlaceholder}" AutomationProperties.Name="{Binding Localization.ShareTakeDownChoose}" />
                            </StackPanel>
                            <Grid ColumnDefinitions="Auto,8,*" IsVisible="{Binding TakeDownWarning, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <!-- a caution before the click, so it is not drawn like a failure, which is red -->
                                <Path Classes="icon size-16" Data="{StaticResource Icon.Warning}" Stroke="{StaticResource Brush.Untested}" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="2" Classes="body-md" Text="{Binding TakeDownWarning}" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>

                        <Grid ColumnDefinitions="Auto,8,*" IsVisible="{Binding DoneText, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Path Classes="icon size-16" Data="{StaticResource Icon.CheckCircle}" Stroke="{StaticResource Brush.Positive}" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="2" Classes="body-md" Text="{Binding DoneText}" TextWrapping="Wrap" />
                        </Grid>
                        <Button Classes="link" Margin="-8,0,0,0" HorizontalAlignment="Left" Command="{Binding OpenPullRequestCommand}" ToolTip.Tip="{Binding PullRequest}" IsVisible="{Binding PullRequest, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Classes="action-md" Text="{Binding Localization.ShareShowRequest}" />
                        </Button>

                        <!-- while a request is out, Close stays off -->
                        <Grid ColumnDefinitions="Auto,8,*" Margin="0,8,0,0" IsVisible="{Binding IsRunning}">
                            <ProgressBar Width="38" MinWidth="0" Height="6" VerticalAlignment="Center" IsIndeterminate="True" Foreground="{StaticResource Brush.Accent}" />
                            <TextBlock Grid.Column="2" Classes="body-sm secondary" Text="{Binding ProgressText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Spacing="8" Margin="0,8,0,0" IsVisible="{Binding UserCode, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Classes="body-sm" Text="{Binding CodeText}" TextWrapping="Wrap" />
                            <SelectableTextBlock Text="{Binding UserCode}" FontFamily="{StaticResource Font.Mono}" FontSize="36" HorizontalAlignment="Left" />
                            <TextBlock Classes="body-sm secondary" Text="{Binding CodeWarningText}" TextWrapping="Wrap" />
                            <WrapPanel ItemSpacing="8" LineSpacing="4" Margin="-8,0,0,0" IsVisible="{Binding HasCodePage}">
                                <Button Classes="link" Command="{Binding OpenCodePageCommand}">
                                    <TextBlock Classes="action-md" Text="{Binding Localization.ShareOpenPageAgain}" />
                                </Button>
                                <Button Classes="link" Command="{Binding CopyCodeCommand}">
                                    <TextBlock Classes="action-md" Text="{Binding Localization.ShareCopyCode}" />
                                </Button>
                            </WrapPanel>
                            <Button Classes="link" Margin="-8,0,0,0" Command="{Binding CopyCodeAndOpenCommand}" HorizontalAlignment="Left" IsVisible="{Binding !HasCodePage}">
                                <TextBlock Classes="action-md" Text="{Binding Localization.ListingShareHostCopyCode}" />
                            </Button>
                        </StackPanel>

                        <Grid ColumnDefinitions="Auto,8,*" Margin="0,8,0,0" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Path Classes="icon size-16" Data="{StaticResource Icon.XCircle}" Stroke="{StaticResource Brush.Danger}" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="2" Classes="body-md danger" Text="{Binding Error}" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Classes="body-sm secondary" Text="{Binding ErrorDetail}" TextWrapping="Wrap" IsVisible="{Binding ErrorDetail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <WrapPanel ItemSpacing="8" LineSpacing="0" Margin="-8,8,0,0">
                            <Button Classes="link" Command="{Binding SignOutCommand}" IsVisible="{Binding SignOutText, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Classes="action-md" Text="{Binding SignOutText}" />
                            </Button>
                            <Button Classes="link" Command="{Binding OpenManageLinkCommand}" ToolTip.Tip="{Binding ManageLink}" AutomationProperties.ControlTypeOverride="Hyperlink">
                                <TextBlock Classes="action-md" Text="{Binding ManageLinkText}" />
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Panel>
</UserControl>
