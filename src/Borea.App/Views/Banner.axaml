<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="using:Borea.App.Views">
    <!-- The action text and the close icon take their brushes from the banner, so no class style may set them: a style outranks a template binding. -->
    <ControlTheme x:Key="{x:Type views:Banner}" TargetType="views:Banner">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHeader}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.SurfaceHeader}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="TitleForeground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="ActionForeground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="DismissForeground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Spacing="8">
                            <TextBlock Name="PART_Title" Classes="heading-sm" Text="{TemplateBinding Title}" Foreground="{TemplateBinding TitleForeground}" TextWrapping="Wrap" IsVisible="{TemplateBinding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Name="PART_Message" Classes="body-md" Text="{TemplateBinding Message}" Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap" IsVisible="{TemplateBinding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                        <Button Name="PART_Action" Grid.Column="1" Classes="plain" Height="20" Margin="24,0,0,0" VerticalAlignment="Top" Command="{TemplateBinding ActionCommand}" CommandParameter="{TemplateBinding ActionCommandParameter}" IsVisible="{TemplateBinding ActionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Name="PART_ActionText" FontSize="14" FontWeight="SemiBold" Text="{TemplateBinding ActionText}" Foreground="{TemplateBinding ActionForeground}" VerticalAlignment="Center" />
                        </Button>
                        <Button Name="PART_Dismiss" Grid.Column="2" Classes="plain" Width="16" Height="16" Margin="16,2,0,0" VerticalAlignment="Top" Command="{TemplateBinding DismissCommand}" ToolTip.Tip="{TemplateBinding DismissText}" AutomationProperties.Name="{TemplateBinding DismissText}" IsVisible="{TemplateBinding DismissCommand, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Path Name="PART_DismissIcon" Width="24" Height="24" Margin="-4" Stretch="None" Fill="Transparent" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" RenderTransformOrigin="50%,50%" RenderTransform="scale(0.6667)" Data="{DynamicResource Icon.Close}" Stroke="{TemplateBinding DismissForeground}" />
                        </Button>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Button:pointerover">
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="^:outline">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        </Style>
        <Style Selector="^:accent">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
            <Setter Property="TitleForeground" Value="{DynamicResource Brush.OnAccent}" />
            <Setter Property="ActionForeground" Value="{DynamicResource Brush.OnAccent}" />
            <Setter Property="DismissForeground" Value="{DynamicResource Brush.OnAccent}" />
        </Style>
        <Style Selector="^:error">
            <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
            <Setter Property="TitleForeground" Value="{DynamicResource Brush.Danger}" />
            <Setter Property="ActionForeground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="DismissForeground" Value="{DynamicResource Brush.Text}" />
        </Style>
        <Style Selector="^:success">
            <Setter Property="Background" Value="{DynamicResource Brush.PositiveSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Positive}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Positive}" />
            <Setter Property="TitleForeground" Value="{DynamicResource Brush.Positive}" />
            <Setter Property="ActionForeground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="DismissForeground" Value="{DynamicResource Brush.Text}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
