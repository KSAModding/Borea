<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Borea.App.ViewModels"
             xmlns:views="using:Borea.App.Views"
             x:Class="Borea.App.Views.ToastHost"
             x:DataType="vm:MainViewModel">
    <Panel Width="360">
        <TextBlock Height="0" Text="{Binding Toasts.Announcement}" TextWrapping="Wrap" Opacity="0" IsHitTestVisible="False" AutomationProperties.LiveSetting="Polite" />
        <ItemsControl ItemsSource="{Binding Toasts.Items}" VerticalAlignment="Bottom">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ToastItem">
                    <views:ToastView />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Panel>
</UserControl>
