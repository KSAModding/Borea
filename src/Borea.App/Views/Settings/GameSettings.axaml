<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Borea.App.ViewModels"
             xmlns:core="using:Borea.Core.Game"
             x:Class="Borea.App.Views.Settings.GameSettings"
             x:DataType="vm:MainViewModel">
    <!-- Game: where KSA is, and the installed mod loader versions -->
    <ScrollViewer>
        <StackPanel Margin="32,32,44,24" Spacing="6" IsEnabled="{Binding !IsSetupBusy}">
            <TextBlock Classes="heading-md" Text="{Binding Localization.SetupGameDirectory}" />
            <TextBlock Classes="body-sm secondary" Text="{Binding Localization.SetupGameDirectoryHint}" />
            <Grid ColumnDefinitions="*,8,Auto,8,Auto" Margin="0,6,0,0">
                <TextBox Classes="field" Text="{Binding GameDirectoryInput}" AutomationProperties.Name="{Binding Localization.SetupGameDirectory}" />
                <Button Grid.Column="2" Classes="text" Content="{Binding Localization.SetupBrowse}" Click="BrowseGameDirectory" />
                <Panel Grid.Column="4">
                    <Button Classes="text primary" Content="{Binding Localization.SetupSave}" Command="{Binding SaveGameDirectoryCommand}" IsVisible="{Binding !IsGameDirectorySuggested}" />
                    <Button Classes="text primary" Content="{Binding Localization.SetupUseThisFolder}" Command="{Binding SaveGameDirectoryCommand}" IsVisible="{Binding IsGameDirectorySuggested}" />
                </Panel>
            </Grid>
            <TextBlock Classes="body-sm secondary" Text="{Binding Localization.SetupFoundGames}" TextWrapping="Wrap" Margin="0,6,0,0" IsVisible="{Binding HasSeveralDetectedGames}" />
            <ListBox ItemsSource="{Binding DetectedGames}" SelectedItem="{Binding SelectedDetectedGame}" AutomationProperties.Name="{Binding Localization.SetupFoundGames}" IsVisible="{Binding HasSeveralDetectedGames}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="core:DetectedGame">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="label-md">
                                <Run Text="KSA" /><Run Text=" " /><Run Text="{Binding Version.RawVersion}" />
                            </TextBlock>
                            <TextBlock Classes="body-sm secondary" Text="{Binding Directory}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Classes="body-sm secondary" Text="{Binding Localization.SetupFoundGame}" TextWrapping="Wrap" Margin="0,6,0,0" IsVisible="{Binding IsGameDirectorySuggested}" />
            <Border Classes="chip" HorizontalAlignment="Left" Margin="0,6,0,0">
                <Panel>
                    <TextBlock IsVisible="{Binding InstalledVersionText, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Run Text="KSA" /><Run Text=" " /><Run Text="{Binding InstalledVersionText}" />
                    </TextBlock>
                    <TextBlock IsVisible="{Binding InstalledVersionText, Converter={x:Static ObjectConverters.IsNull}}" Text="{Binding Localization.HomeNoGameVersion}" />
                </Panel>
            </Border>

            <Border Height="1" Background="{StaticResource Brush.BorderStrong}" Margin="0,18,0,12" />

            <TextBlock Classes="heading-md" Text="{Binding Localization.SettingsLoadersTitle}" />
            <TextBlock Classes="body-sm secondary" Text="{Binding Localization.SettingsLoadersHint}" TextWrapping="Wrap" />
            <TextBlock Classes="body-md muted" Text="{Binding Localization.InstanceLoaderNotInstalled}" Margin="0,12,0,0" IsVisible="{Binding HasNoLoaderVersions}" />
            <ItemsControl ItemsSource="{Binding LoaderVersionItems}" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LoaderVersionItem">
                        <Grid ColumnDefinitions="*,16,Auto" Margin="0,0,0,10">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <WrapPanel ItemSpacing="8" LineSpacing="4">
                                    <TextBlock Classes="heading-sm" Text="{Binding Title}" VerticalAlignment="Center" />
                                    <Border Classes="chip" Classes.compatible="{Binding IsCompatible}" Classes.incompatible="{Binding IsIncompatible}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse />
                                            <TextBlock Text="{Binding CompatibilityText}" />
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                                <TextBlock Classes="body-sm secondary" Text="{Binding UsedByText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding UsedByToolTip}" IsVisible="{Binding UsedByText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock Classes="body-sm muted" Text="{Binding Version.DirectoryPath}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Version.DirectoryPath}" IsVisible="{Binding IsAdopted}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Classes="body-sm danger" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.SettingsLoaderRemoveConfirm}" VerticalAlignment="Center" IsVisible="{Binding IsConfirmingRemove}" />
                                <Button Classes="text danger" Content="{Binding RemoveText}" Command="{Binding RemoveCommand}" IsEnabled="{Binding CanRemove}" ToolTip.Tip="{Binding RemoveToolTip}" ToolTip.ShowOnDisabled="True" AutomationProperties.HelpText="{Binding RemoveToolTip}" />
                                <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelRemoveCommand}" IsVisible="{Binding IsConfirmingRemove}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="heading-sm" Text="{Binding Localization.SettingsLoaderInstallAnother}" Margin="0,12,0,0" />
            <WrapPanel ItemSpacing="8" LineSpacing="8" Margin="0,6,0,0">
                <ComboBox ItemsSource="{Binding Loaders}" SelectedItem="{Binding SelectedLoader}" AutomationProperties.Name="{Binding Localization.SetupLoader}" Width="200" IsVisible="{Binding ShowLoaderChoice}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:DiscoverItem">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox ItemsSource="{Binding LoaderInstallReleases}" SelectedItem="{Binding SelectedLoaderInstallRelease}" MinWidth="240" MaxDropDownHeight="300" AutomationProperties.Name="{Binding Localization.SettingsLoaderInstallAnother}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LoaderReleaseChoice">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding VersionText}" VerticalAlignment="Center" />
                                <Border Classes="chip" VerticalAlignment="Center" IsVisible="{Binding HasStatus}">
                                    <TextBlock Text="{Binding StatusText}" />
                                </Border>
                                <Border Classes="chip" Classes.compatible="{Binding IsCompatible}" Classes.incompatible="{Binding IsIncompatible}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse />
                                        <TextBlock Text="{Binding CompatibilityText}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Classes="text primary" Content="{Binding Localization.SetupInstallLoader}" Command="{Binding InstallLoaderCommand}" IsEnabled="{Binding CanInstallLoader}" VerticalAlignment="Center" />
            </WrapPanel>
            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0" IsVisible="{Binding IsSetupBusy}">
                <ProgressBar Height="6" VerticalAlignment="Center" Value="{Binding SetupProgress}" Maximum="100" Foreground="{StaticResource Brush.Accent}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" IsVisible="{Binding LoaderInstallRun, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Button Classes="text" Content="{Binding LoaderInstallRun.PauseText}" Command="{Binding LoaderInstallRun.TogglePauseCommand}" />
                    <Button Classes="text" Content="{Binding LoaderInstallRun.StopText}" Command="{Binding LoaderInstallRun.StopCommand}" />
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0" IsVisible="{Binding SetupProgressStatus, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Classes="body-sm secondary" Text="{Binding SetupProgressStatus}" VerticalAlignment="Center" />
                <TextBlock Classes="label-md" Text="{Binding SetupProgressDetail}" VerticalAlignment="Center" IsVisible="{Binding SetupProgressDetail, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>

            <TextBlock Classes="heading-sm" Text="{Binding Localization.SetupLoaderDirectory}" Margin="0,16,0,0" />
            <TextBlock Classes="body-sm secondary" Text="{Binding Localization.SetupLoaderDirectoryHint}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,8,Auto,8,Auto" Margin="0,6,0,0">
                <TextBox Classes="field" Text="{Binding LoaderDirectoryInput}" AutomationProperties.Name="{Binding Localization.SetupLoaderDirectory}" />
                <Button Grid.Column="2" Classes="text" Content="{Binding Localization.SetupBrowse}" Click="BrowseLoaderDirectory" />
                <Button Grid.Column="4" Classes="text" Content="{Binding Localization.SetupUseExisting}" Command="{Binding AdoptLoaderCommand}" />
            </Grid>
            <TextBlock Classes="body-sm secondary" Text="{Binding Localization.SetupFoundLoader}" TextWrapping="Wrap" Margin="0,6,0,0" IsVisible="{Binding IsLoaderDirectorySuggested}" />
            <TextBlock Classes="body-md secondary" Text="{Binding SetupMessage}" TextWrapping="Wrap" Margin="0,12,0,0" IsVisible="{Binding SetupMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="body-md danger" Text="{Binding SetupError}" TextWrapping="Wrap" Margin="0,12,0,0" IsVisible="{Binding SetupError, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <Border Height="1" Background="{StaticResource Brush.BorderStrong}" Margin="0,24,0,16" />

            <TextBlock Classes="heading-md" Text="{Binding Localization.SettingsPresetsTitle}" />
            <TextBlock Classes="body-sm secondary" Text="{Binding Localization.SettingsPresetsHint}" TextWrapping="Wrap" />
            <TextBlock Classes="body-md muted" Text="{Binding Localization.SettingsPresetsEmpty}" Margin="0,12,0,0" IsVisible="{Binding !SavedGameSettingsPresets.Count}" />
            <ItemsControl ItemsSource="{Binding SavedGameSettingsPresets}" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameSettingsPresetItem">
                        <Grid ColumnDefinitions="*,16,Auto,16,Auto" Margin="0,0,0,8">
                            <TextBlock Classes="heading-sm" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="label-md" Text="{Binding VersionText}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Classes="body-sm danger" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.SettingsPresetsDeleteConfirm}" VerticalAlignment="Center" IsVisible="{Binding IsConfirmingDelete}" />
                                <Button Classes="text danger" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryDelete}" Command="{Binding DeleteCommand}" />
                                <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelDeleteCommand}" IsVisible="{Binding IsConfirmingDelete}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="body-md danger" Text="{Binding GameSettingsPresetError}" TextWrapping="Wrap" Margin="0,8,0,0" IsVisible="{Binding GameSettingsPresetError, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
