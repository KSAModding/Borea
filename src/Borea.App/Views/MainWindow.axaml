<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:formatting="using:Borea.App.Formatting"
        xmlns:vm="using:Borea.App.ViewModels"
        xmlns:views="using:Borea.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="832"
        x:Class="Borea.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        CanResize="True"
        Width="1280" Height="832"
        MinWidth="860" MinHeight="480"
        Title="Borea">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <!-- c/instance-row: used by the library list and by the Current Install card on Home.
             Rename and delete happen inline; the row swaps its title or its actions for the edit. -->
        <DataTemplate x:Key="InstanceRow" x:DataType="vm:InstanceItem">
            <Border Classes="card" Padding="12">
                <Grid ColumnDefinitions="70,16,*" RowDefinitions="Auto,*,Auto" Height="70">
                    <Button Grid.RowSpan="3" Classes="plain" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}">
                        <Border Classes="thumbnail" Width="70" Height="70">
                            <Path Classes="icon size-32" Data="{StaticResource Icon.Box}" />
                        </Border>
                    </Button>

                    <!-- Title row: name or the rename field; switch + more, or the edit's buttons -->
                    <Grid Grid.Column="2" Grid.Row="0" ColumnDefinitions="*,16,Auto">
                        <Panel VerticalAlignment="Center">
                            <Button Classes="plain" Command="{Binding OpenCommand}" IsVisible="{Binding !IsRenaming}" HorizontalAlignment="Left">
                                <TextBlock Classes="heading-md" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <TextBox Classes="field" Text="{Binding EditName}" IsVisible="{Binding IsRenaming}" Padding="8,2" MaxWidth="360" HorizontalAlignment="Left" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryRename}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding CommitRenameCommand}" />
                                    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                        </Panel>
                        <Panel Grid.Column="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsRenaming}">
                                <Button Classes="text primary" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibrarySave}" Command="{Binding CommitRenameCommand}" />
                                <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsConfirmingDelete}">
                                <Button Classes="text danger" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryDelete}" Command="{Binding ConfirmDeleteCommand}" />
                                <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <StackPanel.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="!IsRenaming" />
                                        <Binding Path="!IsConfirmingDelete" />
                                    </MultiBinding>
                                </StackPanel.IsVisible>
                                <ToggleSwitch Classes="switch" IsChecked="{Binding IsActive, Mode=OneWay}" Command="{Binding ActivateCommand}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryActivate}" VerticalAlignment="Center" />
                                <Button Classes="icon" AutomationProperties.Name="{Binding Name}">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryRename}" Command="{Binding BeginRenameCommand}" />
                                            <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryDelete}" Command="{Binding BeginDeleteCommand}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                    <Path Classes="icon-filled size-18" Data="{StaticResource Icon.More}" />
                                </Button>
                            </StackPanel>
                        </Panel>
                    </Grid>

                    <!-- Bottom row: chips, and the meta on the right -->
                    <Grid Grid.Column="2" Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Border Classes="chip positive" IsVisible="{Binding SourceText, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Text="{Binding SourceText}" />
                            </Border>
                            <TextBlock Classes="body-md danger" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryDeleteConfirm}" VerticalAlignment="Center" IsVisible="{Binding IsConfirmingDelete}" />
                        </StackPanel>
                        <!-- c/meta: CirclesThree + the number of installed mods -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Path Classes="icon size-16" Data="{StaticResource Icon.CirclesThree}" />
                            <TextBlock Classes="label-md" Text="{Binding ModCount}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- one row of c/table-versions on the instance page -->
        <DataTemplate x:Key="ContentRow" x:DataType="vm:ContentItem">
            <Border BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="0,1,0,0" Padding="16,8">
                <Grid ColumnDefinitions="48,16,*,24,Auto">
                    <Border Classes="thumbnail" Width="48" Height="48">
                        <Path Classes="icon" Data="{StaticResource Icon.PuzzlePiece}" />
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Classes="heading-sm" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="body-sm secondary" Text="{Binding AuthorsText}" IsVisible="{Binding AuthorsText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Classes="body-sm danger" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentRemoveConfirm}" IsVisible="{Binding IsConfirmingRemove}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Path Classes="icon size-16" Data="{StaticResource Icon.GitCommit}" />
                            <TextBlock Classes="label-md" Text="{Binding Version}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Path Classes="icon" Data="{StaticResource Icon.Lock}" IsVisible="{Binding IsDependency}" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.InstanceGroupDependencies}" />
                        <Panel>
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsConfirmingRemove}">
                                <Button Classes="text danger" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentRemove}" Command="{Binding ConfirmRemoveCommand}" />
                                <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelRemoveCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding !IsConfirmingRemove}">
                                <ToggleSwitch Classes="switch" IsChecked="{Binding IsEnabled}" Command="{Binding ToggleEnabledCommand}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
                                <Button Classes="icon" AutomationProperties.Name="{Binding Name}">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentRemove}" Command="{Binding BeginRemoveCommand}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                    <Path Classes="icon-filled size-18" Data="{StaticResource Icon.More}" />
                                </Button>
                            </StackPanel>
                        </Panel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- c/content-row on Discover -->
        <DataTemplate x:Key="DiscoverRow" x:DataType="vm:DiscoverItem">
            <Border Classes="card" Padding="12">
                <Grid ColumnDefinitions="100,16,*" Height="100">
                    <Button Classes="plain" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}">
                        <Border Classes="thumbnail" Width="100" Height="100">
                            <Path Classes="icon size-32" Data="{StaticResource Icon.PuzzlePiece}" />
                        </Border>
                    </Button>
                    <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">
                        <Grid ColumnDefinitions="*,16,Auto">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="plain" Command="{Binding OpenCommand}">
                                        <TextBlock Classes="heading-md" Text="{Binding Name}" />
                                    </Button>
                                    <TextBlock Classes="body-sm secondary" Text="{Binding AuthorsText}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Classes="body-md secondary" Text="{Binding Abstract}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" LineHeight="18" />
                            </StackPanel>
                            <!-- c/button-icon-add -->
                            <Panel Grid.Column="2" VerticalAlignment="Top">
                                <Button Classes="add" Command="{Binding InstallCommand}" IsVisible="{Binding CanInstall}" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.DiscoverAdd}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.DiscoverAdd}">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Plus}" Stroke="{StaticResource Brush.Text}" />
                                </Button>
                                <ProgressBar Width="38" Height="6" VerticalAlignment="Center" IsVisible="{Binding IsInstalling}" Value="{Binding Progress}" Maximum="100" Foreground="{StaticResource Brush.Accent}" />
                                <Border Classes="chip positive" IsVisible="{Binding IsInstalled}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.DiscoverInstalled}" />
                                </Border>
                            </Panel>
                        </Grid>
                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,4,0">
                            <ItemsControl ItemsSource="{Binding Tags}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Classes="chip">
                                            <TextBlock Text="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <TextBlock Classes="body-sm danger" Text="{Binding InstallError}" IsVisible="{Binding InstallError, Converter={x:Static ObjectConverters.IsNotNull}}" MaxWidth="320" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="label-md" Text="{Binding License}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Panel>
    <Grid ColumnDefinitions="80,*">

        <!-- c/nav-bar -->
        <Border Grid.Column="0" Background="{StaticResource Brush.Rail}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,24">
                <StackPanel DockPanel.Dock="Bottom" Spacing="8">
                    <Button Classes="nav" Classes.active="{Binding CurrentWindowTasks}" Command="{Binding SetMainWindowTasks}" ToolTip.Tip="{Binding Localization.NavigationTasks}" AutomationProperties.Name="{Binding Localization.NavigationTasks}">
                        <Path Classes="icon size-32" Data="{StaticResource Icon.Terminal}" />
                    </Button>
                    <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,3" />
                    <Button Classes="nav" Classes.active="{Binding IsSettingsOpen}" Command="{Binding SetMainWindowSettings}" ToolTip.Tip="{Binding Localization.NavigationSettings}" AutomationProperties.Name="{Binding Localization.NavigationSettings}">
                        <Path Classes="icon size-32" Data="{StaticResource Icon.Settings}" />
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Spacing="16">
                    <Button Classes="nav" Classes.active="{Binding CurrentWindowHome}" Command="{Binding SetMainWindowHome}" ToolTip.Tip="{Binding Localization.NavigationHome}" AutomationProperties.Name="{Binding Localization.NavigationHome}">
                        <Path Classes="icon size-32" Data="{StaticResource Icon.Home}" />
                    </Button>
                    <Button Classes="nav" Classes.active="{Binding IsDiscoverSection}" Command="{Binding SetMainWindowDiscover}" ToolTip.Tip="{Binding Localization.NavigationDiscover}" AutomationProperties.Name="{Binding Localization.NavigationDiscover}">
                        <Path Classes="icon size-32" Data="{StaticResource Icon.Compass}" />
                    </Button>
                    <!-- the library stays lit while an instance page is open -->
                    <Button Classes="nav" Classes.active="{Binding IsLibrarySection}" Command="{Binding SetMainWindowLibrary}" ToolTip.Tip="{Binding Localization.NavigationLibrary}" AutomationProperties.Name="{Binding Localization.NavigationLibrary}">
                        <Path Classes="icon size-32" Data="{StaticResource Icon.Library}" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Home -->
        <ScrollViewer Grid.Column="1" IsVisible="{Binding CurrentWindowHome}">
            <StackPanel MaxWidth="700" Margin="32,42,32,32">
                <!-- c/breadcrumb -->
                <StackPanel Orientation="Horizontal" Spacing="4" Height="24">
                    <Path Classes="icon" Data="{StaticResource Icon.Home}" />
                    <TextBlock Classes="label-lg" Text="{Binding Localization.PageHomeHeading}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Current install: black container with the header strip, holding the active instance row -->
                <Border Background="{StaticResource Brush.SurfaceHeader}" CornerRadius="16" Margin="0,23,0,0">
                    <StackPanel>
                        <Grid ColumnDefinitions="Auto,8,*,Auto" Height="44" Margin="12,0">
                            <Path Grid.Column="0" Classes="icon-filled size-16" Fill="{StaticResource Brush.Positive}" Data="{StaticResource Icon.Paw}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="label-md positive" Text="{Binding Localization.HomeCurrentInstall}" VerticalAlignment="Center" />
                            <Border Grid.Column="3" Classes="chip" VerticalAlignment="Center">
                                <Panel>
                                    <TextBlock IsVisible="{Binding InstalledVersionText, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <Run Text="KSA" /><Run Text=" " /><Run Text="{Binding InstalledVersionText}" />
                                    </TextBlock>
                                    <TextBlock IsVisible="{Binding InstalledVersionText, Converter={x:Static ObjectConverters.IsNull}}" Text="{Binding Localization.HomeNoGameVersion}" />
                                </Panel>
                            </Border>
                        </Grid>
                        <ContentControl Content="{Binding ActiveInstance}" ContentTemplate="{StaticResource InstanceRow}" IsVisible="{Binding HasActiveInstance}" />
                        <Border Classes="card" Padding="12" IsVisible="{Binding !HasActiveInstance}">
                            <Grid ColumnDefinitions="70,16,*" Height="70">
                                <Border Classes="thumbnail">
                                    <Path Classes="icon size-32" Data="{StaticResource Icon.Box}" />
                                </Border>
                                <TextBlock Grid.Column="2" Classes="heading-md muted" Text="{Binding Localization.HomeNoInstance}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Trending -->
                <Grid ColumnDefinitions="*,Auto" Margin="3,44,3,0">
                    <TextBlock Classes="heading-sm heading" Text="{Binding Localization.HomeTrending}" />
                    <Button Grid.Column="1" Classes="link" Padding="0" Height="18" Command="{Binding SetMainWindowDiscover}">
                        <TextBlock Classes="action-md" Text="{Binding Localization.HomeDiscoverMods}" />
                    </Button>
                </Grid>

                <ItemsControl ItemsSource="{Binding TrendingItems}" Margin="0,16,-5,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TrendingItem">
                            <!-- tile: thumbnail with the text over its bottom. The index has no image field yet (#8), so the gradient stands in. -->
                            <Border Classes="card" Margin="0,0,5,5" Height="171" Background="{StaticResource Brush.Thumbnail}" Padding="16">
                                <StackPanel VerticalAlignment="Bottom" Spacing="10">
                                    <TextBlock Classes="heading-sm" Text="{Binding Name}" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="label-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentTypeMod}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <Path Classes="icon size-16" Data="{StaticResource Icon.Download}" />
                                            <TextBlock Classes="label-md" Text="{Binding Downloads}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Discover: list column plus the filter panel on the right -->
        <Grid Grid.Column="1" IsVisible="{Binding CurrentWindowDiscover}" ColumnDefinitions="*,348">
            <ScrollViewer Grid.ColumnSpan="2">
                <StackPanel MaxWidth="764" Margin="32,42,348,32">
                    <StackPanel Orientation="Horizontal" Spacing="4" Height="24">
                        <Path Classes="icon" Data="{StaticResource Icon.Compass}" />
                        <TextBlock Classes="label-lg" Text="{Binding Localization.PageDiscoverHeading}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- c/inner-nav-bar -->
                    <Border Background="{StaticResource Brush.SurfaceHeader}" CornerRadius="100" Padding="6" Margin="0,16,0,0" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Button Classes="tab" Classes.active="{Binding IsModsTab}" Content="{Binding Localization.DiscoverTabMods}" Command="{Binding ShowDiscoverModsCommand}" />
                            <Button Classes="tab" Classes.active="{Binding IsLoadersTab}" Content="{Binding Localization.DiscoverTabLoaders}" Command="{Binding ShowDiscoverLoadersCommand}" />
                            <Button Classes="tab" Content="{Binding Localization.DiscoverTabModpacks}" IsEnabled="False" />
                            <Button Classes="tab" Content="{Binding Localization.DiscoverTabVehicles}" IsEnabled="False" />
                            <Button Classes="tab" Content="{Binding Localization.DiscoverTabSaves}" IsEnabled="False" />
                        </StackPanel>
                    </Border>

                    <!-- active filters -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,24,8,0" IsVisible="{Binding HasDiscoverFilters}">
                        <Button Classes="chip-button" Command="{Binding ClearDiscoverFiltersCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Path Classes="icon size-16" Data="{StaticResource Icon.Close}" />
                                <TextBlock Classes="label-sm" Text="{Binding Localization.DiscoverClearAll}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="chip-button" Command="{Binding SelectOsCommand}" IsVisible="{Binding SelectedOs, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Path Classes="icon size-16" Data="{StaticResource Icon.Close}" />
                                <TextBlock Classes="label-sm" Text="{Binding SelectedOs}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="chip-button" Command="{Binding SelectLicenseCommand}" IsVisible="{Binding SelectedLicense, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Path Classes="icon size-16" Data="{StaticResource Icon.Close}" />
                                <TextBlock Classes="label-sm" Text="{Binding SelectedLicense}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock Classes="body-md muted" Text="{Binding Localization.DiscoverLoading}" Margin="8,24,0,0" IsVisible="{Binding IsDiscoverLoading}" />
                    <TextBlock Classes="body-md danger" Text="{Binding DiscoverError}" TextWrapping="Wrap" Margin="8,24,0,0" IsVisible="{Binding DiscoverError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Classes="body-md muted" Text="{Binding Localization.DiscoverNoInstance}" Margin="8,24,0,0" IsVisible="{Binding !HasActiveInstance}" />
                    <TextBlock Classes="body-md muted" Text="{Binding Localization.DiscoverEmpty}" Margin="8,24,0,0">
                        <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!HasDiscoverItems" />
                                <Binding Path="!IsDiscoverLoading" />
                                <Binding Path="DiscoverError" Converter="{x:Static ObjectConverters.IsNull}" />
                            </MultiBinding>
                        </TextBlock.IsVisible>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding DiscoverItems}" ItemTemplate="{StaticResource DiscoverRow}" Margin="0,24,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- filter-panel -->
            <Border Grid.Column="1" Classes="card" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="24" Margin="0,24,24,24" Padding="24" VerticalAlignment="Top">
                <StackPanel Spacing="16">
                    <TextBox Classes="field search" Text="{Binding SearchText}" PlaceholderText="{Binding Localization.DiscoverSearchPlaceholder}" AutomationProperties.Name="{Binding Localization.DiscoverSearchPlaceholder}">
                        <TextBox.InnerLeftContent>
                            <Path Classes="icon size-16" Data="{StaticResource Icon.Search}" Margin="10,0,0,0" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,16,Auto">
                            <TextBlock Classes="heading-sm" Text="{Binding Localization.DiscoverHideInstalled}" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="2" Classes="switch" IsChecked="{Binding HideInstalled}" AutomationProperties.Name="{Binding Localization.DiscoverHideInstalled}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,16,Auto" IsEnabled="False" Opacity="0.5">
                            <TextBlock Classes="heading-sm" Text="{Binding Localization.DiscoverHideIncompatible}" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="2" Classes="switch" AutomationProperties.Name="{Binding Localization.DiscoverHideIncompatible}" />
                        </Grid>
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource Brush.BorderStrong}" IsVisible="{Binding !!OsOptions.Count}" />
                    <StackPanel Spacing="10" IsVisible="{Binding !!OsOptions.Count}">
                        <TextBlock Classes="heading-md" Text="{Binding Localization.DiscoverOperatingSystem}" />
                        <ItemsControl ItemsSource="{Binding OsOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Classes="filter" Content="{Binding}" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectOsCommand}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource Brush.BorderStrong}" IsVisible="{Binding !!LicenseOptions.Count}" />
                    <StackPanel Spacing="10" IsVisible="{Binding !!LicenseOptions.Count}">
                        <TextBlock Classes="heading-md" Text="{Binding Localization.DiscoverLicense}" />
                        <ItemsControl ItemsSource="{Binding LicenseOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Classes="filter" Content="{Binding}" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectLicenseCommand}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Library -->
        <ScrollViewer Grid.Column="1" IsVisible="{Binding CurrentWindowLibrary}">
            <StackPanel MaxWidth="700" Margin="32,42,32,32">
                <!-- header: breadcrumb, c/link-cta, bottom border -->
                <Border BorderBrush="{StaticResource Brush.Surface}" BorderThickness="0,0,0,1" Padding="0,0,8,8">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="4" Height="24">
                            <Path Classes="icon" Data="{StaticResource Icon.Library}" />
                            <TextBlock Classes="label-lg" Text="{Binding Localization.PageLibraryHeading}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="link" Command="{Binding BeginCreateInstanceCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="icon size-16" Data="{StaticResource Icon.Plus}" Stroke="{StaticResource Brush.Accent}" VerticalAlignment="Center" />
                                <TextBlock Classes="action-md" Text="{Binding Localization.LibraryNewInstance}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <TextBlock Classes="body-md danger" Text="{Binding InstanceError}" TextWrapping="Wrap" Margin="0,16,0,0" IsVisible="{Binding InstanceError, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <TextBlock Classes="body-md muted" Text="{Binding Localization.LibraryEmpty}" Margin="8,24,0,0" IsVisible="{Binding !Instances.Count}" />

                <ItemsControl ItemsSource="{Binding Instances}" ItemTemplate="{StaticResource InstanceRow}" Margin="0,24,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Instance (library-instance) -->
        <ScrollViewer Grid.Column="1" IsVisible="{Binding CurrentWindowInstance}">
            <StackPanel MaxWidth="700" Margin="32,42,32,32">
                <!-- breadcrumb: Library / name -->
                <StackPanel Orientation="Horizontal" Spacing="4" Height="24">
                    <Path Classes="icon" Data="{StaticResource Icon.Library}" />
                    <Button Classes="plain" Command="{Binding SetMainWindowLibrary}">
                        <TextBlock Classes="label-lg" Text="{Binding Localization.PageLibraryHeading}" VerticalAlignment="Center" />
                    </Button>
                    <TextBlock Classes="label-lg" Text="/" VerticalAlignment="Center" />
                    <TextBlock Classes="label-lg" Text="{Binding SelectedInstance.Name}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- c/content-header -->
                <Grid ColumnDefinitions="70,24,*" Margin="0,42,0,0">
                    <Border Classes="thumbnail" Width="70" Height="70">
                        <Path Classes="icon size-32" Data="{StaticResource Icon.Box}" />
                    </Border>
                    <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto" Height="70">
                        <Grid ColumnDefinitions="*,24,Auto">
                            <TextBlock Classes="heading-lg" Text="{Binding SelectedInstance.Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <!-- c/button-cta -->
                                <Button Classes="cta" Command="{Binding PlayCommand}" IsEnabled="{Binding !IsLaunching}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon-filled size-16" Fill="{StaticResource Brush.SurfaceHeader}" Data="{StaticResource Icon.Play}" VerticalAlignment="Center" />
                                        <TextBlock Classes="action-lg" Text="{Binding Localization.InstancePlay}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="icon" AutomationProperties.Name="{Binding SelectedInstance.Name}">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuItem Header="{Binding Localization.LibraryRename}" Command="{Binding SelectedInstance.BeginRenameCommand}" />
                                            <MenuItem Header="{Binding Localization.LibraryDelete}" Command="{Binding SelectedInstance.BeginDeleteCommand}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                    <Path Classes="icon-filled size-18" Data="{StaticResource Icon.More}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="24">
                            <Border Classes="chip positive" IsVisible="{Binding SelectedInstance.SourceText, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Text="{Binding SelectedInstance.SourceText}" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Path Classes="icon size-16" Data="{StaticResource Icon.CirclesThree}" />
                                <TextBlock Classes="label-md" Text="{Binding SelectedInstance.ModCount}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- the rename / delete edits of the selected row, so they work from here too -->
                <ContentControl Content="{Binding SelectedInstance}" ContentTemplate="{StaticResource InstanceRow}" Margin="0,16,0,0">
                    <ContentControl.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                            <Binding Path="SelectedInstance.IsRenaming" />
                            <Binding Path="SelectedInstance.IsConfirmingDelete" />
                        </MultiBinding>
                    </ContentControl.IsVisible>
                </ContentControl>

                <TextBlock Classes="body-md secondary" Text="{Binding LaunchMessage}" TextWrapping="Wrap" Margin="0,16,0,0" IsVisible="{Binding LaunchMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Classes="body-md danger" Text="{Binding ContentError}" TextWrapping="Wrap" Margin="0,16,0,0" IsVisible="{Binding ContentError, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <!-- c/inner-nav-bar: only Content has data behind it -->
                <Border Background="{StaticResource Brush.SurfaceHeader}" CornerRadius="100" Padding="6" Margin="0,32,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Button Classes="tab active" Content="{Binding Localization.InstanceTabContent}" />
                        <Button Classes="tab" Content="{Binding Localization.InstanceTabManualInstalls}" IsEnabled="False" />
                        <Button Classes="tab" Content="{Binding Localization.InstanceTabGameData}" IsEnabled="False" />
                        <Button Classes="tab" Content="{Binding Localization.InstanceTabLog}" IsEnabled="False" />
                    </StackPanel>
                </Border>

                <TextBlock Classes="body-md muted" Text="{Binding Localization.InstanceEmptyContent}" Margin="8,32,0,0" IsVisible="{Binding !HasContent}" />

                <!-- c/table-versions per group -->
                <ItemsControl ItemsSource="{Binding ContentGroups}" Margin="0,32,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="16" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ContentGroup">
                            <Border BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="16" ClipToBounds="True" Padding="0,0,0,4">
                                <StackPanel>
                                    <Border Background="{StaticResource Brush.Surface}" Padding="16,11">
                                        <TextBlock Classes="body-md secondary" Text="{Binding Title}" />
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ContentRow}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Content (discover-content): one listing, with the detail panel on the right -->
        <Grid Grid.Column="1" IsVisible="{Binding CurrentWindowContent}" ColumnDefinitions="*,348">
            <ScrollViewer Grid.ColumnSpan="2">
                <StackPanel MaxWidth="764" Margin="32,42,348,32">
                    <StackPanel Orientation="Horizontal" Spacing="4" Height="24">
                        <Path Classes="icon" Data="{StaticResource Icon.Compass}" />
                        <Button Classes="plain" Command="{Binding SetMainWindowDiscover}">
                            <TextBlock Classes="label-lg" Text="{Binding Localization.PageDiscoverHeading}" VerticalAlignment="Center" />
                        </Button>
                        <TextBlock Classes="label-lg" Text="/" VerticalAlignment="Center" />
                        <TextBlock Classes="label-lg" Text="{Binding SelectedContent.TypeText}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- c/content-header -->
                    <Grid ColumnDefinitions="170,32,*" Margin="0,24,0,0">
                        <Border Classes="thumbnail" Width="170" Height="170">
                            <Path Classes="icon" Data="{StaticResource Icon.PuzzlePiece}" RenderTransform="scale(2.5)" StrokeThickness="0.8" />
                        </Border>
                        <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">
                            <Grid ColumnDefinitions="*,24,Auto">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="heading-lg" Text="{Binding SelectedContent.Name}" TextWrapping="Wrap" />
                                    <TextBlock Classes="body-md secondary" Text="{Binding SelectedContent.Abstract}" TextWrapping="Wrap" LineHeight="18" />
                                </StackPanel>
                                <Panel Grid.Column="2" VerticalAlignment="Top">
                                    <Button Classes="cta" Command="{Binding SelectedContent.InstallCommand}" IsVisible="{Binding SelectedContent.CanInstall}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Classes="icon size-16" Data="{StaticResource Icon.Plus}" Stroke="{StaticResource Brush.SurfaceHeader}" StrokeThickness="2" VerticalAlignment="Center" />
                                            <TextBlock Classes="action-lg" Text="{Binding Localization.ContentAdd}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <ProgressBar Width="96" Height="6" VerticalAlignment="Center" IsVisible="{Binding SelectedContent.IsInstalling}" Value="{Binding SelectedContent.Progress}" Maximum="100" Foreground="{StaticResource Brush.Accent}" />
                                    <Border Classes="chip positive" IsVisible="{Binding SelectedContent.IsInstalled}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Localization.DiscoverInstalled}" />
                                    </Border>
                                </Panel>
                            </Grid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="24" Margin="0,16,0,0">
                                <ItemsControl ItemsSource="{Binding SelectedContent.Tags}" VerticalAlignment="Center" IsVisible="{Binding HasContentTags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border Classes="chip">
                                                <TextBlock Text="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding LatestVersion, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Path Classes="icon size-16" Data="{StaticResource Icon.GitCommit}" />
                                        <TextBlock Classes="label-md" Text="{Binding LatestVersion.Version}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Path Classes="icon size-16" Data="{StaticResource Icon.Clock}" />
                                        <TextBlock Classes="label-md" Text="{Binding LatestVersion.PublishedText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0" IsVisible="{Binding IsLoaderContent}">
                        <TextBlock Classes="body-md secondary" Text="{Binding Localization.ContentLoaderHint}" VerticalAlignment="Center" />
                        <Button Classes="link" Command="{Binding SetMainWindowSettings}">
                            <TextBlock Classes="action-md" Text="{Binding Localization.NavigationSettings}" />
                        </Button>
                    </StackPanel>
                    <TextBlock Classes="body-md danger" Text="{Binding SelectedContent.InstallError}" TextWrapping="Wrap" Margin="0,16,0,0" IsVisible="{Binding SelectedContent.InstallError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Classes="body-md danger" Text="{Binding ContentDetailError}" TextWrapping="Wrap" Margin="0,16,0,0" IsVisible="{Binding ContentDetailError, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <!-- c/inner-nav-bar -->
                    <Border Background="{StaticResource Brush.SurfaceHeader}" CornerRadius="100" Padding="6" Margin="0,32,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Button Classes="tab" Classes.active="{Binding IsDescriptionTab}" Content="{Binding Localization.ContentTabDescription}" Command="{Binding ShowContentDescriptionCommand}" />
                            <Button Classes="tab" Classes.active="{Binding IsVersionsTab}" Content="{Binding Localization.ContentTabVersions}" Command="{Binding ShowContentVersionsCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- c/block-text: the CommonMark description -->
                    <Border Classes="card" Padding="36,32" Margin="0,16,0,0" IsVisible="{Binding IsDescriptionTab}">
                        <Panel>
                            <views:MarkdownView Markdown="{Binding SelectedContent.Description}" IsVisible="{Binding SelectedContent.Description, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <TextBlock Classes="body-md muted" Text="{Binding Localization.ContentNoDescription}" IsVisible="{Binding SelectedContent.Description, Converter={x:Static ObjectConverters.IsNull}}" />
                        </Panel>
                    </Border>

                    <!-- c/table-versions -->
                    <StackPanel Margin="0,16,0,0" IsVisible="{Binding IsVersionsTab}">
                        <TextBlock Classes="body-md muted" Text="{Binding Localization.ContentLoadingVersions}" Margin="8,8,0,8" IsVisible="{Binding IsLoadingVersions}" />
                        <Border BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="16" ClipToBounds="True" IsVisible="{Binding !IsLoadingVersions}">
                            <StackPanel>
                                <Border Background="{StaticResource Brush.Surface}" Padding="16,11">
                                    <Grid ColumnDefinitions="150,150,*,120,80">
                                        <TextBlock Classes="body-md secondary" Text="{Binding Localization.ContentVersionHeader}" />
                                        <TextBlock Grid.Column="1" Classes="body-md secondary" Text="{Binding Localization.ContentChannelHeader}" />
                                        <TextBlock Grid.Column="2" Classes="body-md secondary" Text="{Binding Localization.ContentGameVersionHeader}" />
                                        <TextBlock Grid.Column="3" Classes="body-md secondary" Text="{Binding Localization.ContentPublishedHeader}" />
                                    </Grid>
                                </Border>
                                <TextBlock Classes="body-md muted" Text="{Binding Localization.ContentNoVersions}" Margin="16,12" IsVisible="{Binding !ContentVersions.Count}" />
                                <ItemsControl ItemsSource="{Binding ContentVersions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:VersionItem">
                                            <Border BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="0,1,0,0" Padding="16,8" MinHeight="40">
                                                <Grid ColumnDefinitions="150,150,*,120,80">
                                                    <TextBlock Classes="heading-sm" Text="{Binding Version}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Classes="chip" HorizontalAlignment="Left" VerticalAlignment="Center" Classes.testing="{Binding IsTesting}" Classes.dev="{Binding IsDev}">
                                                        <TextBlock Text="{Binding ChannelText}" />
                                                    </Border>
                                                    <Border Grid.Column="2" Classes="chip" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding GameVersionText}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="3" Classes="body-md secondary" Text="{Binding PublishedText}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Classes="body-sm danger" Text="{Binding InstallError}" IsVisible="{Binding InstallError, Converter={x:Static ObjectConverters.IsNotNull}}" MaxWidth="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <Button Classes="icon" Command="{Binding InstallCommand}" IsEnabled="{Binding !IsInstalling}" IsVisible="{Binding CanInstall}" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.DiscoverAdd}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.DiscoverAdd}">
                                                            <Path Classes="icon size-16" Data="{StaticResource Icon.Plus}" Stroke="{StaticResource Brush.Accent}" StrokeThickness="2" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- detail-panel -->
            <Border Grid.Column="1" Classes="card" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="24" Margin="0,24,24,24" Padding="24" VerticalAlignment="Top">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="heading-md" Text="{Binding Localization.ContentCompatibility}" />
                        <Border Classes="chip" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding SelectedContent.GameVersionText}" />
                        </Border>
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource Brush.BorderStrong}" IsVisible="{Binding HasContentLinks}" />
                    <StackPanel Spacing="10" IsVisible="{Binding HasContentLinks}">
                        <TextBlock Classes="heading-md" Text="{Binding Localization.ContentLinks}" />
                        <ItemsControl ItemsSource="{Binding ContentLinks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ContentLink">
                                    <Button Classes="filter" Content="{Binding Label}" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenLinkCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding Url}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource Brush.BorderStrong}" IsVisible="{Binding HasContentTags}" />
                    <StackPanel Spacing="10" IsVisible="{Binding HasContentTags}">
                        <TextBlock Classes="heading-md" Text="{Binding Localization.ContentTags}" />
                        <ItemsControl ItemsSource="{Binding SelectedContent.Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Classes="chip">
                                        <TextBlock Text="{Binding}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource Brush.BorderStrong}" />
                    <StackPanel Spacing="10">
                        <TextBlock Classes="heading-md" Text="{Binding Localization.ContentAuthor}" />
                        <TextBlock Classes="body-md secondary" Text="{Binding SelectedContent.AuthorNames}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource Brush.BorderStrong}" />
                    <StackPanel Spacing="10">
                        <TextBlock Classes="heading-md" Text="{Binding Localization.ContentDetails}" />
                        <TextBlock Classes="body-sm secondary" FontWeight="SemiBold" Text="{Binding SelectedContent.License}" />
                        <TextBlock Classes="body-sm secondary" FontWeight="SemiBold" Text="{Binding SelectedContent.SourceText}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Tasks -->
        <StackPanel Grid.Column="1" IsVisible="{Binding CurrentWindowTasks}" MaxWidth="700" Margin="32,42,32,32">
            <StackPanel Orientation="Horizontal" Spacing="4" Height="24">
                <Path Classes="icon" Data="{StaticResource Icon.Terminal}" />
                <TextBlock Classes="label-lg" Text="{Binding Localization.NavigationTasks}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Grid>

    <!-- last-resort error bar -->
    <Border Background="{StaticResource Brush.DangerSoft}" BorderBrush="{StaticResource Brush.Danger}" BorderThickness="1" CornerRadius="12" Padding="16,10" Margin="96,0,24,16" VerticalAlignment="Bottom" IsVisible="{Binding UnexpectedError, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Grid ColumnDefinitions="*,12,Auto">
            <TextBlock Classes="body-md danger" Text="{Binding UnexpectedError}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="icon" Command="{Binding DismissUnexpectedErrorCommand}" AutomationProperties.Name="{Binding Localization.ModalClose}">
                <Path Classes="icon size-16" Data="{StaticResource Icon.Close}" Stroke="{StaticResource Brush.Danger}" />
            </Button>
        </Grid>
    </Border>

    <!-- modal: new instance -->
    <Panel Background="#99000000" IsVisible="{Binding IsCreatingInstance}">
        <Border Classes="modal" Width="561" Margin="80,0,0,0">
            <StackPanel>
                <Grid ColumnDefinitions="*,Auto" Margin="24,24,24,0">
                    <TextBlock Classes="heading-lg" Text="{Binding Localization.ModalCreateInstanceTitle}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="icon" Command="{Binding CancelCreateInstanceCommand}" AutomationProperties.Name="{Binding Localization.ModalClose}">
                        <Path Classes="icon" Data="{StaticResource Icon.Close}" />
                    </Button>
                </Grid>
                <Border Height="1" Background="{StaticResource Brush.Window}" Margin="0,24,0,0" />
                <Grid ColumnDefinitions="Auto,12,*,16,Auto" Margin="36,32,24,32">
                    <TextBlock Classes="heading-md heading" Text="{Binding Localization.ModalNameLabel}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="2" Classes="field" Text="{Binding NewInstanceName}" PlaceholderText="{Binding Localization.LibraryNewInstancePlaceholder}" AutomationProperties.Name="{Binding Localization.ModalNameLabel}" VerticalAlignment="Center">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding CreateInstanceCommand}" />
                            <KeyBinding Gesture="Escape" Command="{Binding CancelCreateInstanceCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="4" Classes="cta" Command="{Binding CreateInstanceCommand}">
                        <TextBlock Classes="action-lg" Text="{Binding Localization.LibraryCreate}" />
                    </Button>
                </Grid>
                <TextBlock Classes="body-md danger" Text="{Binding InstanceError}" TextWrapping="Wrap" Margin="36,0,24,24" IsVisible="{Binding InstanceError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </Border>
    </Panel>

    <!-- modal: settings -->
    <Panel Background="#99000000" IsVisible="{Binding IsSettingsOpen}">
        <Border Classes="modal" Width="786" Height="520" Margin="80,0,0,0">
            <Grid RowDefinitions="Auto,1,*">
                <Grid ColumnDefinitions="*,Auto" Margin="24,24,24,24">
                    <TextBlock Classes="heading-lg" Text="{Binding Localization.NavigationSettings}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="icon" Command="{Binding CloseSettingsCommand}" AutomationProperties.Name="{Binding Localization.ModalClose}">
                        <Path Classes="icon" Data="{StaticResource Icon.Close}" />
                    </Button>
                </Grid>
                <Border Grid.Row="1" Background="{StaticResource Brush.Window}" />
                <Grid Grid.Row="2" ColumnDefinitions="223,1,*">
                    <StackPanel Margin="36,40,24,0" Spacing="24">
                        <Button Classes="menu" Classes.active="{Binding IsGeneralTab}" Content="{Binding Localization.SettingsGeneral}" Command="{Binding ShowGeneralSettingsCommand}" />
                        <Button Classes="menu" Classes.active="{Binding IsGameTab}" Content="{Binding Localization.SettingsGame}" Command="{Binding ShowGameSettingsCommand}" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource Brush.Window}" />

                    <!-- General -->
                    <StackPanel Grid.Column="2" Margin="32,32,44,0" Spacing="6" IsVisible="{Binding IsGeneralTab}">
                        <TextBlock Classes="heading-md" Text="{Binding Localization.SettingsLanguageLabel}" />
                        <ComboBox ItemsSource="{Binding Localization.SupportedCultures}" SelectedItem="{Binding Localization.SelectedCulture, Mode=TwoWay}" AutomationProperties.Name="{Binding Localization.SettingsLanguageLabel}" Width="340" Margin="0,4,0,0" />
                        <TextBlock Classes="heading-md" Text="{Binding Localization.SettingsRegionalFormatLabel}" Margin="0,18,0,0" />
                        <ComboBox ItemsSource="{Binding RegionalFormat.SupportedFormats}" SelectedItem="{Binding SelectedRegionalFormat, Mode=TwoWay}" AutomationProperties.Name="{Binding Localization.SettingsRegionalFormatLabel}" MaxDropDownHeight="300" Width="340" Margin="0,4,0,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="formatting:RegionalFormatOption">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Classes="body-md danger" Text="{Binding PreferenceSaveError}" TextWrapping="Wrap" IsVisible="{Binding PreferenceSaveError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Classes="heading-md" Text="{Binding Localization.SettingsThemeLabel}" Margin="0,18,0,0" />
                        <ComboBox ItemsSource="{Binding ThemeNames}" SelectedItem="{Binding CurrentTheme}" AutomationProperties.Name="{Binding Localization.SettingsThemeLabel}" Width="340" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Game: where KSA is, and which loader starts it -->
                    <ScrollViewer Grid.Column="2" IsVisible="{Binding IsGameTab}">
                        <StackPanel Margin="32,32,44,24" Spacing="6" IsEnabled="{Binding !IsSetupBusy}">
                            <TextBlock Classes="heading-md" Text="{Binding Localization.SetupGameDirectory}" />
                            <TextBlock Classes="body-sm secondary" Text="{Binding Localization.SetupGameDirectoryHint}" />
                            <Grid ColumnDefinitions="*,8,Auto,8,Auto" Margin="0,6,0,0">
                                <TextBox Classes="field" Text="{Binding GameDirectoryInput}" AutomationProperties.Name="{Binding Localization.SetupGameDirectory}" />
                                <Button Grid.Column="2" Classes="text" Content="{Binding Localization.SetupBrowse}" Click="BrowseGameDirectory" />
                                <Button Grid.Column="4" Classes="text primary" Content="{Binding Localization.SetupSave}" Command="{Binding SaveGameDirectoryCommand}" />
                            </Grid>
                            <Border Classes="chip" HorizontalAlignment="Left" Margin="0,6,0,0">
                                <Panel>
                                    <TextBlock IsVisible="{Binding InstalledVersionText, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <Run Text="KSA" /><Run Text=" " /><Run Text="{Binding InstalledVersionText}" />
                                    </TextBlock>
                                    <TextBlock IsVisible="{Binding InstalledVersionText, Converter={x:Static ObjectConverters.IsNull}}" Text="{Binding Localization.HomeNoGameVersion}" />
                                </Panel>
                            </Border>

                            <Border Height="1" Background="{StaticResource Brush.BorderStrong}" Margin="0,18,0,12" />

                            <TextBlock Classes="heading-md" Text="{Binding Localization.SetupLoader}" />
                            <ComboBox ItemsSource="{Binding Loaders}" SelectedItem="{Binding SelectedLoader}" AutomationProperties.Name="{Binding Localization.SetupLoader}" Width="340" Margin="0,6,0,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DiscoverItem">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Border Classes="chip positive" HorizontalAlignment="Left" Margin="0,6,0,0" IsVisible="{Binding InstalledLoaderText, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Text="{Binding InstalledLoaderText}" />
                            </Border>
                            <TextBlock Classes="heading-sm" Text="{Binding Localization.SetupLoaderDirectory}" Margin="0,16,0,0" />
                            <TextBlock Classes="body-sm secondary" Text="{Binding Localization.SetupLoaderDirectoryHint}" />
                            <Grid ColumnDefinitions="*,8,Auto" Margin="0,6,0,0">
                                <TextBox Classes="field" Text="{Binding LoaderDirectoryInput}" AutomationProperties.Name="{Binding Localization.SetupLoaderDirectory}" />
                                <Button Grid.Column="2" Classes="text" Content="{Binding Localization.SetupBrowse}" Click="BrowseLoaderDirectory" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button Classes="text primary" Content="{Binding LoaderInstallActionText}" Command="{Binding InstallLoaderCommand}" IsVisible="{Binding CanInstallLoader}" />
                                <Button Classes="text" Content="{Binding Localization.SetupUseExisting}" Command="{Binding AdoptLoaderCommand}" />
                            </StackPanel>
                            <ProgressBar Height="6" Margin="0,8,0,0" IsVisible="{Binding IsSetupBusy}" Value="{Binding SetupProgress}" Maximum="100" Foreground="{StaticResource Brush.Accent}" />
                            <TextBlock Classes="body-md secondary" Text="{Binding SetupMessage}" TextWrapping="Wrap" Margin="0,12,0,0" IsVisible="{Binding SetupMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <TextBlock Classes="body-md danger" Text="{Binding SetupError}" TextWrapping="Wrap" Margin="0,12,0,0" IsVisible="{Binding SetupError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Panel>
    </Panel>
</Window>
