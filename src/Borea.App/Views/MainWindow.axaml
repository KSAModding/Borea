<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Borea.App.ViewModels"
        xmlns:views="using:Borea.App.Views"
        xmlns:pages="using:Borea.App.Views.Pages"
        xmlns:preview="using:Borea.App.Views.Preview"
        xmlns:settings="using:Borea.App.Views.Settings"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="832"
        x:Class="Borea.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/borea.ico"
        CanResize="True"
        Width="1280" Height="832"
        MinWidth="860" MinHeight="480"
        Title="Borea">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- Every page and modal is its own control under Pages/ and Settings/; the rows they share are in Templates.axaml. -->
    <Panel>
    <!-- takes the focus from a text box on a click beside it, and sits first in the tree so that Tab goes on from the top -->
    <Control x:Name="FocusSink" Focusable="True" IsTabStop="False" IsHitTestVisible="False" />

    <Grid ColumnDefinitions="80,*">

        <!-- c/nav-bar -->
        <Border Grid.Column="0" Background="{StaticResource Brush.Rail}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,24">
                <StackPanel DockPanel.Dock="Bottom" Spacing="8">
                    <Panel>
                        <Button x:Name="TasksButton" Classes="nav" Classes.active="{Binding IsTasksOpen}" Command="{Binding ToggleTasksCommand}" ToolTip.Tip="{Binding Localization.NavigationTasks}" AutomationProperties.Name="{Binding Localization.NavigationTasks}">
                            <Path Classes="icon size-32" Data="{StaticResource Icon.Terminal}" />
                        </Button>
                        <ProgressBar Width="32" MinWidth="0" Height="4" MinHeight="0" Margin="0,0,0,2" HorizontalAlignment="Center" VerticalAlignment="Bottom" IsHitTestVisible="False" IsVisible="{Binding Tasks.IsBusy}" IsIndeterminate="{Binding !Tasks.HasProgress}" Value="{Binding Tasks.Progress}" Maximum="100" Foreground="{StaticResource Brush.Accent}" />
                    </Panel>
                    <Border Height="1" Background="{StaticResource Brush.BorderStrong}" Margin="0,3" />
                    <Button Classes="nav" Classes.active="{Binding IsSettingsOpen}" Command="{Binding SetMainWindowSettings}" ToolTip.Tip="{Binding Localization.NavigationSettings}" AutomationProperties.Name="{Binding Localization.NavigationSettings}">
                        <Path Classes="icon size-32" Data="{StaticResource Icon.Settings}" />
                    </Button>
                </StackPanel>
                <!-- the steward entry sits just above Tasks but outside the bottom stack, so no other entry moves when it appears after the steward check -->
                <Panel>
                    <StackPanel VerticalAlignment="Center" Spacing="16">
                        <Button Classes="nav" Classes.active="{Binding IsHomeSection}" Command="{Binding SetMainWindowHome}" ToolTip.Tip="{Binding Localization.NavigationHome}" AutomationProperties.Name="{Binding Localization.NavigationHome}">
                            <Path Classes="icon size-32 optical-lift" Data="{StaticResource Icon.Home}" />
                        </Button>
                        <Button Classes="nav" Classes.active="{Binding IsDiscoverSection}" Command="{Binding SetMainWindowDiscover}" ToolTip.Tip="{Binding Localization.NavigationDiscover}" AutomationProperties.Name="{Binding Localization.NavigationDiscover}">
                            <Path Classes="icon size-32" Data="{StaticResource Icon.Compass}" />
                        </Button>
                        <!-- the library stays lit while an instance page is open -->
                        <Button Classes="nav" Classes.active="{Binding IsLibrarySection}" Command="{Binding SetMainWindowLibrary}" ToolTip.Tip="{Binding Localization.NavigationLibrary}" AutomationProperties.Name="{Binding Localization.NavigationLibrary}">
                            <Path Classes="icon size-32" Data="{StaticResource Icon.Library}" />
                        </Button>
                    </StackPanel>
                    <Button x:Name="StewardButton" Classes="nav" Classes.active="{Binding CurrentWindowSteward}" IsVisible="{Binding IsGitHubSteward}" Command="{Binding OpenStewardPageCommand}" ToolTip.Tip="{Binding Localization.NavigationSteward}" AutomationProperties.Name="{Binding Localization.NavigationSteward}" VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <Path Classes="icon size-32" Data="{StaticResource Icon.ShieldCheck}" />
                    </Button>
                </Panel>
            </DockPanel>
        </Border>

        <!-- Home -->
        <pages:HomePage Grid.Column="1" IsVisible="{Binding CurrentWindowHome}" />

        <!-- Discover: list column plus the filter panel on the right -->
        <pages:DiscoverPage Grid.Column="1" IsVisible="{Binding CurrentWindowDiscover}" />

        <!-- Library -->
        <pages:LibraryPage Grid.Column="1" IsVisible="{Binding CurrentWindowLibrary}" />

        <!-- Instance (library-instance) -->
        <pages:InstancePage Grid.Column="1" IsVisible="{Binding CurrentWindowInstance}" />

        <!-- Content (discover-content): one listing, with the detail panel on the right -->
        <pages:ContentPage Grid.Column="1" IsVisible="{Binding CurrentWindowContent}" />

        <!-- Pack: one modpack, laid out like the content page -->
        <pages:PackPage Grid.Column="1" IsVisible="{Binding CurrentWindowPack}" />

        <!-- List or change your mod: a listing for content-index, with its checks on the right -->
        <pages:ListingPage Grid.Column="1" IsVisible="{Binding CurrentWindowListing}" />

        <!-- Steward tools: opened from the rail or from the GitHub account in Settings -->
        <pages:StewardPage Grid.Column="1" IsVisible="{Binding CurrentWindowSteward}" />

        <!-- Tasks: a drawer over the current page, which stays open behind it -->
        <views:TasksDrawer Grid.Column="1" IsVisible="{Binding IsTasksOpen}" />
    </Grid>

    <!-- the 3D preview over the whole window, like an image lightbox, under the toasts and the modals. Escape or the button shrinks it, and Tab stays inside it -->
    <ContentControl Content="{Binding VehiclePreview.Expanded}">
        <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:VehiclePreviewViewModel">
                <Panel Background="{StaticResource Brush.Surface}" KeyboardNavigation.TabNavigation="Cycle">
                    <Panel.KeyBindings>
                        <KeyBinding Gesture="Escape" Command="{Binding CollapseCommand}" />
                    </Panel.KeyBindings>
                    <!-- Pose comes after Scene for the same reason as on the panel. ResetCount is only on the panel, which stays in the page and passes a reset on through the pose, because a new view would take an earlier click for a new one -->
                    <preview:VehiclePreviewView Scene="{Binding Scene}" Pose="{Binding Pose, Mode=TwoWay}" FocusWhenShown="True" Background="{StaticResource Brush.Surface}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.PreviewPanelName}" />
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="12" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.PreviewCollapseView}" Command="{Binding CollapseCommand}" />
                        <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.PreviewResetView}" Command="{Binding ResetViewCommand}" />
                    </StackPanel>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VehiclePreviewStatus}" />
                </Panel>
            </DataTemplate>
        </ContentControl.ContentTemplate>
    </ContentControl>

    <StackPanel VerticalAlignment="Bottom">
    <!-- toasts, above the error bar -->
    <views:ToastHost Margin="96,0,24,16" HorizontalAlignment="Right" />

    <!-- last-resort error bar -->
    <views:UnexpectedErrorBar Margin="96,0,24,16" IsVisible="{Binding UnexpectedError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <!-- modal: new instance, and rename instance -->
    <views:InstanceNameModal IsVisible="{Binding IsNameModalOpen}" />

    <!-- modal: delete instance -->
    <views:DeleteInstanceModal IsVisible="{Binding IsDeleteModalOpen}" />

    <!-- modal: move an instance back to the game build of the settings -->
    <views:UseCurrentGameBuildModal IsVisible="{Binding IsUseCurrentGameBuildModalOpen}" />

    <!-- modal: launch arguments of an instance -->
    <views:LaunchArgumentsModal IsVisible="{Binding IsLaunchArgumentsModalOpen}" />

    <!-- modal: the mod loader setting of an instance -->
    <views:LoaderSettingModal IsVisible="{Binding IsLoaderSettingModalOpen}" />

    <!-- modal: the plan of a duplicate or an import -->
    <views:ModListModal IsVisible="{Binding IsReviewingModList}" />

    <!-- modal: what "Update all" changes, while its plan waits for a confirmation -->
    <views:UpdateAllModal>
        <views:UpdateAllModal.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="CurrentWindowInstance" />
                <Binding Path="UpdateAll.IsConfirmingUpdate" FallbackValue="{x:False}" />
            </MultiBinding>
        </views:UpdateAllModal.IsVisible>
    </views:UpdateAllModal>

    <!-- modal: a plan stopped because two mods do not work together, over the plan of a duplicate or an import -->
    <views:ConflictModal IsVisible="{Binding IsConflictOpen}" />

    <!-- modal: the game Borea found on the first start -->
    <views:FoundGameModal IsVisible="{Binding IsFoundGameModalOpen}" />

    <!-- modal: the mod loader a launch needs -->
    <views:LoaderPromptModal IsVisible="{Binding IsLoaderPromptOpen}" />

    <!-- modal: the .NET runtime a launch through a Wine wrapper needs -->
    <views:RuntimePromptModal IsVisible="{Binding IsRuntimePromptOpen}" />

    <!-- modal: the loader stopped right after Play -->
    <views:LaunchFailureModal IsVisible="{Binding IsLaunchFailureOpen}" />

    <!-- modal: the whole text of an error toast -->
    <views:ToastDetailsModal IsVisible="{Binding IsToastDetailsOpen}" />

    <!-- modal: the notes of the newer Borea releases -->
    <views:ReleaseNotesModal IsVisible="{Binding IsReleaseNotesOpen}" />

    <!-- modal: the patch notes of the installed game builds -->
    <views:GamePatchNotesModal IsVisible="{Binding IsGamePatchNotesOpen}" />

    <!-- modal: one announcement of the KSAModding team -->
    <views:AnnouncementModal IsVisible="{Binding IsAnnouncementOpen}" />

    <!-- modal: the owner of a listing on a share host changes it there -->
    <views:ShareManageModal IsVisible="{Binding IsShareManageOpen}" />

    <!-- modal: a steward change of index-status.toml -->
    <views:IndexStatusModal IsVisible="{Binding IsStewardChangeOpen}" />

    <!-- modal: a steward amendment of release files -->
    <views:ReleaseAmendmentModal IsVisible="{Binding IsStewardAmendmentOpen}" />

    <!-- modal: a mod author's request to take their mod out of a pack -->
    <views:PackLeaveModal IsVisible="{Binding IsStewardLeaveOpen}" />

    <!-- modal: a steward action on the pull request of the review -->
    <views:PullRequestActionModal IsVisible="{Binding IsStewardActionOpen}" />

    <!-- modal: a steward action on a report of the Reports tab -->
    <views:ReportActionModal IsVisible="{Binding IsStewardReportActionOpen}" />

    <!-- modal: settings -->
    <settings:SettingsModal IsVisible="{Binding IsSettingsOpen}" />

    <!-- modal: keep the game build for an instance, or from a folder that the Game settings chose -->
    <views:KeepGameBuildModal IsVisible="{Binding IsKeepGameBuildModalOpen}" />

    <!-- modal: the code of a GitHub sign-in, over the settings and the pages -->
    <views:GitHubSignInModal IsVisible="{Binding IsGitHubSignInOpen}" />

    <!-- modal: create a game settings preset from an instance's settings.toml -->
    <views:CreateGameSettingsPresetModal IsVisible="{Binding IsCreatingGameSettingsPreset}" />

    <!-- the window stays open until the running installs reached a safe point -->
    <Border Background="{StaticResource Brush.SurfaceRaised}" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="12" Padding="16,10" Margin="96,0,24,16" VerticalAlignment="Bottom" IsVisible="{Binding IsClosing}">
        <Grid ColumnDefinitions="Auto,12,*">
            <ProgressBar Width="38" Height="6" VerticalAlignment="Center" IsIndeterminate="True" Foreground="{StaticResource Brush.Accent}" />
            <TextBlock Grid.Column="2" Classes="body-md" Text="{Binding Localization.InstallClosing}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </Grid>
    </Border>

    <!-- modal: a second close request while Borea still waits -->
    <views:CloseNowModal IsVisible="{Binding IsCloseNowOpen}" />
    </Panel>
</Window>
