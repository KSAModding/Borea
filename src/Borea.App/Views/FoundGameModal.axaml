<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Borea.App.ViewModels"
             x:Class="Borea.App.Views.FoundGameModal"
             x:DataType="vm:MainViewModel">
    <!-- the games Borea found on a start without a usable game folder -->
    <Panel Background="#99000000">
        <Border Classes="modal" Width="561" Margin="80,0,0,0">
            <StackPanel>
                <Grid ColumnDefinitions="*,Auto" Margin="24,24,24,0">
                    <TextBlock Classes="heading-lg" Text="{Binding Localization.SetupBannerAction}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="icon" Command="{Binding DismissFoundGameCommand}" IsEnabled="{Binding !IsSetupBusy}" AutomationProperties.Name="{Binding Localization.ModalClose}">
                        <Path Classes="icon" Data="{StaticResource Icon.Close}" />
                    </Button>
                </Grid>
                <Border Height="1" Background="{StaticResource Brush.Window}" Margin="0,24,0,0" />
                <StackPanel Margin="36,32,24,32" Spacing="16">
                    <TextBlock Classes="body-md" Text="{Binding FoundGameText}" TextWrapping="Wrap" />
                    <ListBox ItemsSource="{Binding FoundGames}" SelectedItem="{Binding SelectedFoundGame}" MaxHeight="240" IsEnabled="{Binding !IsSetupBusy}" AutomationProperties.Name="{Binding Localization.SetupFoundGames}" IsVisible="{Binding HasSeveralFoundGames}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:FoundGameItem">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="label-md">
                                        <Run Text="KSA" /><Run Text=" " /><Run Text="{Binding Version}" />
                                    </TextBlock>
                                    <TextBlock Classes="body-sm secondary" Text="{Binding DirectoryText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Classes="body-md danger" Text="{Binding SetupError}" TextWrapping="Wrap" IsVisible="{Binding SetupError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Classes="text" Content="{Binding Localization.SetupLater}" Command="{Binding DismissFoundGameCommand}" IsEnabled="{Binding !IsSetupBusy}" VerticalAlignment="Center" />
                        <Button Classes="cta" Command="{Binding UseFoundGameCommand}" IsEnabled="{Binding SelectedFoundGame, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Panel VerticalAlignment="Center">
                                <TextBlock Classes="action-lg" Text="{Binding Localization.SetupUseFoundGame}" IsVisible="{Binding !HasSeveralFoundGames}" />
                                <TextBlock Classes="action-lg" Text="{Binding Localization.SetupUseSelectedGame}" IsVisible="{Binding HasSeveralFoundGames}" />
                            </Panel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Panel>
</UserControl>
