<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Borea.App.ViewModels"
             xmlns:views="using:Borea.App.Views"
             x:Class="Borea.App.Views.ReleaseAmendmentModal"
             x:DataType="vm:MainViewModel">
    <UserControl.Resources>
        <!-- a version that a field offers, with its release status, the installed build and the value now marked -->
        <DataTemplate x:Key="AmendVersionTemplate" x:DataType="vm:ReleaseAmendmentChoice">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Value}" VerticalAlignment="Center" />
                <Border Classes="chip" VerticalAlignment="Center" IsVisible="{Binding HasNote}">
                    <TextBlock Text="{Binding Note}" />
                </Border>
                <Border Classes="chip" VerticalAlignment="Center" IsVisible="{Binding IsNow}">
                    <TextBlock Text="{Binding NowMark}" />
                </Border>
            </StackPanel>
        </DataTemplate>
        <!-- an id that a dependency row offers, with the kind the releases state or the name of the listed mod, as wide as its field -->
        <DataTemplate x:Key="AmendIdTemplate" x:DataType="vm:ReleaseAmendmentChoice">
            <DockPanel MaxWidth="190">
                <TextBlock Text="{Binding Value}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="secondary" Text="{Binding Note}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" IsVisible="{Binding HasNote}" />
            </DockPanel>
        </DataTemplate>
        <!-- what the selected releases state now, and whether the typed value narrows or widens them -->
        <DataTemplate x:Key="AmendHintTemplate" x:DataType="vm:ReleaseAmendmentHint">
            <StackPanel Spacing="2">
                <TextBlock Classes="body-sm secondary" Text="{Binding Now}" TextWrapping="Wrap" IsVisible="{Binding HasNow}" />
                <TextBlock Classes="body-sm secondary" Classes.danger="{Binding NeedsAuthor}" Text="{Binding Effect}" TextWrapping="Wrap" IsVisible="{Binding HasEffect}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <!-- modal: a steward amendment of release files, which opens a pull request in content-index-releases after a preview -->
    <Panel Background="#99000000" views:ModalBackdrop.CloseButton="{Binding #CloseButton}">
        <Border Classes="modal" MaxWidth="800" HorizontalAlignment="Stretch" Margin="104,32,24,32" DataContext="{Binding StewardAmendment}" x:DataType="vm:ReleaseAmendmentDialog">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="24,24,24,0">
                    <TextBlock Classes="heading-lg" Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button x:Name="CloseButton" Grid.Column="1" Classes="icon" Command="{Binding CloseCommand}" AutomationProperties.Name="{Binding Localization.ModalClose}">
                        <Path Classes="icon" Data="{StaticResource Icon.Close}" />
                    </Button>
                </Grid>
                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Brush.Window}" Margin="0,24,0,0" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="36,16,24,24">
                    <Button Classes="text tall" Content="{Binding Localization.LibraryCancel}" Command="{Binding CloseCommand}" VerticalAlignment="Center" IsVisible="{Binding !IsOpened}" />
                    <Button Classes="text tall" Content="{Binding Localization.DiscoverIndexRetry}" Command="{Binding RetryCommand}" VerticalAlignment="Center" IsVisible="{Binding CanRetry}" />
                    <Button Classes="text tall" Content="{Binding Localization.StewardAmendPreview}" Command="{Binding PreviewCommand}" VerticalAlignment="Center" IsVisible="{Binding !IsOpened}" />
                    <Button Classes="cta" Command="{Binding OpenPullRequestCommand}" IsVisible="{Binding !IsOpened}">
                        <TextBlock Classes="action-lg" Text="{Binding Localization.ListingPublish}" VerticalAlignment="Center" />
                    </Button>
                    <Button Classes="text tall" Content="{Binding Localization.ModalClose}" Command="{Binding CloseCommand}" VerticalAlignment="Center" IsVisible="{Binding IsOpened}" />
                    <Button Classes="cta" Command="{Binding ShowPullRequestCommand}" IsVisible="{Binding IsOpened}">
                        <TextBlock Classes="action-lg" Text="{Binding Localization.ListingOpenPullRequest}" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
                <ScrollViewer>
                    <StackPanel Margin="36,32,24,16" Spacing="16">
                        <TextBlock Classes="body-md secondary" Text="{Binding Localization.StewardAmendExplanation}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsLoading}">
                            <ProgressBar Width="38" Height="6" VerticalAlignment="Center" IsIndeterminate="True" Foreground="{StaticResource Brush.Accent}" />
                            <TextBlock Classes="body-md" Text="{Binding Localization.StewardAmendLoading}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- the releases, the change and the reason, which the preview and the pull request take as they are -->
                        <StackPanel Spacing="16" IsVisible="{Binding HasVersions}" IsEnabled="{Binding CanEdit}">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="heading-md heading" Text="{Binding Localization.StewardAmendReleases}" />
                                <RadioButton GroupName="AmendScope" IsChecked="{Binding IsScopeChecked}">
                                    <TextBlock Classes="body-sm" Text="{Binding Localization.StewardAmendChecked}" />
                                </RadioButton>
                                <ItemsControl ItemsSource="{Binding Versions}" Margin="28,0,0,0" IsVisible="{Binding IsScopeChecked}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemSpacing="16" LineSpacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ReleaseAmendmentVersion">
                                            <CheckBox IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Version}">
                                                <TextBlock Classes="body-sm" Text="{Binding Version}" />
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <RadioButton GroupName="AmendScope" IsChecked="{Binding IsScopeUpTo}">
                                    <TextBlock Classes="body-sm" Text="{Binding Localization.StewardAmendUpTo}" />
                                </RadioButton>
                                <ComboBox ItemsSource="{Binding VersionNames}" SelectedItem="{Binding UpTo}" Margin="28,0,0,0" MinWidth="180" MaxDropDownHeight="300" IsVisible="{Binding IsScopeUpTo}" AutomationProperties.Name="{Binding Localization.StewardAmendUpTo}" />
                                <RadioButton GroupName="AmendScope" IsChecked="{Binding IsScopeAll}">
                                    <TextBlock Classes="body-sm" Text="{Binding Localization.StewardAmendAll}" />
                                </RadioButton>
                            </StackPanel>

                            <!-- on the author's request the amendment may also widen, and the pull request names the request -->
                            <StackPanel Spacing="8">
                                <CheckBox IsChecked="{Binding OnBehalfOfAuthor}">
                                    <TextBlock Classes="body-sm" Text="{Binding Localization.StewardAmendOnBehalf}" />
                                </CheckBox>
                                <TextBlock Classes="body-sm secondary" Text="{Binding Localization.StewardAmendOnBehalfHint}" TextWrapping="Wrap" />
                                <StackPanel Spacing="6" Margin="28,0,0,0" IsVisible="{Binding OnBehalfOfAuthor}">
                                    <TextBlock Classes="heading-sm" Text="{Binding Localization.StewardAmendAuthorRequest}" TextWrapping="Wrap" />
                                    <TextBox Classes="field" Text="{Binding AuthorRequest}" PlaceholderText="https://" MaxLength="500" AutomationProperties.Name="{Binding Localization.StewardAmendAuthorRequest}" />
                                    <TextBlock Classes="body-sm danger" Text="{Binding InvalidAuthorRequestText}" TextWrapping="Wrap" IsVisible="{Binding InvalidAuthorRequestText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Classes="heading-md heading" Text="{Binding Localization.StewardAmendChange}" />
                                <TextBlock Classes="body-sm secondary" Text="{Binding Localization.StewardAmendReadingFiles}" TextWrapping="Wrap" IsVisible="{Binding IsReadingFiles}" />
                                <TextBlock Classes="body-sm secondary" Text="{Binding Localization.StewardAmendSelectForValues}" TextWrapping="Wrap" IsVisible="{Binding NeedsSelectionForValues}" />
                                <!-- each version field offers the versions that fit and takes any text, and says under it what the releases state now -->
                                <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,6,Auto,8,Auto,16,Auto,6,Auto">
                                    <TextBlock Classes="heading-sm" Text="{Binding GameMinLabel}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="2" Classes="heading-sm" Text="{Binding GameMaxLabel}" TextWrapping="Wrap" />
                                    <StackPanel Grid.Row="2" Spacing="4">
                                        <TextBox Classes="field" Text="{Binding GameMin}" IsVisible="{Binding !HasGameVersions}" AutomationProperties.Name="{Binding GameMinLabel}" />
                                        <ComboBox IsEditable="True" Text="{Binding GameMin}" ItemsSource="{Binding GameMinChoices}" ItemTemplate="{StaticResource AmendVersionTemplate}" IsVisible="{Binding HasGameVersions}" HorizontalAlignment="Stretch" MinHeight="35" MaxDropDownHeight="300" AutomationProperties.Name="{Binding GameMinLabel}" />
                                        <ContentControl Content="{Binding GameMinHint}" ContentTemplate="{StaticResource AmendHintTemplate}" IsVisible="{Binding GameMinHint.IsShown}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2" Spacing="4">
                                        <TextBox Classes="field" Text="{Binding GameMax}" IsEnabled="{Binding !RemoveGameMax}" IsVisible="{Binding !HasGameVersions}" AutomationProperties.Name="{Binding GameMaxLabel}" />
                                        <ComboBox IsEditable="True" Text="{Binding GameMax}" ItemsSource="{Binding GameMaxChoices}" ItemTemplate="{StaticResource AmendVersionTemplate}" IsEnabled="{Binding !RemoveGameMax}" IsVisible="{Binding HasGameVersions}" HorizontalAlignment="Stretch" MinHeight="35" MaxDropDownHeight="300" AutomationProperties.Name="{Binding GameMaxLabel}" />
                                        <ContentControl Content="{Binding GameMaxHint}" ContentTemplate="{StaticResource AmendHintTemplate}" IsVisible="{Binding GameMaxHint.IsShown}" />
                                        <CheckBox IsChecked="{Binding RemoveGameMax}" IsVisible="{Binding OnBehalfOfAuthor}">
                                            <TextBlock Classes="body-sm" Text="{Binding Localization.StewardAmendRemoveGameMax}" />
                                        </CheckBox>
                                    </StackPanel>
                                    <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Classes="body-sm secondary" Text="{Binding Localization.StewardAmendGameHint}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="6" Classes="heading-sm" Text="{Binding LoaderMinLabel}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="6" Grid.Column="2" Classes="heading-sm" Text="{Binding LoaderMaxLabel}" TextWrapping="Wrap" />
                                    <StackPanel Grid.Row="8" Spacing="4">
                                        <TextBox Classes="field" Text="{Binding LoaderMin}" IsEnabled="{Binding !RemoveLoaderMin}" IsVisible="{Binding !HasLoaderVersions}" AutomationProperties.Name="{Binding LoaderMinLabel}" />
                                        <ComboBox IsEditable="True" Text="{Binding LoaderMin}" ItemsSource="{Binding LoaderMinChoices}" ItemTemplate="{StaticResource AmendVersionTemplate}" IsEnabled="{Binding !RemoveLoaderMin}" IsVisible="{Binding HasLoaderVersions}" HorizontalAlignment="Stretch" MinHeight="35" MaxDropDownHeight="300" AutomationProperties.Name="{Binding LoaderMinLabel}" />
                                        <ContentControl Content="{Binding LoaderMinHint}" ContentTemplate="{StaticResource AmendHintTemplate}" IsVisible="{Binding LoaderMinHint.IsShown}" />
                                        <CheckBox IsChecked="{Binding RemoveLoaderMin}" IsVisible="{Binding OnBehalfOfAuthor}">
                                            <TextBlock Classes="body-sm" Text="{Binding Localization.StewardAmendRemoveLoaderMin}" />
                                        </CheckBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="8" Grid.Column="2" Spacing="4">
                                        <TextBox Classes="field" Text="{Binding LoaderMax}" IsEnabled="{Binding !RemoveLoaderMax}" IsVisible="{Binding !HasLoaderVersions}" AutomationProperties.Name="{Binding LoaderMaxLabel}" />
                                        <ComboBox IsEditable="True" Text="{Binding LoaderMax}" ItemsSource="{Binding LoaderMaxChoices}" ItemTemplate="{StaticResource AmendVersionTemplate}" IsEnabled="{Binding !RemoveLoaderMax}" IsVisible="{Binding HasLoaderVersions}" HorizontalAlignment="Stretch" MinHeight="35" MaxDropDownHeight="300" AutomationProperties.Name="{Binding LoaderMaxLabel}" />
                                        <ContentControl Content="{Binding LoaderMaxHint}" ContentTemplate="{StaticResource AmendHintTemplate}" IsVisible="{Binding LoaderMaxHint.IsShown}" />
                                        <CheckBox IsChecked="{Binding RemoveLoaderMax}" IsVisible="{Binding OnBehalfOfAuthor}">
                                            <TextBlock Classes="body-sm" Text="{Binding Localization.StewardAmendRemoveLoaderMax}" />
                                        </CheckBox>
                                    </StackPanel>
                                </Grid>
                                <CheckBox IsChecked="{Binding Yank}" Margin="0,8,0,0">
                                    <TextBlock Classes="body-sm" Text="{Binding Localization.StewardAmendYank}" />
                                </CheckBox>
                                <CheckBox IsChecked="{Binding Unyank}" IsVisible="{Binding OnBehalfOfAuthor}">
                                    <TextBlock Classes="body-sm" Text="{Binding Localization.StewardAmendUnyank}" />
                                </CheckBox>
                                <!-- a change of os names every platform the releases run on, and none removes the restriction -->
                                <StackPanel Spacing="6" IsVisible="{Binding OnBehalfOfAuthor}">
                                    <CheckBox IsChecked="{Binding ChangeOs}">
                                        <TextBlock Classes="body-sm" Text="{Binding Localization.StewardAmendChangeOs}" />
                                    </CheckBox>
                                    <StackPanel Spacing="4" Margin="28,0,0,0" IsVisible="{Binding ChangeOs}">
                                        <TextBlock Classes="body-sm secondary" Text="{Binding Localization.StewardAmendOsHint}" TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding Platforms}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel ItemSpacing="16" LineSpacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ReleaseAmendmentPlatform">
                                                    <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Name}">
                                                        <TextBlock Classes="body-sm" Text="{Binding Name}" />
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Classes="heading-md heading" Text="{Binding Localization.StewardAmendDependencies}" />
                                <TextBlock Classes="body-sm secondary" Text="{Binding DependenciesHint}" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Dependencies}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ReleaseAmendmentDependencyRow">
                                            <Grid ColumnDefinitions="*,8,Auto">
                                                <!-- each field with what the releases state now and what its value does right under it -->
                                                <WrapPanel ItemSpacing="8" LineSpacing="8">
                                                    <StackPanel Width="220" Spacing="4">
                                                        <ComboBox IsEditable="True" HorizontalAlignment="Stretch" MinHeight="35" Text="{Binding Id}" ItemsSource="{Binding IdChoices}" ItemTemplate="{StaticResource AmendIdTemplate}" MaxDropDownHeight="300" PlaceholderText="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingId}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingId}" />
                                                        <ContentControl Content="{Binding IdHint}" ContentTemplate="{StaticResource AmendHintTemplate}" IsVisible="{Binding IdHint.IsShown}" />
                                                    </StackPanel>
                                                    <ComboBox Width="130" MinHeight="35" VerticalAlignment="Top" ItemsSource="{x:Static vm:ReleaseAmendmentDependencyRow.Kinds}" SelectedItem="{Binding Kind}" IsVisible="{Binding IsMissing}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingDependencyKind}" />
                                                    <StackPanel Width="166" Spacing="4" IsVisible="{Binding CanChangeKind}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <ComboBox Width="130" MinHeight="35" VerticalAlignment="Center" ItemsSource="{x:Static vm:ReleaseAmendmentDependencyRow.Kinds}" SelectedItem="{Binding NewKind}" PlaceholderText="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardAmendKindUnchanged}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingDependencyKind}" />
                                                            <Button Classes="icon" Command="{Binding KeepKindCommand}" IsVisible="{Binding HasNewKind}" VerticalAlignment="Center" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardAmendKindUnchanged}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardAmendKindUnchanged}">
                                                                <Path Classes="icon size-16" Data="{StaticResource Icon.Close}" />
                                                            </Button>
                                                        </StackPanel>
                                                        <ContentControl Content="{Binding KindHint}" ContentTemplate="{StaticResource AmendHintTemplate}" IsVisible="{Binding KindHint.IsShown}" />
                                                    </StackPanel>
                                                    <StackPanel Width="140" Spacing="4">
                                                        <TextBox Classes="field" Text="{Binding Min}" IsEnabled="{Binding !RemoveMin}" IsVisible="{Binding HasNoVersions}" PlaceholderText="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingDependencyMin}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingDependencyMin}" />
                                                        <ComboBox IsEditable="True" HorizontalAlignment="Stretch" MinHeight="35" Text="{Binding Min}" ItemsSource="{Binding MinVersions}" ItemTemplate="{StaticResource AmendVersionTemplate}" MaxDropDownHeight="300" IsEnabled="{Binding !RemoveMin}" IsVisible="{Binding HasVersions}" PlaceholderText="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingDependencyMin}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingDependencyMin}" />
                                                        <ContentControl Content="{Binding MinHint}" ContentTemplate="{StaticResource AmendHintTemplate}" IsVisible="{Binding MinHint.IsShown}" />
                                                        <CheckBox IsChecked="{Binding RemoveMin}" IsVisible="{Binding CanChangeKind}">
                                                            <TextBlock Classes="body-sm" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardAmendRemoveMin}" TextWrapping="Wrap" />
                                                        </CheckBox>
                                                    </StackPanel>
                                                    <StackPanel Width="140" Spacing="4">
                                                        <TextBox Classes="field" Text="{Binding Max}" IsEnabled="{Binding !RemoveMax}" IsVisible="{Binding HasNoVersions}" PlaceholderText="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingDependencyMax}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingDependencyMax}" />
                                                        <ComboBox IsEditable="True" HorizontalAlignment="Stretch" MinHeight="35" Text="{Binding Max}" ItemsSource="{Binding MaxVersions}" ItemTemplate="{StaticResource AmendVersionTemplate}" MaxDropDownHeight="300" IsEnabled="{Binding !RemoveMax}" IsVisible="{Binding HasVersions}" PlaceholderText="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingDependencyMax}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingDependencyMax}" />
                                                        <ContentControl Content="{Binding MaxHint}" ContentTemplate="{StaticResource AmendHintTemplate}" IsVisible="{Binding MaxHint.IsShown}" />
                                                        <CheckBox IsChecked="{Binding RemoveMax}" IsVisible="{Binding CanChangeKind}">
                                                            <TextBlock Classes="body-sm" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.StewardAmendRemoveMax}" TextWrapping="Wrap" />
                                                        </CheckBox>
                                                    </StackPanel>
                                                </WrapPanel>
                                                <Button Grid.Column="2" Classes="icon" Command="{Binding RemoveCommand}" VerticalAlignment="Top" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingRemove}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ListingRemove}">
                                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Trash}" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <WrapPanel ItemSpacing="16" LineSpacing="8">
                                    <Button Classes="link" Command="{Binding AddMissingDependencyCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Classes="icon size-16" Data="{StaticResource Icon.Plus}" />
                                            <TextBlock Classes="action-md" Text="{Binding Localization.StewardAmendAddDependency}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="link" Command="{Binding BoundDependencyCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Classes="icon size-16" Data="{StaticResource Icon.Plus}" />
                                            <TextBlock Classes="action-md" Text="{Binding BoundDependencyLabel}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="heading-md heading" Text="{Binding Localization.StewardReason}" />
                                <TextBlock Classes="body-sm secondary" Text="{Binding Localization.StewardAmendReasonHint}" TextWrapping="Wrap" />
                                <TextBox Classes="field" Text="{Binding Reason}" MaxLength="500" AutomationProperties.Name="{Binding Localization.StewardReason}">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding PreviewCommand}" />
                                        <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <TextBlock Classes="body-sm danger" Text="{Binding InvalidReasonText}" TextWrapping="Wrap" IsVisible="{Binding InvalidReasonText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsPreviewing}">
                            <ProgressBar Width="38" Height="6" VerticalAlignment="Center" IsIndeterminate="True" Foreground="{StaticResource Brush.Accent}" />
                            <TextBlock Classes="body-md" Text="{Binding Localization.StewardAmendPreviewing}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="body-md danger" Text="{Binding Refusal}" TextWrapping="Wrap" IsVisible="{Binding Refusal, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Classes="body-sm secondary" Text="{Binding RefusalDetails}" TextWrapping="Wrap" IsVisible="{Binding RefusalDetails, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Classes="body-md" Text="{Binding Notice}" TextWrapping="Wrap" IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <!-- the preview: each selected release file with its diff, or the note that it already says this -->
                        <StackPanel Spacing="8" IsVisible="{Binding HasPreview}">
                            <TextBlock Classes="heading-md heading" Text="{Binding Localization.StewardAmendPreviewHeading}" />
                            <TextBlock Classes="body-md" Text="{Binding NothingText}" TextWrapping="Wrap" IsVisible="{Binding NothingText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <ItemsControl ItemsSource="{Binding Files}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ReleaseAmendmentFile">
                                        <Border Classes="card" Padding="24,16">
                                            <StackPanel Spacing="8">
                                                <WrapPanel ItemSpacing="12" LineSpacing="4">
                                                    <TextBlock Classes="label-md" Text="{Binding File.Path}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    <TextBlock Classes="body-sm secondary" Text="{Binding UnchangedText}" VerticalAlignment="Center" IsVisible="{Binding !IsChanged}" />
                                                </WrapPanel>
                                                <Border Background="{StaticResource Brush.Window}" CornerRadius="8" Padding="12" IsVisible="{Binding IsChanged}">
                                                    <ItemsControl ItemsSource="{Binding Lines}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:StewardPatchLine">
                                                                <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="12" Text="{Binding Text}" TextWrapping="Wrap" Classes.positive="{Binding IsAdded}" Classes.danger="{Binding IsRemoved}" Classes.secondary="{Binding IsHunk}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="body-sm secondary" Text="{Binding MentionText}" TextWrapping="Wrap" IsVisible="{Binding MentionText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsOpening}">
                            <ProgressBar Width="38" Height="6" VerticalAlignment="Center" IsIndeterminate="True" Foreground="{StaticResource Brush.Accent}" />
                            <TextBlock Classes="body-md" Text="{Binding Localization.StewardOpening}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="body-md" Text="{Binding OpenedText}" TextWrapping="Wrap" IsVisible="{Binding IsOpened}" />
                        <TextBlock Classes="body-md danger" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Panel>
</UserControl>
