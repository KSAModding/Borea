<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Borea.App.ViewModels"
             xmlns:views="using:Borea.App.Views"
             x:Class="Borea.App.Views.LaunchFailureModal"
             x:DataType="vm:MainViewModel">
    <!-- the loader stopped right after Play: why, the way out, and what it wrote -->
    <Panel Background="#99000000" views:ModalBackdrop.CloseButton="{Binding #CloseButton}">
        <Border Classes="modal" Width="561" Margin="80,0,0,0">
            <StackPanel>
                <Grid ColumnDefinitions="*,Auto" Margin="24,24,24,0">
                    <TextBlock Classes="heading-lg" Text="{Binding LaunchFailureTitle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button x:Name="CloseButton" Grid.Column="1" Classes="icon" Command="{Binding CloseLaunchFailureCommand}" AutomationProperties.Name="{Binding Localization.ModalClose}">
                        <Path Classes="icon" Data="{StaticResource Icon.Close}" />
                    </Button>
                </Grid>
                <Border Height="1" Background="{StaticResource Brush.Window}" Margin="0,24,0,0" />
                <StackPanel Margin="36,32,24,32" Spacing="16">
                    <TextBlock Classes="body-md" Text="{Binding LaunchMessage}" TextWrapping="Wrap" />
                    <Button Classes="link" HorizontalAlignment="Left" Margin="-8,0,0,0" Command="{Binding OpenLaunchLoaderReleasesCommand}" ToolTip.Tip="{Binding LaunchLoaderReleases.Url}" IsVisible="{Binding LaunchLoaderReleases, Converter={x:Static ObjectConverters.IsNotNull}}" AutomationProperties.ControlTypeOverride="Hyperlink">
                        <TextBlock Classes="action-md" Text="{Binding LaunchLoaderReleases.Label}" />
                    </Button>
                    <Border Classes="card" Padding="16" IsVisible="{Binding IsLaunchOutputShown}">
                        <ScrollViewer MaxHeight="240">
                            <SelectableTextBlock Classes="log-line" Text="{Binding LaunchOutputText}" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                    <TextBlock Classes="body-md danger" Text="{Binding LaunchFailureError}" TextWrapping="Wrap" IsVisible="{Binding LaunchFailureError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <!-- the text buttons wrap, so a long cta keeps the right edge of the text above it -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <WrapPanel ItemSpacing="8" LineSpacing="8" VerticalAlignment="Center">
                            <Button Classes="text tall" Content="{Binding Localization.LaunchShowDetails}" Command="{Binding ToggleLaunchOutputCommand}" />
                            <Button Classes="text tall" Content="{Binding Localization.LaunchOpenLog}" Command="{Binding OpenLaunchLogCommand}" />
                        </WrapPanel>
                        <Button Grid.Column="1" Classes="cta" Command="{Binding DisableBlamedModCommand}" IsVisible="{Binding CanDisableBlamedMod}">
                            <TextBlock Classes="action-lg" Text="{Binding DisableBlamedModText}" VerticalAlignment="Center" />
                        </Button>
                        <Button Grid.Column="1" Classes="cta" Command="{Binding InstallLaunchLoaderOfferCommand}" IsEnabled="{Binding !IsSetupBusy}" IsVisible="{Binding LaunchLoaderInstallText, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Classes="action-lg" Text="{Binding LaunchLoaderInstallText}" VerticalAlignment="Center" />
                        </Button>
                        <Button Grid.Column="1" Classes="text tall" Content="{Binding Localization.ModalClose}" Command="{Binding CloseLaunchFailureCommand}" IsVisible="{Binding ShowsLaunchFailureClose}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </Panel>
</UserControl>
