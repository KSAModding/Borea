<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Borea.App.ViewModels"
             xmlns:views="using:Borea.App.Views"
             x:Class="Borea.App.Views.AnnouncementModal"
             x:DataType="vm:MainViewModel">
    <Panel Background="#99000000">
        <Border Classes="modal" Width="640" Margin="80,32,0,32">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="24,24,24,0">
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Classes="heading-lg" Text="{Binding CurrentAnnouncement.Title}" TextWrapping="Wrap" />
                        <TextBlock Classes="label-md" Text="{Binding AnnouncementDateText}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="icon" VerticalAlignment="Top" Command="{Binding CloseAnnouncementCommand}" AutomationProperties.Name="{Binding Localization.ModalClose}">
                        <Path Classes="icon" Data="{StaticResource Icon.Close}" />
                    </Button>
                </Grid>
                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Brush.Window}" Margin="0,24,0,0" />
                <ScrollViewer>
                    <StackPanel Spacing="12" Margin="36,24,24,32">
                        <views:MarkdownView Markdown="{Binding CurrentAnnouncement.Body}" />
                        <Button Classes="link" HorizontalAlignment="Left" Command="{Binding OpenAnnouncementLinkCommand}" ToolTip.Tip="{Binding CurrentAnnouncement.Link}" IsVisible="{Binding CurrentAnnouncement.Link, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Classes="action-md" Text="{Binding Localization.AnnouncementOpenLink}" />
                        </Button>
                        <TextBlock Classes="body-md danger" Text="{Binding AnnouncementLinkError}" TextWrapping="Wrap" IsVisible="{Binding AnnouncementLinkError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Panel>
</UserControl>
