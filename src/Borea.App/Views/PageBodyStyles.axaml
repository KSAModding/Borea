<Styles xmlns="https://github.com/avaloniaui">
    <!-- only the pages with a "page-body" container include these styles, because a container query at app level would watch every control of every page and make each row of a long list slower to show -->
    <!-- a page body narrower than the design: tables hide the columns they can do without -->
    <ContainerQuery Name="page-body" Query="max-width:720">
        <Style Selector=":is(Control).hide-narrow">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </ContainerQuery>
    <ContainerQuery Name="page-body" Query="max-width:520">
        <Style Selector=":is(Control).hide-small">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </ContainerQuery>
</Styles>
