<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Borea.App.ViewModels"
             xmlns:views="using:Borea.App.Views"
             x:Class="Borea.App.Views.InstanceNameModal"
             x:DataType="vm:MainViewModel">
    <!-- modal: new instance, and rename instance -->
    <Panel Background="#99000000" views:ModalBackdrop.CloseButton="{Binding #CloseButton}">
        <Border Classes="modal" Width="561" Margin="80,0,0,0">
            <StackPanel>
                <Grid ColumnDefinitions="*,Auto" Margin="24,24,24,0">
                    <TextBlock Classes="heading-lg" Text="{Binding NameModalTitle}" VerticalAlignment="Center" />
                    <Button x:Name="CloseButton" Grid.Column="1" Classes="icon" Command="{Binding CancelNameModalCommand}" AutomationProperties.Name="{Binding Localization.ModalClose}">
                        <Path Classes="icon" Data="{StaticResource Icon.Close}" />
                    </Button>
                </Grid>
                <Border Height="1" Background="{StaticResource Brush.Window}" Margin="0,24,0,0" />
                <StackPanel Spacing="12" Margin="36,24,24,0" IsVisible="{Binding IsCreatingInstance}">
                    <TextBlock Classes="body-md secondary" Text="{Binding Localization.ModalInstanceExplanation}" TextWrapping="Wrap" />
                    <StackPanel Spacing="4" IsVisible="{Binding IsImportingSharedProfile}">
                        <TextBlock Classes="body-md secondary" Text="{Binding Localization.SharedProfileModalCopies}" TextWrapping="Wrap" />
                        <TextBlock Classes="body-md secondary" Text="{Binding Localization.SharedProfileModalUnchanged}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
                <Grid RowDefinitions="Auto,Auto,Auto" Margin="36,32,24,32">
                    <!-- Instance Name -->
                    <StackPanel Grid.Row="0" Spacing="6">
                        <TextBlock Classes="heading-md heading" Text="{Binding Localization.ModalNameLabel}" />
                        <TextBox Classes="field" Text="{Binding ModalInstanceName}" PlaceholderText="{Binding Localization.LibraryNewInstancePlaceholder}" AutomationProperties.Name="{Binding Localization.ModalNameLabel}" HorizontalAlignment="Stretch">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding ConfirmNameModalCommand}" />
                                <KeyBinding Gesture="Escape" Command="{Binding CancelNameModalCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                    </StackPanel>
                    <!-- Game Settings Preset -->
                    <StackPanel Grid.Row="1" Spacing="6" Margin="0,16,0,0" IsVisible="{Binding CanPickGameSettingsPreset}">
                        <TextBlock Classes="heading-md heading" Text="{Binding Localization.ChooseGameSettingsPreset}" />
                        <ComboBox ItemsSource="{Binding GameSettingsPresets}" SelectedItem="{Binding SelectedGameSettingsPreset}" PlaceholderText="{Binding Localization.SelectAPreset}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:GameSettingsPresetItem">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        <TextBlock Classes="label-md" Text="{Binding VersionText}" VerticalAlignment="Center" IsVisible="{Binding VersionText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <!-- Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,32,0,0">
                        <Button Classes="cta" Command="{Binding ConfirmNameModalCommand}">
                            <TextBlock Classes="action-lg" Text="{Binding NameModalConfirmText}" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
                <TextBlock Classes="body-md secondary" Text="{Binding Localization.SharedProfileImporting}" TextWrapping="Wrap" Margin="36,0,24,24" IsVisible="{Binding IsSharedProfileImportRunning}" />
                <TextBlock Classes="body-md danger" Text="{Binding InstanceError}" TextWrapping="Wrap" Margin="36,0,24,24" IsVisible="{Binding InstanceError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </Border>
    </Panel>
</UserControl>
