<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Borea.App.ViewModels"
             x:Class="Borea.App.Views.GamePatchNotesModal"
             x:DataType="vm:MainViewModel">
    <Panel Background="#99000000">
        <Border Classes="modal" Width="640" Margin="80,32,0,32">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="24,24,24,0">
                    <TextBlock Classes="heading-lg" Text="{Binding Localization.GamePatchNotesTitle}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="link" Margin="16,0" VerticalAlignment="Center" Command="{Binding OpenGameBuildDownloadCommand}" ToolTip.Tip="{Binding GameBuildDownloadUrl}" IsVisible="{Binding GameBuildDownloadUrl, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Classes="action-md" Text="{Binding Localization.GameBuildDownload}" />
                    </Button>
                    <Button Grid.Column="2" Classes="icon" Command="{Binding CloseGamePatchNotesCommand}" AutomationProperties.Name="{Binding Localization.ModalClose}">
                        <Path Classes="icon" Data="{StaticResource Icon.Close}" />
                    </Button>
                </Grid>
                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Brush.Window}" Margin="0,24,0,0" />
                <TextBlock DockPanel.Dock="Top" Classes="body-md danger" Margin="36,24,24,0" Text="{Binding GamePatchNotesError}" TextWrapping="Wrap" IsVisible="{Binding GamePatchNotesError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock DockPanel.Dock="Top" Classes="body-md muted" Margin="36,24,24,32" Text="{Binding Localization.GamePatchNotesEmpty}" IsVisible="{Binding HasNoGamePatchNotes}" />
                <!-- the full history has thousands of lines, so only the builds in view are created -->
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding GamePatchNotes}" Margin="36,24,24,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GamePatchNotesItem">
                                <StackPanel Spacing="8" Margin="0,0,0,24">
                                    <WrapPanel ItemSpacing="8" LineSpacing="4">
                                        <TextBlock Classes="heading-md" Text="{Binding Build}" VerticalAlignment="Center" />
                                        <TextBlock Classes="label-md" Text="{Binding DateText}" VerticalAlignment="Center" IsVisible="{Binding DateText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    </WrapPanel>
                                    <ItemsControl ItemsSource="{Binding Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,0,0,4">
                                                    <Ellipse Width="4" Height="4" Margin="0,8,0,0" VerticalAlignment="Top" Fill="{DynamicResource Brush.TextMuted}" />
                                                    <TextBlock Grid.Column="1" Classes="body-md" Text="{Binding}" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Panel>
</UserControl>
