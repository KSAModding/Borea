<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:Borea.App.ViewModels"
                    xmlns:views="using:Borea.App.Views">
    <!-- The row templates the pages use. App.axaml merges this file, so every page can reach them. -->
    <!-- the game is not set up: one line and the way to the Game tab (#152) -->
    <DataTemplate x:Key="GameSetupBanner" x:DataType="vm:MainViewModel">
        <Border Background="{StaticResource Brush.AccentSoft}" BorderBrush="{StaticResource Brush.Accent}" BorderThickness="1" CornerRadius="12" Padding="16,10" Margin="0,16,0,0">
            <Grid ColumnDefinitions="Auto,12,*,16,Auto">
                <Path Classes="icon-filled size-16" Fill="{StaticResource Brush.Accent}" Data="{StaticResource Icon.Paw}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="body-md" Text="{Binding GameSetupBannerText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="4" Classes="text primary" Content="{Binding Localization.SetupBannerAction}" Command="{Binding OpenGameSetupCommand}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </DataTemplate>
    <!-- what the last launch said, on Home and on the instance page -->
    <DataTemplate x:Key="LaunchStatus" x:DataType="vm:MainViewModel">
        <StackPanel>
            <TextBlock Classes="body-md secondary" Text="{Binding LaunchMessage}" TextWrapping="Wrap" Margin="0,16,0,0" IsVisible="{Binding LaunchMessage, Converter={x:Static ObjectConverters.IsNotNull}}" Classes.danger="{Binding HasLaunchOutput}" />
            <!-- the loader stopped while it loaded: the way out, and what it wrote -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" IsVisible="{Binding HasLaunchOutput}">
                <Button Classes="text primary" Content="{Binding DisableBlamedModText}" Command="{Binding DisableBlamedModCommand}" IsVisible="{Binding CanDisableBlamedMod}" />
                <Button Classes="text" Content="{Binding Localization.LaunchShowDetails}" Command="{Binding ToggleLaunchOutputCommand}" />
                <Button Classes="text" Content="{Binding Localization.LaunchOpenLog}" Command="{Binding OpenLaunchLogCommand}" />
            </StackPanel>
            <Border Classes="card" Padding="16" Margin="0,8,0,0" IsVisible="{Binding IsLaunchOutputShown}">
                <SelectableTextBlock Classes="log-line" Text="{Binding LaunchOutputText}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="SharedProfileBanner" x:DataType="vm:MainViewModel">
        <Border Background="{StaticResource Brush.AccentSoft}" BorderBrush="{StaticResource Brush.Accent}" BorderThickness="1" CornerRadius="12" Padding="16,10" Margin="0,16,0,0">
            <Grid ColumnDefinitions="Auto,12,*,16,Auto,8,Auto">
                <Path Classes="icon-filled size-16" Fill="{StaticResource Brush.Accent}" Data="{StaticResource Icon.Paw}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="body-md" Text="{Binding SharedProfileBannerText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="4" Classes="text" Content="{Binding Localization.SharedProfileDismiss}" Command="{Binding DismissSharedProfileBannerCommand}" VerticalAlignment="Center" />
                <Button Grid.Column="6" Classes="text primary" Content="{Binding Localization.SharedProfileCreateInstance}" Command="{Binding BeginImportSharedProfileCommand}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </DataTemplate>
    <!-- c/instance-row: used by the library list and by the Current Install card on Home.
         Delete asks for a confirmation in the row, and rename opens the name modal. -->
    <DataTemplate x:Key="InstanceRow" x:DataType="vm:InstanceItem">
        <Border Classes="card" Padding="12">
            <Grid ColumnDefinitions="70,16,*" RowDefinitions="Auto,*,Auto" Height="70">
                <Button Grid.RowSpan="3" Classes="plain" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}">
                    <Border Classes="thumbnail" Width="70" Height="70">
                        <Path Classes="icon size-32" Data="{StaticResource Icon.Box}" />
                    </Border>
                </Button>

                <!-- Title row: the name, and the switch + more or the delete confirmation -->
                <Grid Grid.Column="2" Grid.Row="0" ColumnDefinitions="*,16,Auto">
                    <Button Classes="plain" Command="{Binding OpenCommand}" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Classes="heading-md" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </Button>
                    <Panel Grid.Column="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsConfirmingDelete}">
                            <Button Classes="text danger" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryDelete}" Command="{Binding ConfirmDeleteCommand}" />
                            <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding !IsConfirmingDelete}">
                            <ToggleSwitch Classes="switch" IsChecked="{Binding IsActive, Mode=OneWay}" Command="{Binding ToggleActiveCommand}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryActivate}" VerticalAlignment="Center" />
                            <Button Classes="icon" AutomationProperties.Name="{Binding Name}">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryRename}" Command="{Binding BeginRenameCommand}" />
                                        <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryOpenFolder}" Command="{Binding OpenFolderCommand}" />
                                        <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryDuplicate}" Command="{Binding DuplicateCommand}" />
                                        <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryExportModList}" Command="{Binding ExportModListCommand}" />
                                        <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCopyModList}" Command="{Binding CopyModListCommand}" />
                                        <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryDelete}" Command="{Binding BeginDeleteCommand}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                                <Path Classes="icon-filled size-18" Data="{StaticResource Icon.More}" />
                            </Button>
                        </StackPanel>
                    </Panel>
                </Grid>

                <!-- Bottom row: chips, and the meta on the right -->
                <Grid Grid.Column="2" Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Border Classes="chip positive" IsVisible="{Binding SourceText, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Text="{Binding SourceText}" />
                        </Border>
                        <TextBlock Classes="body-md danger" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryDeleteConfirm}" VerticalAlignment="Center" IsVisible="{Binding IsConfirmingDelete}" />
                    </StackPanel>
                    <!-- c/meta: GameController + when the instance was last played, CirclesThree + the number of installed mods -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,0" ToolTip.Tip="{Binding LastPlayedToolTip}">
                            <Path Classes="icon size-16" Data="{StaticResource Icon.GameController}" />
                            <TextBlock Classes="label-md" Text="{Binding LastPlayedText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Path Classes="icon size-16" Data="{StaticResource Icon.CirclesThree}" />
                        <TextBlock Classes="label-md" Text="{Binding ModCount}" VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- the update count shows only on the Current Install card of Home -->
                    <Button Grid.Column="2" Classes="link" Height="24" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center" Command="{Binding OpenCommand}">
                        <Button.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="$parent[Window].((vm:MainViewModel)DataContext).CurrentWindowHome" />
                                <Binding Path="$parent[Window].((vm:MainViewModel)DataContext).HasActiveInstanceUpdates" />
                            </MultiBinding>
                        </Button.IsVisible>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Path Classes="icon size-16" Stroke="{StaticResource Brush.Accent}" Data="{StaticResource Icon.ArrowsLeftRight}" />
                            <TextBlock Classes="label-md" Foreground="{StaticResource Brush.Accent}" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).ActiveInstanceUpdatesText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- the changelog of one release an update passes, as Markdown or as a link -->
    <DataTemplate x:Key="ChangelogEntry" x:DataType="vm:ReleaseChangelog">
        <StackPanel Spacing="4">
            <TextBlock Classes="label-md" Text="{Binding Title}" />
            <views:MarkdownView Markdown="{Binding Text}" IsVisible="{Binding Text, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Button Classes="link" HorizontalAlignment="Left" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenLinkCommand}" CommandParameter="{Binding Link}" ToolTip.Tip="{Binding Link.Url}" IsVisible="{Binding Link, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Classes="action-md" Text="{Binding Link.Label}" />
            </Button>
        </StackPanel>
    </DataTemplate>

    <!-- one row of c/table-versions on the instance page -->
    <DataTemplate x:Key="ContentRow" x:DataType="vm:ContentItem">
        <Border BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid ColumnDefinitions="48,16,*,24,Auto" RowDefinitions="Auto,Auto,Auto">
                <Button Classes="plain" Command="{Binding OpenCommand}" IsVisible="{Binding CanOpen}" AutomationProperties.Name="{Binding Name}">
                    <Border Classes="thumbnail" Width="48" Height="48">
                        <views:ListingImageView Image="{Binding Icon}" Background="{StaticResource Brush.Surface}">
                            <Path Classes="icon" Data="{StaticResource Icon.PuzzlePiece}" />
                        </views:ListingImageView>
                    </Border>
                </Button>
                <Border Classes="thumbnail" Width="48" Height="48" IsVisible="{Binding !CanOpen}" ToolTip.Tip="{Binding NoPageText}">
                    <views:ListingImageView Image="{Binding Icon}" Background="{StaticResource Brush.Surface}">
                        <Path Classes="icon" Data="{StaticResource Icon.PuzzlePiece}" />
                    </views:ListingImageView>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Button Classes="plain" Command="{Binding OpenCommand}" IsVisible="{Binding CanOpen}" HorizontalAlignment="Left">
                        <TextBlock Classes="heading-sm" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </Button>
                    <TextBlock Classes="heading-sm" Text="{Binding Name}" TextTrimming="CharacterEllipsis" IsVisible="{Binding !CanOpen}" ToolTip.Tip="{Binding NoPageText}" />
                    <TextBlock Classes="body-sm secondary" Text="{Binding AuthorsText}" IsVisible="{Binding AuthorsText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Classes="body-sm danger" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentRemoveConfirm}" IsVisible="{Binding IsConfirmingRemove}" />
                    <TextBlock Classes="body-sm secondary" Text="{Binding ProgressStatus}" ToolTip.Tip="{Binding ProgressStatus}" TextTrimming="CharacterEllipsis" IsVisible="{Binding ProgressStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Classes="body-sm secondary" Text="{Binding InstallWarning}" ToolTip.Tip="{Binding InstallWarning}" TextTrimming="CharacterEllipsis" IsVisible="{Binding IsConfirmingUpdate}" />
                    <TextBlock Classes="body-sm danger" Text="{Binding InstallError}" ToolTip.Tip="{Binding InstallError}" TextTrimming="CharacterEllipsis" IsVisible="{Binding InstallError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Path Classes="icon size-16" Data="{StaticResource Icon.GitCommit}" />
                        <TextBlock Classes="label-md" Text="{Binding Version}" VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- one slot after the version: the lock of a dependency, or the update of any other row -->
                    <Panel VerticalAlignment="Center">
                        <Path Classes="icon" Data="{StaticResource Icon.Lock}" IsVisible="{Binding IsDependency}" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.InstanceGroupDependencies}" />
                        <Button Classes="icon" Command="{Binding UpdateCommand}" IsVisible="{Binding HasUpdate}" IsEnabled="{Binding $parent[Window].((vm:MainViewModel)DataContext).CanChangeContent}" ToolTip.Tip="{Binding UpdateText}" AutomationProperties.Name="{Binding UpdateText}">
                            <Path Classes="icon" Data="{StaticResource Icon.ArrowsLeftRight}" />
                        </Button>
                        <ProgressBar Width="38" Height="6" VerticalAlignment="Center" IsVisible="{Binding IsInstalling}" Value="{Binding Progress}" Maximum="100" Foreground="{StaticResource Brush.Accent}" />
                    </Panel>
                    <Panel IsEnabled="{Binding $parent[Window].((vm:MainViewModel)DataContext).CanChangeContent}">
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsConfirmingRemove}">
                            <Button Classes="text danger" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentRemove}" Command="{Binding ConfirmRemoveCommand}" />
                            <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelRemoveCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsConfirmingUpdate}">
                            <Button Classes="text primary" Content="{Binding ConfirmUpdateText}" Command="{Binding ConfirmUpdateCommand}" IsEnabled="{Binding Choices.IsComplete, FallbackValue={x:True}}" />
                            <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelUpdateCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <StackPanel.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="!IsConfirmingRemove" />
                                    <Binding Path="!IsConfirmingUpdate" />
                                </MultiBinding>
                            </StackPanel.IsVisible>
                            <ToggleSwitch Classes="switch" IsChecked="{Binding IsEnabled}" Command="{Binding ToggleEnabledCommand}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
                            <Button Classes="icon" Command="{Binding BeginRemoveCommand}" IsEnabled="{Binding CanRemove}" ToolTip.Tip="{Binding RemoveToolTip}" ToolTip.ShowOnDisabled="True" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding RemoveToolTip}">
                                <Path Classes="icon size-18" Data="{StaticResource Icon.Trash}" />
                            </Button>
                        </StackPanel>
                    </Panel>
                </StackPanel>
                <ContentControl Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Margin="0,8,0,0" Content="{Binding Choices}" IsVisible="{Binding Choices, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <ItemsControl Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Margin="0,8,0,0" ItemsSource="{Binding Changelogs}" ItemTemplate="{StaticResource ChangelogEntry}" IsVisible="{Binding HasChangelogs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- c/content-row on Discover -->
    <DataTemplate x:Key="DiscoverRow" x:DataType="vm:DiscoverItem">
        <Border Classes="card" Padding="12">
            <Grid ColumnDefinitions="100,16,*" MinHeight="100">
                <Button Classes="plain" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}">
                    <Border Classes="thumbnail" Width="100" Height="100">
                        <views:ListingImageView Image="{Binding Icon}" Background="{StaticResource Brush.Surface}">
                            <Path Classes="icon size-32" Data="{StaticResource Icon.PuzzlePiece}" />
                        </views:ListingImageView>
                    </Border>
                </Button>
                <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">
                    <Grid ColumnDefinitions="*,16,Auto">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="plain" Command="{Binding OpenCommand}">
                                    <TextBlock Classes="heading-md" Text="{Binding Name}" />
                                </Button>
                                <TextBlock Classes="body-sm secondary" Text="{Binding AuthorsText}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Classes="body-md secondary" Text="{Binding Abstract}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" LineHeight="18" />
                        </StackPanel>
                        <!-- c/button-icon-add -->
                        <Panel Grid.Column="2" VerticalAlignment="Top">
                            <Button Classes="add" Command="{Binding InstallCommand}" IsVisible="{Binding CanInstall}" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.DiscoverAdd}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.DiscoverAdd}">
                                <Path Classes="icon size-16" Data="{StaticResource Icon.Plus}" />
                            </Button>
                            <ProgressBar Width="38" Height="6" VerticalAlignment="Center" IsVisible="{Binding IsInstalling}" Value="{Binding Progress}" Maximum="100" Foreground="{StaticResource Brush.Accent}" />
                            <ProgressBar Width="38" Height="6" VerticalAlignment="Center" IsVisible="{Binding IsRemoving}" IsIndeterminate="True" Foreground="{StaticResource Brush.Accent}" />
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding IsInstalled}">
                                <Border Classes="chip positive" VerticalAlignment="Center" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).InstalledInText}">
                                    <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.DiscoverInstalled}" />
                                </Border>
                                <Button Classes="icon" Command="{Binding BeginRemoveCommand}" IsVisible="{Binding !IsRemoving}" IsEnabled="{Binding CanRemove}" ToolTip.Tip="{Binding RemoveToolTip}" ToolTip.ShowOnDisabled="True" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding RemoveToolTip}">
                                    <Path Classes="icon size-18" Data="{StaticResource Icon.Trash}" />
                                </Button>
                            </StackPanel>
                        </Panel>
                    </Grid>
                    <ContentControl Grid.Row="1" Margin="0,8" Content="{Binding Choices}" IsVisible="{Binding Choices, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,4,0">
                        <ItemsControl ItemsSource="{Binding Tags}" VerticalAlignment="Center" ClipToBounds="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Classes="chip">
                                        <TextBlock Text="{Binding}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsConfirmingRemove}">
                                <TextBlock Classes="body-sm danger" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentRemoveConfirm}" VerticalAlignment="Center" />
                                <Button Classes="text danger" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentRemove}" Command="{Binding ConfirmRemoveCommand}" />
                                <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelRemoveCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding ProgressStatus, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Classes="body-sm secondary" Text="{Binding ProgressStatus}" ToolTip.Tip="{Binding ProgressStatus}" MaxWidth="260" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Classes="label-md" Text="{Binding ProgressDetail}" VerticalAlignment="Center" IsVisible="{Binding ProgressDetail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsConfirmingInstall}">
                                <TextBlock Classes="body-sm secondary" Text="{Binding InstallWarning}" ToolTip.Tip="{Binding InstallWarning}" MaxWidth="260" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Button Classes="text primary" Content="{Binding ConfirmInstallText}" Command="{Binding ConfirmInstallCommand}" IsEnabled="{Binding Choices.IsComplete, FallbackValue={x:True}}" />
                                <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelInstallCommand}" />
                            </StackPanel>
                            <TextBlock Classes="body-sm danger" Text="{Binding InstallError}" ToolTip.Tip="{Binding InstallError}" IsVisible="{Binding InstallError, Converter={x:Static ObjectConverters.IsNotNull}}" MaxWidth="320" TextTrimming="CharacterEllipsis" />
                            <!-- c/meta: the downloads and the age of the newest release, when the index reports them -->
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding DownloadsText, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentDownloads}">
                                <Path Classes="icon size-16" Data="{StaticResource Icon.Download}" />
                                <TextBlock Classes="label-md" Text="{Binding DownloadsText}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding UpdatedText, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="{Binding UpdatedDateText}">
                                <Path Classes="icon size-16" Data="{StaticResource Icon.Clock}" />
                                <TextBlock Classes="label-md" Text="{Binding UpdatedText}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Classes="chip" Classes.compatible="{Binding IsCompatible}" Classes.untested="{Binding IsUntested}" Classes.incompatible="{Binding IsIncompatible}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse />
                                    <TextBlock Text="{Binding CompatibilityText}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- a pack row: the Discover row with the mod count, and no removal -->
    <DataTemplate x:Key="PackRow" x:DataType="vm:PackItem">
        <Border Classes="card" Padding="12">
            <Grid ColumnDefinitions="100,16,*" MinHeight="100">
                <Button Classes="plain" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}">
                    <Border Classes="thumbnail" Width="100" Height="100">
                        <views:ListingImageView Image="{Binding Icon}" Background="{StaticResource Brush.Surface}">
                            <Path Classes="icon size-32" Data="{StaticResource Icon.Box}" />
                        </views:ListingImageView>
                    </Border>
                </Button>
                <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">
                    <Grid ColumnDefinitions="*,16,Auto">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="plain" Command="{Binding OpenCommand}">
                                    <TextBlock Classes="heading-md" Text="{Binding Name}" />
                                </Button>
                                <TextBlock Classes="body-sm secondary" Text="{Binding AuthorsText}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Classes="body-md secondary" Text="{Binding Abstract}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" LineHeight="18" />
                        </StackPanel>
                        <Panel Grid.Column="2" VerticalAlignment="Top">
                            <Button Classes="add" Command="{Binding InstallCommand}" IsVisible="{Binding CanInstall}" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.DiscoverAdd}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.DiscoverAdd}">
                                <Path Classes="icon size-16" Data="{StaticResource Icon.Plus}" />
                            </Button>
                            <ProgressBar Width="38" Height="6" VerticalAlignment="Center" IsVisible="{Binding IsInstalling}" Value="{Binding Progress}" Maximum="100" Foreground="{StaticResource Brush.Accent}" />
                            <Border Classes="chip positive" VerticalAlignment="Center" IsVisible="{Binding IsInstalled}" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).InstalledInText}">
                                <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.DiscoverInstalled}" />
                            </Border>
                        </Panel>
                    </Grid>
                    <ContentControl Grid.Row="1" Margin="0,8" Content="{Binding Choices}" IsVisible="{Binding Choices, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,4,0">
                        <ItemsControl ItemsSource="{Binding Tags}" VerticalAlignment="Center" ClipToBounds="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Classes="chip">
                                        <TextBlock Text="{Binding}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding ProgressStatus, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Classes="body-sm secondary" Text="{Binding ProgressStatus}" ToolTip.Tip="{Binding ProgressStatus}" MaxWidth="260" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Classes="label-md" Text="{Binding ProgressDetail}" VerticalAlignment="Center" IsVisible="{Binding ProgressDetail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsConfirmingInstall}">
                                <TextBlock Classes="body-sm secondary" Text="{Binding InstallWarning}" ToolTip.Tip="{Binding InstallWarning}" MaxWidth="260" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Button Classes="text primary" Content="{Binding ConfirmInstallText}" Command="{Binding ConfirmInstallCommand}" IsEnabled="{Binding Choices.IsComplete, FallbackValue={x:True}}" />
                                <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelInstallCommand}" />
                            </StackPanel>
                            <TextBlock Classes="body-sm danger" Text="{Binding InstallError}" ToolTip.Tip="{Binding InstallError}" IsVisible="{Binding InstallError, Converter={x:Static ObjectConverters.IsNotNull}}" MaxWidth="320" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="label-md" Text="{Binding ModCountText}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" ToolTip.Tip="{Binding ReleasedDateText}">
                                <Path Classes="icon size-16" Data="{StaticResource Icon.Clock}" />
                                <TextBlock Classes="label-md" Text="{Binding ReleasedText}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Classes="chip" Classes.compatible="{Binding IsCompatible}" Classes.untested="{Binding IsUntested}" Classes.incompatible="{Binding IsIncompatible}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse />
                                    <TextBlock Text="{Binding CompatibilityText}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
