<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:Borea.App.ViewModels"
                    xmlns:views="using:Borea.App.Views">
    <!-- The row templates the pages use. App.axaml merges this file, so every page can reach them. -->
    <!-- the game is not set up: one line and the way to the Game tab (#152) -->
    <DataTemplate x:Key="GameSetupBanner" x:DataType="vm:MainViewModel">
        <views:Banner Kind="Accent" Margin="0,16,0,0" Message="{Binding GameSetupBannerText}" ActionText="{Binding Localization.SetupBannerAction}" ActionCommand="{Binding OpenGameSetupCommand}" />
    </DataTemplate>
    <!-- what the last launch said, on Home, in the Library and on the instance page -->
    <DataTemplate x:Key="LaunchStatus" x:DataType="vm:MainViewModel">
        <!-- one line, and the way out: the launch modal when the loader stopped, the use-current modal when the kept build is not found -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,0" IsVisible="{Binding LaunchMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Classes="body-md secondary" Text="{Binding LaunchMessage}" TextWrapping="Wrap" VerticalAlignment="Center" Classes.danger="{Binding HasLaunchFailed}" />
            <Button Grid.Column="1" Classes="link" Margin="16,0,0,0" VerticalAlignment="Center" Command="{Binding ShowLaunchFailureCommand}" IsVisible="{Binding HasLaunchOutput}">
                <TextBlock Classes="action-md" Text="{Binding Localization.LaunchShowDetails}" />
            </Button>
            <Button Grid.Column="1" Classes="link" Margin="16,0,0,0" VerticalAlignment="Center" Command="{Binding LaunchGameBuildMissingItem.BeginUseCurrentGameBuildCommand}" IsVisible="{Binding LaunchGameBuildMissingItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Classes="action-md" Text="{Binding Localization.InstanceUseCurrentGameBuild}" />
            </Button>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="SharedProfileBanner" x:DataType="vm:MainViewModel">
        <views:Banner Kind="Outline" Margin="0,16,0,0" Message="{Binding SharedProfileBannerText}" ActionText="{Binding Localization.SharedProfileCreateInstance}" ActionCommand="{Binding BeginImportSharedProfileCommand}" DismissCommand="{Binding DismissSharedProfileBannerCommand}" DismissText="{Binding Localization.SharedProfileDismiss}" />
    </DataTemplate>
    <DataTemplate x:Key="InstanceHint" x:DataType="vm:MainViewModel">
        <WrapPanel ItemSpacing="12" LineSpacing="4">
            <TextBlock Classes="body-md secondary" Text="{Binding InstanceHintText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Classes="link" Command="{Binding FollowInstanceHintCommand}" VerticalAlignment="Center" AutomationProperties.Name="{Binding InstanceHintActionText}">
                <TextBlock Classes="action-md" Text="{Binding InstanceHintActionText}" />
            </Button>
        </WrapPanel>
    </DataTemplate>
    <!-- the kept build of the active instance is not found: one line, and the way out -->
    <DataTemplate x:Key="ActiveKeptBuildUnavailable" x:DataType="vm:MainViewModel">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="body-md danger" Text="{Binding ActiveInstance.AddRefusalText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="link" Margin="16,0,0,0" VerticalAlignment="Center" Command="{Binding ActiveInstance.BeginUseCurrentGameBuildCommand}">
                <TextBlock Classes="action-md" Text="{Binding Localization.InstanceUseCurrentGameBuild}" />
            </Button>
        </Grid>
    </DataTemplate>
    <!-- the page header names the instance that Add goes into, and leads to the Library to change it -->
    <DataTemplate x:Key="AddingTo" x:DataType="vm:MainViewModel">
        <Button Classes="plain" HorizontalAlignment="Right" Margin="16,0,0,0" Command="{Binding SetMainWindowLibraryCommand}" IsVisible="{Binding HasActiveInstance}" ToolTip.Tip="{Binding AddingToText}" AutomationProperties.Name="{Binding AddingToText}" AutomationProperties.HelpText="{Binding Localization.DiscoverOpenLibrary}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Classes="label-lg" Text="{Binding AddingToBefore}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="label-lg" Text="{Binding ActiveInstance.Name}" Foreground="{StaticResource Brush.Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="label-lg" Text="{Binding AddingToAfter}" VerticalAlignment="Center" />
            </Grid>
        </Button>
    </DataTemplate>
    <!-- c/instance-row: used by the library list and by the Current Install card on Home -->
    <DataTemplate x:Key="InstanceRow" x:DataType="vm:InstanceItem">
        <Button Classes="plain card-button" views:RowButton.IgnoresDisabled="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}">
            <Border Classes="card" Padding="12">
                <Grid ColumnDefinitions="70,16,*" RowDefinitions="Auto,*,Auto" Height="70">
                    <Border Grid.RowSpan="3" Classes="thumbnail" Width="70" Height="70">
                        <Path Classes="icon size-32" Data="{StaticResource Icon.Box}" />
                    </Border>

                    <!-- Title row: the name, and Play on the active row of the Library, the switch + more -->
                    <Grid Grid.Column="2" Grid.Row="0" ColumnDefinitions="*,16,Auto">
                        <TextBlock Classes="heading-md" Text="{Binding Name}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Button Classes="cta with-icon" Command="{Binding PlayCommand}" IsEnabled="{Binding $parent[Window].((vm:MainViewModel)DataContext).EnableActiveInstance}" VerticalAlignment="Center">
                                <Button.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="IsActive" />
                                        <Binding Path="$parent[Window].((vm:MainViewModel)DataContext).CurrentWindowLibrary" />
                                    </MultiBinding>
                                </Button.IsVisible>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="icon-filled size-16" Fill="{StaticResource Brush.SurfaceHeader}" Data="{StaticResource Icon.Play}" VerticalAlignment="Center" />
                                    <TextBlock Classes="action-lg" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.InstancePlay}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <ToggleSwitch Classes="switch" IsChecked="{Binding IsActive, Mode=OneWay}" Command="{Binding ToggleActiveCommand}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryActivate}" VerticalAlignment="Center" />
                            <views:InstanceMenu />
                        </StackPanel>
                    </Grid>

                    <!-- Bottom row: chips, and the meta on the right -->
                    <Grid Grid.Column="2" Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Border Classes="chip positive" IsVisible="{Binding SourceText, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Text="{Binding SourceText}" />
                            </Border>
                            <!-- after an update, the chip shows which instances still start the build they keep -->
                            <Border Classes="chip muted" IsVisible="{Binding GameBuildText, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="{Binding GameBuildToolTip}" AutomationProperties.Name="{Binding GameBuildToolTip}">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.PushPin}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding GameBuildText}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <!-- c/meta: GameController + when the instance was last played, CirclesThree + the number of installed mods -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,0" ToolTip.Tip="{Binding LastPlayedToolTip}">
                                <Path Classes="icon size-16" Data="{StaticResource Icon.GameController}" />
                                <TextBlock Classes="label-md" Text="{Binding LastPlayedText}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="{Binding ModCountToolTip}">
                                <Path Classes="icon size-16" Data="{StaticResource Icon.CirclesThree}" />
                                <TextBlock Classes="label-md" Text="{Binding ModCount}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <!-- the update count shows only on the Current Install card of Home, and only for the active instance it counts -->
                        <Button Grid.Column="2" Classes="link" Height="24" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center" Command="{Binding OpenCommand}">
                            <Button.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsActive" />
                                    <Binding Path="$parent[Window].((vm:MainViewModel)DataContext).CurrentWindowHome" />
                                    <Binding Path="$parent[Window].((vm:MainViewModel)DataContext).HasActiveInstanceUpdates" />
                                </MultiBinding>
                            </Button.IsVisible>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Path Classes="icon size-16" Stroke="{StaticResource Brush.Accent}" Data="{StaticResource Icon.ArrowsLeftRight}" />
                                <TextBlock Classes="label-md" Foreground="{StaticResource Brush.Accent}" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).ActiveInstanceUpdatesText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Button>
    </DataTemplate>

    <!-- the changelog of one release an update passes, as Markdown or as a link -->
    <DataTemplate x:Key="ChangelogEntry" x:DataType="vm:ReleaseChangelog">
        <StackPanel Spacing="4">
            <TextBlock Classes="label-md" Text="{Binding Title}" IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <views:MarkdownView IsCompact="True" Markdown="{Binding Text}" IsVisible="{Binding Text, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Button Classes="link" HorizontalAlignment="Left" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenLinkCommand}" CommandParameter="{Binding Link}" ToolTip.Tip="{Binding Link.Url}" IsVisible="{Binding Link, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Classes="action-md" Text="{Binding Link.Label}" />
            </Button>
        </StackPanel>
    </DataTemplate>

    <!-- steps a listing asks the player to do by hand, as plain text in the author's words (RFC 0035) -->
    <DataTemplate x:Key="StepList" x:DataType="vm:StepList">
        <StackPanel Spacing="4">
            <TextBlock Classes="label-md" Text="{Binding Heading}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NumberedStep">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                            <TextBlock Classes="body-sm secondary" Text="{Binding Number}" />
                            <TextBlock Grid.Column="1" Classes="body-sm" Text="{Binding Text}" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>

    <!-- the panel of several step lists, such as one for each listing a plan installs -->
    <ItemsPanelTemplate x:Key="StepListsPanel">
        <StackPanel Spacing="8" />
    </ItemsPanelTemplate>

    <!-- the Play button under the steps of a new vehicle or save, built only for a row that shows them, because every control of a row costs each time the list shows the row -->
    <DataTemplate x:Key="InstalledPlayButton" x:DataType="vm:DiscoverItem">
        <StackPanel Spacing="4">
            <Button Classes="cta with-icon" HorizontalAlignment="Left" Command="{Binding PlayInstalledCommand}" IsEnabled="{Binding CanPlayInstalled}" ToolTip.Tip="{Binding InstalledPlayText}">
                <!-- a dock panel gives the name the width that is left, so it trims inside the button -->
                <DockPanel>
                    <Path Classes="icon-filled size-16" Fill="{StaticResource Brush.SurfaceHeader}" Data="{StaticResource Icon.Play}" DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Classes="action-lg" Text="{Binding InstalledPlayText}" MaxWidth="320" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
            <!-- the launch line shows on Home, in the Library and on the instance page, and this button is on none of them -->
            <TextBlock Classes="body-sm secondary" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).LaunchMessage}" TextWrapping="Wrap" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsLaunching}" />
        </StackPanel>
    </DataTemplate>

    <!-- the body of one row of c/table-versions, which the row shows inside its button or, without a page, on its own.
         The columns after the name share their widths with the other rows of the page, so each column starts at the same place in every row -->
    <DataTemplate x:Key="ContentRowBody" x:DataType="vm:ContentItem">
        <Border Classes="list-row" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ContentDetached" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ContentSize" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ContentVersion" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ContentSlot" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ContentActions" />
                </Grid.ColumnDefinitions>
                <Border Classes="thumbnail" Width="48" Height="48" ToolTip.Tip="{Binding NoPageText}">
                    <views:ListingImageView Image="{Binding Icon}" Background="{StaticResource Brush.Surface}">
                        <Path Classes="icon" Data="{StaticResource Icon.PuzzlePiece}" />
                    </views:ListingImageView>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Classes="heading-sm" Text="{Binding Name}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" ToolTip.Tip="{Binding NoPageText}" />
                    <TextBlock Classes="body-sm secondary" Text="{Binding AuthorsText}" IsVisible="{Binding AuthorsText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Classes="body-sm secondary" Text="{Binding GoneText}" ToolTip.Tip="{Binding GoneText}" TextTrimming="CharacterEllipsis" IsVisible="{Binding GoneText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Classes="body-sm secondary" Text="{Binding HeldText}" TextWrapping="Wrap" IsVisible="{Binding HeldText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Classes="body-sm danger" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentNotOnDisk}" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentNotOnDiskDetail}" IsVisible="{Binding IsMissing}" />
                    <TextBlock Classes="body-sm danger" Text="{Binding RemoveConfirmText}" TextWrapping="Wrap" IsVisible="{Binding IsConfirmingRemove}" />
                    <TextBlock Classes="body-sm danger" Text="{Binding DisableConfirmText}" TextWrapping="Wrap" IsVisible="{Binding IsConfirmingDisable}" />
                    <ContentControl Margin="0,4,0,0" Content="{Binding RemoveSteps}" ContentTemplate="{StaticResource StepList}">
                        <ContentControl.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsConfirmingRemove" />
                                <Binding Path="RemoveSteps" Converter="{x:Static ObjectConverters.IsNotNull}" />
                            </MultiBinding>
                        </ContentControl.IsVisible>
                    </ContentControl>
                    <TextBlock Classes="body-sm danger" Text="{Binding ManageConfirmText}" TextWrapping="Wrap" IsVisible="{Binding IsConfirmingManage}" />
                    <TextBlock Classes="body-sm danger" Text="{Binding ManageMissingText}" TextWrapping="Wrap" IsVisible="{Binding ManageMissingText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <CheckBox IsChecked="{Binding InstallManageDependencies}" IsVisible="{Binding ManageInstallMissingText, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Classes="body-sm" Text="{Binding ManageInstallMissingText}" TextWrapping="Wrap" />
                    </CheckBox>
                    <TextBlock Classes="body-sm secondary" Text="{Binding ManageNotInstalledText}" TextWrapping="Wrap" IsVisible="{Binding ManageNotInstalledText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Classes="body-sm secondary" Text="{Binding ProgressStatus}" ToolTip.Tip="{Binding ProgressStatus}" TextTrimming="CharacterEllipsis" IsVisible="{Binding ProgressStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Classes="body-sm secondary" Text="{Binding PackVersionText}" TextWrapping="Wrap" IsVisible="{Binding PackVersionText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Classes="body-sm" Foreground="{StaticResource Brush.Untested}" Text="{Binding InstallWarning}" TextWrapping="Wrap" IsVisible="{Binding IsConfirmingUpdate}" />
                    <TextBlock Classes="body-sm danger" Text="{Binding InstallError}" ToolTip.Tip="{Binding InstallError}" TextTrimming="CharacterEllipsis" IsVisible="{Binding InstallError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
                <!-- a mod of the pack that the player detached, which the row menu attaches again -->
                <Border Grid.Column="3" Classes="chip muted" Margin="24,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding DetachedText, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="{Binding DetachedText}" AutomationProperties.Name="{Binding DetachedText}">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Path Classes="icon size-16" Data="{StaticResource Icon.LinkSimpleBreak}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentDetached}" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" Margin="24,0,0,0" VerticalAlignment="Center" IsVisible="{Binding SizeText, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentSizeOnDisk}">
                    <Path Classes="icon size-16" Data="{StaticResource Icon.HardDrive}" />
                    <TextBlock Classes="label-md" Text="{Binding SizeText}" VerticalAlignment="Center" />
                </StackPanel>
                <!-- a long pre-release version is trimmed, so that it does not take the room of the names in every row -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" Margin="24,0,0,0" VerticalAlignment="Center">
                    <Path Classes="icon size-16" Data="{StaticResource Icon.GitCommit}" />
                    <TextBlock Classes="label-md" Text="{Binding Version}" MaxWidth="160" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Version}" VerticalAlignment="Center" />
                    <Path Classes="icon size-16" Data="{StaticResource Icon.PushPin}" IsVisible="{Binding IsPinned}" ToolTip.Tip="{Binding PinnedText}" AutomationProperties.Name="{Binding PinnedText}" />
                </StackPanel>
                <!-- one slot after the version: the lock of a dependency, or the update of any other row -->
                <Panel Grid.Column="6" Margin="24,0,0,0" VerticalAlignment="Center">
                    <Path Classes="icon" Data="{StaticResource Icon.Lock}" IsVisible="{Binding IsDependency}" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.InstanceGroupDependencies}" />
                    <Button Classes="icon" Command="{Binding UpdateCommand}" IsVisible="{Binding HasUpdate}" IsEnabled="{Binding $parent[Window].((vm:MainViewModel)DataContext).CanChangeContent}" ToolTip.Tip="{Binding UpdateText}" AutomationProperties.Name="{Binding UpdateText}">
                        <Path Classes="icon" Data="{StaticResource Icon.ArrowsLeftRight}" />
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding IsInstalling}">
                        <ProgressBar Width="38" MinWidth="0" Height="6" VerticalAlignment="Center" Value="{Binding Progress}" Maximum="100" Foreground="{StaticResource Brush.Accent}" />
                        <Button Classes="icon" Command="{Binding Run.TogglePauseCommand}" IsVisible="{Binding !Run.IsStopping, FallbackValue={x:True}}" ToolTip.Tip="{Binding Run.PauseText}" AutomationProperties.Name="{Binding Run.PauseText}">
                            <Panel>
                                <Path Classes="icon size-16" Data="{StaticResource Icon.Pause}" IsVisible="{Binding !Run.IsPaused, FallbackValue={x:True}}" />
                                <Path Classes="icon-filled size-16" Data="{StaticResource Icon.Play}" IsVisible="{Binding Run.IsPaused, FallbackValue={x:False}}" />
                            </Panel>
                        </Button>
                        <Button Classes="icon" Command="{Binding Run.StopCommand}" IsVisible="{Binding !Run.IsStopping, FallbackValue={x:True}}" ToolTip.Tip="{Binding Run.StopText}" AutomationProperties.Name="{Binding Run.StopText}">
                            <Path Classes="icon size-16" Data="{StaticResource Icon.Close}" />
                        </Button>
                        <TextBlock Classes="body-sm secondary" Text="{Binding Run.StopText}" VerticalAlignment="Center" IsVisible="{Binding Run.IsStopping, FallbackValue={x:False}}" />
                    </StackPanel>
                </Panel>
                <!-- the actions end at the right edge of the row, as in the Versions table of a mod -->
                <Panel Grid.Column="7" Margin="24,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="{Binding $parent[Window].((vm:MainViewModel)DataContext).CanChangeContent}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <StackPanel.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!IsConfirmingRemove" />
                                <Binding Path="!IsConfirmingUpdate" />
                                <Binding Path="!IsConfirmingManage" />
                            </MultiBinding>
                        </StackPanel.IsVisible>
                        <ToggleSwitch Classes="switch" IsChecked="{Binding IsEnabled}" Command="{Binding ToggleEnabledCommand}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
                        <Button Classes="icon" VerticalAlignment="Center" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryMoreActions}">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentOpenPage}" Command="{Binding OpenCommand}" IsVisible="{Binding CanOpen}" />
                                    <MenuItem Header="{Binding Page.FavoriteText}" Command="{Binding Page.ToggleFavoriteCommand}" IsVisible="{Binding CanOpen}" />
                                    <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentManage}" Command="{Binding BeginManageCommand}" IsVisible="{Binding CanManage}" />
                                    <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentInstallAgain}" Command="{Binding InstallAgainCommand}" IsVisible="{Binding IsMissing}" />
                                    <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentPinVersion}" Command="{Binding PinCommand}" IsVisible="{Binding CanPin}" />
                                    <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentUnpin}" Command="{Binding UnpinCommand}" IsVisible="{Binding IsPinned}" />
                                    <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentDetachFromPack}" Command="{Binding DetachCommand}" IsVisible="{Binding CanDetach}" />
                                    <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentAttachToPack}" Command="{Binding AttachCommand}" IsVisible="{Binding CanAttach}" />
                                    <MenuItem Header="{Binding RemoveActionText}" Command="{Binding BeginRemoveCommand}" IsEnabled="{Binding CanRemove}" AutomationProperties.HelpText="{Binding RemoveBlockedText}" />
                                    <MenuItem IsEnabled="False" IsVisible="{Binding RemoveBlockedText, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <MenuItem.Header>
                                            <TextBlock Classes="body-sm secondary" Text="{Binding RemoveBlockedText}" TextWrapping="Wrap" MaxWidth="260" />
                                        </MenuItem.Header>
                                    </MenuItem>
                                </MenuFlyout>
                            </Button.Flyout>
                            <Path Classes="icon-filled" Data="{StaticResource Icon.More}" />
                        </Button>
                    </StackPanel>
                </Panel>
                <!-- a confirmation opens below the row, as on the Versions tab of a mod, so it does not make the shared actions column of every row wider -->
                <StackPanel Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="6" Margin="0,8,0,0" HorizontalAlignment="Right" IsEnabled="{Binding $parent[Window].((vm:MainViewModel)DataContext).CanChangeContent}">
                    <StackPanel.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                            <Binding Path="IsConfirmingRemove" />
                            <Binding Path="IsConfirmingUpdate" />
                            <Binding Path="IsConfirmingManage" />
                            <Binding Path="IsConfirmingDisable" />
                        </MultiBinding>
                    </StackPanel.IsVisible>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsConfirmingDisable}">
                        <Button Classes="text danger" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentDisable}" Command="{Binding ConfirmDisableCommand}" />
                        <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelDisableCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsConfirmingRemove}">
                        <Button Classes="text danger" Content="{Binding RemoveActionText}" Command="{Binding ConfirmRemoveCommand}" />
                        <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelRemoveCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsConfirmingUpdate}">
                        <Button Classes="text primary" Content="{Binding ConfirmUpdateText}" Command="{Binding ConfirmUpdateCommand}" IsEnabled="{Binding Choices.IsComplete, FallbackValue={x:True}}" />
                        <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelUpdateCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsConfirmingManage}">
                        <Button Classes="text danger" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentManageConfirmAction}" Command="{Binding ConfirmManageCommand}" />
                        <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelManageCommand}" />
                    </StackPanel>
                </StackPanel>
                <ContentControl Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="6" Margin="0,8,0,0" Content="{Binding Choices}" IsVisible="{Binding Choices, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <ItemsControl Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="6" Margin="0,8,0,0" ItemsSource="{Binding Changelogs}" ItemTemplate="{StaticResource ChangelogEntry}" IsVisible="{Binding HasChangelogs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- one row of c/table-versions on the instance page. The whole row opens the mod page, unless the index knows no page for the mod. -->
    <DataTemplate x:Key="ContentRow" x:DataType="vm:ContentItem">
        <Panel>
            <Button Classes="plain card-button" views:RowButton.IgnoresDisabled="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}" IsVisible="{Binding CanOpen}" Content="{Binding PageRow}" ContentTemplate="{StaticResource ContentRowBody}" />
            <ContentControl IsVisible="{Binding !CanOpen}" Content="{Binding PlainRow}" ContentTemplate="{StaticResource ContentRowBody}" />
        </Panel>
    </DataTemplate>

    <!-- an author name, which shows Discover with only the content of that author -->
    <DataTemplate x:Key="AuthorLink" x:DataType="vm:AuthorLink">
        <Button Classes="plain" VerticalAlignment="Center" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).FilterByAuthorCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding Hint}" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Hint}">
            <!-- the comma is in the same text as the name, so it trims with the name and never stays alone -->
            <TextBlock Classes="body-sm secondary" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Name}" /><Run Text="{Binding Separator}" Foreground="{StaticResource Brush.TextSecondary}" />
            </TextBlock>
        </Button>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="AuthorLinksPanel">
        <WrapPanel ItemSpacing="4" />
    </ItemsPanelTemplate>

    <!-- an author name on the one line of a row, whose comma stands before the name, so a name that drops out takes its comma along and the tooltip keeps the whole list -->
    <DataTemplate x:Key="RowAuthorLink" x:DataType="vm:AuthorLink">
        <Button Classes="plain" VerticalAlignment="Center" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).FilterByAuthorCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding RowHint}" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding RowHint}">
            <TextBlock Classes="body-sm secondary" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding RowSeparator}" Foreground="{StaticResource Brush.TextSecondary}" /><Run Text="{Binding Name}" />
            </TextBlock>
        </Button>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="RowAuthorLinksPanel">
        <WrapPanel />
    </ItemsPanelTemplate>

    <!-- c/content-row on Discover -->
    <DataTemplate x:Key="DiscoverRow" x:DataType="vm:DiscoverItem">
        <Button Classes="plain card-button" views:RowButton.IgnoresDisabled="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}">
            <Border Classes="card" Padding="12">
                <Grid ColumnDefinitions="100,16,*" MinHeight="100">
                    <Border Classes="thumbnail" Width="100" Height="100">
                        <!-- a vehicle without an icon shows its still, and every other row shows its icon -->
                        <views:PreviewStillView StillPath="{Binding PreviewStillPath}" Note="{Binding PreviewStillNote}" Background="{StaticResource Brush.Surface}">
                            <views:ListingImageView Image="{Binding Icon}" Background="{StaticResource Brush.Surface}">
                                <Panel>
                                    <Path Classes="icon size-32" Data="{StaticResource Icon.PuzzlePiece}" IsVisible="{Binding !IsVehicleOrSave}" />
                                    <Path Classes="icon size-32" Data="{StaticResource Icon.Cylinder}" IsVisible="{Binding IsVehicle}" />
                                    <Path Classes="icon size-32" Data="{StaticResource Icon.Planet}" IsVisible="{Binding IsSave}" />
                                </Panel>
                            </views:ListingImageView>
                        </views:PreviewStillView>
                    </Border>
                    <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto,Auto">
                        <Grid ColumnDefinitions="*,16,Auto">
                            <StackPanel Spacing="4">
                                <DockPanel>
                                    <TextBlock Classes="heading-md" Text="{Binding Name}" TextTrimming="CharacterEllipsis" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                    <Path Classes="icon size-16 favorite" Data="{StaticResource Icon.Star}" DockPanel.Dock="Left" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsFavorite}" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.DiscoverFavorite}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.DiscoverFavorite}" />
                                    <DockPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Classes="body-sm secondary" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).ByAuthorBefore}" TextTrimming="CharacterEllipsis" DockPanel.Dock="Left" Margin="0,0,3,0" VerticalAlignment="Center" />
                                        <!-- one line of 16 px, so an author that does not fit on it drops out whole -->
                                        <ItemsControl ItemsSource="{Binding AuthorLinks}" ItemTemplate="{StaticResource RowAuthorLink}" ItemsPanel="{StaticResource RowAuthorLinksPanel}" DockPanel.Dock="Left" MaxHeight="16" ClipToBounds="True" VerticalAlignment="Center" />
                                        <TextBlock Classes="body-sm secondary" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).ByAuthorAfter}" TextTrimming="CharacterEllipsis" Margin="3,0,0,0" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DockPanel>
                                <TextBlock Classes="body-md secondary" Text="{Binding Abstract}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" LineHeight="18" />
                            </StackPanel>
                            <!-- c/button-icon-add -->
                            <Panel Grid.Column="2" VerticalAlignment="Top">
                                <Button Classes="add" Command="{Binding InstallCommand}" IsVisible="{Binding CanInstall}" IsEnabled="{Binding $parent[Window].((vm:MainViewModel)DataContext).CanAddToActiveInstance}" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).AddToText}" ToolTip.ShowOnDisabled="True" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).AddToText}">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Plus}" />
                                </Button>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding IsInstalling}">
                                    <ProgressBar Width="38" Height="6" VerticalAlignment="Center" Value="{Binding Progress}" Maximum="100" Foreground="{StaticResource Brush.Accent}" />
                                    <Button Classes="icon" Command="{Binding Run.TogglePauseCommand}" IsVisible="{Binding !Run.IsStopping, FallbackValue={x:True}}" ToolTip.Tip="{Binding Run.PauseText}" AutomationProperties.Name="{Binding Run.PauseText}">
                                        <Panel>
                                            <Path Classes="icon size-16" Data="{StaticResource Icon.Pause}" IsVisible="{Binding !Run.IsPaused, FallbackValue={x:True}}" />
                                            <Path Classes="icon-filled size-16" Data="{StaticResource Icon.Play}" IsVisible="{Binding Run.IsPaused, FallbackValue={x:False}}" />
                                        </Panel>
                                    </Button>
                                    <Button Classes="icon" Command="{Binding Run.StopCommand}" IsVisible="{Binding !Run.IsStopping, FallbackValue={x:True}}" ToolTip.Tip="{Binding Run.StopText}" AutomationProperties.Name="{Binding Run.StopText}">
                                        <Path Classes="icon size-16" Data="{StaticResource Icon.Close}" />
                                    </Button>
                                    <TextBlock Classes="body-sm secondary" Text="{Binding Run.StopText}" VerticalAlignment="Center" IsVisible="{Binding Run.IsStopping, FallbackValue={x:False}}" />
                                </StackPanel>
                                <ProgressBar Width="38" Height="6" VerticalAlignment="Center" IsVisible="{Binding IsRemoving}" IsIndeterminate="True" Foreground="{StaticResource Brush.Accent}" />
                                <Button Classes="add installed" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).InstalledInText}" AutomationProperties.Name="{Binding InstalledAutomationName}" AutomationProperties.HelpText="{Binding $parent[Window].((vm:MainViewModel)DataContext).InstalledInText}">
                                    <Button.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="IsInstalled" />
                                            <Binding Path="!IsRemoving" />
                                        </MultiBinding>
                                    </Button.IsVisible>
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuItem Header="{Binding FavoriteText}" Command="{Binding ToggleFavoriteCommand}" />
                                            <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentChangeVersion}" Command="{Binding ChangeVersionCommand}" IsVisible="{Binding CanChangeVersion}" />
                                            <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentRemove}" Command="{Binding BeginRemoveCommand}" AutomationProperties.HelpText="{Binding RemoveBlockedText}" />
                                            <MenuItem IsEnabled="False" IsVisible="{Binding RemoveBlockedText, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <MenuItem.Header>
                                                    <TextBlock Classes="body-sm secondary" Text="{Binding RemoveBlockedText}" TextWrapping="Wrap" MaxWidth="260" />
                                                </MenuItem.Header>
                                            </MenuItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Check}" />
                                </Button>
                            </Panel>
                        </Grid>
                        <ContentControl Grid.Row="1" Margin="0,8" Content="{Binding Choices}" IsVisible="{Binding Choices, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <!-- the row's actions and status, on a line of their own so that they never reach past the card -->
                        <StackPanel Grid.Row="2">
                            <!-- the question and the two buttons keep one line while they fit, and the buttons take the next line when they do not -->
                            <WrapPanel HorizontalAlignment="Right" ItemsAlignment="End" ItemSpacing="8" LineSpacing="8" Margin="0,0,4,8" IsVisible="{Binding IsConfirmingRemove}">
                                <TextBlock Classes="body-sm danger" Text="{Binding RemoveConfirmText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="text danger" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentRemove}" Command="{Binding ConfirmRemoveCommand}" />
                                    <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelRemoveCommand}" />
                                </StackPanel>
                            </WrapPanel>
                            <ContentControl Margin="0,0,4,8" Content="{Binding RemoveSteps}" ContentTemplate="{StaticResource StepList}">
                                <ContentControl.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="IsConfirmingRemove" />
                                        <Binding Path="RemoveSteps" Converter="{x:Static ObjectConverters.IsNotNull}" />
                                    </MultiBinding>
                                </ContentControl.IsVisible>
                            </ContentControl>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,4,8" IsVisible="{Binding ProgressStatus, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Classes="body-sm secondary" Text="{Binding ProgressStatus}" ToolTip.Tip="{Binding ProgressStatus}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="label-md" Text="{Binding ProgressDetail}" VerticalAlignment="Center" IsVisible="{Binding ProgressDetail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </Grid>
                            <ItemsControl Margin="0,0,4,8" ItemsSource="{Binding PlanSteps}" ItemTemplate="{StaticResource StepList}" ItemsPanel="{StaticResource StepListsPanel}" IsVisible="{Binding !!PlanSteps.Count}" />
                            <!-- the texts take the whole width, because a warning can be long, and the buttons keep their own row -->
                            <StackPanel Spacing="8" Margin="0,0,4,8" IsVisible="{Binding IsConfirmingInstall}">
                                <TextBlock Classes="body-sm secondary" Text="{Binding AddedModsText}" ToolTip.Tip="{Binding AddedModsToolTip}" IsVisible="{Binding AddedModsText, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="body-sm" Foreground="{StaticResource Brush.Untested}" Text="{Binding InstallWarning}" IsVisible="{Binding InstallWarning, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />
                                <WrapPanel HorizontalAlignment="Right" ItemsAlignment="End" ItemSpacing="8" LineSpacing="8">
                                    <Button Classes="text primary" Content="{Binding ConfirmInstallText}" Command="{Binding ConfirmInstallCommand}" IsEnabled="{Binding Choices.IsComplete, FallbackValue={x:True}}" />
                                    <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelInstallCommand}" />
                                </WrapPanel>
                            </StackPanel>
                            <TextBlock Classes="body-sm danger" Text="{Binding InstallError}" ToolTip.Tip="{Binding InstallError}" IsVisible="{Binding InstallError, Converter={x:Static ObjectConverters.IsNotNull}}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" Margin="0,0,4,8" />
                            <!-- what the author still asks for after an install and where a new vehicle or save is in the game, until the player dismisses it -->
                            <StackPanel Spacing="8" Margin="0,0,4,8" IsVisible="{Binding HasInstallStepsNotice}">
                                <ItemsControl ItemsSource="{Binding InstallStepsNotice}" ItemTemplate="{StaticResource StepList}" ItemsPanel="{StaticResource StepListsPanel}" />
                                <WrapPanel ItemSpacing="8" LineSpacing="8">
                                    <ContentControl Content="{Binding InstalledPlayRow}" ContentTemplate="{StaticResource InstalledPlayButton}" />
                                    <Button Classes="text" VerticalAlignment="Center" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.InstallStepsDismiss}" Command="{Binding DismissInstallStepsNoticeCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,0,4,0">
                            <Border Classes="chip" Classes.compatible="{Binding IsCompatible}" Classes.incompatible="{Binding IsIncompatible}" IsVisible="{Binding ShowsCompatibility}" VerticalAlignment="Center" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse />
                                    <TextBlock Text="{Binding CompatibilityText}" />
                                </StackPanel>
                            </Border>
                            <!-- an installed row leads its tags with a green Installed chip -->
                            <views:TagChipRow Grid.Column="1" Tags="{Binding AllTags}" Lead="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.DiscoverInstalled}" ShowsLead="{Binding IsInstalled}" LeadTip="{Binding $parent[Window].((vm:MainViewModel)DataContext).InstalledInText}" VerticalAlignment="Center" Margin="0,0,24,0" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" Margin="8,0,0,0">
                                <!-- c/meta: the downloads and the age of the newest release, when the index reports them -->
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding DownloadsText, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="{Binding DownloadsExactText}">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Download}" />
                                    <TextBlock Classes="label-md" Text="{Binding DownloadsText}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding UpdatedText, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="{Binding UpdatedDateText}">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Clock}" />
                                    <TextBlock Classes="label-md" Text="{Binding UpdatedText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Button>
    </DataTemplate>

    <!-- a pack row: the Discover row with the mod count, and no removal -->
    <DataTemplate x:Key="PackRow" x:DataType="vm:PackItem">
        <Button Classes="plain card-button" views:RowButton.IgnoresDisabled="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}">
            <Border Classes="card" Padding="12">
                <Grid ColumnDefinitions="100,16,*" MinHeight="100">
                    <Border Classes="thumbnail" Width="100" Height="100">
                        <views:ListingImageView Image="{Binding Icon}" Background="{StaticResource Brush.Surface}">
                            <Path Classes="icon size-32" Data="{StaticResource Icon.Box}" />
                        </views:ListingImageView>
                    </Border>
                    <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto,Auto">
                        <Grid ColumnDefinitions="*,16,Auto">
                            <StackPanel Spacing="4">
                                <DockPanel>
                                    <TextBlock Classes="heading-md" Text="{Binding Name}" TextTrimming="CharacterEllipsis" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                    <Path Classes="icon size-16 favorite" Data="{StaticResource Icon.Star}" DockPanel.Dock="Left" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsFavorite}" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.DiscoverFavorite}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.DiscoverFavorite}" />
                                    <DockPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Classes="body-sm secondary" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).ByAuthorBefore}" TextTrimming="CharacterEllipsis" DockPanel.Dock="Left" Margin="0,0,3,0" VerticalAlignment="Center" />
                                        <!-- one line of 16 px, so an author that does not fit on it drops out whole -->
                                        <ItemsControl ItemsSource="{Binding AuthorLinks}" ItemTemplate="{StaticResource RowAuthorLink}" ItemsPanel="{StaticResource RowAuthorLinksPanel}" DockPanel.Dock="Left" MaxHeight="16" ClipToBounds="True" VerticalAlignment="Center" />
                                        <TextBlock Classes="body-sm secondary" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).ByAuthorAfter}" TextTrimming="CharacterEllipsis" Margin="3,0,0,0" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DockPanel>
                                <TextBlock Classes="body-md secondary" Text="{Binding Abstract}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" LineHeight="18" />
                                <Grid ColumnDefinitions="Auto,4,*" IsVisible="{Binding HasNewerReleases}">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.ArrowsLeftRight}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Classes="body-sm secondary" Text="{Binding NewerReleasesText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                <Button Classes="add" Command="{Binding NewInstanceCommand}" IsVisible="{Binding !IsInstalling}" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.PackNewInstance}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.PackNewInstance}">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Library}" />
                                </Button>
                                <Button Classes="add" Command="{Binding InstallCommand}" IsVisible="{Binding CanInstall}" IsEnabled="{Binding $parent[Window].((vm:MainViewModel)DataContext).CanAddToActiveInstance}" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).AddToText}" ToolTip.ShowOnDisabled="True" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).AddToText}">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Plus}" />
                                </Button>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding IsInstalling}">
                                    <ProgressBar Width="38" Height="6" VerticalAlignment="Center" Value="{Binding Progress}" Maximum="100" Foreground="{StaticResource Brush.Accent}" />
                                    <Button Classes="icon" Command="{Binding Run.TogglePauseCommand}" IsVisible="{Binding !Run.IsStopping, FallbackValue={x:True}}" ToolTip.Tip="{Binding Run.PauseText}" AutomationProperties.Name="{Binding Run.PauseText}">
                                        <Panel>
                                            <Path Classes="icon size-16" Data="{StaticResource Icon.Pause}" IsVisible="{Binding !Run.IsPaused, FallbackValue={x:True}}" />
                                            <Path Classes="icon-filled size-16" Data="{StaticResource Icon.Play}" IsVisible="{Binding Run.IsPaused, FallbackValue={x:False}}" />
                                        </Panel>
                                    </Button>
                                    <Button Classes="icon" Command="{Binding Run.StopCommand}" IsVisible="{Binding !Run.IsStopping, FallbackValue={x:True}}" ToolTip.Tip="{Binding Run.StopText}" AutomationProperties.Name="{Binding Run.StopText}">
                                        <Path Classes="icon size-16" Data="{StaticResource Icon.Close}" />
                                    </Button>
                                    <TextBlock Classes="body-sm secondary" Text="{Binding Run.StopText}" VerticalAlignment="Center" IsVisible="{Binding Run.IsStopping, FallbackValue={x:False}}" />
                                </StackPanel>
                                <!-- the green check of an installed pack, as on a mod row; a pack has no removal, so its menu only marks a favorite -->
                                <Button Classes="add installed" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).InstalledInText}" AutomationProperties.Name="{Binding InstalledAutomationName}" AutomationProperties.HelpText="{Binding $parent[Window].((vm:MainViewModel)DataContext).InstalledInText}">
                                    <Button.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="IsInstalled" />
                                            <Binding Path="!IsInstalling" />
                                        </MultiBinding>
                                    </Button.IsVisible>
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuItem Header="{Binding FavoriteText}" Command="{Binding ToggleFavoriteCommand}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Check}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <ContentControl Grid.Row="1" Margin="0,8" Content="{Binding Choices}" IsVisible="{Binding Choices, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <StackPanel Grid.Row="2">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,4,8" IsVisible="{Binding ProgressStatus, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Classes="body-sm secondary" Text="{Binding ProgressStatus}" ToolTip.Tip="{Binding ProgressStatus}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="label-md" Text="{Binding ProgressDetail}" VerticalAlignment="Center" IsVisible="{Binding ProgressDetail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </Grid>
                            <ItemsControl Margin="0,0,4,8" ItemsSource="{Binding PlanSteps}" ItemTemplate="{StaticResource StepList}" ItemsPanel="{StaticResource StepListsPanel}" IsVisible="{Binding !!PlanSteps.Count}" />
                            <!-- as the confirmation of a mod row: the warning takes the whole width, and the buttons keep their own row -->
                            <StackPanel Spacing="8" Margin="0,0,4,8" IsVisible="{Binding IsConfirmingInstall}">
                                <TextBlock Classes="body-sm" Foreground="{StaticResource Brush.Untested}" Text="{Binding InstallWarning}" IsVisible="{Binding InstallWarning, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />
                                <WrapPanel HorizontalAlignment="Right" ItemsAlignment="End" ItemSpacing="8" LineSpacing="8">
                                    <Button Classes="link" Command="{Binding ChooseContentNameCommand}" IsVisible="{Binding CanChooseContentName}" VerticalAlignment="Center">
                                        <TextBlock Classes="action-md" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.PackContentChooseName}" />
                                    </Button>
                                    <Button Classes="text primary" Content="{Binding ConfirmInstallText}" Command="{Binding ConfirmInstallCommand}" IsEnabled="{Binding Choices.IsComplete, FallbackValue={x:True}}" />
                                    <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelInstallCommand}" />
                                </WrapPanel>
                            </StackPanel>
                            <TextBlock Classes="body-sm danger" Text="{Binding InstallError}" ToolTip.Tip="{Binding InstallError}" IsVisible="{Binding InstallError, Converter={x:Static ObjectConverters.IsNotNull}}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" Margin="0,0,4,8" />
                            <TextBlock Classes="body-sm secondary" Text="{Binding InstallNote}" ToolTip.Tip="{Binding InstallNote}" IsVisible="{Binding InstallNote, Converter={x:Static ObjectConverters.IsNotNull}}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" Margin="0,0,4,8" />
                            <!-- what the authors of the members still ask for after an install, until the player dismisses it -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,4,8" IsVisible="{Binding HasInstallStepsNotice}">
                                <ItemsControl ItemsSource="{Binding InstallStepsNotice}" ItemTemplate="{StaticResource StepList}" ItemsPanel="{StaticResource StepListsPanel}" />
                                <Button Grid.Column="1" Classes="text" VerticalAlignment="Top" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.InstallStepsDismiss}" Command="{Binding DismissInstallStepsNoticeCommand}" />
                            </Grid>
                        </StackPanel>
                        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,0,4,0">
                            <Border Classes="chip" Classes.compatible="{Binding IsCompatible}" Classes.incompatible="{Binding IsIncompatible}" IsVisible="{Binding ShowsCompatibility}" VerticalAlignment="Center" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse />
                                    <TextBlock Text="{Binding CompatibilityText}" />
                                </StackPanel>
                            </Border>
                            <views:TagChipRow Grid.Column="1" Tags="{Binding AllTags}" Lead="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.DiscoverInstalled}" ShowsLead="{Binding IsInstalled}" LeadTip="{Binding $parent[Window].((vm:MainViewModel)DataContext).InstalledInText}" VerticalAlignment="Center" Margin="0,0,24,0" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Classes="label-md" Text="{Binding ModCountText}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" ToolTip.Tip="{Binding ReleasedDateText}">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Clock}" />
                                    <TextBlock Classes="label-md" Text="{Binding ReleasedText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Button>
    </DataTemplate>
    <!-- the search over the listed mods that adds an entry, on the full form of a listing and on the share steps -->
    <DataTemplate x:Key="ListingDependencySearch" x:DataType="vm:MainViewModel">
        <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,8,Auto">
                <TextBox Classes="field search" Text="{Binding ListingEditor.DependencyQuery}" PlaceholderText="{Binding Localization.DiscoverSearchPlaceholder}" AutomationProperties.Name="{Binding Localization.ListingSearchDependencies}">
                    <TextBox.InnerLeftContent>
                        <Path Classes="icon size-16" Data="{StaticResource Icon.Search}" Margin="10,0,0,0" />
                    </TextBox.InnerLeftContent>
                </TextBox>
                <Button Grid.Column="2" Classes="text" Content="{Binding Localization.ListingAddMember}" Command="{Binding ListingEditor.AddListedDependencyCommand}" />
            </Grid>
            <ListBox ItemsSource="{Binding ListingEditor.DependencyMatches}" SelectedItem="{Binding ListingEditor.SelectedDependencyMatch}" MaxHeight="240" AutomationProperties.Name="{Binding Localization.ListingSearchDependencies}" IsVisible="{Binding !!ListingEditor.DependencyMatches.Count}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ListedListing">
                        <Grid ColumnDefinitions="*,16,Auto">
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="heading-sm" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Border Classes="chip" VerticalAlignment="Center" IsVisible="{Binding IsLoader}">
                                        <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentTypeModLoader}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Classes="label-md" Text="{Binding Id}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Classes="body-sm secondary" Text="{Binding AuthorsText}" MaxWidth="240" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Classes="body-sm secondary" Text="{Binding Localization.ListingNoListedMatch}" IsVisible="{Binding ListingEditor.HasNoDependencyMatch}" />
        </StackPanel>
    </DataTemplate>
    <!-- over a shown scene of a vehicle: the stage while the textures or the mods load, or why a later step stopped, in the panel of the page and in the expanded view -->
    <DataTemplate x:Key="VehiclePreviewStatus" x:DataType="vm:VehiclePreviewViewModel">
        <Border Background="{StaticResource Brush.SurfaceHeader}" CornerRadius="100" Padding="12,4" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Bottom">
            <Border.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="HasScene" />
                    <Binding Path="StatusText" Converter="{x:Static ObjectConverters.IsNotNull}" />
                </MultiBinding>
            </Border.IsVisible>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="body-sm secondary" Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
