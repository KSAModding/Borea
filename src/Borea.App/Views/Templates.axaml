<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:Borea.App.ViewModels"
                    xmlns:views="using:Borea.App.Views">
    <!-- The row templates the pages use. App.axaml merges this file, so every page can reach them. -->
    <!-- the game is not set up: one line and the way to the Game tab (#152) -->
    <DataTemplate x:Key="GameSetupBanner" x:DataType="vm:MainViewModel">
        <views:Banner Kind="Accent" Margin="0,16,0,0" Message="{Binding GameSetupBannerText}" ActionText="{Binding Localization.SetupBannerAction}" ActionCommand="{Binding OpenGameSetupCommand}" />
    </DataTemplate>
    <!-- what the last launch said, on Home, in the Library and on the instance page -->
    <DataTemplate x:Key="LaunchStatus" x:DataType="vm:MainViewModel">
        <!-- one line, and the launch modal has the way out when the loader stopped -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,0" IsVisible="{Binding LaunchMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Classes="body-md secondary" Text="{Binding LaunchMessage}" TextWrapping="Wrap" VerticalAlignment="Center" Classes.danger="{Binding HasLaunchOutput}" />
            <Button Grid.Column="1" Classes="link" Margin="16,0,0,0" VerticalAlignment="Center" Command="{Binding ShowLaunchFailureCommand}" IsVisible="{Binding HasLaunchOutput}">
                <TextBlock Classes="action-md" Text="{Binding Localization.LaunchShowDetails}" />
            </Button>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="SharedProfileBanner" x:DataType="vm:MainViewModel">
        <views:Banner Kind="Outline" Margin="0,16,0,0" Message="{Binding SharedProfileBannerText}" ActionText="{Binding Localization.SharedProfileCreateInstance}" ActionCommand="{Binding BeginImportSharedProfileCommand}" DismissCommand="{Binding DismissSharedProfileBannerCommand}" DismissText="{Binding Localization.SharedProfileDismiss}" />
    </DataTemplate>
    <DataTemplate x:Key="InstanceHint" x:DataType="vm:MainViewModel">
        <WrapPanel ItemSpacing="12" LineSpacing="4">
            <TextBlock Classes="body-md secondary" Text="{Binding InstanceHintText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Classes="link" Command="{Binding FollowInstanceHintCommand}" VerticalAlignment="Center" AutomationProperties.Name="{Binding InstanceHintActionText}">
                <TextBlock Classes="action-md" Text="{Binding InstanceHintActionText}" />
            </Button>
        </WrapPanel>
    </DataTemplate>
    <!-- the page header names the instance that Add goes into, and leads to the Library to change it -->
    <DataTemplate x:Key="AddingTo" x:DataType="vm:MainViewModel">
        <Button Classes="plain" HorizontalAlignment="Right" Margin="16,0,0,0" Command="{Binding SetMainWindowLibraryCommand}" IsVisible="{Binding HasActiveInstance}" ToolTip.Tip="{Binding AddingToText}" AutomationProperties.Name="{Binding AddingToText}" AutomationProperties.HelpText="{Binding Localization.DiscoverOpenLibrary}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Classes="label-lg" Text="{Binding AddingToBefore}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="label-lg" Text="{Binding ActiveInstance.Name}" Foreground="{StaticResource Brush.Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="label-lg" Text="{Binding AddingToAfter}" VerticalAlignment="Center" />
            </Grid>
        </Button>
    </DataTemplate>
    <!-- c/instance-row: used by the library list and by the Current Install card on Home -->
    <DataTemplate x:Key="InstanceRow" x:DataType="vm:InstanceItem">
        <Button Classes="plain card-button" views:RowButton.IgnoresDisabled="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}">
            <Border Classes="card" Padding="12">
                <Grid ColumnDefinitions="70,16,*" RowDefinitions="Auto,*,Auto" Height="70">
                    <Border Grid.RowSpan="3" Classes="thumbnail" Width="70" Height="70">
                        <Path Classes="icon size-32" Data="{StaticResource Icon.Box}" />
                    </Border>

                    <!-- Title row: the name, and Play on the active row of the Library, the switch + more -->
                    <Grid Grid.Column="2" Grid.Row="0" ColumnDefinitions="*,16,Auto">
                        <TextBlock Classes="heading-md" Text="{Binding Name}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Button Classes="cta" Command="{Binding PlayCommand}" IsEnabled="{Binding $parent[Window].((vm:MainViewModel)DataContext).EnableActiveInstance}" VerticalAlignment="Center">
                                <Button.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="IsActive" />
                                        <Binding Path="$parent[Window].((vm:MainViewModel)DataContext).CurrentWindowLibrary" />
                                    </MultiBinding>
                                </Button.IsVisible>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="icon-filled size-16" Fill="{StaticResource Brush.SurfaceHeader}" Data="{StaticResource Icon.Play}" VerticalAlignment="Center" />
                                    <TextBlock Classes="action-lg" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.InstancePlay}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <ToggleSwitch Classes="switch" IsChecked="{Binding IsActive, Mode=OneWay}" Command="{Binding ToggleActiveCommand}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryActivate}" VerticalAlignment="Center" />
                            <views:InstanceMenu />
                        </StackPanel>
                    </Grid>

                    <!-- Bottom row: chips, and the meta on the right -->
                    <Grid Grid.Column="2" Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Border Classes="chip positive" IsVisible="{Binding SourceText, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Text="{Binding SourceText}" />
                            </Border>
                        </StackPanel>
                        <!-- c/meta: GameController + when the instance was last played, CirclesThree + the number of installed mods -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,0" ToolTip.Tip="{Binding LastPlayedToolTip}">
                                <Path Classes="icon size-16" Data="{StaticResource Icon.GameController}" />
                                <TextBlock Classes="label-md" Text="{Binding LastPlayedText}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="{Binding ModCountToolTip}">
                                <Path Classes="icon size-16" Data="{StaticResource Icon.CirclesThree}" />
                                <TextBlock Classes="label-md" Text="{Binding ModCount}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <!-- the update count shows only on the Current Install card of Home, and only for the active instance it counts -->
                        <Button Grid.Column="2" Classes="link" Height="24" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center" Command="{Binding OpenCommand}">
                            <Button.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsActive" />
                                    <Binding Path="$parent[Window].((vm:MainViewModel)DataContext).CurrentWindowHome" />
                                    <Binding Path="$parent[Window].((vm:MainViewModel)DataContext).HasActiveInstanceUpdates" />
                                </MultiBinding>
                            </Button.IsVisible>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Path Classes="icon size-16" Stroke="{StaticResource Brush.Accent}" Data="{StaticResource Icon.ArrowsLeftRight}" />
                                <TextBlock Classes="label-md" Foreground="{StaticResource Brush.Accent}" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).ActiveInstanceUpdatesText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Button>
    </DataTemplate>

    <!-- the changelog of one release an update passes, as Markdown or as a link -->
    <DataTemplate x:Key="ChangelogEntry" x:DataType="vm:ReleaseChangelog">
        <StackPanel Spacing="4">
            <TextBlock Classes="label-md" Text="{Binding Title}" />
            <views:MarkdownView Markdown="{Binding Text}" IsVisible="{Binding Text, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Button Classes="link" HorizontalAlignment="Left" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenLinkCommand}" CommandParameter="{Binding Link}" ToolTip.Tip="{Binding Link.Url}" IsVisible="{Binding Link, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Classes="action-md" Text="{Binding Link.Label}" />
            </Button>
        </StackPanel>
    </DataTemplate>

    <!-- one row of c/table-versions on the instance page -->
    <!-- the body of one row of c/table-versions, which the row shows inside its button or, without a page, on its own -->
    <DataTemplate x:Key="ContentRowBody" x:DataType="vm:ContentItem">
        <Border Classes="list-row" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid ColumnDefinitions="48,16,*,24,Auto" RowDefinitions="Auto,Auto,Auto">
                <Border Classes="thumbnail" Width="48" Height="48" ToolTip.Tip="{Binding NoPageText}">
                    <views:ListingImageView Image="{Binding Icon}" Background="{StaticResource Brush.Surface}">
                        <Path Classes="icon" Data="{StaticResource Icon.PuzzlePiece}" />
                    </views:ListingImageView>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Classes="heading-sm" Text="{Binding Name}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" ToolTip.Tip="{Binding NoPageText}" />
                    <TextBlock Classes="body-sm secondary" Text="{Binding AuthorsText}" IsVisible="{Binding AuthorsText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Classes="body-sm danger" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentNotOnDisk}" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentNotOnDiskDetail}" IsVisible="{Binding IsMissing}" />
                    <TextBlock Classes="body-sm danger" Text="{Binding RemoveConfirmText}" IsVisible="{Binding IsConfirmingRemove}" />
                    <TextBlock Classes="body-sm danger" Text="{Binding ManageConfirmText}" TextWrapping="Wrap" IsVisible="{Binding IsConfirmingManage}" />
                    <TextBlock Classes="body-sm danger" Text="{Binding ManageMissingText}" TextWrapping="Wrap" IsVisible="{Binding ManageMissingText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <CheckBox IsChecked="{Binding InstallManageDependencies}" IsVisible="{Binding ManageInstallMissingText, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Classes="body-sm" Text="{Binding ManageInstallMissingText}" TextWrapping="Wrap" />
                    </CheckBox>
                    <TextBlock Classes="body-sm secondary" Text="{Binding ManageNotInstalledText}" TextWrapping="Wrap" IsVisible="{Binding ManageNotInstalledText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Classes="body-sm secondary" Text="{Binding ProgressStatus}" ToolTip.Tip="{Binding ProgressStatus}" TextTrimming="CharacterEllipsis" IsVisible="{Binding ProgressStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Classes="body-sm secondary" Text="{Binding InstallWarning}" ToolTip.Tip="{Binding InstallWarning}" TextTrimming="CharacterEllipsis" IsVisible="{Binding IsConfirmingUpdate}" />
                    <TextBlock Classes="body-sm danger" Text="{Binding InstallError}" ToolTip.Tip="{Binding InstallError}" TextTrimming="CharacterEllipsis" IsVisible="{Binding InstallError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding SizeText, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentSizeOnDisk}">
                        <Path Classes="icon size-16" Data="{StaticResource Icon.HardDrive}" />
                        <TextBlock Classes="label-md" Text="{Binding SizeText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Path Classes="icon size-16" Data="{StaticResource Icon.GitCommit}" />
                        <TextBlock Classes="label-md" Text="{Binding Version}" VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- one slot after the version: the lock of a dependency, or the update of any other row -->
                    <Panel VerticalAlignment="Center">
                        <Path Classes="icon" Data="{StaticResource Icon.Lock}" IsVisible="{Binding IsDependency}" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.InstanceGroupDependencies}" />
                        <Button Classes="icon" Command="{Binding UpdateCommand}" IsVisible="{Binding HasUpdate}" IsEnabled="{Binding $parent[Window].((vm:MainViewModel)DataContext).CanChangeContent}" ToolTip.Tip="{Binding UpdateText}" AutomationProperties.Name="{Binding UpdateText}">
                            <Path Classes="icon" Data="{StaticResource Icon.ArrowsLeftRight}" />
                        </Button>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding IsInstalling}">
                            <ProgressBar Width="38" Height="6" VerticalAlignment="Center" Value="{Binding Progress}" Maximum="100" Foreground="{StaticResource Brush.Accent}" />
                            <Button Classes="icon" Command="{Binding Run.TogglePauseCommand}" IsVisible="{Binding !Run.IsStopping, FallbackValue={x:True}}" ToolTip.Tip="{Binding Run.PauseText}" AutomationProperties.Name="{Binding Run.PauseText}">
                                <Panel>
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Pause}" IsVisible="{Binding !Run.IsPaused, FallbackValue={x:True}}" />
                                    <Path Classes="icon-filled size-16" Data="{StaticResource Icon.Play}" IsVisible="{Binding Run.IsPaused, FallbackValue={x:False}}" />
                                </Panel>
                            </Button>
                            <Button Classes="icon" Command="{Binding Run.StopCommand}" IsVisible="{Binding !Run.IsStopping, FallbackValue={x:True}}" ToolTip.Tip="{Binding Run.StopText}" AutomationProperties.Name="{Binding Run.StopText}">
                                <Path Classes="icon size-16" Data="{StaticResource Icon.Close}" />
                            </Button>
                            <TextBlock Classes="body-sm secondary" Text="{Binding Run.StopText}" VerticalAlignment="Center" IsVisible="{Binding Run.IsStopping, FallbackValue={x:False}}" />
                        </StackPanel>
                    </Panel>
                    <Panel IsEnabled="{Binding $parent[Window].((vm:MainViewModel)DataContext).CanChangeContent}">
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsConfirmingRemove}">
                            <Button Classes="text danger" Content="{Binding RemoveActionText}" Command="{Binding ConfirmRemoveCommand}" />
                            <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelRemoveCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsConfirmingUpdate}">
                            <Button Classes="text primary" Content="{Binding ConfirmUpdateText}" Command="{Binding ConfirmUpdateCommand}" IsEnabled="{Binding Choices.IsComplete, FallbackValue={x:True}}" />
                            <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelUpdateCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsConfirmingManage}">
                            <Button Classes="text danger" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentManageConfirmAction}" Command="{Binding ConfirmManageCommand}" />
                            <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelManageCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <StackPanel.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="!IsConfirmingRemove" />
                                    <Binding Path="!IsConfirmingUpdate" />
                                    <Binding Path="!IsConfirmingManage" />
                                </MultiBinding>
                            </StackPanel.IsVisible>
                            <ToggleSwitch Classes="switch" IsChecked="{Binding IsEnabled}" Command="{Binding ToggleEnabledCommand}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
                            <Button Classes="icon" VerticalAlignment="Center" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryMoreActions}">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentOpenPage}" Command="{Binding OpenCommand}" IsVisible="{Binding CanOpen}" />
                                        <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentManage}" Command="{Binding BeginManageCommand}" IsVisible="{Binding CanManage}" />
                                        <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentInstallAgain}" Command="{Binding InstallAgainCommand}" IsVisible="{Binding IsMissing}" />
                                        <MenuItem Header="{Binding RemoveActionText}" Command="{Binding BeginRemoveCommand}" IsEnabled="{Binding CanRemove}" AutomationProperties.HelpText="{Binding RemoveBlockedText}" />
                                        <MenuItem IsEnabled="False" IsVisible="{Binding RemoveBlockedText, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <MenuItem.Header>
                                                <TextBlock Classes="body-sm secondary" Text="{Binding RemoveBlockedText}" TextWrapping="Wrap" MaxWidth="260" />
                                            </MenuItem.Header>
                                        </MenuItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <Path Classes="icon-filled" Data="{StaticResource Icon.More}" />
                            </Button>
                        </StackPanel>
                    </Panel>
                </StackPanel>
                <ContentControl Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Margin="0,8,0,0" Content="{Binding Choices}" IsVisible="{Binding Choices, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <ItemsControl Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Margin="0,8,0,0" ItemsSource="{Binding Changelogs}" ItemTemplate="{StaticResource ChangelogEntry}" IsVisible="{Binding HasChangelogs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- one row of c/table-versions on the instance page. The whole row opens the mod page, unless the index knows no page for the mod. -->
    <DataTemplate x:Key="ContentRow" x:DataType="vm:ContentItem">
        <Panel>
            <Button Classes="plain card-button" views:RowButton.IgnoresDisabled="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}" IsVisible="{Binding CanOpen}" Content="{Binding PageRow}" ContentTemplate="{StaticResource ContentRowBody}" />
            <ContentControl IsVisible="{Binding !CanOpen}" Content="{Binding PlainRow}" ContentTemplate="{StaticResource ContentRowBody}" />
        </Panel>
    </DataTemplate>

    <!-- c/content-row on Discover -->
    <DataTemplate x:Key="DiscoverRow" x:DataType="vm:DiscoverItem">
        <Button Classes="plain card-button" views:RowButton.IgnoresDisabled="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}">
            <Border Classes="card" Padding="12">
                <Grid ColumnDefinitions="100,16,*" MinHeight="100">
                    <Border Classes="thumbnail" Width="100" Height="100">
                        <views:ListingImageView Image="{Binding Icon}" Background="{StaticResource Brush.Surface}">
                            <Path Classes="icon size-32" Data="{StaticResource Icon.PuzzlePiece}" />
                        </views:ListingImageView>
                    </Border>
                    <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto,Auto">
                        <Grid ColumnDefinitions="*,16,Auto">
                            <StackPanel Spacing="4">
                                <DockPanel>
                                    <TextBlock Classes="heading-md" Text="{Binding Name}" TextTrimming="CharacterEllipsis" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                    <TextBlock Classes="body-sm secondary" Text="{Binding AuthorsText}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Classes="body-md secondary" Text="{Binding Abstract}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" LineHeight="18" />
                            </StackPanel>
                            <!-- c/button-icon-add -->
                            <Panel Grid.Column="2" VerticalAlignment="Top">
                                <Button Classes="add" Command="{Binding InstallCommand}" IsVisible="{Binding CanInstall}" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).AddToText}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).AddToText}">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Plus}" />
                                </Button>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding IsInstalling}">
                                    <ProgressBar Width="38" Height="6" VerticalAlignment="Center" Value="{Binding Progress}" Maximum="100" Foreground="{StaticResource Brush.Accent}" />
                                    <Button Classes="icon" Command="{Binding Run.TogglePauseCommand}" IsVisible="{Binding !Run.IsStopping, FallbackValue={x:True}}" ToolTip.Tip="{Binding Run.PauseText}" AutomationProperties.Name="{Binding Run.PauseText}">
                                        <Panel>
                                            <Path Classes="icon size-16" Data="{StaticResource Icon.Pause}" IsVisible="{Binding !Run.IsPaused, FallbackValue={x:True}}" />
                                            <Path Classes="icon-filled size-16" Data="{StaticResource Icon.Play}" IsVisible="{Binding Run.IsPaused, FallbackValue={x:False}}" />
                                        </Panel>
                                    </Button>
                                    <Button Classes="icon" Command="{Binding Run.StopCommand}" IsVisible="{Binding !Run.IsStopping, FallbackValue={x:True}}" ToolTip.Tip="{Binding Run.StopText}" AutomationProperties.Name="{Binding Run.StopText}">
                                        <Path Classes="icon size-16" Data="{StaticResource Icon.Close}" />
                                    </Button>
                                    <TextBlock Classes="body-sm secondary" Text="{Binding Run.StopText}" VerticalAlignment="Center" IsVisible="{Binding Run.IsStopping, FallbackValue={x:False}}" />
                                </StackPanel>
                                <ProgressBar Width="38" Height="6" VerticalAlignment="Center" IsVisible="{Binding IsRemoving}" IsIndeterminate="True" Foreground="{StaticResource Brush.Accent}" />
                                <Button Classes="add installed" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).InstalledInText}" AutomationProperties.Name="{Binding InstalledAutomationName}" AutomationProperties.HelpText="{Binding $parent[Window].((vm:MainViewModel)DataContext).InstalledInText}">
                                    <Button.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="IsInstalled" />
                                            <Binding Path="!IsRemoving" />
                                        </MultiBinding>
                                    </Button.IsVisible>
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentChangeVersion}" Command="{Binding ChangeVersionCommand}" IsVisible="{Binding CanChangeVersion}" />
                                            <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentRemove}" Command="{Binding BeginRemoveCommand}" AutomationProperties.HelpText="{Binding RemoveBlockedText}" />
                                            <MenuItem IsEnabled="False" IsVisible="{Binding RemoveBlockedText, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <MenuItem.Header>
                                                    <TextBlock Classes="body-sm secondary" Text="{Binding RemoveBlockedText}" TextWrapping="Wrap" MaxWidth="260" />
                                                </MenuItem.Header>
                                            </MenuItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Check}" />
                                </Button>
                            </Panel>
                        </Grid>
                        <ContentControl Grid.Row="1" Margin="0,8" Content="{Binding Choices}" IsVisible="{Binding Choices, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <!-- the row's actions and status, on a line of their own so that they never reach past the card -->
                        <StackPanel Grid.Row="2">
                            <!-- the question and the two buttons keep one line while they fit, and the buttons take the next line when they do not -->
                            <WrapPanel HorizontalAlignment="Right" ItemsAlignment="End" ItemSpacing="8" LineSpacing="8" Margin="0,0,4,8" IsVisible="{Binding IsConfirmingRemove}">
                                <TextBlock Classes="body-sm danger" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentRemoveConfirm}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="text danger" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentRemove}" Command="{Binding ConfirmRemoveCommand}" />
                                    <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelRemoveCommand}" />
                                </StackPanel>
                            </WrapPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,4,8" IsVisible="{Binding ProgressStatus, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Classes="body-sm secondary" Text="{Binding ProgressStatus}" ToolTip.Tip="{Binding ProgressStatus}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="label-md" Text="{Binding ProgressDetail}" VerticalAlignment="Center" IsVisible="{Binding ProgressDetail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,4,8" IsVisible="{Binding IsConfirmingInstall}">
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Classes="body-sm secondary" Text="{Binding AddedModsText}" ToolTip.Tip="{Binding AddedModsToolTip}" IsVisible="{Binding AddedModsText, Converter={x:Static ObjectConverters.IsNotNull}}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Classes="body-sm secondary" Text="{Binding InstallWarning}" ToolTip.Tip="{Binding InstallWarning}" IsVisible="{Binding InstallWarning, Converter={x:Static ObjectConverters.IsNotNull}}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Classes="text primary" Content="{Binding ConfirmInstallText}" Command="{Binding ConfirmInstallCommand}" IsEnabled="{Binding Choices.IsComplete, FallbackValue={x:True}}" />
                                    <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelInstallCommand}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Classes="body-sm danger" Text="{Binding InstallError}" ToolTip.Tip="{Binding InstallError}" IsVisible="{Binding InstallError, Converter={x:Static ObjectConverters.IsNotNull}}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" Margin="0,0,4,8" />
                        </StackPanel>
                        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,0,4,0">
                            <Border Classes="chip" Classes.compatible="{Binding IsCompatible}" Classes.untested="{Binding IsUntested}" Classes.incompatible="{Binding IsIncompatible}" IsVisible="{Binding ShowsCompatibility}" VerticalAlignment="Center" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse />
                                    <TextBlock Text="{Binding CompatibilityText}" />
                                </StackPanel>
                            </Border>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Tags}" VerticalAlignment="Center" ClipToBounds="True">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Classes="chip">
                                            <TextBlock Text="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" Margin="8,0,0,0">
                                <!-- c/meta: the size, the downloads and the age of the newest release, when the index reports them -->
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding DownloadSizeText, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.ContentDownloadSize}">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.HardDrive}" />
                                    <TextBlock Classes="label-md" Text="{Binding DownloadSizeText}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding DownloadsText, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="{Binding DownloadsExactText}">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Download}" />
                                    <TextBlock Classes="label-md" Text="{Binding DownloadsText}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding UpdatedText, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="{Binding UpdatedDateText}">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Clock}" />
                                    <TextBlock Classes="label-md" Text="{Binding UpdatedText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Button>
    </DataTemplate>

    <!-- a pack row: the Discover row with the mod count, and no removal -->
    <DataTemplate x:Key="PackRow" x:DataType="vm:PackItem">
        <Button Classes="plain card-button" views:RowButton.IgnoresDisabled="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}">
            <Border Classes="card" Padding="12">
                <Grid ColumnDefinitions="100,16,*" MinHeight="100">
                    <Border Classes="thumbnail" Width="100" Height="100">
                        <views:ListingImageView Image="{Binding Icon}" Background="{StaticResource Brush.Surface}">
                            <Path Classes="icon size-32" Data="{StaticResource Icon.Box}" />
                        </views:ListingImageView>
                    </Border>
                    <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto,Auto">
                        <Grid ColumnDefinitions="*,16,Auto">
                            <StackPanel Spacing="4">
                                <DockPanel>
                                    <TextBlock Classes="heading-md" Text="{Binding Name}" TextTrimming="CharacterEllipsis" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                    <TextBlock Classes="body-sm secondary" Text="{Binding AuthorsText}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Classes="body-md secondary" Text="{Binding Abstract}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" LineHeight="18" />
                                <Grid ColumnDefinitions="Auto,4,*" IsVisible="{Binding HasNewerReleases}">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.ArrowsLeftRight}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Classes="body-sm secondary" Text="{Binding NewerReleasesText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                <Button Classes="add" Command="{Binding NewInstanceCommand}" IsVisible="{Binding !IsInstalling}" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.PackNewInstance}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.PackNewInstance}">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Library}" />
                                </Button>
                                <Button Classes="add" Command="{Binding InstallCommand}" IsVisible="{Binding CanInstall}" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).AddToText}" AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).AddToText}">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Plus}" />
                                </Button>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding IsInstalling}">
                                    <ProgressBar Width="38" Height="6" VerticalAlignment="Center" Value="{Binding Progress}" Maximum="100" Foreground="{StaticResource Brush.Accent}" />
                                    <Button Classes="icon" Command="{Binding Run.TogglePauseCommand}" IsVisible="{Binding !Run.IsStopping, FallbackValue={x:True}}" ToolTip.Tip="{Binding Run.PauseText}" AutomationProperties.Name="{Binding Run.PauseText}">
                                        <Panel>
                                            <Path Classes="icon size-16" Data="{StaticResource Icon.Pause}" IsVisible="{Binding !Run.IsPaused, FallbackValue={x:True}}" />
                                            <Path Classes="icon-filled size-16" Data="{StaticResource Icon.Play}" IsVisible="{Binding Run.IsPaused, FallbackValue={x:False}}" />
                                        </Panel>
                                    </Button>
                                    <Button Classes="icon" Command="{Binding Run.StopCommand}" IsVisible="{Binding !Run.IsStopping, FallbackValue={x:True}}" ToolTip.Tip="{Binding Run.StopText}" AutomationProperties.Name="{Binding Run.StopText}">
                                        <Path Classes="icon size-16" Data="{StaticResource Icon.Close}" />
                                    </Button>
                                    <TextBlock Classes="body-sm secondary" Text="{Binding Run.StopText}" VerticalAlignment="Center" IsVisible="{Binding Run.IsStopping, FallbackValue={x:False}}" />
                                </StackPanel>
                                <Border Classes="chip positive" VerticalAlignment="Center" IsVisible="{Binding IsInstalled}" ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).InstalledInText}">
                                    <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.DiscoverInstalled}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                        <ContentControl Grid.Row="1" Margin="0,8" Content="{Binding Choices}" IsVisible="{Binding Choices, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <StackPanel Grid.Row="2">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,4,8" IsVisible="{Binding ProgressStatus, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Classes="body-sm secondary" Text="{Binding ProgressStatus}" ToolTip.Tip="{Binding ProgressStatus}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="label-md" Text="{Binding ProgressDetail}" VerticalAlignment="Center" IsVisible="{Binding ProgressDetail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,4,8" IsVisible="{Binding IsConfirmingInstall}">
                                <TextBlock Classes="body-sm secondary" Text="{Binding InstallWarning}" ToolTip.Tip="{Binding InstallWarning}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Classes="text primary" Content="{Binding ConfirmInstallText}" Command="{Binding ConfirmInstallCommand}" IsEnabled="{Binding Choices.IsComplete, FallbackValue={x:True}}" />
                                    <Button Classes="text" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).Localization.LibraryCancel}" Command="{Binding CancelInstallCommand}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Classes="body-sm danger" Text="{Binding InstallError}" ToolTip.Tip="{Binding InstallError}" IsVisible="{Binding InstallError, Converter={x:Static ObjectConverters.IsNotNull}}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" Margin="0,0,4,8" />
                        </StackPanel>
                        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,0,4,0">
                            <Border Classes="chip" Classes.compatible="{Binding IsCompatible}" Classes.untested="{Binding IsUntested}" Classes.incompatible="{Binding IsIncompatible}" IsVisible="{Binding ShowsCompatibility}" VerticalAlignment="Center" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse />
                                    <TextBlock Text="{Binding CompatibilityText}" />
                                </StackPanel>
                            </Border>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Tags}" VerticalAlignment="Center" ClipToBounds="True">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Classes="chip">
                                            <TextBlock Text="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Classes="label-md" Text="{Binding ModCountText}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" ToolTip.Tip="{Binding ReleasedDateText}">
                                    <Path Classes="icon size-16" Data="{StaticResource Icon.Clock}" />
                                    <TextBlock Classes="label-md" Text="{Binding ReleasedText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Button>
    </DataTemplate>
</ResourceDictionary>
