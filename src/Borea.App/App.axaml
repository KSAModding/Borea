<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Borea.App.App"
             xmlns:local="using:Borea.App"
             xmlns:views="using:Borea.App.Views"
             RequestedThemeVariant="Dark">
             <!-- App.axaml.cs sets the variant from the saved theme. Fluent stays the base so stock controls (ComboBox, ToggleSwitch) follow it. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Borea.App/Assets/Icons.axaml" />
                <ResourceInclude Source="avares://Borea.App/Views/Templates.axaml" />
                <ResourceInclude Source="avares://Borea.App/Views/Banner.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Palettes. Borealis (dark) holds the tokens of the Figma file from #8 (neutral-900 .. white, green, purple-500); Light mirrors them. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="{x:Static ThemeVariant.Dark}">
                    <Color x:Key="Color.Window">#171717</Color>
                    <Color x:Key="Color.Rail">#262626</Color>
                    <Color x:Key="Color.Surface">#262626</Color>
                    <Color x:Key="Color.SurfaceHeader">#000000</Color>
                    <Color x:Key="Color.SurfaceRaised">#333333</Color>
                    <Color x:Key="Color.Border">#000000</Color>
                    <Color x:Key="Color.BorderStrong">#3A3A3A</Color>
                    <Color x:Key="Color.Text">#FFFFFF</Color>
                    <Color x:Key="Color.TextHeading">#E1E1E1</Color>
                    <Color x:Key="Color.TextSecondary">#ABABAB</Color>
                    <Color x:Key="Color.TextMuted">#777777</Color>
                    <Color x:Key="Color.Accent">#CABCFF</Color>
                    <Color x:Key="Color.AccentSoft">#26CABCFF</Color>
                    <Color x:Key="Color.OnAccent">#000000</Color>
                    <Color x:Key="Color.Positive">#C1FFB5</Color>
                    <Color x:Key="Color.PositiveSoft">#0DC1FFB5</Color>
                    <Color x:Key="Color.Danger">#F07178</Color>
                    <Color x:Key="Color.DangerSoft">#26F07178</Color>
                    <Color x:Key="Color.Compatible">#C1FFB5</Color>
                    <Color x:Key="Color.Untested">#F5B35C</Color>
                    <Color x:Key="Color.Incompatible">#F07178</Color>
                    <Color x:Key="Color.CompatibilityUnknown">#8A8A8A</Color>
                    <Color x:Key="Color.ChannelTesting">#7AB6FF</Color>
                    <Color x:Key="Color.ChannelDev">#D78BFF</Color>
                    <Color x:Key="Color.ThumbStart">#262626</Color>
                    <Color x:Key="Color.ThumbEnd">#171717</Color>
                    <Color x:Key="Color.ScrimStart">#33000000</Color>
                    <Color x:Key="Color.ScrimEnd">#CC000000</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="{x:Static ThemeVariant.Light}">
                    <Color x:Key="Color.Window">#E4E5E9</Color>
                    <Color x:Key="Color.Rail">#ECEDF0</Color>
                    <Color x:Key="Color.Surface">#F1F2F4</Color>
                    <Color x:Key="Color.SurfaceHeader">#D9DADF</Color>
                    <Color x:Key="Color.SurfaceRaised">#E6E7EB</Color>
                    <Color x:Key="Color.Border">#D0D1D7</Color>
                    <Color x:Key="Color.BorderStrong">#BBBCC4</Color>
                    <Color x:Key="Color.Text">#1A1A1E</Color>
                    <Color x:Key="Color.TextHeading">#2A2A30</Color>
                    <Color x:Key="Color.TextSecondary">#52525C</Color>
                    <Color x:Key="Color.TextMuted">#7E7E88</Color>
                    <Color x:Key="Color.Accent">#6A56E0</Color>
                    <Color x:Key="Color.AccentSoft">#266A56E0</Color>
                    <Color x:Key="Color.OnAccent">#FFFFFF</Color>
                    <Color x:Key="Color.Positive">#2B6A1A</Color>
                    <Color x:Key="Color.PositiveSoft">#1A2B6A1A</Color>
                    <Color x:Key="Color.Danger">#A3262F</Color>
                    <Color x:Key="Color.DangerSoft">#26A3262F</Color>
                    <Color x:Key="Color.Compatible">#3C8A25</Color>
                    <Color x:Key="Color.Untested">#A76300</Color>
                    <Color x:Key="Color.Incompatible">#C93A43</Color>
                    <Color x:Key="Color.CompatibilityUnknown">#7E7E88</Color>
                    <Color x:Key="Color.ChannelTesting">#1F6CC9</Color>
                    <Color x:Key="Color.ChannelDev">#9136C8</Color>
                    <Color x:Key="Color.ThumbStart">#F1F2F4</Color>
                    <Color x:Key="Color.ThumbEnd">#D9DADF</Color>
                    <Color x:Key="Color.ScrimStart">#33F1F2F4</Color>
                    <Color x:Key="Color.ScrimEnd">#CCF1F2F4</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Brushes resolve their color per theme, so styles can keep StaticResource on the brush -->
            <SolidColorBrush x:Key="Brush.Window" Color="{DynamicResource Color.Window}" />
            <SolidColorBrush x:Key="Brush.Rail" Color="{DynamicResource Color.Rail}" />
            <SolidColorBrush x:Key="Brush.Surface" Color="{DynamicResource Color.Surface}" />
            <SolidColorBrush x:Key="Brush.SurfaceHeader" Color="{DynamicResource Color.SurfaceHeader}" />
            <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{DynamicResource Color.SurfaceRaised}" />
            <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Color.Border}" />
            <SolidColorBrush x:Key="Brush.BorderStrong" Color="{DynamicResource Color.BorderStrong}" />
            <SolidColorBrush x:Key="Brush.Text" Color="{DynamicResource Color.Text}" />
            <SolidColorBrush x:Key="Brush.TextHeading" Color="{DynamicResource Color.TextHeading}" />
            <SolidColorBrush x:Key="Brush.TextSecondary" Color="{DynamicResource Color.TextSecondary}" />
            <SolidColorBrush x:Key="Brush.TextMuted" Color="{DynamicResource Color.TextMuted}" />
            <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.Accent}" />
            <SolidColorBrush x:Key="Brush.AccentSoft" Color="{DynamicResource Color.AccentSoft}" />
            <SolidColorBrush x:Key="Brush.OnAccent" Color="{DynamicResource Color.OnAccent}" />
            <SolidColorBrush x:Key="Brush.Positive" Color="{DynamicResource Color.Positive}" />
            <SolidColorBrush x:Key="Brush.PositiveSoft" Color="{DynamicResource Color.PositiveSoft}" />
            <SolidColorBrush x:Key="Brush.Danger" Color="{DynamicResource Color.Danger}" />
            <SolidColorBrush x:Key="Brush.DangerSoft" Color="{DynamicResource Color.DangerSoft}" />
            <SolidColorBrush x:Key="Brush.Compatible" Color="{DynamicResource Color.Compatible}" />
            <SolidColorBrush x:Key="Brush.Untested" Color="{DynamicResource Color.Untested}" />
            <SolidColorBrush x:Key="Brush.Incompatible" Color="{DynamicResource Color.Incompatible}" />
            <SolidColorBrush x:Key="Brush.CompatibilityUnknown" Color="{DynamicResource Color.CompatibilityUnknown}" />
            <SolidColorBrush x:Key="Brush.ChannelTesting" Color="{DynamicResource Color.ChannelTesting}" />
            <SolidColorBrush x:Key="Brush.ChannelDev" Color="{DynamicResource Color.ChannelDev}" />
            <LinearGradientBrush x:Key="Brush.Thumbnail" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="{DynamicResource Color.ThumbStart}" />
                <GradientStop Offset="1" Color="{DynamicResource Color.ThumbEnd}" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="Brush.Scrim" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0.2" Color="{DynamicResource Color.ScrimStart}" />
                <GradientStop Offset="0.75" Color="{DynamicResource Color.ScrimEnd}" />
            </LinearGradientBrush>

            <!-- IBM Plex (SIL OFL 1.1), bundled under Assets/Fonts -->
            <FontFamily x:Key="Font.Sans">avares://Borea.App/Assets/Fonts#IBM Plex Sans</FontFamily>
            <FontFamily x:Key="Font.Mono">avares://Borea.App/Assets/Fonts#IBM Plex Mono</FontFamily>

            <!-- Fluent's ToggleSwitch and ComboBox read these for their fills and borders -->
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="{DynamicResource Color.Window}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="{DynamicResource Color.Window}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="{DynamicResource Color.Window}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="{DynamicResource Color.Window}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="{DynamicResource Color.BorderStrong}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="{DynamicResource Color.BorderStrong}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled" Color="{DynamicResource Color.Window}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{DynamicResource Color.Accent}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{DynamicResource Color.Accent}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{DynamicResource Color.Accent}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{DynamicResource Color.Accent}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{DynamicResource Color.Accent}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="{DynamicResource Color.Accent}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled" Color="{DynamicResource Color.Window}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{DynamicResource Color.SurfaceHeader}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="{DynamicResource Color.SurfaceHeader}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="{DynamicResource Color.SurfaceHeader}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{DynamicResource Color.Window}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{DynamicResource Color.BorderStrong}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{DynamicResource Color.BorderStrong}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="{DynamicResource Color.Window}" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource Brush.Window}" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        </Style>

        <!-- Type scale from the Figma file: label-* are IBM Plex Mono, heading-*/action-* IBM Plex Sans SemiBold -->
        <Style Selector="TextBlock.label-sm">
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        </Style>
        <Style Selector="TextBlock.label-md">
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        </Style>
        <Style Selector="TextBlock.label-lg">
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        </Style>
        <Style Selector="TextBlock.heading-sm">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.heading-md">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.body-md">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="TextBlock.action-md">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        </Style>
        <Style Selector="TextBlock.heading-lg">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.body-sm">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.action-lg">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.SurfaceHeader}" />
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        </Style>
        <Style Selector="TextBlock.positive">
            <Setter Property="Foreground" Value="{StaticResource Brush.Positive}" />
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextHeading}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        </Style>
        <Style Selector="TextBlock.danger">
            <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
        </Style>

        <!-- Icons: Phosphor outlines on a 24 grid with a 1.5 stroke. Width/Height stay 24; the size-* classes scale to Phosphor's other sizes. -->
        <Style Selector="Path.icon">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        </Style>
        <Style Selector="Path.icon-filled">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="Fill" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        </Style>
        <Style Selector="Path.size-32">
            <Setter Property="RenderTransform" Value="scale(1.3333)" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style Selector="Path.size-18">
            <Setter Property="RenderTransform" Value="scale(0.75)" />
            <Setter Property="Margin" Value="-3" />
        </Style>
        <Style Selector="Path.size-16">
            <Setter Property="RenderTransform" Value="scale(0.6667)" />
            <Setter Property="Margin" Value="-4" />
        </Style>

        <!-- Navigation rail: 48px actions holding 32px icons; the active one turns purple -->
        <Style Selector="Button.nav">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
        </Style>
        <Style Selector="Button.nav:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
        </Style>
        <Style Selector="Button.nav.active Path.icon">
            <Setter Property="Stroke" Value="{StaticResource Brush.Accent}" />
        </Style>
        <!-- The house keeps its weight under the roof, so the rail lifts it one pixel inside its 32px box, between where its box sits and where its weight does. -->
        <Style Selector="Button.nav Path.size-32.optical-lift">
            <Setter Property="Margin" Value="4,3,4,5" />
        </Style>

        <!-- Cards, chips, thumbnails -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.thumbnail">
            <Setter Property="Background" Value="{StaticResource Brush.Thumbnail}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="views|ListingImageView">
            <Setter Property="PulseBrush" Value="{StaticResource Brush.SurfaceRaised}" />
        </Style>
        <!-- the thumbnail radius 8 less half its 1 px line, so the image stays inside the line -->
        <Style Selector="Border.thumbnail > views|ListingImageView">
            <Setter Property="CornerRadius" Value="7.5" />
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style Selector="Border.chip TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.chip.positive">
            <Setter Property="Background" Value="{StaticResource Brush.PositiveSoft}" />
        </Style>
        <Style Selector="Border.chip.positive TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Positive}" />
        </Style>

        <!-- Compatibility chips show a colored dot, and channel chips color their border instead -->
        <Style Selector="Border.chip Ellipse">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource Brush.CompatibilityUnknown}" />
        </Style>
        <Style Selector="Border.chip.compatible Ellipse">
            <Setter Property="Fill" Value="{StaticResource Brush.Compatible}" />
        </Style>
        <Style Selector="Border.chip.compatible TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Compatible}" />
        </Style>
        <Style Selector="Border.chip.untested Ellipse">
            <Setter Property="Fill" Value="{StaticResource Brush.Untested}" />
        </Style>
        <Style Selector="Border.chip.untested TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Untested}" />
        </Style>
        <Style Selector="Border.chip.incompatible Ellipse">
            <Setter Property="Fill" Value="{StaticResource Brush.Incompatible}" />
        </Style>
        <Style Selector="Border.chip.incompatible TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Incompatible}" />
        </Style>
        <Style Selector="Border.chip.testing">
            <Setter Property="BorderBrush" Value="{StaticResource Brush.ChannelTesting}" />
        </Style>
        <Style Selector="Border.chip.testing TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.ChannelTesting}" />
        </Style>
        <Style Selector="Border.chip.dev">
            <Setter Property="BorderBrush" Value="{StaticResource Brush.ChannelDev}" />
        </Style>
        <Style Selector="Border.chip.dev TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.ChannelDev}" />
        </Style>

        <!-- Game log lines, colored by the level the game wrote -->
        <Style Selector="SelectableTextBlock.log-line">
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        </Style>
        <Style Selector="Run.log-muted">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        </Style>
        <Style Selector="Run.log-information">
            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        </Style>
        <Style Selector="Run.log-warning">
            <Setter Property="Foreground" Value="{StaticResource Brush.Untested}" />
        </Style>
        <Style Selector="Run.log-error">
            <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
        </Style>
        <Style Selector="Run.log-tag">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextHeading}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Buttons -->
        <Style Selector="Button, ToggleSwitch, ComboBox, CheckBox, RadioButton">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button:disabled, ToggleSwitch:disabled, ComboBox:disabled, CheckBox:disabled, RadioButton:disabled">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Button.text">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="100" />
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Button.text:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brush.BorderStrong}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        </Style>
        <Style Selector="Button.text.primary">
            <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.SurfaceHeader}" />
        </Style>
        <Style Selector="Button.text.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.SurfaceHeader}" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="Button.text.danger">
            <Setter Property="Background" Value="{StaticResource Brush.DangerSoft}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
        </Style>
        <Style Selector="Button.text.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brush.DangerSoft}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="Button.text.danger:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <!-- c/button-cta: purple pill, 38px tall -->
        <Style Selector="Button.cta">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="20,0,24,0" />
            <Setter Property="CornerRadius" Value="100" />
            <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.cta:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <!-- the purple buttons stay purple while pressed or disabled, instead of turning into the grey Fluent button -->
        <Style Selector="Button.text.primary:pressed /template/ ContentPresenter, Button.cta:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.SurfaceHeader}" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="Button.text.primary:disabled /template/ ContentPresenter, Button.cta:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.SurfaceHeader}" />
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <!-- c/button-icon-add: black disc with a plus -->
        <Style Selector="Button.add">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="100" />
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceHeader}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.add:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
        </Style>
        <Style Selector="Button.add Path">
            <Setter Property="Stroke" Value="{StaticResource Brush.Accent}" />
            <Setter Property="StrokeThickness" Value="2" />
        </Style>
        <Style Selector="Button.add.installed Path">
            <Setter Property="Stroke" Value="{StaticResource Brush.Compatible}" />
        </Style>
        <!-- c/inner-nav-action: tabs inside the black pill -->
        <Style Selector="Button.tab">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="100" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        </Style>
        <Style Selector="Button.tab.active">
            <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.SurfaceHeader}" />
        </Style>
        <Style Selector="Button.tab.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.SurfaceHeader}" />
        </Style>
        <!-- on a detail page the selected tab is purple text without the pill -->
        <Style Selector="Button.tab.quiet.active">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        </Style>
        <Style Selector="Button.tab.quiet.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        </Style>
        <!-- a tab for content without listings yet keeps its plain text, without the grey pill of a disabled Fluent button -->
        <Style Selector="Button.tab:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <!-- c/filter-category: plain text rows in the filter panel -->
        <Style Selector="Button.filter">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.filter:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        </Style>
        <Style Selector="Button.filter:pointerover Path.icon">
            <Setter Property="Stroke" Value="{StaticResource Brush.Text}" />
        </Style>
        <Style Selector="Button.filter.active /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        </Style>
        <Style Selector="Button.filter.active Path.icon">
            <Setter Property="Stroke" Value="{StaticResource Brush.Accent}" />
        </Style>
        <!-- chip with an X, for active filters -->
        <Style Selector="Button.chip-button">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.chip-button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        </Style>
        <!-- the back control before a breadcrumb, in the accent colour like the active item of the rail -->
        <Style Selector="Button.back Path.icon">
            <Setter Property="Stroke" Value="{StaticResource Brush.Accent}" />
        </Style>
        <!-- an invisible button around text or a thumbnail -->
        <Style Selector="Button.plain">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.plain:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- a plain button that is only a title or an icon turns to the accent colour under the pointer; a row keeps the hover of its card -->
        <Style Selector="Button.plain:pointerover > TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        </Style>
        <Style Selector="Button.plain:pointerover > Path.icon">
            <Setter Property="Stroke" Value="{StaticResource Brush.Accent}" />
        </Style>
        <Style Selector="Button.plain.back:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brush.AccentSoft}" />
            <Setter Property="CornerRadius" Value="100" />
        </Style>
        <Style Selector="Button.plain:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- a plain button carries its own content, so a disabled one keeps it -->
        <Style Selector="Button.plain:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        </Style>
        <Style Selector="Button.card-button:pointerover Border.card">
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
        </Style>
        <!-- a row of a list carries the same hover state, without the surface of a card -->
        <Style Selector="Button.card-button:pointerover Border.list-row">
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
        </Style>
        <!-- a button as wide as a row keeps its size under the pointer, because the press scale of the theme would pull its edge away from the pointer -->
        <Style Selector="Button.card-button:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <!-- modal: rounded card over a dimmed page -->
        <Style Selector="Border.modal">
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Window}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="views:RoundedClip.IsEnabled" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- settings modal menu items -->
        <Style Selector="Button.menu">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.menu:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        </Style>
        <Style Selector="Button.menu.active">
            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        </Style>
        <Style Selector="Button.menu.active:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        </Style>

        <!-- c/link-cta: icon + purple text, 32px tall -->
        <Style Selector="Button.link">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="100" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brush.AccentSoft}" />
        </Style>
        <!-- an inline dropdown: a label, the chosen value and a caret, without a box -->
        <Style Selector="Button.dropdown">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="100" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.dropdown:pointerover /template/ ContentPresenter, Button.dropdown:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        </Style>
        <!-- c/button-icon-more: round, 24px dots -->
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="100" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
        </Style>
        <Style Selector="Button.icon:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <!-- views:InfoButton adds the class itself: a round 24px button with a 16px question mark -->
        <Style Selector="Button.info">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="100" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Content">
                <Template>
                    <Path Classes="icon size-16" Data="{StaticResource Icon.Question}" />
                </Template>
            </Setter>
        </Style>
        <Style Selector="Button.info:pointerover /template/ ContentPresenter, Button.info:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
        </Style>
        <Style Selector="TextBlock.info-text">
            <Setter Property="MaxWidth" Value="320" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBox.field">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Background" Value="{StaticResource Brush.Window}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style Selector="TextBox.field.search">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="{StaticResource Brush.Window}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Surface}" />
        </Style>

        <!-- the track and the knob of the Fluent switch, without the header and the on and off text it keeps space for; the names let the Fluent states style the parts -->
        <Style Selector="ToggleSwitch.switch">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid x:Name="SwitchAreaGrid" Background="{TemplateBinding Background}" TemplatedControl.IsTemplateFocusTarget="True">
                        <Border x:Name="OuterBorder" Width="40" Height="20" CornerRadius="10" Background="{DynamicResource ToggleSwitchFillOff}" BorderBrush="{DynamicResource ToggleSwitchStrokeOff}" BorderThickness="{DynamicResource ToggleSwitchOuterBorderStrokeThickness}" />
                        <Border x:Name="SwitchKnobBounds" Width="40" Height="20" CornerRadius="10" Background="{DynamicResource ToggleSwitchFillOn}" BorderBrush="{DynamicResource ToggleSwitchStrokeOn}" BorderThickness="{DynamicResource ToggleSwitchOnStrokeThickness}" />
                        <Canvas x:Name="PART_SwitchKnob" Width="20" Height="20" HorizontalAlignment="Left">
                            <Grid x:Name="PART_MovingKnobs" Width="20" Height="20">
                                <Ellipse x:Name="SwitchKnobOn" Width="10" Height="10" Fill="{DynamicResource ToggleSwitchKnobFillOn}" />
                                <Ellipse x:Name="SwitchKnobOff" Width="10" Height="10" Fill="{DynamicResource ToggleSwitchKnobFillOff}" />
                            </Grid>
                        </Canvas>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- c/SplitButton-launch: a purple pill cut in two, 32px tall like c/link-cta, purple in every state -->
        <Style Selector="Button.splitButton">
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.splitButton.primary">
            <Setter Property="Padding" Value="14,0,14,0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="CornerRadius" Value="100,0,0,100" />
        </Style>
        <Style Selector="Button.splitButton.flyout">
            <Setter Property="Padding" Value="8,0,12,0" />
            <Setter Property="CornerRadius" Value="0,100,100,0" />
        </Style>
        <Style Selector="Button.splitButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="Button.splitButton:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="Button.splitButton:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <!-- c/link-cta while it cannot act, without the grey pill of a disabled Fluent button -->
        <Style Selector="Button.link:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <!-- filter-panel and detail-panel: a card along the right edge of the page, full height, that scrolls on its own -->
        <Style Selector="Border.side-panel">
            <Setter Property="Width" Value="{x:Static views:PageBodyPanel.SidePanelWidth}" />
            <Setter Property="Margin" Value="{x:Static views:PageBodyPanel.SidePanelMargin}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="views:RoundedClip.IsEnabled" Value="True" />
        </Style>

        <!-- c/content-header: the actions right of the title -->
        <Style Selector=":is(Control).content-actions">
            <Setter Property="Grid.Column" Value="2" />
        </Style>
        <!-- a page body narrower than the design: the actions go below the text, and tables hide the columns they can do without -->
        <ContainerQuery Name="page-body" Query="max-width:720">
            <Style Selector=":is(Control).content-text">
                <Setter Property="Grid.ColumnSpan" Value="3" />
            </Style>
            <Style Selector=":is(Control).content-actions">
                <Setter Property="Grid.Row" Value="1" />
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.ColumnSpan" Value="3" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="0,16,0,0" />
            </Style>
            <Style Selector=":is(Control).hide-narrow">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </ContainerQuery>
        <ContainerQuery Name="page-body" Query="max-width:520">
            <Style Selector=":is(Control).hide-small">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </ContainerQuery>

        <!-- the author placeholder of the detail panel -->
        <Style Selector="Border.avatar">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceHeader}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.avatar Path.icon">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Application.Styles>
</Application>
