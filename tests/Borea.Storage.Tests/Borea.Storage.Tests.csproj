<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Borea.Core\Borea.Core.csproj" />
    <ProjectReference Include="..\..\src\Borea.Storage\Borea.Storage.csproj" />
    <ProjectReference Include="Fixtures\LaunchProbeFixture\LaunchProbeFixture.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Own projects inside this folder, so their sources stay out of these globs. -->
    <Compile Remove="Fixtures\**" />
    <None Remove="Fixtures\**" />
    <None Update="Index\Fixtures\current-snapshot.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- A copy of schemas/vectors.json of content-index at 1621b26b8efe, the documents its checks and its listing page run. -->
    <None Update="Listings\Fixtures\vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Copies of index-status.toml and its schema from content-index. -->
    <None Update="Stewardship\Fixtures\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- A copy of schemas/pack-vectors.json of content-index at f99a2ed148d7, the merge of content-index #178 (sha256 13509dc1). -->
    <None Update="Listings\Fixtures\pack-vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The copies of real game files, which the game check runs against. -->
    <None Update="Game\Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\announcements.toml" Link="Announcements\announcements.toml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="..\VersionFixtures.targets" />

  <!-- The probe runs through the dotnet host, which needs its runtime config next to it. -->
  <Target Name="CopyLaunchProbeFixture" AfterTargets="CopyFilesToOutputDirectory">
    <MSBuild Projects="Fixtures\LaunchProbeFixture\LaunchProbeFixture.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="LaunchProbeAssembly" />
    </MSBuild>
    <ItemGroup>
      <LaunchProbeFile Include="@(LaunchProbeAssembly)" />
      <LaunchProbeFile Include="@(LaunchProbeAssembly->'%(RootDir)%(Directory)%(Filename).runtimeconfig.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(LaunchProbeFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true">
      <Output TaskParameter="CopiedFiles" ItemName="FileWrites" />
    </Copy>
  </Target>

</Project>
